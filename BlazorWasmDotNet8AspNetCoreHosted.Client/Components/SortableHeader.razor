@* Заголовок таблиці з єдиною поведінкою сортування. *@
<th class="@HeaderClass"
    style="@Style"
    scope="col"
    aria-sort="@AriaSort">
    <button type="button"
            class="sortable-th__button"
            title="@Title"
            @onclick="Sort">
        <span>@ChildContent</span>
        @if (IsActive)
        {
            <span class="ms-1" aria-hidden="true">@(SortAscending ? "▲" : "▼")</span>
        }
    </button>
</th>

@code {
    [Parameter, EditorRequired]
    public string Field { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ActiveField { get; set; } = string.Empty;

    [Parameter]
    public bool SortAscending { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnSort { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private bool IsActive => string.Equals(Field, ActiveField, StringComparison.Ordinal);

    private string AriaSort => IsActive
        ? SortAscending ? "ascending" : "descending"
        : "none";

    private string HeaderClass => string.IsNullOrWhiteSpace(Class)
        ? "sortable-th"
        : $"sortable-th {Class}";

    private async Task Sort()
    {
        await OnSort.InvokeAsync(Field);
    }
}
