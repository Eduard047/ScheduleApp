@page "/admin/lunch"
@inject NavigationManager Nav

<PageTitle>Адмін • Обід</PageTitle>

<div class="alert alert-info mt-3">
    Налаштування обіду тепер робиться на сторінці слотів часу. Позначте потрібний слот як обід у розділі
    <a class="alert-link" href="/admin/time-slots">«Слоти часу»</a>.
</div>

<button class="btn btn-primary" @onclick="GoToSlots">Відкрити слоти часу</button>

@code {
    private void GoToSlots() => Nav.NavigateTo("/admin/time-slots");
}
