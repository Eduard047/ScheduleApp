@page "/admin/lunch"
@inject NavigationManager Nav

<PageTitle>Адмін • Обід</PageTitle>

<div class="alert alert-warning mt-3">
    Окремий конфіг обіду більше не використовується автогенерацією. Час пар задається у
    <a class="alert-link" href="/admin/time-slots">«Слотах часу»</a>, а пріоритет типу занять
    <strong>«Бажано першим у тижні»</strong> тепер налаштовується там же через ліміт слота.
</div>

<button class="btn btn-primary" @onclick="GoToSlots">Відкрити слоти часу</button>

@code {
    // Переходить на сторінку слотів часу.
    private void GoToSlots() => Nav.NavigateTo("/admin/time-slots");
}
