@* Сторінка адміністрування кафедр *@
@page "/admin/departments"
@using System.Net
@using System.Net.Http.Json
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Адмін • Кафедри</PageTitle>

<h1 class="h3 mb-3">Кафедри</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
        @if (loadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoad" disabled="@(loading || mutationInProgress)">
                    Повторити завантаження
                </button>
            </div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}

@if (loading)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Завантаження кафедр…</div>
}

<fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreate">Додати кафедру</button>
        <AdminSearchBox @bind-Value="filter" Class="ms-auto" Style="max-width:360px;" Placeholder="Id / назва" />
        <div class="small text-muted">Показано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(DepartmentEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">Id</SortableHeader>
                    <SortableHeader Field="@nameof(DepartmentEditDto.Name)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                    <SortableHeader Field="@nameof(DepartmentEditDto.IsActive)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:120px;">Активна</SortableHeader>
                    <th style="width:220px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center">Немає записів.</td>
                    </tr>
                }
                else
                {
                    @foreach (var d in SortedAndFiltered)
                    {
                        <tr>
                            <td>@d.Id</td>
                            <td>@d.Name</td>
                            <td>
                                <input type="checkbox" class="form-check-input" checked="@d.IsActive" disabled />
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEdit(d)">Редагувати</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(d.Id!.Value)">Видалити</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</fieldset>

@if (editorOpen)
{
    <AdminEditorModal Title="@DepartmentEditorTitle"
                      Subtitle="Вкажіть назву кафедри та її статус."
                      CssClass="department-editor"
                      Busy="@(loading || mutationInProgress)"
                      OnClose="@CloseEditor">
        @if (loadFailed)
        {
            <div class="alert alert-danger" role="alert">
                <div class="fw-semibold">Операцію виконано, але дані не оновлено.</div>
                <div class="small mt-1">@error</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="RetryLoad"
                        disabled="@(loading || mutationInProgress)">
                    @(loading ? "Завантаження…" : "Повторити лише завантаження")
                </button>
            </div>
        }
        <fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <label class="form-label" for="department-name">Назва</label>
                <input id="department-name" class="form-control" @bind="form.Name" />
            </div>
            <div class="col-12 col-md-4">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="depActiveEditor" @bind="form.IsActive" />
                    <label class="form-check-label" for="depActiveEditor">Активна</label>
                </div>
            </div>
        </div>
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="Save">@(saving ? "Збереження…" : "Зберегти")</button>
            <button class="btn btn-outline-secondary" @onclick="CloseEditor">Скасувати</button>
        </div>
        </fieldset>
    </AdminEditorModal>
}

@code {
    private string? error, ok;
    private List<DepartmentEditDto> items = new();
    private DepartmentEditDto form = NewForm();
    private bool editorOpen;
    private bool loading, saving, loadFailed, mutationInProgress;
    private bool IsInteractionBlocked => loading || mutationInProgress || loadFailed;
    private Action? pendingRefreshCompletion;
    private string? pendingRefreshSuccessMessage;
    private string? filter;
    private string sortField = nameof(DepartmentEditDto.Name);
    private bool sortAsc = true;
    private string DepartmentEditorTitle => form.Id is null
        ? "Створення кафедри"
        : $"Редагування кафедри #{form.Id}";
    private static DepartmentEditDto NewForm() => new() { Id = null, Name = "", IsActive = true };
    private void OpenCreate()
    {
        form = NewForm();
        editorOpen = true;
    }
    private void OpenEdit(DepartmentEditDto dto)
    {
        form = new DepartmentEditDto(dto.Id, dto.Name, dto.IsActive);
        editorOpen = true;
    }
    private void CloseEditor()
    {
        editorOpen = false;
        form = NewForm();
    }
    // Початкове завантаження списку кафедр.
    protected override async Task OnInitializedAsync() => await Load();
    // Завантажує кафедри з API.
    private async Task<bool> Load(bool clearMessages = true)
    {
        error = null;
        if (clearMessages) ok = null;
        loading = true;
        loadFailed = false;
        try
        {
            var loadedItems = await Http.GetFromJsonWithDetailsAsync<List<DepartmentEditDto>>("api/admin/departments") ?? new();
            items = loadedItems;
            return true;
        }
        catch (Exception ex)
        {
            loadFailed = true;
            error = $"Не вдалося завантажити кафедри: {ex.Message}";
            return false;
        }
        finally { loading = false; }
    }
    // Повторює лише завантаження після вже виконаної серверної операції.
    private async Task RetryLoad()
    {
        if (loading || mutationInProgress) return;
        if (!await Load(clearMessages: false)) return;
        var completion = pendingRefreshCompletion;
        var successMessage = pendingRefreshSuccessMessage;
        pendingRefreshCompletion = null;
        pendingRefreshSuccessMessage = null;
        completion?.Invoke();
        if (!string.IsNullOrWhiteSpace(successMessage)) ok = successMessage;
    }
    // Зберігає кафедру через API.
    private async Task Save()
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        saving = true;
        try
        {
            error = null;
            ok = null;
            var resp = await Http.PostAsJsonAsync("api/admin/departments/upsert", form);
            await resp.EnsureSuccessWithDetailsAsync();
            await FinishMutationAsync(
                "Кафедру збережено",
                "Збережено.",
                "повторно зберігати кафедру не потрібно",
                CloseEditor);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
            mutationInProgress = false;
        }
    }
    // Видаляє кафедру з підтвердженням та force-режимом.
    private async Task Delete(int id)
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        try
        {
            error = null;
            ok = null;
            var dep = items.FirstOrDefault(x => x.Id == id);
            var caption = dep is null ? $"#{id}" : $"{dep.Name} (#{id})";
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити кафедру {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            var resp = await Http.DeleteAsync($"api/admin/departments/{id}?confirm=true");
            if (resp.StatusCode == HttpStatusCode.Conflict)
            {
                var forceConfirmed = await JS.InvokeAsync<bool>(
                    "confirm",
                    "Кафедра використовується викладачами або темами. Видалити примусово (force) і очистити привʼязки?");
                if (!forceConfirmed) return;
                resp = await Http.DeleteAsync($"api/admin/departments/{id}?confirm=true&force=true");
            }
            await resp.EnsureSuccessWithDetailsAsync();
            await FinishMutationAsync(
                "Кафедру видалено",
                "Видалено.",
                "повторно видаляти кафедру не потрібно",
                editorOpen && form.Id == id ? CloseEditor : null);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { mutationInProgress = false; }
    }
    // Завершує мутацію лише після успішного оновлення локального списку.
    private async Task FinishMutationAsync(
        string completedAction,
        string successMessage,
        string repeatWarning,
        Action? completion = null)
    {
        if (await Load(clearMessages: false))
        {
            completion?.Invoke();
            ok = successMessage;
            return;
        }

        var refreshError = error;
        ok = null;
        pendingRefreshCompletion = completion;
        pendingRefreshSuccessMessage = successMessage;
        error = $"{completedAction}, але оновити дані не вдалося. Повторіть завантаження; {repeatWarning}. Причина: {refreshError}";
    }
    // Перемикає напрямок сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
    // Фільтрує кафедри за пошуковим рядком.
    private IEnumerable<DepartmentEditDto> ApplyFilter(IEnumerable<DepartmentEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(x =>
            x.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) == true
            || (x.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
    }
    // Сортує кафедри за вибраним полем.
    private IEnumerable<DepartmentEditDto> ApplySort(IEnumerable<DepartmentEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(DepartmentEditDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(DepartmentEditDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(DepartmentEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(DepartmentEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(DepartmentEditDto.IsActive), true) => seq.OrderByDescending(x => x.IsActive).ThenBy(x => x.Name),
            (nameof(DepartmentEditDto.IsActive), false) => seq.OrderBy(x => x.IsActive).ThenBy(x => x.Name),
            _ => seq
        };
    }
    private IEnumerable<DepartmentEditDto> SortedAndFiltered => ApplySort(ApplyFilter(items));
}
