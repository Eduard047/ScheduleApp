@* Сторінка адміністрування кафедр *@
@page "/admin/departments"
@using System.Net
@using System.Net.Http.Json
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Адмін • Кафедри</PageTitle>

<h3 class="mb-3">Кафедри</h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreate">Додати кафедру</button>
        <div class="input-group ms-auto" style="max-width:360px;">
            <span class="input-group-text">Пошук</span>
            <input class="form-control" @bind="filter" @bind:event="oninput" placeholder="Id / назва" />
        </div>
        <div class="small text-muted">Показано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:80px;" class="sortable-th" role="button" @onclick="() => ToggleSort(nameof(DepartmentEditDto.Id))">
                        Id @HeaderIcon(nameof(DepartmentEditDto.Id))
                    </th>
                    <th class="sortable-th" role="button" @onclick="() => ToggleSort(nameof(DepartmentEditDto.Name))">
                        Назва @HeaderIcon(nameof(DepartmentEditDto.Name))
                    </th>
                    <th style="width:120px;" class="sortable-th" role="button" @onclick="() => ToggleSort(nameof(DepartmentEditDto.IsActive))">
                        Активна @HeaderIcon(nameof(DepartmentEditDto.IsActive))
                    </th>
                    <th style="width:180px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center">Немає записів.</td>
                    </tr>
                }
                else
                {
                    @foreach (var d in SortedAndFiltered)
                    {
                        <tr>
                            <td>@d.Id</td>
                            <td>@d.Name</td>
                            <td>
                                <input type="checkbox" class="form-check-input" checked="@d.IsActive" disabled />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEdit(d)">Редагувати</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(d.Id!.Value)">Видалити</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (editorOpen)
{
    <div class="editor-overlay" @onclick="CloseEditor">
        <div class="editor editor-modal department-editor" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div class="editor-title">@((form.Id is null ? "Створення кафедри" : $"Редагування кафедри #{form.Id}"))</div>
                    <div class="editor-subtitle">Вкажіть назву кафедри та її статус.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary editor-close" title="Закрити" @onclick="CloseEditor">×</button>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-8">
                    <label class="form-label">Назва</label>
                    <input class="form-control" @bind="form.Name" />
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="depActiveEditor" @bind="form.IsActive" />
                        <label class="form-check-label" for="depActiveEditor">Активна</label>
                    </div>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="Save">Зберегти</button>
                <button class="btn btn-outline-secondary" @onclick="CloseEditor">Скасувати</button>
            </div>
        </div>
    </div>
}

<style>
    .editor-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(2px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 72px 18px 24px;
        overflow-y: auto;
        z-index: 2500;
    }
    .editor {
        margin-top: 14px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px;
        width: min(720px, 100%);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }
    .editor-modal-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .editor-title { font-weight: 800; font-size: 1.1rem; }
    .editor-subtitle { color: #475569; font-size: .92rem; margin-top: 4px; }
    .editor-close { min-width: 44px; height: 44px; font-size: 1.3rem; padding: 0 .6rem; }
    .editor-actions {
        margin-top: 14px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }
</style>

@code {
    private string? error, ok;
    private List<DepartmentEditDto> items = new();
    private DepartmentEditDto form = NewForm();
    private bool editorOpen;
    private string? filter;
    private string sortField = nameof(DepartmentEditDto.Name);
    private bool sortAsc = true;
    private static DepartmentEditDto NewForm() => new() { Id = null, Name = "", IsActive = true };
    private void OpenCreate()
    {
        form = NewForm();
        editorOpen = true;
    }
    private void OpenEdit(DepartmentEditDto dto)
    {
        form = new DepartmentEditDto(dto.Id, dto.Name, dto.IsActive);
        editorOpen = true;
    }
    private void CloseEditor()
    {
        editorOpen = false;
        form = NewForm();
    }
    // Початкове завантаження списку кафедр.
    protected override async Task OnInitializedAsync() => await Load();
    // Завантажує кафедри з API.
    private async Task Load()
    {
        try
        {
            error = ok = null;
            items = await Http.GetFromJsonAsync<List<DepartmentEditDto>>("api/admin/departments") ?? new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
    // Зберігає кафедру через API.
    private async Task Save()
    {
        try
        {
            error = null;
            ok = null;
            var resp = await Http.PostAsJsonAsync("api/admin/departments/upsert", form);
            await Ensure(resp);
            await Load();
            ok = "Збережено.";
            CloseEditor();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
    // Видаляє кафедру з підтвердженням та force-режимом.
    private async Task Delete(int id)
    {
        try
        {
            error = null;
            ok = null;
            var dep = items.FirstOrDefault(x => x.Id == id);
            var caption = dep is null ? $"#{id}" : $"{dep.Name} (#{id})";
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити кафедру {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            var resp = await Http.DeleteAsync($"api/admin/departments/{id}?confirm=true");
            if (resp.StatusCode == HttpStatusCode.Conflict)
            {
                var forceConfirmed = await JS.InvokeAsync<bool>(
                    "confirm",
                    "Кафедра використовується викладачами або темами. Видалити примусово (force) і очистити привʼязки?");
                if (!forceConfirmed) return;
                resp = await Http.DeleteAsync($"api/admin/departments/{id}?confirm=true&force=true");
            }
            await Ensure(resp);
            await Load();
            ok = "Видалено.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
    // Перевіряє успішність відповіді API.
    private static async Task Ensure(HttpResponseMessage resp)
    {
        if (resp.IsSuccessStatusCode) return;
        var body = await resp.Content.ReadAsStringAsync();
        var msg = string.IsNullOrWhiteSpace(body) ? resp.ReasonPhrase : body;
        throw new HttpRequestException(msg ?? "Request failed", null, resp.StatusCode);
    }
    // Перемикає напрямок сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
    // Повертає піктограму для заголовка сортування.
    private string HeaderIcon(string field)
    {
        if (sortField != field) return "";
        return sortAsc ? "▲" : "▼";
    }
    // Фільтрує кафедри за пошуковим рядком.
    private IEnumerable<DepartmentEditDto> ApplyFilter(IEnumerable<DepartmentEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(x =>
            x.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) == true
            || (x.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
    }
    // Сортує кафедри за вибраним полем.
    private IEnumerable<DepartmentEditDto> ApplySort(IEnumerable<DepartmentEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(DepartmentEditDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(DepartmentEditDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(DepartmentEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(DepartmentEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(DepartmentEditDto.IsActive), true) => seq.OrderByDescending(x => x.IsActive).ThenBy(x => x.Name),
            (nameof(DepartmentEditDto.IsActive), false) => seq.OrderBy(x => x.IsActive).ThenBy(x => x.Name),
            _ => seq
        };
    }
    private IEnumerable<DepartmentEditDto> SortedAndFiltered => ApplySort(ApplyFilter(items));
}
