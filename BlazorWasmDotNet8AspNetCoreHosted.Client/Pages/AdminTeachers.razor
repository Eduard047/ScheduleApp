@* Сторінка адміністрування викладачів *@
@page "/admin/teachers"
@using System.Net
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Адмін • Викладачі</PageTitle>

<h1 class="h3">Викладачі</h1>

@if (edit is null && !string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
        @if (listLoadFailed || metaLoadFailed)
        {
            <div class="mt-2">
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        disabled="@operationInProgress"
                        @onclick="RetryListAsync">
                    @RetryLoadLabel
                </button>
            </div>
        }
    </div>
}
@if (edit is null && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}

@if (loading)
{
    <p role="status" aria-live="polite">Завантаження…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
        <button class="btn btn-primary" disabled="@IsMutationBlocked" @onclick="CreateNew">Додати викладача</button>
        <AdminSearchBox @bind-Value="filter" Style="max-width:360px;" Placeholder="Id / ПІБ / кафедра / курс / ступінь / звання / модуль" />
    </div>
    <div class="small text-muted mb-2">Показано: @SortedAndFiltered.Count() з @list.Count</div>
    <div class="table-responsive" role="region" aria-label="Список викладачів" tabindex="0">
        <table class="table table-sm">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(TeacherViewDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">#</SortableHeader>
                    <SortableHeader Field="@nameof(TeacherViewDto.FullName)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">ПІБ</SortableHeader>
                    <SortableHeader Field="@DepartmentField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Кафедра</SortableHeader>
                    <SortableHeader Field="@nameof(TeacherViewDto.ScientificDegree)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Науковий ступінь</SortableHeader>
                    <SortableHeader Field="@nameof(TeacherViewDto.AcademicTitle)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Наукове звання</SortableHeader>
                    <SortableHeader Field="@ModulesField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Модулі</SortableHeader>
                    <SortableHeader Field="@ActiveCoursesField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Активні</SortableHeader>
                    <th scope="col" style="width:220px;"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!SortedAndFiltered.Any())
                {
                    <tr>
                        <td colspan="8" class="text-muted text-center">
                            @(list.Count == 0 ? "Викладачів ще немає." : "За цим пошуком нічого не знайдено.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in SortedAndFiltered)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>@t.FullName</td>
                            <td>@DepartmentCaption(t.DepartmentId)</td>
                            <td>@t.ScientificDegree</td>
                            <td>@t.AcademicTitle</td>
                            <td>@ModulesCaption(t)</td>
                            <td>@ActiveCoursesMarkup(t)</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-2"
                                        disabled="@IsMutationBlocked"
                                        @onclick="() => Edit(t.Id)">
                                    @(_editingId == t.Id ? "Відкриття…" : "Редагувати")
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@IsMutationBlocked"
                                        @onclick="() => Delete(t.Id)">
                                    @(deletingId == t.Id ? "Видалення…" : "Видалити")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (edit != null)
{
    <AdminEditorModal Title="@TeacherEditorTitle"
                      Subtitle="Заповніть дані викладача, дозвольте потрібні модулі та робочі вікна."
                      CssClass="teacher-editor"
                      Busy="@operationInProgress"
                      OnClose="@Cancel">
            <div class="teacher-editor-body">
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger" role="alert">
                        @error
                        @if (listLoadFailed || metaLoadFailed)
                        {
                            <div class="mt-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@operationInProgress"
                                        @onclick="RetryListAsync">
                                    @RetryLoadLabel
                                </button>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(ok))
                {
                    <div class="alert alert-success" role="status">@ok</div>
                }
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="teacherFullName">ПІБ</label>
                        <input id="teacherFullName" class="form-control" disabled="@operationInProgress" @bind="edit.FullName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="teacherDepartment">Кафедра</label>
                        <select id="teacherDepartment"
                                class="form-select"
                                disabled="@operationInProgress"
                                value="@edit.DepartmentId"
                                @onchange="e => edit.DepartmentId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : (int?)null">
                            <option value="">— Не вказано —</option>
                            @foreach (var d in meta.Departments.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@d.Id" selected="@(d.Id == edit.DepartmentId)">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="teacherDegree">Науковий ступінь</label>
                        <input id="teacherDegree" class="form-control" disabled="@operationInProgress" @bind="edit.ScientificDegree" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="teacherTitle">Наукове звання</label>
                        <input id="teacherTitle" class="form-control" disabled="@operationInProgress" @bind="edit.AcademicTitle" />
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="fw-semibold">Допустимі модулі</div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled="@operationInProgress"
                                @onclick="SelectAllModules">
                            Вибрати всі
                        </button>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                        @foreach (var m in meta.Modules)
                        {
                            var checkedFlag = edit.ModuleIds.Contains(m.Id);
                            var checkboxId = $"teacher_module_{m.Id}";
                            <div class="col">
                                <div class="form-check align-items-start">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@checkboxId"
                                           disabled="@operationInProgress"
                                           checked="@checkedFlag"
                                           @onchange="e => ToggleModule(m.Id, AsBool(e.Value))" />
                                    <label class="form-check-label ms-2" for="@checkboxId">
                                        <span class="d-block fw-semibold">@m.Name</span>
                                        <span class="d-block text-muted small">@m.CourseName</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="fw-semibold">Керівництво самостійними роботами</div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled="@operationInProgress"
                                @onclick="SelectAllSupervisorModules">
                            Вибрати всі
                        </button>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                        @foreach (var m in meta.Modules)
                        {
                            var checkedFlag = edit.SupervisorModuleIds.Contains(m.Id);
                            var checkboxId = $"teacher_sup_module_{m.Id}";
                            <div class="col">
                                <div class="form-check align-items-start">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@checkboxId"
                                           disabled="@operationInProgress"
                                           checked="@checkedFlag"
                                           @onchange="e => ToggleSupervisorModule(m.Id, AsBool(e.Value))" />
                                    <label class="form-check-label ms-2" for="@checkboxId">
                                        <span class="d-block fw-semibold">@m.Name</span>
                                        <span class="d-block text-muted small">@m.CourseName</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <h5 class="mb-0">Навантаження по курсам</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Курс</th>
                                    <th scope="col" style="width:200px">Заплановано годин</th>
                                    <th scope="col" style="width:120px">Активне</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in meta.Courses)
                                {
                                    var row = GetLoad(c.Id);
                                    var checkboxId = $"teacher_course_{c.Id}";
                                    <tr>
                                        <td>@c.Name</td>
                                        <td>
                                            <span class="badge bg-secondary">@row.ScheduledHours</span>
                                        </td>
                                        <td>
                                            <input id="@checkboxId"
                                                   type="checkbox"
                                                   class="form-check-input"
                                                   aria-label="Активне навантаження для курсу @c.Name"
                                                   disabled="@operationInProgress"
                                                   checked="@row.IsActive"
                                                   @onchange="e => UpdateLoadActive(c.Id, AsBool(e.Value))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="editor-card">
                    <h5 class="mb-2">Робочі вікна</h5>
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @for (int uiDay = 0; uiDay < 7; uiDay++)
                        {
                            var serverDay = (uiDay + 1) % 7; 
                            var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
                            bool enabled = row is not null;
                            string start = row?.Start ?? "09:00";
                            string end = row?.End ?? "17:00";
                            var workingId = $"teacher_working_{serverDay}";
                            var startId = $"teacher_working_start_{serverDay}";
                            var endId = $"teacher_working_end_{serverDay}";
                            <div class="col">
                                <div class="card p-2 h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="fw-semibold">@DayName(uiDay)</div>
                                        <div class="form-check">
                                            <input id="@workingId"
                                                   type="checkbox"
                                                   class="form-check-input"
                                                   disabled="@operationInProgress"
                                                   checked="@enabled"
                                                   @onchange="e => ToggleDay(serverDay, AsBool(e.Value))" />
                                            <label class="form-check-label" for="@workingId">Працює</label>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <label class="visually-hidden" for="@startId">Початок роботи у @DayName(uiDay)</label>
                                        <input id="@startId" class="form-control form-control-sm" type="time" value="@start"
                                               disabled="@(!enabled || operationInProgress)"
                                               @onchange="e => SetWhStart(serverDay, e.Value?.ToString())" />
                                        <span>—</span>
                                        <label class="visually-hidden" for="@endId">Завершення роботи у @DayName(uiDay)</label>
                                        <input id="@endId" class="form-control form-control-sm" type="time" value="@end"
                                               disabled="@(!enabled || operationInProgress)"
                                               @onchange="e => SetWhEnd(serverDay, e.Value?.ToString())" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-success" disabled="@IsMutationBlocked" @onclick="Save">
                    @(operationInProgress ? "Збереження…" : "Зберегти")
                </button>
                <button class="btn btn-outline-secondary" disabled="@operationInProgress" @onclick="Cancel">Скасувати</button>
            </div>
    </AdminEditorModal>
}

@code {

    private MetaResponseDto meta = new(new(), new(), new(), new(), new(), new(), new());
    private List<TeacherViewDto> list = new();
    private TeacherEditDto? edit;
    private bool loading = true;
    private bool operationInProgress;
    private bool listLoadFailed;
    private bool metaLoadFailed;
    private bool closeEditorAfterListRetry;
    private int? _editingId;
    private int? deletingId;
    private string? error;
    private string? ok;
    private string? completedMutationRefreshErrorPrefix;
    private string? completedMutationRetrySuccessMessage;
    private bool IsMutationBlocked => operationInProgress || listLoadFailed || metaLoadFailed;
    private string RetryLoadLabel => metaLoadFailed && listLoadFailed
        ? "Повторити завантаження даних"
        : metaLoadFailed
            ? "Повторити завантаження довідників"
            : "Повторити завантаження списку";
    private const string SaveRefreshErrorPrefix =
        "Збереження викладача виконано, але список не оновлено; повторно зберігати не потрібно.";
    private const string DeleteRefreshErrorPrefix =
        "Видалення викладача виконано, але список не оновлено; повторно видаляти не потрібно.";
    private const string DepartmentField = "Department";
    private const string ModulesField = "ModulesCount";
    private const string ActiveCoursesField = "ActiveCourses";
    private string sortField = nameof(TeacherViewDto.FullName);
    private bool sortAsc = true;
    private string? filter;
    private string TeacherEditorTitle => edit?.Id is null
        ? "Створення викладача"
        : $"Редагування #{edit.Id}";
    // Завантажує метадані та список викладачів.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.WhenAll(LoadMeta(), LoadList());
        }
        catch (Exception ex)
        {
            error = BuildFailedLoadError(ex);
        }
        finally
        {
            loading = false;
        }
    }
    // Завантажує довідники для форми викладача.
    private async Task LoadMeta()
    {
        try
        {
            var loaded = await Http.GetFromJsonWithDetailsAsync<MetaResponseDto>("api/meta")
                         ?? throw new InvalidOperationException("Сервер не повернув довідники викладачів.");
            meta = loaded;
            metaLoadFailed = false;
        }
        catch
        {
            metaLoadFailed = true;
            throw;
        }
    }
    // Завантажує список викладачів.
    private async Task LoadList()
    {
        try
        {
            var loaded = await Http.GetFromJsonWithDetailsAsync<List<TeacherViewDto>>("api/admin/teachers") ?? new();
            list = loaded;
            listLoadFailed = false;
        }
        catch
        {
            listLoadFailed = true;
            throw;
        }
    }
    // Повторює лише ті безпечні читання довідників або списку, які завершилися помилкою.
    private async Task RetryListAsync()
    {
        if (operationInProgress) return;
        var retryMeta = metaLoadFailed;
        var retryList = listLoadFailed;
        if (!retryMeta && !retryList) return;
        operationInProgress = true;
        error = null;
        ok = null;
        try
        {
            if (retryMeta && retryList)
            {
                await Task.WhenAll(LoadMeta(), LoadList());
            }
            else if (retryMeta)
            {
                await LoadMeta();
            }
            else
            {
                await LoadList();
            }

            if (completedMutationRefreshErrorPrefix is not null
                || completedMutationRetrySuccessMessage is not null)
            {
                if (closeEditorAfterListRetry)
                {
                    edit = null;
                }
                closeEditorAfterListRetry = false;
                ok = completedMutationRetrySuccessMessage ?? "Список викладачів оновлено.";
                completedMutationRefreshErrorPrefix = null;
                completedMutationRetrySuccessMessage = null;
            }
            else
            {
                ok = retryMeta && retryList
                    ? "Довідники та список викладачів оновлено."
                    : retryMeta
                        ? "Довідники викладачів оновлено."
                        : "Список викладачів оновлено.";
            }
        }
        catch (Exception ex)
        {
            error = BuildFailedLoadError(ex);
        }
        finally
        {
            operationInProgress = false;
        }
    }
    // Відкриває форму редагування викладача.
    private async Task Edit(int id)
    {
        if (IsMutationBlocked) return;
        operationInProgress = true;
        _editingId = id;
        error = null;
        ok = null;
        try
        {
            edit = await Http.GetFromJsonWithDetailsAsync<TeacherEditDto>($"api/admin/teachers/{id}");
            if (edit is null)
            {
                error = "Сервер не повернув дані викладача.";
            }
        }
        catch (Exception ex)
        {
            error = ErrorMessage(ex, "Не вдалося відкрити викладача.");
        }
        finally
        {
            _editingId = null;
            operationInProgress = false;
        }
    }
    private const string DefaultWhStart = "08:30";
    private const string DefaultWhEnd = "19:00";
    // Ініціалізує форму створення викладача.
    private void CreateNew()
    {
        if (IsMutationBlocked) return;
        error = null;
        ok = null;
        var defaultWorkingHours = Enumerable.Range(0, 7)
            .Select(ui => new TeacherWorkingHourDto((ui + 1) % 7, DefaultWhStart, DefaultWhEnd))
            .ToList();
        edit = new TeacherEditDto(
            id: null,
            fullName: "",
            scientificDegree: null,
            academicTitle: null,
            departmentId: null,
            moduleIds: new List<int>(),
            supervisorModuleIds: new List<int>(),
            loads: new List<TeacherLoadDto>(),
            workingHours: defaultWorkingHours
        );
    }
    // Зберігає дані викладача через API.
    private async Task Save()
    {
        if (edit is null || IsMutationBlocked) return;
        operationInProgress = true;
        error = null;
        ok = null;
        try
        {
            using var resp = await Http.PostAsJsonAsync("api/admin/teachers/upsert", edit);
            await resp.EnsureSuccessWithDetailsAsync();
            try
            {
                var savedId = await resp.Content.ReadFromJsonAsync<int?>();
                if (savedId is > 0)
                {
                    edit.Id = savedId.Value;
                }
            }
            catch
            {
                // Мутація вже завершена; безпечне оновлення списку нижче визначить актуальний стан.
            }
            if (await RefreshAfterCompletedMutationAsync(
                    SaveRefreshErrorPrefix,
                    "Список викладачів оновлено; збереження вже було виконано.",
                    closeEditorAfterRetry: true))
            {
                edit = null;
                ok = "Збережено.";
            }
        }
        catch (Exception ex)
        {
            error = ErrorMessage(ex, "Не вдалося зберегти викладача.");
        }
        finally
        {
            operationInProgress = false;
        }
    }
    // Видаляє викладача після підтвердження.
    private async Task Delete(int id)
    {
        if (IsMutationBlocked) return;
        var teacher = list.FirstOrDefault(t => t.Id == id);
        var caption = teacher?.FullName ?? $"#{id}";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити викладача {caption}? Дію не можна скасувати.");
        if (!confirmed) return;
        if (IsMutationBlocked) return;
        operationInProgress = true;
        deletingId = id;
        error = null;
        ok = null;
        try
        {
            using var resp = await Http.DeleteAsync($"api/admin/teachers/{id}?confirm=true");
            await resp.EnsureSuccessWithDetailsAsync();
            list.RemoveAll(teacher => teacher.Id == id);
            if (await RefreshAfterCompletedMutationAsync(
                    DeleteRefreshErrorPrefix,
                    "Список викладачів оновлено; видалення вже було виконано.",
                    closeEditorAfterRetry: false))
            {
                ok = "Видалено.";
            }
        }
        catch (Exception ex)
        {
            error = ErrorMessage(ex, "Не вдалося видалити викладача.");
        }
        finally
        {
            deletingId = null;
            operationInProgress = false;
        }
    }
    // Окремо обробляє помилку читання після вже завершеної мутації.
    private async Task<bool> RefreshAfterCompletedMutationAsync(
        string errorPrefix,
        string retrySuccessMessage,
        bool closeEditorAfterRetry)
    {
        try
        {
            await LoadList();
            completedMutationRefreshErrorPrefix = null;
            completedMutationRetrySuccessMessage = null;
            closeEditorAfterListRetry = false;
            return true;
        }
        catch (Exception ex)
        {
            completedMutationRefreshErrorPrefix = errorPrefix;
            completedMutationRetrySuccessMessage = retrySuccessMessage;
            closeEditorAfterListRetry = closeEditorAfterRetry;
            ok = null;
            error = BuildListRefreshError(ex);
            return false;
        }
    }
    // Формує повідомлення, яке прямо забороняє повторювати вже виконану мутацію.
    private string BuildListRefreshError(Exception exception)
    {
        var reason = ErrorMessage(exception, "Не вдалося оновити список викладачів.");
        return completedMutationRefreshErrorPrefix is null
            ? $"Не вдалося оновити список викладачів. Причина: {reason}"
            : $"{completedMutationRefreshErrorPrefix} Натисніть «Повторити завантаження списку». Причина: {reason}";
    }
    // Пояснює, який саме набір даних лишився недоступним, і зберігає попередження про виконану мутацію.
    private string BuildFailedLoadError(Exception exception)
    {
        var reason = ErrorMessage(exception, "Не вдалося завантажити дані викладачів.");
        if (metaLoadFailed && listLoadFailed)
        {
            return $"Не вдалося завантажити довідники та список викладачів. Причина: {reason}";
        }
        if (metaLoadFailed)
        {
            return $"Не вдалося завантажити довідники викладачів. Редагування заблоковано до успішного повторного завантаження. Причина: {reason}";
        }
        return BuildListRefreshError(exception);
    }
    // Повертає найкорисніше повідомлення про помилку API.
    private static string ErrorMessage(Exception exception, string fallback)
        => exception is ApiErrorException apiError
            ? apiError.Errors.FirstOrDefault() ?? apiError.Message
            : string.IsNullOrWhiteSpace(exception.Message) ? fallback : exception.Message;
    // Закриває форму редагування.
    private void Cancel()
    {
        if (operationInProgress) return;
        edit = null;
        if (!listLoadFailed)
        {
            error = null;
        }
        closeEditorAfterListRetry = false;
    }
    // Нормалізує значення прапорця.
    private static bool AsBool(object? v) => v is bool b ? b : bool.TryParse(v?.ToString(), out var bb) && bb;
    // Формує підпис модуля для відображення.
    private string ModuleCaption(int id)
    {
        var module = meta.Modules.FirstOrDefault(m => m.Id == id);
        if (module is null) return id.ToString();
        var course = string.IsNullOrWhiteSpace(module.CourseName) ? null : module.CourseName;
        return course is null ? module.Name : $"{module.Name} ({course})";
    }
    // Формує підпис кафедри для відображення.
    private string DepartmentCaption(int? departmentId)
        => departmentId is int id && id > 0
            ? (meta.Departments.FirstOrDefault(x => x.Id == id)?.Name ?? $"#{id}")
            : "—";
    // Формує перелік модулів викладача.
    private string ModulesCaption(TeacherViewDto t) => string.Join(", ", t.ModuleIds.Select(ModuleCaption));
    // Формує підпис курсу.
    private string CourseCaption(int courseId)
        => meta.Courses.FirstOrDefault(c => c.Id == courseId)?.Name ?? $"#{courseId}";
    // Повертає активні курси викладача.
    private List<int> ActiveCourseIds(TeacherViewDto t) =>
        (t.Loads ?? new())
            .Where(x => x.IsActive)
            .Select(x => x.CourseId)
            .Distinct()
            .OrderBy(x => CourseCaption(x), StringComparer.OrdinalIgnoreCase)
            .ToList();
    // Будує HTML-мітки активних курсів.
    private MarkupString ActiveCoursesMarkup(TeacherViewDto t)
    {
        var ids = ActiveCourseIds(t);
        if (ids.Count == 0) return new MarkupString("<span class=\"text-muted\">—</span>");
        var html = string.Join("", ids.Select(cid => $"<span class=\"badge bg-success me-1\">{WebUtility.HtmlEncode(CourseCaption(cid))}</span>"));
        return new MarkupString(html);
    }
    // Перемикає прив'язку модуля до викладача.
    private void ToggleModule(int moduleId, bool isChecked)
    {
        if (edit is null) return;
        if (isChecked)
        {
            if (!edit.ModuleIds.Contains(moduleId))
                edit.ModuleIds.Add(moduleId);
        }
        else
        {
            edit.ModuleIds.RemoveAll(x => x == moduleId);
        }
    }
    // Перемикає модулі для самостійних робіт.
    private void ToggleSupervisorModule(int moduleId, bool isChecked)
    {
        if (edit is null) return;
        if (isChecked)
        {
            if (!edit.SupervisorModuleIds.Contains(moduleId))
                edit.SupervisorModuleIds.Add(moduleId);
        }
        else
        {
            edit.SupervisorModuleIds.RemoveAll(x => x == moduleId);
        }
    }
    // Виділяє всі модулі для викладача.
    private void SelectAllModules()
    {
        if (edit is null) return;
        edit.ModuleIds.Clear();
        edit.ModuleIds.AddRange(meta.Modules.Select(m => m.Id));
    }
    // Виділяє всі модулі керівництва.
    private void SelectAllSupervisorModules()
    {
        if (edit is null) return;
        edit.SupervisorModuleIds.Clear();
        edit.SupervisorModuleIds.AddRange(meta.Modules.Select(m => m.Id));
    }
    // Повертає або створює рядок навантаження для курсу.
    private TeacherLoadDto GetLoad(int courseId)
    {
        if (edit is null) return new TeacherLoadDto(courseId, false, 0);
        var row = edit.Loads.FirstOrDefault(l => l.CourseId == courseId);
        if (row is null)
        {
            row = new TeacherLoadDto(courseId, false, 0);
            edit.Loads.Add(row);
        }
        return row;
    }
    // Оновлює активність навантаження для курсу.
    private void UpdateLoadActive(int courseId, bool active)
    {
        if (edit is null) return;
        var row = GetLoad(courseId);
        row.IsActive = active;
    }
    // Перемикає робочий день у графіку викладача.
    private void ToggleDay(int serverDay, bool enable)
    {
        if (edit is null) return;
        if (enable)
        {
            if (!edit.WorkingHours.Any(x => x.DayOfWeek == serverDay))
                edit.WorkingHours.Add(new TeacherWorkingHourDto(serverDay, DefaultWhStart, DefaultWhEnd));
        }
        else
        {
            edit.WorkingHours.RemoveAll(x => x.DayOfWeek == serverDay);
        }
    }
    // Встановлює початок робочого вікна.
    private void SetWhStart(int serverDay, string? val)
    {
        if (edit is null) return;
        var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
        if (row is null)
        {
            row = new TeacherWorkingHourDto(serverDay, val ?? DefaultWhStart, DefaultWhEnd);
            edit.WorkingHours.Add(row);
        }
        else row.Start = val ?? row.Start;
    }
    // Встановлює завершення робочого вікна.
    private void SetWhEnd(int serverDay, string? val)
    {
        if (edit is null) return;
        var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
        if (row is null)
        {
            row = new TeacherWorkingHourDto(serverDay, DefaultWhStart, val ?? DefaultWhEnd);
            edit.WorkingHours.Add(row);
        }
        else row.End = val ?? row.End;
    }
    // Повертає назву дня українською.
    private static string DayName(int uiDay) => System.Globalization.CultureInfo
        .GetCultureInfo("uk-UA")
        .DateTimeFormat.DayNames[(uiDay + 1) % 7];
    // Фільтрує список викладачів за пошуковим рядком.
    private IEnumerable<TeacherViewDto> ApplyFilter(IEnumerable<TeacherViewDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(t =>
            t.Id.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (t.FullName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            DepartmentCaption(t.DepartmentId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            string.Join(", ", ActiveCourseIds(t).Select(CourseCaption)).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (t.ScientificDegree?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.AcademicTitle?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            ModulesCaption(t).Contains(f, StringComparison.OrdinalIgnoreCase)
        );
    }
    // Сортує список викладачів згідно з вибраним полем.
    private IEnumerable<TeacherViewDto> ApplySort(IEnumerable<TeacherViewDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(TeacherViewDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(TeacherViewDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(TeacherViewDto.FullName), true) => seq.OrderBy(x => x.FullName),
            (nameof(TeacherViewDto.FullName), false) => seq.OrderByDescending(x => x.FullName),
            (nameof(TeacherViewDto.ScientificDegree), true) => seq.OrderBy(x => x.ScientificDegree),
            (nameof(TeacherViewDto.ScientificDegree), false) => seq.OrderByDescending(x => x.ScientificDegree),
            (nameof(TeacherViewDto.AcademicTitle), true) => seq.OrderBy(x => x.AcademicTitle),
            (nameof(TeacherViewDto.AcademicTitle), false) => seq.OrderByDescending(x => x.AcademicTitle),
            (DepartmentField, true) => seq.OrderBy(x => DepartmentCaption(x.DepartmentId)).ThenBy(x => x.FullName),
            (DepartmentField, false) => seq.OrderByDescending(x => DepartmentCaption(x.DepartmentId)).ThenByDescending(x => x.FullName),
            (ModulesField, true) => seq.OrderBy(x => x.ModuleIds?.Count ?? 0).ThenBy(x => ModulesCaption(x)),
            (ModulesField, false) => seq.OrderByDescending(x => x.ModuleIds?.Count ?? 0).ThenByDescending(x => ModulesCaption(x)),
            (ActiveCoursesField, true) => seq.OrderBy(x => string.Join(", ", ActiveCourseIds(x).Select(CourseCaption))).ThenBy(x => x.FullName),
            (ActiveCoursesField, false) => seq.OrderByDescending(x => string.Join(", ", ActiveCourseIds(x).Select(CourseCaption))).ThenByDescending(x => x.FullName),
            _ => seq
        };
    }
    private IEnumerable<TeacherViewDto> SortedAndFiltered => ApplySort(ApplyFilter(list));
    // Перемикає режим сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
}
