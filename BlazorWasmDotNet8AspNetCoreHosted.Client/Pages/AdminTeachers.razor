@* Сторінка адміністрування викладачів *@
@page "/admin/teachers"
@using System.Net
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<h3>Викладачі</h3>

@if (loading)
{
    <p>Завантаження…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
        <button class="btn btn-primary" @onclick="CreateNew">Додати викладача</button>
        <div class="input-group" style="max-width:360px;">
            <span class="input-group-text">Пошук</span>
            <input class="form-control" @bind="filter" @bind:event="oninput" placeholder="Id / ПІБ / кафедра / курс / ступінь / звання / модуль" />
        </div>
    </div>
    <div class="small text-muted mb-2">Показано: @SortedAndFiltered.Count() з @list.Count</div>
    <table class="table table-sm">
        <thead>
            <tr>
                <th class="sortable-th" style="width:80px;" role="button"
                    @onclick="() => ToggleSort(nameof(TeacherViewDto.Id))">
                    # @HeaderIcon(nameof(TeacherViewDto.Id))
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(nameof(TeacherViewDto.FullName))">
                    ПІБ @HeaderIcon(nameof(TeacherViewDto.FullName))
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(DepartmentField)">
                    Кафедра @HeaderIcon(DepartmentField)
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(nameof(TeacherViewDto.ScientificDegree))">
                    Науковий ступінь @HeaderIcon(nameof(TeacherViewDto.ScientificDegree))
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(nameof(TeacherViewDto.AcademicTitle))">
                    Наукове звання @HeaderIcon(nameof(TeacherViewDto.AcademicTitle))
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(ModulesField)">
                    Модулі @HeaderIcon(ModulesField)
                </th>
                <th class="sortable-th" role="button"
                    @onclick="() => ToggleSort(ActiveCoursesField)">
                    Активні @HeaderIcon(ActiveCoursesField)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in SortedAndFiltered)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.FullName</td>
                    <td>@DepartmentCaption(t.DepartmentId)</td>
                    <td>@t.ScientificDegree</td>
                    <td>@t.AcademicTitle</td>
                    <td>@ModulesCaption(t)</td>
                    <td>@ActiveCoursesMarkup(t)</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(t.Id)">Редагувати</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(t.Id)">Видалити</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (edit != null)
{
    <div class="editor-overlay" @onclick="Cancel">
        <div class="editor editor-modal teacher-editor" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div class="editor-title">@(edit.Id is null ? "Створення викладача" : $"Редагування #{edit.Id}")</div>
                    <div class="editor-subtitle">Заповніть дані викладача, дозвольте потрібні модулі та робочі вікна.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary editor-close" title="Закрити" @onclick="Cancel">×</button>
            </div>
            <div class="teacher-editor-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">ПІБ</label>
                        <input class="form-control" @bind="edit.FullName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Кафедра</label>
                        <select class="form-select"
                                value="@edit.DepartmentId"
                                @onchange="e => edit.DepartmentId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : (int?)null">
                            <option value="">— Не вказано —</option>
                            @foreach (var d in meta.Departments.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@d.Id" selected="@(d.Id == edit.DepartmentId)">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Науковий ступінь</label>
                        <input class="form-control" @bind="edit.ScientificDegree" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Наукове звання</label>
                        <input class="form-control" @bind="edit.AcademicTitle" />
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="fw-semibold">Допустимі модулі</div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                @onclick="SelectAllModules">
                            Вибрати всі
                        </button>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                        @foreach (var m in meta.Modules)
                        {
                            var checkedFlag = edit.ModuleIds.Contains(m.Id);
                            var checkboxId = $"teacher_module_{m.Id}";
                            <div class="col">
                                <div class="form-check align-items-start">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@checkboxId"
                                           checked="@checkedFlag"
                                           @onchange="e => ToggleModule(m.Id, AsBool(e.Value))" />
                                    <label class="form-check-label ms-2" for="@checkboxId">
                                        <span class="d-block fw-semibold">@m.Name</span>
                                        <span class="d-block text-muted small">@m.CourseName</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="fw-semibold">Керівництво самостійними роботами</div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                @onclick="SelectAllSupervisorModules">
                            Вибрати всі
                        </button>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                        @foreach (var m in meta.Modules)
                        {
                            var checkedFlag = edit.SupervisorModuleIds.Contains(m.Id);
                            var checkboxId = $"teacher_sup_module_{m.Id}";
                            <div class="col">
                                <div class="form-check align-items-start">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@checkboxId"
                                           checked="@checkedFlag"
                                           @onchange="e => ToggleSupervisorModule(m.Id, AsBool(e.Value))" />
                                    <label class="form-check-label ms-2" for="@checkboxId">
                                        <span class="d-block fw-semibold">@m.Name</span>
                                        <span class="d-block text-muted small">@m.CourseName</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="editor-card">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <h5 class="mb-0">Навантаження по курсам</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Курс</th>
                                    <th style="width:200px">Заплановано годин</th>
                                    <th style="width:120px">Активне</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in meta.Courses)
                                {
                                    var row = GetLoad(c.Id);
                                    <tr>
                                        <td>@c.Name</td>
                                        <td>
                                            <span class="badge bg-secondary">@row.ScheduledHours</span>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@row.IsActive"
                                                   @onchange="e => UpdateLoadActive(c.Id, AsBool(e.Value))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="editor-card">
                    <h5 class="mb-2">Робочі вікна</h5>
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @for (int uiDay = 0; uiDay < 7; uiDay++)
                        {
                            var serverDay = (uiDay + 1) % 7; 
                            var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
                            bool enabled = row is not null;
                            string start = row?.Start ?? "09:00";
                            string end = row?.End ?? "17:00";
                            <div class="col">
                                <div class="card p-2 h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="fw-semibold">@DayName(uiDay)</div>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@enabled"
                                                   @onchange="e => ToggleDay(serverDay, AsBool(e.Value))" />
                                            <label class="form-check-label">Працює</label>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <input class="form-control form-control-sm" type="time" value="@start"
                                               disabled="@(!enabled)"
                                               @onchange="e => SetWhStart(serverDay, e.Value?.ToString())" />
                                        <span>—</span>
                                        <input class="form-control form-control-sm" type="time" value="@end"
                                               disabled="@(!enabled)"
                                               @onchange="e => SetWhEnd(serverDay, e.Value?.ToString())" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-success" @onclick="Save">Зберегти</button>
                <button class="btn btn-outline-secondary" @onclick="Cancel">Скасувати</button>
            </div>
        </div>
    </div>
}

<style>
    .editor-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(2px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 72px 18px 24px;
        overflow-y: auto;
        z-index: 2500;
    }
    .editor {
        margin-top: 14px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px;
        width: min(1200px, 100%);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }
    .editor-modal-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .editor-title { font-weight: 800; font-size: 1.1rem; }
    .editor-subtitle { color: #475569; font-size: .92rem; margin-top: 4px; }
    .editor-close { min-width: 44px; height: 44px; font-size: 1.3rem; padding: 0 .6rem; }
    .teacher-editor-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .editor-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px;
        background: #f8fafc;
    }
    .editor-actions {
        margin-top: 14px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }
</style>

@code {

    private MetaResponseDto meta = new(new(), new(), new(), new(), new(), new(), new());
    private List<TeacherViewDto> list = new();
    private TeacherEditDto? edit;
    private bool loading = true;
    private const string DepartmentField = "Department";
    private const string ModulesField = "ModulesCount";
    private const string ActiveCoursesField = "ActiveCourses";
    private string sortField = nameof(TeacherViewDto.FullName);
    private bool sortAsc = true;
    private string? filter;
    // Завантажує метадані та список викладачів.
    protected override async Task OnInitializedAsync()
    {
        await LoadMeta();
        await LoadList();
        loading = false;
    }
    // Завантажує довідники для форми викладача.
    private async Task LoadMeta()
    {
        meta = await Http.GetFromJsonAsync<MetaResponseDto>("api/meta") ?? meta;
    }
    // Завантажує список викладачів.
    private async Task LoadList()
    {
        list = await Http.GetFromJsonAsync<List<TeacherViewDto>>("api/admin/teachers") ?? new();
    }
    // Відкриває форму редагування викладача.
    private async Task Edit(int id)
    {
        edit = await Http.GetFromJsonAsync<TeacherEditDto>($"api/admin/teachers/{id}");
    }
    private const string DefaultWhStart = "08:30";
    private const string DefaultWhEnd = "19:00";
    // Ініціалізує форму створення викладача.
    private void CreateNew()
    {
        var defaultWorkingHours = Enumerable.Range(0, 7)
            .Select(ui => new TeacherWorkingHourDto((ui + 1) % 7, DefaultWhStart, DefaultWhEnd))
            .ToList();
        edit = new TeacherEditDto(
            id: null,
            fullName: "",
            scientificDegree: null,
            academicTitle: null,
            departmentId: null,
            moduleIds: new List<int>(),
            supervisorModuleIds: new List<int>(),
            loads: new List<TeacherLoadDto>(),
            workingHours: defaultWorkingHours
        );
    }
    // Зберігає дані викладача через API.
    private async Task Save()
    {
        if (edit is null) return;
        var resp = await Http.PostAsJsonAsync("api/admin/teachers/upsert", edit);
        if (resp.IsSuccessStatusCode)
        {
            edit = null;
            await LoadList();
            StateHasChanged();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            Console.Error.WriteLine(msg);
        }
    }
    // Видаляє викладача після підтвердження.
    private async Task Delete(int id)
    {
        var teacher = list.FirstOrDefault(t => t.Id == id);
        var caption = teacher?.FullName ?? $"#{id}";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити викладача {caption}? Дію не можна скасувати.");
        if (!confirmed) return;
        var resp = await Http.DeleteAsync($"api/admin/teachers/{id}?confirm=true");
        if (resp.IsSuccessStatusCode)
            await LoadList();
    }
    // Закриває форму редагування.
    private void Cancel() => edit = null;
    // Нормалізує значення прапорця.
    private static bool AsBool(object? v) => v is bool b ? b : bool.TryParse(v?.ToString(), out var bb) && bb;
    // Формує підпис модуля для відображення.
    private string ModuleCaption(int id)
    {
        var module = meta.Modules.FirstOrDefault(m => m.Id == id);
        if (module is null) return id.ToString();
        var course = string.IsNullOrWhiteSpace(module.CourseName) ? null : module.CourseName;
        return course is null ? module.Name : $"{module.Name} ({course})";
    }
    // Формує підпис кафедри для відображення.
    private string DepartmentCaption(int? departmentId)
        => departmentId is int id && id > 0
            ? (meta.Departments.FirstOrDefault(x => x.Id == id)?.Name ?? $"#{id}")
            : "—";
    // Формує перелік модулів викладача.
    private string ModulesCaption(TeacherViewDto t) => string.Join(", ", t.ModuleIds.Select(ModuleCaption));
    // Формує підпис курсу.
    private string CourseCaption(int courseId)
        => meta.Courses.FirstOrDefault(c => c.Id == courseId)?.Name ?? $"#{courseId}";
    // Повертає активні курси викладача.
    private List<int> ActiveCourseIds(TeacherViewDto t) =>
        (t.Loads ?? new())
            .Where(x => x.IsActive)
            .Select(x => x.CourseId)
            .Distinct()
            .OrderBy(x => CourseCaption(x), StringComparer.OrdinalIgnoreCase)
            .ToList();
    // Будує HTML-мітки активних курсів.
    private MarkupString ActiveCoursesMarkup(TeacherViewDto t)
    {
        var ids = ActiveCourseIds(t);
        if (ids.Count == 0) return new MarkupString("<span class=\"text-muted\">—</span>");
        var html = string.Join("", ids.Select(cid => $"<span class=\"badge bg-success me-1\">{WebUtility.HtmlEncode(CourseCaption(cid))}</span>"));
        return new MarkupString(html);
    }
    // Перемикає прив'язку модуля до викладача.
    private void ToggleModule(int moduleId, bool isChecked)
    {
        if (edit is null) return;
        if (isChecked)
        {
            if (!edit.ModuleIds.Contains(moduleId))
                edit.ModuleIds.Add(moduleId);
        }
        else
        {
            edit.ModuleIds.RemoveAll(x => x == moduleId);
        }
    }
    // Перемикає модулі для самостійних робіт.
    private void ToggleSupervisorModule(int moduleId, bool isChecked)
    {
        if (edit is null) return;
        if (isChecked)
        {
            if (!edit.SupervisorModuleIds.Contains(moduleId))
                edit.SupervisorModuleIds.Add(moduleId);
        }
        else
        {
            edit.SupervisorModuleIds.RemoveAll(x => x == moduleId);
        }
    }
    // Виділяє всі модулі для викладача.
    private void SelectAllModules()
    {
        if (edit is null) return;
        edit.ModuleIds.Clear();
        edit.ModuleIds.AddRange(meta.Modules.Select(m => m.Id));
    }
    // Виділяє всі модулі керівництва.
    private void SelectAllSupervisorModules()
    {
        if (edit is null) return;
        edit.SupervisorModuleIds.Clear();
        edit.SupervisorModuleIds.AddRange(meta.Modules.Select(m => m.Id));
    }
    // Повертає або створює рядок навантаження для курсу.
    private TeacherLoadDto GetLoad(int courseId)
    {
        if (edit is null) return new TeacherLoadDto(courseId, false, 0);
        var row = edit.Loads.FirstOrDefault(l => l.CourseId == courseId);
        if (row is null)
        {
            row = new TeacherLoadDto(courseId, false, 0);
            edit.Loads.Add(row);
        }
        return row;
    }
    // Оновлює активність навантаження для курсу.
    private void UpdateLoadActive(int courseId, bool active)
    {
        if (edit is null) return;
        var row = GetLoad(courseId);
        row.IsActive = active;
    }
    // Перемикає робочий день у графіку викладача.
    private void ToggleDay(int serverDay, bool enable)
    {
        if (edit is null) return;
        if (enable)
        {
            if (!edit.WorkingHours.Any(x => x.DayOfWeek == serverDay))
                edit.WorkingHours.Add(new TeacherWorkingHourDto(serverDay, DefaultWhStart, DefaultWhEnd));
        }
        else
        {
            edit.WorkingHours.RemoveAll(x => x.DayOfWeek == serverDay);
        }
    }
    // Встановлює початок робочого вікна.
    private void SetWhStart(int serverDay, string? val)
    {
        if (edit is null) return;
        var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
        if (row is null)
        {
            row = new TeacherWorkingHourDto(serverDay, val ?? DefaultWhStart, DefaultWhEnd);
            edit.WorkingHours.Add(row);
        }
        else row.Start = val ?? row.Start;
    }
    // Встановлює завершення робочого вікна.
    private void SetWhEnd(int serverDay, string? val)
    {
        if (edit is null) return;
        var row = edit.WorkingHours.FirstOrDefault(x => x.DayOfWeek == serverDay);
        if (row is null)
        {
            row = new TeacherWorkingHourDto(serverDay, DefaultWhStart, val ?? DefaultWhEnd);
            edit.WorkingHours.Add(row);
        }
        else row.End = val ?? row.End;
    }
    // Повертає назву дня українською.
    private static string DayName(int uiDay) => System.Globalization.CultureInfo
        .GetCultureInfo("uk-UA")
        .DateTimeFormat.DayNames[(uiDay + 1) % 7];
    // Фільтрує список викладачів за пошуковим рядком.
    private IEnumerable<TeacherViewDto> ApplyFilter(IEnumerable<TeacherViewDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(t =>
            t.Id.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (t.FullName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            DepartmentCaption(t.DepartmentId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            string.Join(", ", ActiveCourseIds(t).Select(CourseCaption)).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (t.ScientificDegree?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.AcademicTitle?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            ModulesCaption(t).Contains(f, StringComparison.OrdinalIgnoreCase)
        );
    }
    // Сортує список викладачів згідно з вибраним полем.
    private IEnumerable<TeacherViewDto> ApplySort(IEnumerable<TeacherViewDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(TeacherViewDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(TeacherViewDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(TeacherViewDto.FullName), true) => seq.OrderBy(x => x.FullName),
            (nameof(TeacherViewDto.FullName), false) => seq.OrderByDescending(x => x.FullName),
            (nameof(TeacherViewDto.ScientificDegree), true) => seq.OrderBy(x => x.ScientificDegree),
            (nameof(TeacherViewDto.ScientificDegree), false) => seq.OrderByDescending(x => x.ScientificDegree),
            (nameof(TeacherViewDto.AcademicTitle), true) => seq.OrderBy(x => x.AcademicTitle),
            (nameof(TeacherViewDto.AcademicTitle), false) => seq.OrderByDescending(x => x.AcademicTitle),
            (DepartmentField, true) => seq.OrderBy(x => DepartmentCaption(x.DepartmentId)).ThenBy(x => x.FullName),
            (DepartmentField, false) => seq.OrderByDescending(x => DepartmentCaption(x.DepartmentId)).ThenByDescending(x => x.FullName),
            (ModulesField, true) => seq.OrderBy(x => x.ModuleIds?.Count ?? 0).ThenBy(x => ModulesCaption(x)),
            (ModulesField, false) => seq.OrderByDescending(x => x.ModuleIds?.Count ?? 0).ThenByDescending(x => ModulesCaption(x)),
            (ActiveCoursesField, true) => seq.OrderBy(x => string.Join(", ", ActiveCourseIds(x).Select(CourseCaption))).ThenBy(x => x.FullName),
            (ActiveCoursesField, false) => seq.OrderByDescending(x => string.Join(", ", ActiveCourseIds(x).Select(CourseCaption))).ThenByDescending(x => x.FullName),
            _ => seq
        };
    }
    private IEnumerable<TeacherViewDto> SortedAndFiltered => ApplySort(ApplyFilter(list));
    // Перемикає режим сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
    // Повертає піктограму для заголовка сортування.
    private MarkupString HeaderIcon(string field)
        => new(sortField == field ? $"<span class=\"ms-1\">{(sortAsc ? "▲" : "▼")}</span>" : "");
}
