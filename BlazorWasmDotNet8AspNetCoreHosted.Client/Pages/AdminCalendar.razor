@* Сторінка керування календарними винятками *@
@page "/admin/calendar"
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Admin
@inject IJSRuntime JS

<PageTitle>Адмін • Календар</PageTitle>

<h3 class="mb-3">Винятки календаря</h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}

<div class="d-flex justify-content-between align-items-start align-items-md-center flex-column flex-md-row gap-2 mb-3">
    <div>
        <h5 class="mb-1">Керування винятками</h5>
        <div class="text-muted small">Редагування та створення відкриваються у вікні поверх таблиці.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-primary" @onclick="OpenCreate">Додати виняток</button>
    </div>
</div>

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
        <div class="text-muted small">Показано: @SortedAndFiltered.Count() з @items.Count</div>
        <div class="input-group" style="max-width:320px;">
            <span class="input-group-text">Пошук</span>
            <input class="form-control" @bind="filter" @bind:event="oninput" placeholder="Id / дата / назва / курс / група / так/ні" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:80px;" role="button" class="sortable-th"
                        @onclick="() => ToggleSort(nameof(CalendarExceptionEditDto.Id))">
                        Id @HeaderIcon(nameof(CalendarExceptionEditDto.Id))
                    </th>
                    <th role="button" class="sortable-th"
                        @onclick="() => ToggleSort(nameof(CalendarExceptionEditDto.Date))">
                        Дата @HeaderIcon(nameof(CalendarExceptionEditDto.Date))
                    </th>
                    <th role="button" class="sortable-th"
                        @onclick="() => ToggleSort(CourseNameField)">
                        Курс @HeaderIcon(CourseNameField)
                    </th>
                    <th role="button" class="sortable-th"
                        @onclick="() => ToggleSort(GroupNameField)">
                        Група @HeaderIcon(GroupNameField)
                    </th>
                    <th role="button" class="sortable-th"
                        @onclick="() => ToggleSort(nameof(CalendarExceptionEditDto.Name))">
                        Назва @HeaderIcon(nameof(CalendarExceptionEditDto.Name))
                    </th>
                    <th role="button" class="sortable-th"
                        @onclick="() => ToggleSort(nameof(CalendarExceptionEditDto.IsWorkingDay))">
                        Робочий @HeaderIcon(nameof(CalendarExceptionEditDto.IsWorkingDay))
                    </th>
                    <th style="width:140px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in SortedAndFiltered)
                {
                    <tr>
                        <td>@x.Id</td>
                        <td>@x.Date</td>
                        <td>@CourseLabel(x)</td>
                        <td>@GroupLabel(x)</td>
                        <td>@x.Name</td>
                        <td>@(x.IsWorkingDay ? "Так" : "Ні")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditRow(x)">Редагувати</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(x.Id!.Value)">Видалити</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (editorOpen)
{
    <div class="editor-overlay" @onclick="CloseEditor">
        <div class="editor editor-modal calendar-editor" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div class="editor-title">@EditorTitle</div>
                    <div class="editor-subtitle">Укажіть дату, курс, за потреби групу та статус робочого дня.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary editor-close" title="Закрити" @onclick="CloseEditor">×</button>
            </div>
            <div class="calendar-editor-grid">
                <div class="calendar-editor-field">
                    <label class="form-label">Дата</label>
                    <InputText class="form-control" type="date" @bind-Value="form.Date" />
                </div>
                <div class="calendar-editor-field">
                    <label class="form-label">Назва</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </div>
                <div class="calendar-editor-field">
                    <label class="form-label">Курс</label>
                    <select class="form-select" value="@form.CourseId" @onchange="OnCourseChanged">
                        <option value="">Оберіть курс</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <div class="form-text">Виняток діє в межах вибраного курсу.</div>
                </div>
                <div class="calendar-editor-field">
                    <label class="form-label">Група (необов'язково)</label>
                    <select class="form-select"
                            value="@form.GroupId"
                            @onchange="OnGroupChanged"
                            disabled="@(form.CourseId is null)">
                        <option value="">Усі групи курсу</option>
                        @foreach (var g in GroupsForCourse(form.CourseId))
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                    <div class="form-text">Оберіть групу, якщо виняток стосується лише її.</div>
                </div>
                <div class="calendar-editor-field calendar-editor-switch">
                    <div class="switch-caption">
                        <div class="switch-title">Статус дня</div>
                        <div class="switch-hint">Перемикач робочого/вихідного дня.</div>
                    </div>
                    <label class="toggle" for="isWorkingSwitch">
                        <input type="checkbox"
                               class="toggle-input"
                               id="isWorkingSwitch"
                               @bind="form.IsWorkingDay" />
                        <span class="toggle-track">
                            <span class="toggle-thumb"></span>
                            <span class="toggle-text toggle-text--on">Робочий</span>
                            <span class="toggle-text toggle-text--off">Вихідний</span>
                        </span>
                    </label>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="Save">Зберегти</button>
                <button class="btn btn-outline-secondary" @onclick="CloseEditor">Скасувати</button>
            </div>
        </div>
    </div>
}

<style>
    .editor-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(2px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 72px 18px 24px;
        overflow-y: auto;
        z-index: 2500;
    }
    .editor {
        margin-top: 14px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px;
        width: min(900px, 100%);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }
    .editor-modal-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .editor-title { font-weight: 800; font-size: 1.1rem; }
    .editor-subtitle { color: #475569; font-size: .92rem; margin-top: 4px; }
    .editor-close { min-width: 44px; height: 44px; font-size: 1.3rem; padding: 0 .6rem; }
    .calendar-editor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
    }
    .calendar-editor-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }
    .calendar-editor-switch {
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 14px;
        padding: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        flex-wrap: wrap;
        width: 100%;
        box-sizing: border-box;
        grid-column: auto;
        align-self: end;
        min-width: 260px;
    }
    .switch-caption { display: flex; flex-direction: column; gap: 4px; }
    .switch-title { font-weight: 700; }
    .switch-hint { color: #64748b; font-size: .88rem; }
    .toggle {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        position: relative;
        width: 100%;
        max-width: 340px;
        justify-content: flex-start;
        gap: 10px;
    }
    .toggle-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 1px;
        height: 1px;
    }
    .toggle-track {
        --switch-width: 220px;
        --switch-padding: 6px;
        --thumb-gap: 8px;
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        align-items: center;
        width: var(--switch-width);
        max-width: 100%;
        padding: var(--switch-padding);
        min-height: 54px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 14px 30px rgba(15, 23, 42, .08);
        box-sizing: border-box;
        transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
    }
    .toggle-thumb {
        position: absolute;
        inset: var(--switch-padding) auto var(--switch-padding) var(--switch-padding);
        width: calc(50% - var(--thumb-gap));
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: linear-gradient(135deg, #fb7185, #ef4444);
        color: #fff;
        font-weight: 800;
        letter-spacing: .01em;
        box-shadow: 0 8px 24px rgba(239, 68, 68, .25);
        transform: translateX(0);
        transition: transform .22s ease, background .22s ease, box-shadow .22s ease;
        z-index: 2;
    }
    .toggle-thumb::after {
        content: "Вихідний";
        font-size: .95rem;
    }
    .toggle-text {
        font-size: .95rem;
        font-weight: 700;
        text-align: center;
        user-select: none;
        position: relative;
        z-index: 1;
        color: #94a3b8;
        padding: 0 6px;
    }
    .toggle-text--on { text-align: left; }
    .toggle-text--off { text-align: right; }
    .toggle:focus-within .toggle-track {
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .22), inset 0 1px 0 rgba(255, 255, 255, .7), 0 14px 30px rgba(15, 23, 42, .08);
        border-color: #bfdbfe;
    }
    .toggle-input:checked + .toggle-track {
        border-color: #bbf7d0;
        background: #ecfdf3;
    }
    .toggle-input:checked + .toggle-track .toggle-thumb {
        transform: translateX(calc(100% + var(--thumb-gap)));
        background: linear-gradient(135deg, #22c55e, #16a34a);
        box-shadow: 0 8px 24px rgba(22, 163, 74, .25);
    }
    .toggle-input:checked + .toggle-track .toggle-thumb::after { content: "Робочий"; }
    .toggle-input:not(:checked) + .toggle-track .toggle-text--off { color: #dc2626; }
    .toggle-input:checked + .toggle-track .toggle-text--on { color: #15803d; }
    .toggle-input:checked + .toggle-track .toggle-text--off { color: #cbd5e1; }
    .editor-actions {
        margin-top: 14px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }
</style>

@code {

    // Зберігаємо повідомлення про помилки та успішні дії.
    private string? error, ok;
    // Кешовані винятки календаря, завантажені з API.
    private List<CalendarExceptionEditDto> items = new();
    private List<LookupDto> courses = new();
    private List<GroupEditDto> groups = new();
    // Модель форми для створення або редагування запису.
    private CalendarExceptionEditDto form = new()
    {
        Id = null,
        Date = DateTime.Today.ToString("yyyy-MM-dd"),
        Name = "",
        IsWorkingDay = false,
        CourseId = null,
        GroupId = null
    };
    private bool editorOpen;
    // Поточні параметри сортування та фільтрування.
    private const string CourseNameField = "CourseName";
    private const string GroupNameField = "GroupName";
    private string sortField = nameof(CalendarExceptionEditDto.Date);
    private bool sortAsc = true;
    private string? filter;
    // Викликається під час ініціалізації сторінки та завантажує дані.
    protected override async Task OnInitializedAsync() => await Load();
    // Оновлює список винятків, очищаючи попередні повідомлення.
    private async Task Load()
    {
        try
        {
            error = ok = null;
            items = await Admin.GetCalendar();
            var meta = await Admin.GetMeta();
            courses = meta.Courses ?? new();
            groups = await Admin.GetGroups();
            NormalizeFormWithMeta();
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Повертає назву курсу для відображення.
    private string NameOfCourse(int? id)
    {
        if (id is int cid && cid > 0)
            return courses.FirstOrDefault(c => c.Id == cid)?.Name ?? $"Курс #{cid}";
        return "Усі курси";
    }
    // Повертає назву групи для відображення.
    private string NameOfGroup(int? id)
    {
        if (id is int gid && gid > 0)
            return groups.FirstOrDefault(g => g.Id == gid)?.Name ?? $"Група #{gid}";
        return "Усі групи курсу";
    }
    // Повертає групи, що належать курсу.
    private IEnumerable<GroupEditDto> GroupsForCourse(int? courseId)
    {
        if (courseId is int cid && cid > 0)
            return groups.Where(g => g.CourseId == cid).OrderBy(g => g.Name);
        return Enumerable.Empty<GroupEditDto>();
    }
    // Повертає підпис курсу для рядка.
    private string CourseLabel(CalendarExceptionEditDto x) => NameOfCourse(x.CourseId);
    // Повертає підпис групи для рядка.
    private string GroupLabel(CalendarExceptionEditDto x)
    {
        if (x.GroupId is int gid && gid > 0)
            return NameOfGroup(gid);
        return "Усі групи курсу";
    }
    // Узгоджує форму з довідниками курсів і груп.
    private void NormalizeFormWithMeta()
    {
        var hasCourse = form.CourseId is int cid && courses.Any(c => c.Id == cid);
        if (!hasCourse) form.CourseId = null;
        if (form.GroupId is int gid)
        {
            var grp = groups.FirstOrDefault(g => g.Id == gid);
            if (grp is null || (form.CourseId is int c && grp.CourseId != c))
            {
                form.GroupId = null;
            }
            else
            {
                form.CourseId ??= grp.CourseId;
            }
        }
    }
    private CalendarExceptionEditDto NewBlankForm(int? preferredCourse)
        => new()
        {
            Id = null,
            Date = DateTime.Today.ToString("yyyy-MM-dd"),
            Name = "",
            IsWorkingDay = false,
            CourseId = preferredCourse,
            GroupId = null
        };
    private string EditorTitle => form.Id is null ? "Створення винятку" : $"Редагування #{form.Id}";
    // Відкриває форму створення винятку.
    private void OpenCreate()
    {
        form = NewBlankForm(form.CourseId);
        NormalizeFormWithMeta();
        editorOpen = true;
    }
    // Закриває форму редагування винятку.
    private void CloseEditor()
    {
        editorOpen = false;
        form = NewBlankForm(form.CourseId);
        NormalizeFormWithMeta();
    }
    // Переносить дані в форму для подальшого редагування.
    private void EditRow(CalendarExceptionEditDto x)
    {
        form = new()
        {
            Id = x.Id,
            Date = x.Date,
            IsWorkingDay = x.IsWorkingDay,
            Name = x.Name,
            CourseId = x.CourseId,
            GroupId = x.GroupId
        };
        NormalizeFormWithMeta();
        editorOpen = true;
    }
    // Зберігає поточний запис і перезавантажує список.
    private void OnCourseChanged(ChangeEventArgs e)
    {
        form.CourseId = null;
        if (e?.Value is not null && int.TryParse(e.Value.ToString(), out var cid) && cid > 0)
        {
            form.CourseId = cid;
        }
        if (form.CourseId is null)
        {
            form.GroupId = null;
            return;
        }
        if (form.GroupId is int gid)
        {
            var grp = groups.FirstOrDefault(g => g.Id == gid);
            if (grp is null || (form.CourseId is int c && grp.CourseId != c))
            {
                form.GroupId = null;
            }
        }
    }
    // Обробляє зміну групи у формі.
    private void OnGroupChanged(ChangeEventArgs e)
    {
        form.GroupId = null;
        if (e?.Value is not null && int.TryParse(e.Value.ToString(), out var gid) && gid > 0)
        {
            var grp = groups.FirstOrDefault(g => g.Id == gid);
            if (grp is not null && (form.CourseId is null || grp.CourseId == form.CourseId))
            {
                form.GroupId = gid;
                form.CourseId ??= grp.CourseId;
            }
        }
    }
    private async Task Save()
    {
        try
        {
            error = ok = null;
            if (form.CourseId is null || form.CourseId <= 0)
            {
                error = "Оберіть курс для винятку.";
                return;
            }
            if (form.GroupId is int gid)
            {
                var targetGroup = groups.FirstOrDefault(g => g.Id == gid);
                if (targetGroup is null)
                {
                    error = "Групу не знайдено.";
                    return;
                }
                if (targetGroup.CourseId != form.CourseId)
                {
                    error = "Група не належить обраному курсу.";
                    return;
                }
            }
            form.Name = (form.Name ?? string.Empty).Trim();
            form.Date = (form.Date ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(form.Date))
            {
                error = "Оберіть дату для винятку.";
                return;
            }
            var keepCourse = form.CourseId;
            await Admin.UpsertCalendar(form);
            await Load();
            ok = "Збережено.";
            form = NewBlankForm(keepCourse);
            NormalizeFormWithMeta();
            editorOpen = false;
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Видаляє запис за ідентифікатором та оновлює таблицю.
    private async Task Delete(int id)
    {
        try
        {
            var item = items.FirstOrDefault(x => x.Id == id);
            var caption = item is null ? $"#{id}" : $"{item.Date} — {item.Name}";
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити виняток {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            await Admin.DeleteCalendar(id);
            await Load();
            ok = "Видалено.";
            if (editorOpen && form.Id == id)
            {
                CloseEditor();
            }
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Безпечно перетворює рядок у DateOnly для сортування.
    private static DateOnly DO(string? s)
        => DateOnly.TryParse(s, out var d) ? d : DateOnly.MinValue;
    // Повертає запис, що відповідає текстовому фільтру.
    private IEnumerable<CalendarExceptionEditDto> ApplyFilter(IEnumerable<CalendarExceptionEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(x =>
            (x.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.Date?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            CourseLabel(x).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            GroupLabel(x).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            ((f.Equals("так", StringComparison.OrdinalIgnoreCase) && x.IsWorkingDay) ||
             (f.Equals("ні", StringComparison.OrdinalIgnoreCase) && !x.IsWorkingDay)))
        ;
    }
    // Виконує сортування колекції згідно з обраними параметрами.
    private IEnumerable<CalendarExceptionEditDto> ApplySort(IEnumerable<CalendarExceptionEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(CalendarExceptionEditDto.Id), true) => seq.OrderBy(x => x.Id ?? 0),
            (nameof(CalendarExceptionEditDto.Id), false) => seq.OrderByDescending(x => x.Id ?? 0),
            (nameof(CalendarExceptionEditDto.Date), true) => seq.OrderBy(x => DO(x.Date)),
            (nameof(CalendarExceptionEditDto.Date), false) => seq.OrderByDescending(x => DO(x.Date)),
            (CourseNameField, true) => seq.OrderBy(CourseLabel),
            (CourseNameField, false) => seq.OrderByDescending(CourseLabel),
            (GroupNameField, true) => seq.OrderBy(GroupLabel),
            (GroupNameField, false) => seq.OrderByDescending(GroupLabel),
            (nameof(CalendarExceptionEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(CalendarExceptionEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(CalendarExceptionEditDto.IsWorkingDay), true) => seq.OrderBy(x => x.IsWorkingDay),
            (nameof(CalendarExceptionEditDto.IsWorkingDay), false) => seq.OrderByDescending(x => x.IsWorkingDay),
            _ => seq
        };
    }
    // Отримує колекцію з урахуванням фільтру та сортування.
    private IEnumerable<CalendarExceptionEditDto> SortedAndFiltered
        => ApplySort(ApplyFilter(items));
    // Змінює поле сортування або напрямок.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
    // Додає піктограму до заголовку таблиці залежно від сортування.
    private MarkupString HeaderIcon(string field)
        => new(sortField == field ? $"<span class=\"ms-1\">{(sortAsc ? "▲" : "▼")}</span>" : "");
}
