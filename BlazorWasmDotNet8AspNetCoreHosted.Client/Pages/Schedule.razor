@* Сторінка перегляду розкладу *@
@page "/schedule"
@using System.Globalization
@using System.Linq
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@inject HttpClient Http
@inject IScheduleApi ScheduleApi
@inject TimeSlotsApi TimeSlotsApi
@inject NavigationManager Nav

@code {

    [Parameter, SupplyParameterFromQuery(Name = "weekStart")]
    public string? QueryWeekStart { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "courseId")]
    public int? QueryCourseId { get; set; }

    private const string AppVersion = "1.5.1"; // Оновлюйте перед релізом
    private MetaResponseDto? _meta;
    private int? _courseId;
    private int? _groupId;
    private int? _teacherId;
    private int? _roomId;
    private DateOnly _weekStart = FirstMonday(DateOnly.FromDateTime(DateTime.Today));
    private List<ScheduleItemDto> _items = new();
    private List<TimeSlotDto> _slots = new();
    private int _scheduleLoadVersion;
    private int _slotLoadVersion;
    private DateOnly? _loadedWeekStart;
    private int? _loadedCourseId;
    private bool _scheduleLoading;
    private string? _scheduleError;
    private bool _scheduleLoadFailed;
    private int? _editItemId;
    private int _editLessonTypeId;
    private bool _editSaving;
    private string? _editError;
    private static readonly int[] DaysMonFirst = new[] { 1, 2, 3, 4, 5, 6, 0 };
    private static readonly CultureInfo UkrainianCulture = new("uk-UA");
    private static readonly Dictionary<int, string> DayNamesUk = DaysMonFirst.ToDictionary(
        d => d,
        d =>
        {
            var name = UkrainianCulture.DateTimeFormat.GetDayName((DayOfWeek)d);
            return UkrainianCulture.TextInfo.ToTitleCase(name);
        });
    private record SlotRow(string Start, string End)
    {
        public string Label => $"{Start}-{End}";
    }
    private sealed record ScheduleCell(
        ScheduleItemDto Item,
        List<string> MergedGroups,
        bool IsMergedLecture,
        bool IsBreak,
        string ModuleCourse,
        string ColorCss);
    private List<SlotRow> _rows = new();
    private List<ScheduleItemDto> _visibleItems = new();
    private Dictionary<(int DayNumber, string Start, string End), List<ScheduleCell>> _scheduleCells = new();
    private Dictionary<int, string> _moduleCourseById = new();
    // Формує читабельний діапазон дат для поточного тижня.
    private string WeekRangeLabel
    {
        get
        {
            var from = _weekStart.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", UkrainianCulture);
            var to = _weekStart.AddDays(6).ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", UkrainianCulture);
            return $"{from} — {to}";
        }
    }
    private bool HasAdditionalFilters => _groupId is not null || _teacherId is not null || _roomId is not null;
    private bool HasScheduleItemsInContext => _items.Any(ItemMatchesCourse);
    private IEnumerable<LookupDto> GroupsForSelectedCourse => (_meta?.Groups ?? new List<LookupDto>())
        .Where(group => _courseId is null || group.CourseId == _courseId)
        .OrderBy(group => group.Name, StringComparer.CurrentCultureIgnoreCase);
    // Початкове завантаження метаданих.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _meta = await ScheduleApi.GetMeta();
            _moduleCourseById = _meta.Modules
                .Where(m => !string.IsNullOrWhiteSpace(m.CourseName))
                .ToDictionary(m => m.Id, m => m.CourseName!);
        }
        catch (ApiErrorException ex)
        {
            _scheduleLoadFailed = true;
            _scheduleError = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _scheduleLoadFailed = true;
            _scheduleError = ex.Message;
        }
    }
    // Перезавантажує розклад і тайм-слоти.
    private async Task Reload()
    {
        _scheduleLoading = true;
        _scheduleError = null;
        _scheduleLoadFailed = false;
        var requestedWeekStart = _weekStart;
        var requestedCourseId = _courseId;
        var contextChanged = _loadedWeekStart != requestedWeekStart || _loadedCourseId != requestedCourseId;
        if (contextChanged)
        {
            ClearLoadedScheduleView();
        }
        var itemsTask = LoadScheduleItemsAsync();
        var reloadVersion = _scheduleLoadVersion;
        var slotsTask = ReloadSlotsAsync(rebuildView: false);
        try
        {
            await Task.WhenAll(itemsTask, slotsTask);
            if (reloadVersion != _scheduleLoadVersion)
            {
                return;
            }
            if (_editItemId is int editing && !_items.Any(i => i.Id == editing))
            {
                CancelEdit();
            }
            RebuildScheduleCells();
            _loadedWeekStart = requestedWeekStart;
            _loadedCourseId = requestedCourseId;
        }
        catch (ApiErrorException ex)
        {
            if (reloadVersion == _scheduleLoadVersion)
            {
                ClearLoadedScheduleView();
                _scheduleLoadFailed = true;
                _scheduleError = ex.Errors.FirstOrDefault() ?? ex.Message;
            }
        }
        catch (Exception ex)
        {
            if (reloadVersion == _scheduleLoadVersion)
            {
                ClearLoadedScheduleView();
                _scheduleLoadFailed = true;
                _scheduleError = ex.Message;
            }
        }
        finally
        {
            if (reloadVersion == _scheduleLoadVersion)
            {
                _scheduleLoading = false;
            }
        }
    }
    // Прибирає попередній розклад, якщо користувач уже перейшов до іншого тижня або курсу.
    private void ClearLoadedScheduleView()
    {
        _items = new List<ScheduleItemDto>();
        _slots = new List<TimeSlotDto>();
        _rows = new List<SlotRow>();
        _visibleItems = new List<ScheduleItemDto>();
        _scheduleCells = new Dictionary<(int DayNumber, string Start, string End), List<ScheduleCell>>();
        _loadedWeekStart = null;
        _loadedCourseId = null;
    }
    // Застосовує контекст із посилання після завантаження метаданих.
    protected override async Task OnParametersSetAsync()
    {
        if (_meta is null)
        {
            return;
        }

        _weekStart = DateOnly.TryParse(QueryWeekStart, out var requestedDate)
            ? FirstMonday(requestedDate)
            : FirstMonday(DateOnly.FromDateTime(DateTime.Today));
        _courseId = NormalizeCourseId(QueryCourseId);
        NormalizeDependentFilters();

        var canonicalUri = BuildContextUri(_weekStart, _courseId);
        if (!string.Equals(canonicalUri, Nav.Uri, StringComparison.Ordinal))
        {
            Nav.NavigateTo(canonicalUri, replace: true);
            return;
        }

        await Reload();
    }
    private async Task LoadScheduleItemsAsync()
    {
        var loadVersion = ++_scheduleLoadVersion;
        var requestedWeekStart = _weekStart;
        var items = await ScheduleApi.GetWeek(requestedWeekStart);
        if (loadVersion != _scheduleLoadVersion || requestedWeekStart != _weekStart)
        {
            return;
        }
        _items = items;
    }
    // Завантажує ефективну часову сітку вибраного курсу або об'єднання всіх курсів для огляду.
    private async Task ReloadSlotsAsync(bool rebuildView = true)
    {
        var loadVersion = ++_slotLoadVersion;
        var courseIds = ResolveCourseIdsForSlots();
        var slotTasks = courseIds
            .Select(courseId => TimeSlotsApi.GetEffectiveAsync(courseId, includeDayOverrides: true))
            .ToList();
        List<TimeSlotDto>[] slotSets;
        try
        {
            slotSets = await Task.WhenAll(slotTasks);
        }
        catch (Exception) when (loadVersion != _slotLoadVersion)
        {
            // Помилка застарілого запиту не повинна перекривати успішний стан новішого фільтра.
            return;
        }

        // Не дозволяємо повільнішій попередній відповіді повернути сітку іншої групи.
        if (loadVersion != _slotLoadVersion)
        {
            return;
        }

        _slots = slotSets.SelectMany(slots => slots).ToList();
        if (rebuildView)
        {
            RebuildScheduleCells();
        }
    }
    // Вирівнює дату на понеділок поточного тижня.
    private static DateOnly FirstMonday(DateOnly d)
    {
        int diff = ((int)d.DayOfWeek + 6) % 7; 
        return d.AddDays(-diff);
    }
    private IReadOnlyList<int?> ResolveCourseIdsForSlots()
    {
        if (_meta is null)
        {
            return new int?[] { null };
        }

        if (_courseId is int courseId)
        {
            return new int?[] { courseId };
        }

        if (_groupId is int groupId)
        {
            return new int?[] { _meta.Groups.FirstOrDefault(group => group.Id == groupId)?.CourseId };
        }

        var courseIds = _meta.Courses
            .Select(course => (int?)course.Id)
            .Concat(_meta.Groups.Select(group => group.CourseId))
            .Where(courseId => courseId is not null)
            .Distinct()
            .ToList();
        return courseIds.Count > 0 ? courseIds : new int?[] { null };
    }
    // Повертає назву дня українською з готового кешу.
    private static string DayNameUk(int d) => DayNamesUk[d];
    // Мапить коди станів на CSS-класи.
    static string CssByCode(string code) => code switch
    {
        "CANCELED" => "can",
        "RESCHEDULED" => "res",
        "BREAK" => "brk",
        _ => ""
    };
    // Формує перелік груп для об'єднаної лекції в межах одного слота.
    private static List<string> ResolveMergedLectureGroups(IEnumerable<ScheduleItemDto> items)
    {
        return items
            .Select(item => item.Group?.Trim())
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Select(name => name!)
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(name => name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }
    private static string LessonModeLabel(bool requiresRoom) => requiresRoom ? "Аудиторна година" : "Без аудиторії";
    // Оновлює швидкий індекс комірок після завантаження або зміни фільтрів.
    private void RebuildScheduleCells()
    {
        _visibleItems = _items
            .Where(i =>
                ItemMatchesCourse(i) &&
                (_groupId is null || i.GroupId == _groupId) &&
                (_teacherId is null || i.TeacherId == _teacherId) &&
                (_roomId is null || i.RoomId == _roomId))
            .ToList();

        _rows = ScheduleOverviewLayoutPlanner.BuildSlotRows(_slots, _visibleItems)
            .Select(row => new SlotRow(row.Start, row.End))
            .ToList();
        _scheduleCells = ScheduleOverviewLayoutPlanner.GroupEvents(_visibleItems)
            .GroupBy(group => (group.Anchor.DayNumber, group.Anchor.TimeStart, group.Anchor.TimeEnd))
            .ToDictionary(
                group => group.Key,
                group => group.Select(displayGroup =>
                {
                    var item = displayGroup.Anchor;
                    var mergedGroups = ResolveMergedLectureGroups(displayGroup.Items);
                    var isBreak = string.Equals(item.LessonTypeCode, "BREAK", StringComparison.OrdinalIgnoreCase);
                    var moduleCourse = !isBreak && _moduleCourseById.TryGetValue(item.ModuleId, out var course)
                        ? course
                        : string.Empty;

                    return new ScheduleCell(
                        item,
                        mergedGroups,
                        displayGroup.IsMergedLecture,
                        isBreak,
                        moduleCourse,
                        item.LessonTypeCss ?? CssByCode(item.LessonTypeCode));
                }).ToList());
    }
    private void OnFilterChanged()
    {
        RebuildScheduleCells();
    }
    // Змінює курс, очищає несумісну групу та зберігає контекст у посиланні.
    private void OnCourseFilterChanged(ChangeEventArgs args)
    {
        var nextCourseId = int.TryParse(args.Value?.ToString(), out var parsedCourseId)
            ? NormalizeCourseId(parsedCourseId)
            : null;
        if (nextCourseId == _courseId)
        {
            return;
        }

        _courseId = nextCourseId;
        NormalizeDependentFilters();
        NavigateToContext(_weekStart, _courseId);
    }
    private async Task OnGroupFilterChangedAsync()
    {
        RebuildScheduleCells();
        if (_scheduleLoadFailed)
        {
            await Reload();
            return;
        }

        try
        {
            _scheduleError = null;
            await ReloadSlotsAsync();
        }
        catch (ApiErrorException ex)
        {
            _scheduleLoadFailed = true;
            _scheduleError = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _scheduleLoadFailed = true;
            _scheduleError = ex.Message;
        }
    }

    private async Task RetryLoadAsync()
    {
        if (_meta is null)
        {
            Nav.NavigateTo(Nav.Uri, forceLoad: true, replace: true);
            return;
        }

        await Reload();
    }
    private Task PrevWeek()
    {
        NavigateToContext(_weekStart.AddDays(-7), _courseId);
        return Task.CompletedTask;
    }
    private Task NextWeek()
    {
        NavigateToContext(_weekStart.AddDays(7), _courseId);
        return Task.CompletedTask;
    }
    // Змінює тиждень і одразу завантажує дані для обраної дати.
    private async Task OnWeekChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || !DateOnly.TryParse(value, out var date))
        {
            _scheduleError = "Оберіть коректну дату.";
            return;
        }
        NavigateToContext(FirstMonday(date), _courseId);
        await Task.CompletedTask;
    }
    private async Task ResetFiltersAsync()
    {
        var hadCourseFilter = _courseId is not null;
        _courseId = null;
        _groupId = _teacherId = _roomId = null;
        if (hadCourseFilter)
        {
            NavigateToContext(_weekStart, null);
            return;
        }
        await OnGroupFilterChangedAsync();
    }
    // Перевіряє, чи належить заняття поточному курсу через його групу.
    private bool ItemMatchesCourse(ScheduleItemDto item)
    {
        if (_courseId is null || _meta is null)
        {
            return true;
        }
        return _meta.Groups.FirstOrDefault(group => group.Id == item.GroupId)?.CourseId == _courseId;
    }
    private int? NormalizeCourseId(int? courseId)
        => courseId is > 0 && _meta?.Courses.Any(course => course.Id == courseId) == true ? courseId : null;
    // Не залишає вибраною групу з іншого курсу.
    private void NormalizeDependentFilters()
    {
        if (_groupId is not int groupId || _courseId is null || _meta is null)
        {
            return;
        }
        if (_meta.Groups.FirstOrDefault(group => group.Id == groupId)?.CourseId != _courseId)
        {
            _groupId = null;
        }
    }
    private string BuildContextUri(DateOnly weekStart, int? courseId)
        => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["weekStart"] = weekStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["courseId"] = courseId,
            ["groupId"] = null,
            ["teacherId"] = null,
            ["roomId"] = null
        });
    private void NavigateToContext(DateOnly weekStart, int? courseId)
    {
        var uri = BuildContextUri(weekStart, courseId);
        if (!string.Equals(uri, Nav.Uri, StringComparison.Ordinal))
        {
            Nav.NavigateTo(uri, replace: true);
        }
    }
    // Готує послідовність карток дня для мобільного подання.
    private List<(SlotRow Slot, ScheduleCell Cell)> MobileCellsForDay(int dayNumber)
        => _rows
            .SelectMany(slot => _scheduleCells.TryGetValue((dayNumber, slot.Start, slot.End), out var cells)
                ? cells.Select(cell => (slot, cell))
                : Enumerable.Empty<(SlotRow, ScheduleCell)>())
            .ToList();
    private DateOnly DateForDay(int dayNumber)
    {
        var offset = Array.IndexOf(DaysMonFirst, dayNumber);
        return _weekStart.AddDays(offset < 0 ? 0 : offset);
    }
    // Вмикає режим редагування типу заняття.
    private void BeginEdit(ScheduleItemDto item)
    {
        if (item.IsLocked || _scheduleLoading || _editSaving) return;
        _editItemId = item.Id;
        _editLessonTypeId = item.LessonTypeId;
        _editError = null;
    }
    // Скасовує редагування та очищає помилку.
    private void CancelEdit()
    {
        _editItemId = null;
        _editError = null;
    }
    private void OnLessonTypeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id))
        {
            _editLessonTypeId = id;
        }
    }
    // Зберігає новий тип заняття для вибраної пари.
    private async Task SaveLessonTypeAsync()
    {
        if (_editItemId is null) return;
        var item = _items.FirstOrDefault(x => x.Id == _editItemId);
        if (item is null)
        {
            CancelEdit();
            return;
        }
        _editSaving = true;
        _editError = null;
        try
        {
            var payload = new UpsertScheduleItemRequest(
                Id: item.Id,
                Date: item.Date,
                TimeStart: item.TimeStart,
                TimeEnd: item.TimeEnd,
                GroupId: item.GroupId,
                ModuleId: item.ModuleId,
                TeacherId: item.TeacherId,
                RoomId: item.RoomId,
                LessonTypeId: _editLessonTypeId,
                IsLocked: item.IsLocked,
                OverrideNonWorkingDay: false,
                ExpectedRevision: item.Revision
            );
            await ScheduleApi.Upsert(payload);
            await LoadScheduleItemsAsync();
            RebuildScheduleCells();
            CancelEdit();
        }
        catch (ApiErrorException ex)
        {
            _editError = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _editSaving = false;
        }
    }
}

<PageTitle>Розклад</PageTitle>

<header class="schedule-header">
    <div>
        <h1 class="page-title">Розклад</h1>
        <p class="page-subtitle">Переглядайте опубліковані заняття та за потреби змінюйте їхній тип.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_scheduleError) && !_scheduleLoadFailed)
{
    <div class="alert alert-danger" role="alert">@_scheduleError</div>
}

<div class="week-nav week-nav--top" aria-label="Навігація за тижнями">
    <button class="btn btn-ghost week-nav__button" disabled="@(_scheduleLoading || _editSaving)" @onclick="PrevWeek">
        <span aria-hidden="true">‹</span><span>Попередній тиждень</span>
    </button>
    <div class="week-nav__current">
        <strong class="week-label">@WeekRangeLabel</strong>
        <label class="week-date-picker">
            <span>Перейти до дати</span>
            <input type="date"
                   class="select"
                   value="@_weekStart.ToString("yyyy-MM-dd")"
                   disabled="@(_scheduleLoading || _editSaving)"
                   @onchange="OnWeekChangedAsync" />
        </label>
    </div>
    <button class="btn btn-ghost week-nav__button" disabled="@(_scheduleLoading || _editSaving)" @onclick="NextWeek">
        <span>Наступний тиждень</span><span aria-hidden="true">›</span>
    </button>
</div>

<section class="filters-panel" aria-labelledby="schedule-filters-title">
    <div class="filters-panel__heading">
        <div>
            <h2 id="schedule-filters-title">Що показати</h2>
            <p>Спочатку оберіть курс, потім за потреби уточніть групу, викладача чи аудиторію.</p>
        </div>
        <div class="filters-panel__actions">
            <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving)" @onclick="Reload">
                @(_scheduleLoading ? "Завантаження..." : "Оновити дані")
            </button>
            <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving || (_courseId is null && !HasAdditionalFilters))" @onclick="ResetFiltersAsync">
                Скинути фільтри
            </button>
        </div>
    </div>
    <div class="toolbar">
        <label class="filter-field filter-field--primary">
            <span>Курс</span>
            <select class="select" value="@(_courseId?.ToString() ?? string.Empty)" @onchange="OnCourseFilterChanged">
                <option value="">Усі курси</option>
                @if (_meta is not null)
                {
                    foreach (var course in _meta.Courses.OrderBy(course => course.Name, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <option value="@course.Id">@course.Name</option>
                    }
                }
            </select>
        </label>
        <label class="filter-field">
            <span>Група</span>
            <select class="select" @bind="_groupId" @bind:after="OnGroupFilterChangedAsync">
                <option value="">Усі групи</option>
                @foreach (var group in GroupsForSelectedCourse)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </label>
        <label class="filter-field filter-field--wide">
            <span>Викладач</span>
            <select class="select" @bind="_teacherId" @bind:after="OnFilterChanged">
                <option value="">Усі викладачі</option>
                @if (_meta is not null)
                {
                    foreach (var teacher in _meta.Teachers.OrderBy(teacher => teacher.Name, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <option value="@teacher.Id">@teacher.Name</option>
                    }
                }
            </select>
        </label>
        <label class="filter-field">
            <span>Аудиторія</span>
            <select class="select" @bind="_roomId" @bind:after="OnFilterChanged">
                <option value="">Усі аудиторії</option>
                @if (_meta is not null)
                {
                    foreach (var room in _meta.Rooms.OrderBy(room => room.Name, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <option value="@room.Id">@room.Name</option>
                    }
                }
            </select>
        </label>
    </div>
</section>

@if (_scheduleLoading)
{
    <div class="empty-state" role="status">
        <strong>Завантажуємо розклад…</strong>
        <span>Це може тривати кілька секунд.</span>
    </div>
}
else if (_scheduleLoadFailed)
{
    <div class="load-error-state" role="alert">
        <strong>Не вдалося завантажити розклад</strong>
        <span>@(_scheduleError ?? "Сервер тимчасово не відповідає.")</span>
        <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving)" @onclick="RetryLoadAsync">
            Спробувати ще раз
        </button>
    </div>
}
else if (!HasScheduleItemsInContext)
{
    <div class="empty-state">
        <strong>На цей тиждень занять ще немає</strong>
        <span>Оберіть інший тиждень або курс. Якщо заняття вже сформовані, перевірте, чи їх опубліковано.</span>
    </div>
}
else if (_visibleItems.Count == 0)
{
    <div class="empty-state">
        <strong>За обраними фільтрами нічого не знайдено</strong>
        <span>Заняття на цьому тижні є, але жодне не відповідає вибраній групі, викладачу чи аудиторії.</span>
        <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving)" @onclick="ResetFiltersAsync">Скинути фільтри</button>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty-state">
        <strong>Не вдалося побудувати часову сітку</strong>
        <span>Перевірте налаштування слотів часу для вибраного курсу.</span>
    </div>
}
else
{
    <div class="layout">
        <div class="grid-wrap">
            <table class="schedule">
                <thead>
                    <tr>
                        <th class="col-time">Час</th>
                        @foreach (var d in DaysMonFirst)
                        {
                            <th>@DayNameUk(d)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <th class="time-cell">
                                <span class="time-pill">@row.Label</span>
                            </th>
                            @foreach (var d in DaysMonFirst)
                            {
                                var hasCells = _scheduleCells.TryGetValue((d, row.Start, row.End), out var cells);
                                <td class="cell">
                                    @if (hasCells && cells is not null)
                                    {
                                        <div class="cell-stack">
                                        @foreach (var cell in cells)
                                        {
                                            var item = cell.Item;
                                            <div @key="item.Id" class="card @cell.ColorCss @(cell.IsMergedLecture ? "card--merged-lecture" : string.Empty)">
                                            <div class="card-top">
                                                <span class="badge">@item.LessonTypeName</span>
                                                @if (item.IsLocked)
                                                {
                                                    <span class="lock" title="Зафіксовано">🔒</span>
                                                }
                                            </div>
                                            @if (!item.IsLocked && _editItemId != item.Id)
                                            {
                                                <button type="button"
                                                        class="card-edit-trigger"
                                                        @onclick="() => BeginEdit(item)"
                                                        title="Редагувати тип заняття">
                                                    <span class="td-edit-icon" aria-hidden="true">✎</span>
                                                </button>
                                            }
                                            <div class="title">
                                                <div>@item.Module</div>
                                                @if (!string.IsNullOrWhiteSpace(cell.ModuleCourse))
                                                {
                                                    <div class="title-course text-muted small">@cell.ModuleCourse</div>
                                                }
                                            </div>
                                            @if (!cell.IsBreak && !string.IsNullOrWhiteSpace(item.Group))
                                            {
                                                <div class="sub">@item.Group</div>
                                            }
                                            @if (!cell.IsBreak && cell.IsMergedLecture)
                                            {
                                                <div class="merged-lecture-label">
                                                    Об'єднана лекція (@cell.MergedGroups.Count груп): @string.Join(", ", cell.MergedGroups)
                                                </div>
                                            }
                                            @if (!cell.IsBreak)
                                            {
                                                <div class="meta">
                                                    <span class="slot-mode">@LessonModeLabel(item.RequiresRoom)</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Teacher))
                                                    {
                                                        <span>@item.Teacher</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.Room))
                                                    {
                                                        <span>@item.Room @(!string.IsNullOrWhiteSpace(item.Building) ? $"({item.Building})" : "")</span>
                                                    }
                                                </div>
                                            }
                                            @if (_editItemId == item.Id)
                                            {
                                                <div class="card-edit">
                                                    <label class="card-edit-field">
                                                        <span class="card-edit-label">Тип заняття</span>
                                                        <select class="card-edit-select"
                                                                value="@_editLessonTypeId"
                                                                @onchange="OnLessonTypeChanged"
                                                                disabled="@_editSaving">
                                                            @foreach (var lt in _meta?.LessonTypes ?? Enumerable.Empty<IdCodeNameDto>())
                                                            {
                                                                <option value="@lt.Id">@lt.Name</option>
                                                            }
                                                        </select>
                                                    </label>
                                                    @if (!string.IsNullOrWhiteSpace(_editError))
                                                    {
                                                        <div class="card-edit-error">@_editError</div>
                                                    }
                                                    <div class="card-edit-actions">
                                                        <button type="button"
                                                                class="btn btn-primary btn-sm"
                                                                disabled="@_editSaving"
                                                                @onclick="SaveLessonTypeAsync">
                                                            @if (_editSaving)
                                                            {
                                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                            }
                                                            <span>Зберегти</span>
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-ghost btn-sm"
                                                                disabled="@_editSaving"
                                                                @onclick="CancelEdit">
                                                            Скасувати
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            </div>
                                        }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="schedule-mobile" aria-label="Розклад за днями">
        @foreach (var dayNumber in DaysMonFirst)
        {
            var dayCells = MobileCellsForDay(dayNumber);
            if (dayCells.Count == 0)
            {
                continue;
            }
            var dayDate = DateForDay(dayNumber);
            <section class="mobile-day">
                <header class="mobile-day__header">
                    <strong>@DayNameUk(dayNumber)</strong>
                    <span>@dayDate.ToString("d MMMM", UkrainianCulture)</span>
                </header>
                <div class="mobile-day__items">
                    @foreach (var dayCell in dayCells)
                    {
                        var cell = dayCell.Cell;
                        var item = cell.Item;
                        <article @key="item.Id" class="mobile-lesson">
                            <div class="mobile-lesson__time">@dayCell.Slot.Label</div>
                            <div class="card @cell.ColorCss @(cell.IsMergedLecture ? "card--merged-lecture" : string.Empty)">
                                <div class="card-top">
                                    <span class="badge">@item.LessonTypeName</span>
                                    @if (item.IsLocked)
                                    {
                                        <span class="lock" title="Зафіксовано">🔒</span>
                                    }
                                </div>
                                @if (!item.IsLocked && _editItemId != item.Id)
                                {
                                    <button type="button"
                                            class="card-edit-trigger"
                                            @onclick="() => BeginEdit(item)"
                                            title="Редагувати тип заняття">
                                        <span class="td-edit-icon" aria-hidden="true">✎</span>
                                    </button>
                                }
                                <div class="title">
                                    <div>@item.Module</div>
                                    @if (!string.IsNullOrWhiteSpace(cell.ModuleCourse))
                                    {
                                        <div class="title-course text-muted small">@cell.ModuleCourse</div>
                                    }
                                </div>
                                @if (!cell.IsBreak && !string.IsNullOrWhiteSpace(item.Group))
                                {
                                    <div class="sub">@item.Group</div>
                                }
                                @if (!cell.IsBreak && cell.IsMergedLecture)
                                {
                                    <div class="merged-lecture-label">
                                        Об'єднана лекція (@cell.MergedGroups.Count груп): @string.Join(", ", cell.MergedGroups)
                                    </div>
                                }
                                @if (!cell.IsBreak)
                                {
                                    <div class="meta">
                                        <span class="slot-mode">@LessonModeLabel(item.RequiresRoom)</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Teacher))
                                        {
                                            <span>@item.Teacher</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Room))
                                        {
                                            <span>@item.Room @(!string.IsNullOrWhiteSpace(item.Building) ? $"({item.Building})" : "")</span>
                                        }
                                    </div>
                                }
                                @if (_editItemId == item.Id)
                                {
                                    <div class="card-edit">
                                        <label class="card-edit-field">
                                            <span class="card-edit-label">Тип заняття</span>
                                            <select class="card-edit-select"
                                                    value="@_editLessonTypeId"
                                                    @onchange="OnLessonTypeChanged"
                                                    disabled="@_editSaving">
                                                @foreach (var lessonType in _meta?.LessonTypes ?? Enumerable.Empty<IdCodeNameDto>())
                                                {
                                                    <option value="@lessonType.Id">@lessonType.Name</option>
                                                }
                                            </select>
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(_editError))
                                        {
                                            <div class="card-edit-error">@_editError</div>
                                        }
                                        <div class="card-edit-actions">
                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    disabled="@_editSaving"
                                                    @onclick="SaveLessonTypeAsync">
                                                @if (_editSaving)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                <span>Зберегти</span>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-ghost btn-sm"
                                                    disabled="@_editSaving"
                                                    @onclick="CancelEdit">
                                                Скасувати
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    <div class="week-nav week-nav--bottom">
        <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving)" @onclick="PrevWeek">‹ Попередній</button>
        <span class="week-label">@WeekRangeLabel</span>
        <button class="btn btn-ghost" disabled="@(_scheduleLoading || _editSaving)" @onclick="NextWeek">Наступний ›</button>
    </div>
}

<footer class="schedule-footer">Версія застосунку @AppVersion</footer>

