            border-top: 1px solid #e5e7eb; /* Закриваємо верхню лінію шапки */
        }
            table.schedule thead th:first-child {
                border-left: 1px solid #e5e7eb;
            }
    .col-time {
        width: 140px;
    }
    .time-cell {
        position: sticky;
