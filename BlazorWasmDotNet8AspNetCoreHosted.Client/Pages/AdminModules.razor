    private void EndPageMutation() => _pageMutationInProgress = false;
    // Блокує повторну мутацію, доки підтверджений запис сервера не буде перечитано.
    private void RequireRefreshRecovery(
        string message,
        string successMessage,
        Func<Task<bool>> refreshAction,
        Action? completed = null)
    {
        _refreshRecoveryRequired = true;
        _refreshRecoveryMessage = message;
        _pendingRecoverySuccessMessage = successMessage;
        _refreshRecoveryAction = refreshAction;
        _refreshRecoveryCompleted = completed;
        ok = null;
        error = null;
    }
    // Повторює лише читання стану; успішну мутацію не надсилає вдруге.
    private async Task RetryRefreshAsync()
    {
        if (!_refreshRecoveryRequired
            || _pageMutationInProgress
            || _pageLoadInProgress
            || _refreshRecoveryInProgress)
        {
            return;
        }

        _refreshRecoveryInProgress = true;
        try
        {
            var refreshed = _refreshRecoveryAction is not null && await _refreshRecoveryAction();
            if (!refreshed)
            {
                _refreshRecoveryMessage = $"Оновити дані не вдалося: {_lastLoadError ?? "невідома помилка"}. Повторіть спробу; операцію на сервері не повторюйте.";
                return;
            }

            var successMessage = _pendingRecoverySuccessMessage;
            var completed = _refreshRecoveryCompleted;
            _refreshRecoveryRequired = false;
            _refreshRecoveryMessage = null;
            _pendingRecoverySuccessMessage = null;
            _refreshRecoveryAction = null;
            _refreshRecoveryCompleted = null;
            error = null;
            ok = successMessage;
            completed?.Invoke();
        }
        catch (Exception ex)
        {
            _lastLoadError = ex.Message;
            _refreshRecoveryMessage = $"Оновити дані не вдалося: {ex.Message}. Повторіть спробу; операцію на сервері не повторюйте.";
        }
        finally
        {
            _refreshRecoveryInProgress = false;
        }
    }
