@* Сторінка адміністрування модулів *@
@page "/admin/modules"
@using System.Net.Http.Json
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using System.Text.Json
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Admin
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Модулі</PageTitle>

<h3 class="mb-3">Модулі</h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}

<div class="card p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Імпорт модулів з .docx</h5>
        @if (importBusy)
        {
            <span class="text-muted small">Завантаження...</span>
        }
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label d-block">Файл .docx</label>
            <InputFile class="d-none" id="docxFileInput" OnChange="OnImportFileChange" accept=".docx" />
            <label for="docxFileInput" class="btn btn-outline-secondary me-2 mb-2">Оберіть файл</label>
            <span class="text-muted small">@ImportFileCaption</span>
        </div>
        <div class="col-12 col-md-6 d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="() => ImportDocx(false)"
                    disabled="@(importBusy || importFile is null)">
                Попередній перегляд
            </button>
            <button class="btn btn-primary"
                    @onclick="() => ImportDocx(true)"
                    disabled="@(importBusy || importFile is null)">
                Імпортувати
            </button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(importError))
    {
        <div class="alert alert-danger mt-3">@importError</div>
    }
    @if (!string.IsNullOrWhiteSpace(importOk))
    {
        <div class="alert alert-success mt-3">@importOk</div>
    }
    @if (importResult is not null)
    {
        <ModuleImportPreview Result="@importResult" ImportedTopicsCount="@ImportedTopicsCount" />
    }
</div>

<ClearAllModulesCard Busy="@clearBusy" Error="@clearError" Ok="@clearOk" OnClear="@ClearAllModules" />

<div class="card p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreateModule">Додати модуль</button>
        <AdminSearchBox @bind-Value="filter" Class="ms-auto" Style="max-width:320px;" Placeholder="Id / код / назва / курс / кредити" />
        <div class="text-muted small">Відібрано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(ModuleEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">Id</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Code)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Код</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Title)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                    <SortableHeader Field="@CourseField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Курси</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Credits)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Обсяг кредитів</SortableHeader>
                    <th style="width:230px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in SortedAndFiltered)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@m.Code</td>
                        <td>@m.Title</td>
                        <td>@ModuleCourseSummary(m)</td>
                        <td>@m.Credits</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary me-2" title="План модуля"
                                    @onclick="() => OpenPlans(m)">
                                План модуля
                            </button>
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditModule(m)">
                                Редагувати
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m.Id!.Value)">
                                Видалити
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (moduleEditorOpen)
{
    <div class="editor-overlay" @onclick="CloseModuleEditor">
        <div class="editor editor-modal module-editor" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div class="editor-title">@((form.Id is null ? "Створення модуля" : $"Редагування модуля #{form.Id}"))</div>
                    <div class="editor-subtitle">Налаштуйте курс, дозволені корпуси та аудиторії для модуля.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary editor-close" title="Закрити" @onclick="CloseModuleEditor">×</button>
            </div>
            <div class="module-editor-body">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label">Код</label>
                        <input class="form-control" @bind="form.Code" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label">Назва</label>
                        <input class="form-control" @bind="form.Title" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Курс модуля</label>
                        <div class="form-text small mb-2">
                            Один модуль належить лише одному курсу.
                        </div>
                        @if (!courses.Any())
                        {
                            <div class="border rounded p-2 bg-light text-muted small">Курси відсутні.</div>
                        }
                        else
                        {
                            <div class="course-chip-grid">
                                @foreach (var c in courses.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    var cid = c.Id;
                                    var selected = IsCourseSelected(cid);
                                    <button type="button"
                                            class="course-chip btn btn-sm @(selected ? "btn-primary" : "btn-outline-primary")"
                                            @onclick="() => SelectCourse(cid)">
                                        @c.Name
                                    </button>
                                }
                            </div>
                            @if (form.CourseId > 0)
                            {
                                <div class="mt-2 small text-muted">
                                    Обраний курс: @NameOfCourse(form.CourseId)
                                </div>
                            }
                        }
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0">Дозволені корпуси</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAllBuildings">Обрати всі</button>
                        </div>
                        <div class="border rounded p-2" style="max-height:200px;overflow:auto;">
                            @foreach (var b in buildings)
                            {
                                var bid = b.Id ?? 0;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@form.AllowedBuildingIds.Contains(bid)"
                                           @onchange="e => ToggleBuilding(bid, (bool)e.Value!)" id="module_bld_@bid" />
                                    <label class="form-check-label" for="module_bld_@bid">@b.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0">Дозволені аудиторії</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="SelectAllRooms"
                                    disabled="@(!rooms.Any())">Обрати всі</button>
                        </div>
                        @if (!rooms.Any())
                        {
                            <div class="border rounded p-2 bg-light text-muted small">Оберіть корпус, щоб побачити перелік аудиторій.</div>
                        }
                        else
                        {
                            <div class="border rounded p-2" style="max-height:200px;overflow:auto;">
                                @foreach (var r in rooms)
                                {
                                    var rid = r.Id ?? 0;
                                    if (rid <= 0)
                                    {
                                        continue;
                                    }
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@form.AllowedRoomIds.Contains(rid)"
                                               @onchange="e => Toggle(form.AllowedRoomIds, rid, (bool)e.Value!)" id="module_room_@rid" />
                                        <label class="form-check-label" for="module_room_@rid">@r.Name</label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="Save">Зберегти</button>
                <button class="btn btn-outline-secondary" @onclick="CloseModuleEditor">Скасувати</button>
            </div>
        </div>
    </div>
}

@if (plansModuleId is not null)
{
    <div class="plan-modal-overlay">
        <div class="plan-modal-backdrop" @onclick="ClosePlans"></div>
        <div class="plan-modal-dialog">
            <div class="plan-modal-header">
                <div>
                    <h5 class="mb-0">
                        План модуля: <span class="fw-semibold">@plansModuleTitle</span>
                    </h5>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <label class="form-label mb-0 small">Курс</label>
                        <select class="form-select form-select-sm"
                                value="@selectedPlanCourseId"
                                @onchange="OnPlanCourseChanged"
                                disabled="@(_plansBusy || !planCourseIds.Any())">
                            @foreach (var cid in planCourseIds)
                            {
                                <option value="@cid">@NameOfCourse(cid)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePlans" disabled="@_plansBusy">Закрити</button>
                    <button class="btn btn-sm btn-primary" @onclick="SavePlans" disabled="@(_plansBusy || selectedPlanCourseId <= 0)">@(_plansBusy ? "Зачекайте..." : "Зберегти план")</button>
                </div>
            </div>
            <div class="plan-modal-body">
                <div class="row g-3 mt-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Обсяг кредитів (за планом)</label>
                        <input type="number" min="0" step="0.1" class="form-control" @bind="planCourse.Credits" disabled="@_plansBusy" />
                        <div class="form-text">≈ @Math.Round(planCourse.Credits * 30M) год.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Розкладено</label>
                        <input type="number" class="form-control" value="@planCourse.ScheduledHours" disabled />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="planActive" @bind="planCourse.IsActive" disabled="@_plansBusy" />
                            <label class="form-check-label" for="planActive">Активний</label>
                        </div>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    * Зміни набувають чинності після натискання кнопки <b>Зберегти план</b> та повторного перезавантаження модуля.
                </div>
                <hr />
                <div class="card module-topics-card p-3 mb-3">
                    <div class="module-topics-header">
                        <div>
                            <h6 class="mb-0">Керування заняттями</h6>
                            <p class="small text-muted mb-0">Редагування теми відкривається в окремому вікні поверх плану.</p>
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                @onclick="OpenCreateTopic"
                                disabled="@(_plansBusy || !plansModuleId.HasValue)">
                            Додати заняття
                        </button>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle module-topics-table">
                            <thead>
                                <tr>
                                    <th class="text-nowrap">Код</th>
                                    <th class="text-nowrap">Тип</th>
                                    <th class="text-nowrap">Кафедра</th>
                                    <th class="text-nowrap text-center">Міжзборові заходи</th>
                                    <th class="text-nowrap text-center">Самостійні години</th>
                                    <th class="text-nowrap">Годин всього</th>
                                    <th class="text-nowrap">Годин аудиторних</th>
                                    <th class="text-nowrap">Годин самостійних</th>
                                    <th class="module-topics-col-groups">Заплановані групи</th>
                                    <th class="module-topics-col-groups">Відпрацьовані групи</th>
                                    <th class="module-topics-col-actions"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (moduleTopics.Count == 0)
                                {
                                    <tr>
                                        <td colspan="11" class="text-muted text-center">Немає записів.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var topic in moduleTopics)
                                    {
                                        <tr>
                                            <td>@topic.TopicCode</td>
                                            <td>@topic.LessonTypeName</td>
                                            <td>@(string.IsNullOrWhiteSpace(topic.DepartmentName) ? "—" : topic.DepartmentName)</td>
                                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" checked="@topic.IsInterAssembly"
                                       disabled="@_plansBusy"
                                       @onchange="e => ToggleTopicInterAssembly(topic, e)"
                                       aria-label="Міжзборові заходи" />
                                            </td>
                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-sm topic-flag-btn @(topic.SelfStudyBySupervisor ? "btn-success" : "btn-outline-secondary")"
                                                        title="Самостійні години цієї теми ставляться у розклад"
                                                        disabled="@_plansBusy"
                                                        @onclick="() => ToggleTopicSupervisorSelfStudy(topic)">
                                                    @(topic.SelfStudyBySupervisor ? "У розкладі" : "Не розкладати")
                                                </button>
                                            </td>
                                            <td>@topic.TotalHours</td>
                                            <td>@topic.AuditoriumHours</td>
                                            <td>@topic.SelfStudyHours</td>
                                            <td class="module-topics-col-groups">
                                                <span>@GroupsHoursCaption(topic.PlannedGroupsHours ?? new())</span>
                                            </td>
                                            <td class="module-topics-col-groups">
                                                <span>@GroupsHoursCaption(topic.CompletedGroupsHours ?? new())</span>
                                            </td>
                                            <td class="module-topics-col-actions text-end text-nowrap">
                                                <div class="btn-group btn-group-sm me-1 mb-1 mb-sm-0">
                                                    <button class="btn btn-outline-secondary" disabled="@_plansBusy" @onclick="() => EditTopic(topic)">Редагувати</button>
                                                    <button class="btn btn-outline-danger" disabled="@_plansBusy" @onclick="() => DeleteTopic(topic.Id)">Видалити</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (moduleTopics.Any())
                            {
                        var totals = CalculateModuleTopicTotals();
                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td colspan="5" class="text-end pe-3">Всього за модуль</td>
                                <td>@totals.total</td>
                                <td>@totals.auditorium</td>
                                <td>@totals.self</td>
                                <td colspan="2"></td>
                                <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
                @if (topicEditorOpen)
                {
                    <div class="editor-overlay topic-editor-overlay" @onclick="CloseTopicEditor">
                        <div class="editor editor-modal topic-editor" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                            <div class="editor-modal-head">
                                <div>
                                    <div class="editor-title">@(topicForm.Id is null ? "Створення теми заняття" : $"Редагування теми #{topicForm.Id}")</div>
                                    <div class="editor-subtitle">Вкажіть код у форматі <code>1.1.1.1</code> та заповніть параметри теми.</div>
                                </div>
                                <button type="button" class="btn btn-outline-secondary editor-close" title="Закрити" @onclick="CloseTopicEditor">×</button>
                            </div>
                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-lg-4">
                                    <label class="form-label text-nowrap">Код заняття</label>
                                    <input class="form-control" @bind="topicCodeInput" />
                                </div>
                                <div class="col-12 col-lg-4">
                                    <label class="form-label text-nowrap">Тип заняття</label>
                                    <select class="form-select" @bind="topicForm.LessonTypeId">
                                        <option value="0">- Оберіть тип заняття -</option>
                                        @foreach (var lt in lessonTypes)
                                        {
                                            <option value="@lt.Id">@lt.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <label class="form-label text-nowrap">Кафедра</label>
                                    <select class="form-select"
                                            value="@topicForm.DepartmentId"
                                            @onchange="e => topicForm.DepartmentId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : (int?)null">
                                        <option value="">— Не вказано —</option>
                                        @foreach (var dep in departments.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <option value="@dep.Id" selected="@(topicForm.DepartmentId == dep.Id)">@dep.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-nowrap">Годин аудиторних</label>
                                    <input type="number" min="0" class="form-control" @bind="topicForm.AuditoriumHours" @bind:after="SyncTotalHours" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-nowrap">Годин самостійних</label>
                                    <input type="number" min="0" class="form-control" @bind="topicForm.SelfStudyHours" @bind:after="SyncTotalHours" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label text-nowrap">Всього</label>
                                    <input type="number" min="0" class="form-control" value="@topicForm.TotalHours" readonly />
                                </div>
                            </div>
                            <div class="editor-actions">
                                <button type="button" class="btn btn-primary" @onclick="SaveTopic" disabled="@(_plansBusy || !plansModuleId.HasValue)">Зберегти заняття</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="ClearTopicForm" disabled="@(_plansBusy || !plansModuleId.HasValue)">Очистити поля</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CloseTopicEditor" disabled="@_plansBusy">Скасувати</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {

    private string? error, ok;
    private IBrowserFile? importFile;
    private DocxImportResultDto? importResult;
    private bool importBusy;
    private string? importError;
    private string? importOk;
    private bool clearBusy;
    private string? clearError;
    private string? clearOk;
    private List<ModuleEditDto> items = new();
    private ModuleEditDto form = NewModuleForm();
    private bool moduleEditorOpen;
    private List<LookupDto> courses = new();
    private List<LookupDto> departments = new();
    private List<RoomEditDto> rooms = new();
    private List<RoomEditDto> allRooms = new();
    private List<BuildingEditDto> buildings = new();
    private List<IdCodeNameDto> lessonTypes = new();

private int? plansModuleId;
private List<int> planCourseIds = new();
private int selectedPlanCourseId;
private string plansModuleTitle = "";
private string plansModuleCode = "";
    private PlanCourseVM planCourse = new();
    private bool _plansBusy;

    private List<ModuleTopicViewDto> moduleTopics = new();
    private ModuleTopicFormVM topicForm = new();
    private string topicCodeInput = string.Empty;
    private bool topicEditorOpen;
    // Дозволяємо літери/цифри/крапки/дефіси, щоб підтримати коди на кшталт КП.1.1
    private static readonly Regex TopicCodePattern = new(@"^[A-Za-zА-Яа-яІіЇїЄєҐґ0-9._-]+$");
    private const string CourseField = "CourseName";
    private string sortField = nameof(ModuleEditDto.Title);
    private bool sortAsc = true;
    private string? filter;
    private static ModuleEditDto NewModuleForm() => new()
    {
        Id = null,
        Code = string.Empty,
        Title = string.Empty,
        CourseId = 0,
        AllowedRoomIds = new(),
        AllowedBuildingIds = new(),
        CloneCourseIds = new(),
        Credits = 0
    };
    private void OpenCreateModule()
    {
        form = NewModuleForm();
        moduleEditorOpen = true;
        UpdateVisibleRooms();
    }
    private void CloseModuleEditor()
    {
        moduleEditorOpen = false;
        form = NewModuleForm();
        UpdateVisibleRooms();
    }
    // Завантажує дані модулів і довідників під час першого відкриття сторінки.
    protected override async Task OnInitializedAsync() => await Load();
    private int ImportedTopicsCount => importResult?.Modules?.Sum(m => m.Topics?.Count ?? 0) ?? 0;
    private string ImportFileCaption => importFile is null
        ? "Файл не обрано"
        : $"{importFile.Name} ({Math.Round(importFile.Size / 1024.0, 1)} КБ)";
    // Обробляє вибір файлу для імпорту DOCX.
    private async Task OnImportFileChange(InputFileChangeEventArgs e)
    {
        importFile = e.FileCount > 0 ? e.File : null;
        importResult = null;
        importError = null;
        importOk = null;
        await InvokeAsync(StateHasChanged);
    }
    // Запускає імпорт або попередній перегляд DOCX.
    private async Task ImportDocx(bool apply)
    {
        if (importFile is null)
        {
            importError = "Оберіть .docx файл для імпорту.";
            importOk = null;
            return;
        }
        try
        {
            importBusy = true;
            importError = null;
            importOk = null;
            importResult = await Admin.ImportModulesFromDocx(importFile, apply);
            importOk = apply ? "Імпорт виконано." : "Прев’ю імпорту отримано.";
            if (apply)
            {
                await Load();
            }
        }
        catch (Exception ex)
        {
            importError = TryParseImportError(ex.Message);
        }
        finally
        {
            importBusy = false;
        }
    }
    // Намагається витягнути повідомлення помилки з JSON-відповіді.
    private string TryParseImportError(string message)
    {
        try
        {
            using var doc = JsonDocument.Parse(message);
            var root = doc.RootElement;
            var msg = root.TryGetProperty("message", out var m) ? m.GetString() : message;
            var warns = root.TryGetProperty("warnings", out var w) && w.ValueKind == JsonValueKind.Array
                ? string.Join("; ", w.EnumerateArray().Select(x => x.GetString()).Where(s => !string.IsNullOrWhiteSpace(s))!)
                : null;
            return string.IsNullOrWhiteSpace(warns) ? msg ?? message : $"{msg}: {warns}";
        }
        catch
        {
            return message;
        }
    }
