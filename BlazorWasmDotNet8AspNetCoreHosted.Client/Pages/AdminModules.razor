    // Отримує список модулів, супровідні довідники та налаштовує стан форми.
    private async Task<bool> Load(bool clearMessages = true)
    {
        var loadVersion = _pageLoadGuard.Begin();
        _pageLoadInProgress = true;
        if (clearMessages)
        {
            error = null;
            ok = null;
        }
        _lastLoadError = null;
        try
        {
            var loadedItems = await Admin.GetModules();
            var meta = await Admin.GetMeta();
            var loadedCourses = meta.Courses ?? new();
            var loadedLessonTypes = meta.LessonTypes ?? new();
            var loadedDepartments = meta.Departments ?? new();
            var loadedRooms = await Admin.GetRooms() ?? new();
            var loadedBuildings = await Admin.GetBuildings();

            if (!_pageLoadGuard.IsCurrent(loadVersion))
            {
                return true;
            }

            items = loadedItems;
            courses = loadedCourses;
            lessonTypes = loadedLessonTypes;
            departments = loadedDepartments;
            allRooms = loadedRooms;
            buildings = loadedBuildings;
            EnsureBuildingsCoverSelectedRooms();
            UpdateVisibleRooms();
            return true;
        }
        catch (Exception ex)
        {
            if (!_pageLoadGuard.IsCurrent(loadVersion))
            {
                return true;
            }

            _lastLoadError = ex.Message;
            if (clearMessages)
            {
                ok = null;
                error = ex.Message;
            }
            return false;
        }
        finally
        {
            if (_pageLoadGuard.IsCurrent(loadVersion))
            {
                _pageLoadInProgress = false;
            }
        }
    }
    // Додає або вилучає ідентифікатор зі списку залежно від прапорця.
    private static void Toggle(List<int> list, int id, bool on)
