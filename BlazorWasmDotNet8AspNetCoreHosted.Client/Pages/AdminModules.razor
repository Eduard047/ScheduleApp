    // Перевіряє введені дані та зберігає модуль через API.
    private async Task Save()
    {
        if (!TryBeginPageMutation()) return;
        moduleSaving = true;
        ok = null;
        error = null;
        try
        {
            var selectedCourses = CurrentCourseIds();
            if (selectedCourses.Count == 0)
            {
                error = "Оберіть принаймні один курс для модуля.";
                return;
            }
            SetSelectedCourses(selectedCourses);
            var payload = new ModuleEditDto(
                form.Id,
                form.Code,
                form.Title,
                form.CourseId,
                new List<int>(form.AllowedRoomIds),
                new List<int>(form.AllowedBuildingIds),
                form.Credits);
            var savedId = await Admin.UpsertModule(payload);
            form.Id = savedId;
            if (await Load(clearMessages: false))
            {
                ok = "Модуль успішно збережено.";
                error = null;
                CloseModuleEditorCore();
            }
            else
            {
                RequireRefreshRecovery(
                    $"Модуль збережено, але оновити список не вдалося: {_lastLoadError ?? "невідома помилка"}. Повторно зберігати модуль не потрібно.",
                    "Модуль успішно збережено.",
                    () => Load(clearMessages: false),
                    CloseModuleEditorCore);
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            moduleSaving = false;
            EndPageMutation();
        }
    }
