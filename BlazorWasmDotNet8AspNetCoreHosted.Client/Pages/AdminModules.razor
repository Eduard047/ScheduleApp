    // Зберігає налаштування плану годин для вибраного курсу.
    private async Task SavePlans()
    {
        if (plansModuleId is null || selectedPlanCourseId <= 0 || !TryBeginPageMutation()) return;

        _plansBusy = true;
        ok = null;
        error = null;
        var moduleId = plansModuleId.Value;
        var courseId = selectedPlanCourseId;
        var credits = planCourse.Credits;
        var isActive = planCourse.IsActive;
        try
        {
            var normalizedHours = (int)Math.Round(Math.Max(0m, credits) * 30m);
            await Admin.UpsertCourseModulePlan(
                moduleId,
                courseId,
                new SaveCourseModulePlanDto(normalizedHours, isActive)
            );
            if (plansModuleId != moduleId || selectedPlanCourseId != courseId)
            {
                return;
            }
            void ApplyCreditsToRow()
            {
                var moduleRow = items.FirstOrDefault(x => x.Id == moduleId);
                if (moduleRow is not null)
                {
                    moduleRow.Credits = credits;
                }
            }
            if (await LoadPlanDetails(moduleId, courseId, credits))
            {
                ApplyCreditsToRow();
                ok = "План модуля оновлено.";
                error = null;
            }
            else
            {
                RequireRefreshRecovery(
                    $"План модуля збережено, але оновити його не вдалося: {_lastLoadError ?? "невідома помилка"}. Повторно зберігати план не потрібно.",
                    "План модуля оновлено.",
                    () => LoadPlanDetails(moduleId, courseId, credits),
                    ApplyCreditsToRow);
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            _plansBusy = false;
            EndPageMutation();
        }
    }
    // Завантажує деталі плану годин для модуля та курсу.
    private async Task<bool> LoadPlanDetails(int moduleId, int courseId, decimal fallbackCredits)
    {
        _lastLoadError = null;
        try
        {
            PlanCourseVM loadedPlan;
            if (courseId <= 0)
            {
                var normalizedHours = (int)Math.Round(Math.Max(0m, fallbackCredits) * 30m);
                loadedPlan = new PlanCourseVM
                {
                    CourseId = 0,
                    TargetHours = normalizedHours,
                    Credits = fallbackCredits,
                    ScheduledHours = 0,
                    IsActive = true
                };
            }
            else
            {
                var dto = await Admin.GetCourseModulePlan(moduleId, courseId);
                if (dto is null)
                {
                    var normalizedHours = (int)Math.Round(Math.Max(0m, fallbackCredits) * 30m);
                    loadedPlan = new PlanCourseVM
                    {
                        CourseId = courseId,
                        TargetHours = normalizedHours,
                        Credits = fallbackCredits,
                        ScheduledHours = 0,
                        IsActive = true
                    };
                }
                else
                {
                    loadedPlan = new PlanCourseVM
                    {
                        CourseId = courseId,
                        TargetHours = dto.TargetHours,
                        Credits = Math.Round(dto.TargetHours / 30m, 2),
                        ScheduledHours = dto.ScheduledHours,
                        IsActive = dto.IsActive
                    };
                }
            }

            planCourse = loadedPlan;
            return true;
        }
        catch (Exception ex)
        {
            _lastLoadError = ex.Message;
            return false;
        }
    }
    private async Task<bool> LoadPlanContext(int moduleId, int courseId, decimal fallbackCredits)
    {
        if (!await LoadPlanDetails(moduleId, courseId, fallbackCredits))
        {
            return false;
        }
        if (!await LoadTopics(moduleId))
        {
            return false;
        }
        ResetTopicForm(moduleId);
        return true;
    }
    // Реагує на зміну курсу у плані та підвантажує його дані.
    private async Task OnPlanCourseChanged(ChangeEventArgs e)
    {
        if (plansModuleId is null) return;
        if (e?.Value is null) return;
        if (!int.TryParse(e.Value.ToString(), out var nextCourseId)) return;
        if (!planCourseIds.Contains(nextCourseId)) return;
        if (nextCourseId <= 0 || nextCourseId == selectedPlanCourseId) return;
        if (!TryBeginPageMutation()) return;

        _plansBusy = true;
        ok = null;
        error = null;
        var moduleId = plansModuleId.Value;
        var fallbackCredits = items.FirstOrDefault(x => x.Id == moduleId)?.Credits ?? planCourse.Credits;
        selectedPlanCourseId = nextCourseId;
        try
        {
            if (!await EnsurePlanModuleSeparated(moduleId, nextCourseId, fallbackCredits))
            {
                return;
            }
            if (plansModuleId is not int currentModuleId || selectedPlanCourseId != nextCourseId)
            {
                return;
            }
            var currentModule = items.FirstOrDefault(x => x.Id == currentModuleId);
            var currentCredits = currentModule?.Credits ?? fallbackCredits;
            if (!await LoadPlanContext(currentModuleId, nextCourseId, currentCredits))
            {
                RequireRefreshRecovery(
                    $"Не вдалося завантажити план для вибраного курсу: {_lastLoadError ?? "невідома помилка"}.",
                    "План для вибраного курсу завантажено.",
                    () => LoadPlanContext(currentModuleId, nextCourseId, currentCredits));
            }
        }
        catch (Exception ex)
        {
            RequirePlanContextRecovery(
                $"Не вдалося змінити курс плану: {ex.Message}. Дані плану заблоковано до успішного оновлення.",
                moduleId,
                nextCourseId,
                fallbackCredits);
        }
        finally
        {
            _plansBusy = false;
            EndPageMutation();
        }
    }
    // За потреби розділяє модуль між курсами та перемикає модальне вікно на курсо-специфічний запис.
    private async Task<bool> EnsurePlanModuleSeparated(int currentModuleId, int courseId, decimal fallbackCredits)
    {
        if (courseId <= 0) return true;
        var scopedModuleId = await Admin.EnsureCourseScopedModule(currentModuleId, courseId);
        if (scopedModuleId <= 0)
        {
            return true;
        }
        if (scopedModuleId != currentModuleId)
        {
            plansModuleId = scopedModuleId;
            if (!await Load(clearMessages: false))
            {
                RequireRefreshRecovery(
                    $"Модуль підготовлено для курсу, але оновити список не вдалося: {_lastLoadError ?? "невідома помилка"}. Повторно перемикати курс не потрібно.",
                    "План для вибраного курсу завантажено.",
                    async () =>
                    {
                        if (!await Load(clearMessages: false)) return false;
                        UpdatePlanModuleCaption(scopedModuleId);
                        return await LoadPlanContext(scopedModuleId, courseId, fallbackCredits);
                    });
                return false;
            }
            UpdatePlanModuleCaption(scopedModuleId);
        }
        return true;
    }
    private void UpdatePlanModuleCaption(int moduleId)
    {
        var scopedModule = items.FirstOrDefault(x => x.Id == moduleId);
        if (scopedModule is null) return;
        plansModuleTitle = $"{scopedModule.Code} - {scopedModule.Title}";
        plansModuleCode = scopedModule.Code ?? plansModuleCode;
    }
    private void RequirePlanContextRecovery(
        string message,
        int preferredModuleId,
        int courseId,
        decimal fallbackCredits)
    {
        var moduleCode = plansModuleCode;
        RequireRefreshRecovery(
            message,
            "Дані плану модуля відновлено.",
            () => RecoverPlanContextAsync(preferredModuleId, courseId, fallbackCredits, moduleCode));
    }
    // Відновлює контекст плану лише читанням і не повторює невизначену мутацію розділення модуля.
    private async Task<bool> RecoverPlanContextAsync(
        int preferredModuleId,
        int courseId,
        decimal fallbackCredits,
        string moduleCode)
    {
        if (!await Load(clearMessages: false))
        {
            return false;
        }

        var recoveredModule = items.FirstOrDefault(module =>
                module.Id == preferredModuleId
                && (courseId <= 0 || ModuleCourseIds(module).Contains(courseId)))
            ?? items.FirstOrDefault(module =>
                courseId > 0
                && ModuleCourseIds(module).Contains(courseId)
                && string.Equals(module.Code, moduleCode, StringComparison.OrdinalIgnoreCase));
        if (recoveredModule?.Id is not int recoveredModuleId)
        {
            _lastLoadError = "Не знайдено модуль для вибраного курсу після оновлення.";
            return false;
        }

        plansModuleId = recoveredModuleId;
        planCourseIds = ModuleCourseIds(recoveredModule);
        selectedPlanCourseId = courseId > 0 && planCourseIds.Contains(courseId)
            ? courseId
            : planCourseIds.FirstOrDefault();
        UpdatePlanModuleCaption(recoveredModuleId);
        return await LoadPlanContext(
            recoveredModuleId,
            selectedPlanCourseId,
            recoveredModule.Credits > 0 ? recoveredModule.Credits : fallbackCredits);
    }
    private void ClosePlansDuringRecovery()
    {
        if (!_refreshRecoveryRequired
            || _refreshRecoveryInProgress
            || _pageMutationInProgress
            || _pageLoadInProgress)
