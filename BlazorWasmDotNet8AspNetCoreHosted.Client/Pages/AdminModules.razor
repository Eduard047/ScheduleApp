@* Сторінка адміністрування модулів *@
@page "/admin/modules"
@using System.Net.Http.Json
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using System.Text.Json
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Admin
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Адмін • Модулі</PageTitle>

<h1 class="h3 mb-3">Модулі</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}
@if (_refreshRecoveryRequired)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
        <span>@_refreshRecoveryMessage</span>
        <button type="button" class="btn btn-sm btn-outline-dark" @onclick="RetryRefreshAsync" disabled="@_refreshRecoveryInProgress">
            @(_refreshRecoveryInProgress ? "Оновлення…" : "Повторити оновлення")
        </button>
    </div>
}

<div class="card p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Імпорт модулів з .docx</h5>
        @if (importBusy)
        {
            <span class="text-muted small">Завантаження...</span>
        }
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label" for="docxFileInput">Файл .docx</label>
            <InputFile class="form-control" id="docxFileInput" OnChange="OnImportFileChange" accept=".docx" disabled="@IsPageInteractionBlocked" />
            <div class="text-muted small mt-1">@ImportFileCaption</div>
        </div>
        <div class="col-12 col-md-6 d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="() => ImportDocx(false)"
                    disabled="@(IsPageInteractionBlocked || importFile is null)">
                Попередній перегляд
            </button>
            <button class="btn btn-primary"
                    @onclick="() => ImportDocx(true)"
                    disabled="@(IsPageInteractionBlocked || importFile is null)">
                Імпортувати
            </button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(importError))
    {
        <div class="alert alert-danger mt-3" role="alert">@importError</div>
    }
    @if (!string.IsNullOrWhiteSpace(importOk))
    {
        <div class="alert alert-success mt-3" role="status">@importOk</div>
    }
    @if (importResult is not null)
    {
        <ModuleImportPreview Result="@importResult" ImportedTopicsCount="@ImportedTopicsCount" />
    }
</div>

<fieldset class="border-0 p-0 m-0 w-100" disabled="@IsPageInteractionBlocked">
    <ClearAllModulesCard Busy="@clearBusy" Error="@clearError" Ok="@clearOk" OnClear="@ClearAllModules" />
</fieldset>

<div class="card p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreateModule" disabled="@IsPageInteractionBlocked">Додати модуль</button>
        <AdminSearchBox @bind-Value="filter" Class="ms-auto" Style="max-width:320px;" Placeholder="Id / код / назва / курс / кредити" />
        <div class="text-muted small">Відібрано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive" role="region" aria-label="Список модулів" tabindex="0">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(ModuleEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">Id</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Code)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Код</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Title)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                    <SortableHeader Field="@CourseField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Курси</SortableHeader>
                    <SortableHeader Field="@nameof(ModuleEditDto.Credits)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Обсяг кредитів</SortableHeader>
                    <th style="width:230px;"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in SortedAndFiltered)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@m.Code</td>
                        <td>@m.Title</td>
                        <td>@ModuleCourseSummary(m)</td>
                        <td>@m.Credits</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary me-2" title="План модуля"
                                    @onclick="() => OpenPlans(m)" disabled="@IsPageInteractionBlocked">
                                План модуля
                            </button>
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditModule(m)" disabled="@IsPageInteractionBlocked">
                                Редагувати
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m.Id!.Value)" disabled="@IsPageInteractionBlocked">
                                Видалити
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (moduleEditorOpen)
{
    <AdminEditorModal Title="@((form.Id is null ? "Створення модуля" : $"Редагування модуля #{form.Id}"))"
                      Subtitle="Налаштуйте курс, дозволені корпуси та аудиторії для модуля."
                      CssClass="module-editor"
                      Busy="@IsModalBusy"
                      OnClose="@CloseModuleEditor">
            @if (_refreshRecoveryRequired)
            {
                <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                    <span>@_refreshRecoveryMessage</span>
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="RetryRefreshAsync" disabled="@_refreshRecoveryInProgress">
                        @(_refreshRecoveryInProgress ? "Оновлення…" : "Повторити оновлення")
                    </button>
                </div>
            }
            <fieldset class="border-0 p-0 m-0" disabled="@IsPageInteractionBlocked">
            <div class="module-editor-body">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="module-code">Код</label>
                        <input id="module-code" class="form-control" @bind="form.Code" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="module-title">Назва</label>
                        <input id="module-title" class="form-control" @bind="form.Title" />
                    </div>
                    <div class="col-12">
                        <div id="module-course-label" class="form-label">Курс модуля</div>
                        <div class="form-text small mb-2">
                            Один модуль належить лише одному курсу.
                        </div>
                        @if (!courses.Any())
                        {
                            <div class="border rounded p-2 bg-light text-muted small">Курси відсутні.</div>
                        }
                        else
                        {
                            <div class="course-chip-grid" role="group" aria-labelledby="module-course-label">
                                @foreach (var c in courses.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    var cid = c.Id;
                                    var selected = IsCourseSelected(cid);
                                    <button type="button"
                                            class="course-chip btn btn-sm @(selected ? "btn-primary" : "btn-outline-primary")"
                                            aria-pressed="@selected"
                                            @onclick="() => SelectCourse(cid)">
                                        @c.Name
                                    </button>
                                }
                            </div>
                            @if (form.CourseId > 0)
                            {
                                <div class="mt-2 small text-muted">
                                    Обраний курс: @NameOfCourse(form.CourseId)
                                </div>
                            }
                        }
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div id="module-buildings-label" class="form-label mb-0">Дозволені корпуси</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAllBuildings">Обрати всі</button>
                        </div>
                        <div class="border rounded p-2" style="max-height:200px;overflow:auto;" role="group" aria-labelledby="module-buildings-label">
                            @foreach (var b in buildings)
                            {
                                var bid = b.Id ?? 0;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@form.AllowedBuildingIds.Contains(bid)"
                                           @onchange="e => ToggleBuilding(bid, (bool)e.Value!)" id="module_bld_@bid" />
                                    <label class="form-check-label" for="module_bld_@bid">@b.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div id="module-rooms-label" class="form-label mb-0">Дозволені аудиторії</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="SelectAllRooms"
                                    disabled="@(!rooms.Any())">Обрати всі</button>
                        </div>
                        @if (!rooms.Any())
                        {
                            <div class="border rounded p-2 bg-light text-muted small">Оберіть корпус, щоб побачити перелік аудиторій.</div>
                        }
                        else
                        {
                            <div class="border rounded p-2" style="max-height:200px;overflow:auto;" role="group" aria-labelledby="module-rooms-label">
                                @foreach (var r in rooms)
                                {
                                    var rid = r.Id ?? 0;
                                    if (rid <= 0)
                                    {
                                        continue;
                                    }
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@form.AllowedRoomIds.Contains(rid)"
                                               @onchange="e => Toggle(form.AllowedRoomIds, rid, (bool)e.Value!)" id="module_room_@rid" />
                                        <label class="form-check-label" for="module_room_@rid">@r.Name</label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="Save" disabled="@IsPageInteractionBlocked">@(moduleSaving ? "Збереження…" : "Зберегти")</button>
                <button class="btn btn-outline-secondary" @onclick="CloseModuleEditor" disabled="@IsPageInteractionBlocked">Скасувати</button>
            </div>
            </fieldset>
    </AdminEditorModal>
}

@if (plansModuleId is not null && !topicEditorOpen)
{
    <div class="plan-modal-overlay">
        <div class="plan-modal-backdrop" @onclick="ClosePlans"></div>
        <div @ref="_planDialogElement"
             class="plan-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-busy="@IsPageInteractionBlocked"
             aria-labelledby="module-plan-title"
             tabindex="-1"
             @onkeydown="HandlePlanKeyDown">
            <div class="plan-modal-header">
                <div>
                    <h2 id="module-plan-title" class="h5 mb-0">
                        План модуля: <span class="fw-semibold">@plansModuleTitle</span>
                    </h2>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <label class="form-label mb-0 small" for="module-plan-course">Курс</label>
                        <select id="module-plan-course" class="form-select form-select-sm"
                                value="@selectedPlanCourseId"
                                @onchange="OnPlanCourseChanged"
                                disabled="@(IsPageInteractionBlocked || !planCourseIds.Any())">
                            @foreach (var cid in planCourseIds)
                            {
                                <option value="@cid">@NameOfCourse(cid)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePlans" disabled="@IsPageInteractionBlocked">Закрити</button>
                    <button class="btn btn-sm btn-primary" @onclick="SavePlans" disabled="@(IsPageInteractionBlocked || selectedPlanCourseId <= 0)">@(_plansBusy ? "Зачекайте..." : "Зберегти план")</button>
                </div>
            </div>
            <div class="plan-modal-body">
                @if (_refreshRecoveryRequired)
                {
                    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                        <span>@_refreshRecoveryMessage</span>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="RetryRefreshAsync" disabled="@_refreshRecoveryInProgress">
                                @(_refreshRecoveryInProgress ? "Оновлення…" : "Повторити оновлення")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClosePlansDuringRecovery" disabled="@_refreshRecoveryInProgress">
                                Закрити план
                            </button>
                        </div>
                    </div>
                }
                <div class="row g-3 mt-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="module-plan-credits">Обсяг кредитів (за планом)</label>
                        <input id="module-plan-credits" type="number" min="0" step="0.1" class="form-control" @bind="planCourse.Credits" disabled="@IsPageInteractionBlocked" />
                        <div class="form-text">≈ @Math.Round(planCourse.Credits * 30M) год.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="module-plan-scheduled">Розкладено</label>
                        <input id="module-plan-scheduled" type="number" class="form-control" value="@planCourse.ScheduledHours" disabled />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="planActive" @bind="planCourse.IsActive" disabled="@IsPageInteractionBlocked" />
                            <label class="form-check-label" for="planActive">Активний</label>
                        </div>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    * Зміни набувають чинності після натискання кнопки <b>Зберегти план</b> та повторного перезавантаження модуля.
                </div>
                <hr />
                <div class="card module-topics-card p-3 mb-3">
                    <div class="module-topics-header">
                        <div>
                            <h6 class="mb-0">Керування заняттями</h6>
                            <p class="small text-muted mb-0">Редагування теми відкривається в окремому вікні поверх плану.</p>
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                @onclick="OpenCreateTopic"
                                disabled="@(IsPageInteractionBlocked || !plansModuleId.HasValue)">
                            Додати заняття
                        </button>
                    </div>
                    <div class="table-responsive mt-3" role="region" aria-label="Теми модуля" tabindex="0">
                        <table class="table table-sm align-middle module-topics-table">
                            <thead>
                                <tr>
                                    <th class="text-nowrap">Код</th>
                                    <th class="text-nowrap">Тип</th>
                                    <th class="text-nowrap">Кафедра</th>
                                    <th class="text-nowrap text-center">Міжзборові заходи</th>
                                    <th class="text-nowrap text-center">Самостійні години</th>
                                    <th class="text-nowrap">Годин всього</th>
                                    <th class="text-nowrap">Годин аудиторних</th>
                                    <th class="text-nowrap">Годин самостійних</th>
                                    <th class="module-topics-col-groups">Заплановані групи</th>
                                    <th class="module-topics-col-groups">Відпрацьовані групи</th>
                                    <th class="module-topics-col-actions"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (moduleTopics.Count == 0)
                                {
                                    <tr>
                                        <td colspan="11" class="text-muted text-center">Немає записів.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var topic in moduleTopics)
                                    {
                                        <tr>
                                            <td>@topic.TopicCode</td>
                                            <td>@topic.LessonTypeName</td>
                                            <td>@(string.IsNullOrWhiteSpace(topic.DepartmentName) ? "—" : topic.DepartmentName)</td>
                                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" checked="@topic.IsInterAssembly"
                                       disabled="@IsPageInteractionBlocked"
                                       @onchange="e => ToggleTopicInterAssembly(topic, e)"
                                       aria-label="Міжзборові заходи" />
                                            </td>
                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-sm topic-flag-btn @(topic.SelfStudyBySupervisor ? "btn-success" : "btn-outline-secondary")"
                                                        title="Самостійні години цієї теми ставляться у розклад"
                                                        disabled="@IsPageInteractionBlocked"
                                                        @onclick="() => ToggleTopicSupervisorSelfStudy(topic)">
                                                    @(topic.SelfStudyBySupervisor ? "У розкладі" : "Не розкладати")
                                                </button>
                                            </td>
                                            <td>@topic.TotalHours</td>
                                            <td>@topic.AuditoriumHours</td>
                                            <td>@topic.SelfStudyHours</td>
                                            <td class="module-topics-col-groups">
                                                <span>@GroupsHoursCaption(topic.PlannedGroupsHours ?? new())</span>
                                            </td>
                                            <td class="module-topics-col-groups">
                                                <span>@GroupsHoursCaption(topic.CompletedGroupsHours ?? new())</span>
                                            </td>
                                            <td class="module-topics-col-actions text-end text-nowrap">
                                                <div class="btn-group btn-group-sm me-1 mb-1 mb-sm-0">
                                                    <button class="btn btn-outline-secondary" disabled="@IsPageInteractionBlocked" @onclick="() => EditTopic(topic)">Редагувати</button>
                                                    <button class="btn btn-outline-danger" disabled="@IsPageInteractionBlocked" @onclick="() => DeleteTopic(topic.Id)">Видалити</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (moduleTopics.Any())
                            {
                        var totals = CalculateModuleTopicTotals();
                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td colspan="5" class="text-end pe-3">Всього за модуль</td>
                                <td>@totals.total</td>
                                <td>@totals.auditorium</td>
                                <td>@totals.self</td>
                                <td colspan="2"></td>
                                <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (topicEditorOpen && plansModuleId is not null)
{
    <AdminEditorModal Title="@(topicForm.Id is null ? "Створення теми заняття" : $"Редагування теми #{topicForm.Id}")"
                      Subtitle="Вкажіть код у форматі 1.1.1.1 та заповніть параметри теми."
                      CssClass="topic-editor"
                      Busy="@IsModalBusy"
                      OnClose="@CloseTopicEditor">
        @if (_refreshRecoveryRequired)
        {
            <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                <span>@_refreshRecoveryMessage</span>
                <button type="button" class="btn btn-sm btn-outline-dark" @onclick="RetryRefreshAsync" disabled="@_refreshRecoveryInProgress">
                    @(_refreshRecoveryInProgress ? "Оновлення…" : "Повторити оновлення")
                </button>
            </div>
        }
        <fieldset class="border-0 p-0 m-0" disabled="@IsPageInteractionBlocked">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="form-label text-nowrap" for="module-topic-code">Код заняття</label>
                    <input id="module-topic-code" class="form-control" @bind="topicCodeInput" />
                </div>
                <div class="col-12 col-lg-4">
                    <label class="form-label text-nowrap" for="module-topic-type">Тип заняття</label>
                    <select id="module-topic-type" class="form-select" @bind="topicForm.LessonTypeId">
                        <option value="0">- Оберіть тип заняття -</option>
                        @foreach (var lt in lessonTypes)
                        {
                            <option value="@lt.Id">@lt.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-4">
                    <label class="form-label text-nowrap" for="module-topic-department">Кафедра</label>
                    <select id="module-topic-department" class="form-select"
                            value="@topicForm.DepartmentId"
                            @onchange="e => topicForm.DepartmentId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : (int?)null">
                        <option value="">— Не вказано —</option>
                        @foreach (var dep in departments.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@dep.Id" selected="@(topicForm.DepartmentId == dep.Id)">@dep.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-nowrap" for="module-topic-auditorium">Годин аудиторних</label>
                    <input id="module-topic-auditorium" type="number" min="0" class="form-control" @bind="topicForm.AuditoriumHours" @bind:after="SyncTotalHours" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-nowrap" for="module-topic-self-study">Годин самостійних</label>
                    <input id="module-topic-self-study" type="number" min="0" class="form-control" @bind="topicForm.SelfStudyHours" @bind:after="SyncTotalHours" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-nowrap" for="module-topic-total">Всього</label>
                    <input id="module-topic-total" type="number" min="0" class="form-control" value="@topicForm.TotalHours" readonly />
                </div>
            </div>
            <div class="editor-actions">
                <button type="button" class="btn btn-primary" @onclick="SaveTopic" disabled="@(IsPageInteractionBlocked || !plansModuleId.HasValue)">Зберегти заняття</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearTopicForm" disabled="@(IsPageInteractionBlocked || !plansModuleId.HasValue)">Очистити поля</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseTopicEditor" disabled="@IsPageInteractionBlocked">Скасувати</button>
            </div>
        </fieldset>
    </AdminEditorModal>
}

@code {

    private string? error, ok;
    private IBrowserFile? importFile;
    private DocxImportResultDto? importResult;
    private bool importBusy;
    private string? importError;
    private string? importOk;
    private bool clearBusy;
    private string? clearError;
    private string? clearOk;
    private List<ModuleEditDto> items = new();
    private ModuleEditDto form = NewModuleForm();
    private bool moduleEditorOpen;
    private bool moduleSaving;
    private bool _pageMutationInProgress;
    private readonly LatestAsyncRequestGuard _pageLoadGuard = new();
    private bool _pageLoadInProgress;
    private bool _refreshRecoveryRequired;
    private bool _refreshRecoveryInProgress;
    private string? _refreshRecoveryMessage;
