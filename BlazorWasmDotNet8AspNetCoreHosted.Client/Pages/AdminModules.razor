    // Відкриває панель планів для обраного модуля та завантажує дані.
    private async Task OpenPlans(ModuleEditDto m)
    {
        if (!m.Id.HasValue || !TryBeginPageMutation()) return;

        _plansBusy = true;
        try
        {
            ok = null;
            error = null;
            plansModuleId = m.Id;
            _planFocusPending = true;
            plansModuleTitle = $"{m.Code} - {m.Title}";
            plansModuleCode = m.Code ?? string.Empty;
            planCourseIds = ModuleCourseIds(m);
            selectedPlanCourseId = planCourseIds.FirstOrDefault();
            var moduleCredits = m.Credits;
            if (plansModuleId is int moduleId && selectedPlanCourseId > 0)
            {
                if (!await EnsurePlanModuleSeparated(moduleId, selectedPlanCourseId, moduleCredits))
                {
                    return;
                }

                var activeModuleId = plansModuleId ?? moduleId;
                if (!await LoadPlanContext(activeModuleId, selectedPlanCourseId, moduleCredits))
                {
                    RequireRefreshRecovery(
                        $"Не вдалося завантажити план модуля: {_lastLoadError ?? "невідома помилка"}.",
                        "Дані плану модуля завантажено.",
                        () => LoadPlanContext(activeModuleId, selectedPlanCourseId, moduleCredits));
                    return;
                }
            }
            else
            {
                var normalizedHours = (int)Math.Round(Math.Max(0m, moduleCredits) * 30m);
                planCourse = new PlanCourseVM
                {
                    CourseId = 0,
                    TargetHours = normalizedHours,
                    Credits = moduleCredits,
                    ScheduledHours = 0,
                    IsActive = true
                };
                if (plansModuleId is int id && !await LoadTopics(id))
                {
                    RequireRefreshRecovery(
                        $"Не вдалося завантажити теми модуля: {_lastLoadError ?? "невідома помилка"}.",
                        "Дані плану модуля завантажено.",
                        () => LoadTopics(id));
                    return;
                }
                ResetTopicForm(plansModuleId ?? 0);
            }
            ok = "Дані плану модуля завантажено.";
        }
        catch (Exception ex)
        {
            RequirePlanContextRecovery(
                $"Не вдалося підготувати план модуля: {ex.Message}. Дані плану заблоковано до успішного оновлення.",
                m.Id.Value,
                selectedPlanCourseId > 0 ? selectedPlanCourseId : m.CourseId,
                m.Credits);
        }
        finally
        {
            _plansBusy = false;
            EndPageMutation();
        }
    }
