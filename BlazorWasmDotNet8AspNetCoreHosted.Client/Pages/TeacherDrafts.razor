    private bool NavigateToCurrentContext()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["weekStart"] = _weekStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["courseId"] = _courseId,
            ["teacherId"] = _teacherId,
            ["groupId"] = _groupId,
            ["roomId"] = _roomId
        });
        if (string.Equals(uri, Nav.Uri, StringComparison.Ordinal))
