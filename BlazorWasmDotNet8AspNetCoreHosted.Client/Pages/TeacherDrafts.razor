    private DraftValidationReportDto? ParseWarningReport(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        try
        {
            return JsonSerializer.Deserialize<DraftValidationReportDto>(raw, WarningJsonOptions);
        }
        catch
        {
            return null;
        }
    }
    private static (int errors, int warnings) CountIssues(DraftValidationReportDto report)
    {
        var errors = report.Issues.Count(i => string.Equals(i.Severity, "error", StringComparison.OrdinalIgnoreCase));
        var warnings = report.Issues.Count(i => string.Equals(i.Severity, "warning", StringComparison.OrdinalIgnoreCase));
        return (errors, warnings);
    }
    private bool HasReportedIssues(TeacherDraftItemDto item)
        => _warningReports.TryGetValue(item.Id, out var report) && report.Issues.Count > 0;
    private (int critical, int warnings) CountAllKnownIssues()
    {
        var critical = _publishWarnings.Count;
        var warnings = 0;
        var visibleWeekIssues = VisibleWeekValidationIssues;
        if (visibleWeekIssues.Count > 0)
        {
            var weekCounts = CountIssues(new DraftValidationReportDto(
                _weekValidationReport?.GeneratedAt ?? DateTimeOffset.UtcNow,
                visibleWeekIssues));
            critical += weekCounts.errors;
            warnings += weekCounts.warnings;
        }
        foreach (var report in _warningReports.Values)
        {
            var counts = CountIssues(report);
            critical += counts.errors;
            warnings += counts.warnings;
        }
        return (critical, warnings);
    }
    private static string FormatRecordCount(int count)
    {
        var lastTwoDigits = count % 100;
        var lastDigit = count % 10;
        var word = lastTwoDigits is >= 11 and <= 14
            ? "записів"
            : lastDigit switch
            {
                1 => "запис",
                2 or 3 or 4 => "записи",
                _ => "записів"
            };
        return $"{count} {word}";
    }
    private void ToggleWarningPanel(int itemId)
    {
        if (_expandedWarningSlots.Contains(itemId))
            _expandedWarningSlots.Remove(itemId);
