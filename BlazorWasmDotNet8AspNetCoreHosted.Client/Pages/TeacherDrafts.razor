    // Повертає підпис для модуля.
    private string ResolveModuleLabel(int? moduleId)
    {
        if (moduleId is not int id) return "без змін";
        var module = FindModule(id);
        return module is null ? $"#{id}" : ModuleOptionCaption(module);
    }
    private string ResolveTopicListLabel(int? moduleId, IReadOnlyCollection<int> topicIds)
    {
        if (topicIds.Count == 0) return "без змін";
        if (moduleId is not int mid) return string.Join(", ", topicIds.Select(id => $"#{id}"));
        var labels = OrderedTopicsForModule(mid)
            .Where(t => topicIds.Contains(t.Id))
            .Select(TopicOptionCaption)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();
        return labels.Count == 0 ? "без змін" : string.Join(", ", labels);
    }
    // Виконує масове оновлення викладача/аудиторії/модуля/тем для обраних пар.
    private async Task ApplyBulkEditAsync()
    {
        if (IsDraftMutationBusy) return;
        _ok = _err = null;
        if (_meta is null)
        {
            _err = "Метадані не завантажені.";
            return;
        }
        if (_bulkSelectedIds.Count == 0)
        {
            _err = "Оберіть хоча б одну пару.";
            return;
        }
        var selectedItems = _items.Where(i => _bulkSelectedIds.Contains(i.Id)).ToList();
        if (selectedItems.Count == 0)
        {
            _err = "Обрані пари не знайдені у поточному тижні.";
            return;
        }
        if (selectedItems.Any(item => item.Status != DraftStatusDto.Draft))
        {
            _err = "Схвалені заняття не можна масово редагувати. Видаліть їх у режимі без обмежень або опублікуйте без змін.";
            return;
        }
        if (selectedItems.Select(i => i.DayNumber).Distinct().Count() > 1)
        {
            _err = "Не можна редагувати пари з різних днів.";
            return;
        }
        var effectiveModuleId = ResolveEffectiveBulkModuleId();
        var orderedBulkTopicIds = effectiveModuleId is int moduleIdForTopics
            ? OrderedTopicIdsForModule(moduleIdForTopics, _bulkTopicIds)
            : new List<int>();
        if (_bulkTopicIds.Count > 0 && effectiveModuleId is null)
        {
            _err = "Щоб змінити теми, оберіть модуль або пари лише з одного модуля.";
            return;
        }
        if (effectiveModuleId is int moduleIdForValidation
            && orderedBulkTopicIds.Count > 1
            && !TopicsShareSingleLessonType(moduleIdForValidation, orderedBulkTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        var moduleWillChange = _bulkModuleId is int;
        var topicsWillChange = orderedBulkTopicIds.Count > 0;
        if (_bulkTeacherIds.Count == 0 && _bulkRoomId is null && !moduleWillChange && !topicsWillChange)
        {
            _err = "Оберіть, що саме змінювати: викладачів, аудиторію, модуль або теми.";
            return;
        }
        var dayLabel = DayToDate(selectedItems.First().DayNumber).ToString("dd.MM.yyyy");
        var moduleLabel = ResolveModuleLabel(_bulkModuleId ?? effectiveModuleId);
        var confirmText = $"Застосувати зміни до {selectedItems.Count} пар за {dayLabel}? " +
                          $"Викладачі: {ResolveTeacherListLabel()}. " +
                          $"Аудиторія: {ResolveRoomLabel(_bulkRoomId)}. " +
                          $"Модуль: {moduleLabel}. " +
                          $"Теми: {ResolveTopicListLabel(effectiveModuleId, orderedBulkTopicIds)}.";
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed) return;
        _bulkApplying = true;
        var updated = 0;
        var skipped = 0;
        var skippedLocked = 0;
        var processedSlots = new HashSet<string>(StringComparer.Ordinal);
        var upsertRequests = new List<DraftUpsertRequest>();
        var deleteIds = new HashSet<int>();
        try
        {
            foreach (var item in selectedItems)
            {
                var slotKey = BuildBulkSlotKey(item);
                if (!processedSlots.Add(slotKey))
                {
                    continue;
                }
                if (IsBreak(item) || IsCanceled(item))
                {
                    skipped++;
                    continue;
                }
                var batch = TeacherDraftEditMutationPlanner
                    .SelectLogicalEventRows(_items, item)
                    .ToList();
                if (batch.Count == 0)
                {
                    skipped++;
                    continue;
                }
                if (!_unrestrictedMode && batch.Any(x => x.IsLocked))
                {
                    skippedLocked++;
                    continue;
                }
                if (batch.Any(x => x.Status != DraftStatusDto.Draft))
                {
                    _err = "Логічне заняття містить схвалені рядки й не може бути змінене частково.";
                    return;
                }
                var targetModuleId = _bulkModuleId ?? item.ModuleId;
                var topicIdsForSlot = orderedBulkTopicIds.Count == 0
                    ? _bulkModuleId is int
                        ? new List<int?> { null }
                        : batch
                            .OrderBy(entry => entry.Id)
                            .Select(entry => entry.ModuleTopicId)
                            .Distinct()
                            .ToList()
                    : orderedBulkTopicIds.Select(id => (int?)id).ToList();
                var newRoomId = _bulkRoomId ?? item.RoomId;
                var desiredTeachers = (_bulkTeacherIds.Count > 0
                        ? _bulkTeacherIds.Select(id => (int?)id)
                        : batch.OrderBy(entry => entry.Id).Select(entry => entry.TeacherId))
                    .Distinct()
                    .OrderBy(id => id is null ? 0 : 1)
                    .ThenBy(id => id)
                    .ToList();
                var batchKey = item.BatchKey ?? $"bulk-{Guid.NewGuid():N}";
                var plan = TeacherDraftEditMutationPlanner.BuildReplacementPlan(
                    batch.Select(entry => new TeacherDraftEditExistingRow(
                            entry.Id,
                            entry.ModuleTopicId,
                            entry.TeacherId))
                        .ToList(),
                    topicIdsForSlot,
                    desiredTeachers);
                foreach (var targetRow in plan.TargetRows)
                {
                    var source = targetRow.ExistingId is int existingId
                        ? batch.First(entry => entry.Id == existingId)
                        : item;
                    var slot = BuildSlotKey(source);
                    var request = ApplyTopicToRequest(BuildUpsertRequest(source, slot, ignoreValidation: true) with
                    {
                        Id = targetRow.ExistingId,
                        TeacherId = targetRow.TeacherId,
                        RoomId = newRoomId,
                        ModuleId = targetModuleId,
                        BatchKey = batchKey,
                        IgnoreValidationErrors = true
                    }, targetRow.ModuleTopicId);
                    upsertRequests.Add(request);
                }
                deleteIds.UnionWith(plan.DeleteIds);
            }
            if (upsertRequests.Count + deleteIds.Count > BatchMutationLimit)
            {
                _err = $"Одна масова операція може змінити й видалити загалом не більше {BatchMutationLimit} чернеток. Зменште вибір і повторіть спробу.";
                return;
            }
            updated = 0;
            if (upsertRequests.Count > 0 || deleteIds.Count > 0)
            {
                var mutationResult = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
                    upsertRequests,
                    deleteIds.OrderBy(id => id).ToList(),
                    Confirm: true,
                    Unrestricted: _unrestrictedMode));
                updated = mutationResult.Upserted + mutationResult.Deleted;
            }
            _ok = $"Оновлено пар: {updated}. Пропущено: {skipped}.";
            if (skippedLocked > 0)
            {
                _ok += $" Заблокованих: {skippedLocked}.";
            }
            await ReloadDraftItemsOnlyAsync();
            ClearBulkSelection();
            CloseBulkEdit();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _bulkApplying = false;
        }
    }
    // Формує ключ слоту для уникнення дублювання під час масового редагування.
    private static string BuildBulkSlotKey(TeacherDraftItemDto item)
        => string.IsNullOrWhiteSpace(item.BatchKey)
            ? $"id:{item.Id}"
            : $"b:{item.BatchKey}|{item.Date:yyyyMMdd}|{item.TimeStart}|{item.TimeEnd}|g{item.GroupId}|m{item.ModuleId}|lt{item.LessonTypeId}";
    // Формує підпис списку викладачів.
    private string ResolveTeacherListLabel()
    {
        if (_bulkTeacherIds.Count == 0) return "без змін";
        if (_meta is null) return string.Join(", ", _bulkTeacherIds);
        var labels = _meta.Teachers
            .Where(t => _bulkTeacherIds.Contains(t.Id))
            .Select(t => t.Name)
            .ToList();
        return labels.Count == 0 ? "без змін" : string.Join(", ", labels);
    }
    private SlotKey BuildSlotKey(TeacherDraftItemDto item)
        => new(item.DayNumber, item.TimeStart, item.TimeEnd, item.GroupId);
    private DraftUpsertRequest BuildUpsertRequest(TeacherDraftItemDto item, SlotKey slot, bool ignoreValidation)
        => NormalizeRequest(new(
            Id: item.Id,
            Date: DayToDate(slot.DayNumber),
            TimeStart: slot.Start,
            TimeEnd: slot.End,
            GroupId: slot.GroupId,
            ModuleId: item.ModuleId,
            ModuleTopicId: item.ModuleTopicId,
            TeacherId: item.TeacherId,
            RoomId: item.RoomId,
            RequiresRoom: item.RequiresRoom,
            LessonTypeId: item.LessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: item.BatchKey,
            IsLocked: item.IsLocked,
            IgnoreValidationErrors: ignoreValidation,
            IsSelfStudy: item.IsSelfStudy
        ));
    // Старт перетягування елемента розкладу.
    private void OnItemDragStart(SlotKey origin, TeacherDraftItemDto? item, DragEventArgs e)
    {
        if (!CanDragItem(item))
        {
            return;
        }
        var snapshot = item! with { };
        _dragPayload = new DragPayload(item.Id, origin, snapshot);
        _dragHover = origin;
        if (e.DataTransfer is not null)
        {
            e.DataTransfer.DropEffect = "move";
            e.DataTransfer.EffectAllowed = "move";
        }
    }
    private void OnItemDragEnd()
    {
        _dragPayload = null;
        _dragHover = null;
        _isProcessingDrop = false;
        StateHasChanged();
    }
    private void OnSlotDragEnter(SlotKey key, TeacherDraftItemDto? target)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        if (target is not null
            && target.Id != _dragPayload.ItemId
            && (target.IsLocked || target.Status != DraftStatusDto.Draft))
        {
            return;
        }
        if (_dragHover != key)
        {
            _dragHover = key;
            StateHasChanged();
        }
    }
    private void OnSlotDragLeave(SlotKey key)
    {
        if (_dragHover is { } hover && hover == key)
        {
            _dragHover = null;
            StateHasChanged();
        }
    }
    private void OnSlotDragOver(SlotKey key, TeacherDraftItemDto? target, DragEventArgs e)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        if (target is not null
            && target.Id != _dragPayload.ItemId
            && (target.IsLocked || target.Status != DraftStatusDto.Draft))
        {
            return;
        }
        if (e.DataTransfer is not null)
        {
            e.DataTransfer.DropEffect = "move";
        }
        if (_dragHover != key)
        {
            _dragHover = key;
            StateHasChanged();
        }
    }
    // Обробляє скидання у слот (переміщення або обмін).
    private async Task OnSlotDropAsync(SlotKey targetKey, TeacherDraftItemDto? targetItem)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        var sourceItem = _items.FirstOrDefault(x => x.Id == _dragPayload.ItemId) ?? _dragPayload.Snapshot;
        if (sourceItem is null)
        {
            return;
        }
        if (targetItem?.IsLocked == true && targetItem.Id != sourceItem.Id)
        {
            _err = "Неможливо перенести пару у заблокований слот.";
            _dragHover = null;
            StateHasChanged();
            return;
        }
        if (_dragPayload.Origin == targetKey || targetItem?.Id == sourceItem.Id)
        {
            return;
        }
        _ok = null;
        _err = null;
        _isProcessingDrop = true;
        try
        {
            if (targetItem is null)
            {
                await MoveItemAsync(sourceItem, targetKey);
            }
            else
            {
                await SwapItemsAsync(sourceItem, targetItem, targetKey);
            }
            await ReloadDraftItemsOnlyAsync();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _dragPayload = null;
            _dragHover = null;
            _isProcessingDrop = false;
            StateHasChanged();
        }
    }
    private async Task MoveItemAsync(TeacherDraftItemDto sourceItem, SlotKey targetKey)
    {
        var weekItems = await DraftsApi.GetWeek(FirstMonday(sourceItem.Date), null);
        var currentSource = ResolveCurrentLogicalEventSource(weekItems, sourceItem);
        var sourceRows = ResolveMovableLogicalEventRows(weekItems, currentSource);
        var target = new TeacherDraftRelocationTarget(
            DayToDate(targetKey.DayNumber),
            targetKey.Start,
            targetKey.End,
            targetKey.GroupId);
        var requests = TeacherDraftEditMutationPlanner
            .BuildRelocationRequests(sourceRows, target, _unrestrictedMode)
            .Select(NormalizeRequest)
            .ToList();
        var result = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
            requests,
            new List<int>(),
            Confirm: true,
            Unrestricted: _unrestrictedMode));
        EnsureCompleteRelocationResult(result, requests.Count);
    }
    private async Task SwapItemsAsync(TeacherDraftItemDto sourceItem, TeacherDraftItemDto targetItem, SlotKey targetKey)
    {
        var weekItems = await DraftsApi.GetWeek(FirstMonday(sourceItem.Date), null);
        var currentSource = ResolveCurrentLogicalEventSource(weekItems, sourceItem);
        var currentTarget = ResolveCurrentLogicalEventSource(weekItems, targetItem);
        var sourceRows = ResolveMovableLogicalEventRows(weekItems, currentSource);
        var targetRows = ResolveMovableLogicalEventRows(weekItems, currentTarget);
        if (sourceRows.Select(row => row.Id).Intersect(targetRows.Select(row => row.Id)).Any())
        {
            return;
        }
        var sourceTarget = new TeacherDraftRelocationTarget(
            currentTarget.Date,
            currentTarget.TimeStart,
            currentTarget.TimeEnd,
            currentTarget.GroupId);
        var targetTarget = new TeacherDraftRelocationTarget(
            currentSource.Date,
            currentSource.TimeStart,
            currentSource.TimeEnd,
            currentSource.GroupId);
        // Проміжні колізії допустимі лише всередині транзакції; сервер повторно перевіряє кінцевий стан перед її фіксацією.
        var requests = TeacherDraftEditMutationPlanner
            .BuildRelocationRequests(sourceRows, sourceTarget, ignoreValidationErrors: true)
            .Concat(TeacherDraftEditMutationPlanner.BuildRelocationRequests(
                targetRows,
                targetTarget,
                ignoreValidationErrors: true))
            .Select(NormalizeRequest)
            .ToList();
        var result = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
            requests,
            new List<int>(),
            Confirm: true,
            Unrestricted: _unrestrictedMode));
        EnsureCompleteRelocationResult(result, requests.Count);
    }

    // Перевіряє, що рядок не змінився в іншому вікні після початку перетягування.
    private static TeacherDraftItemDto ResolveCurrentLogicalEventSource(
        IReadOnlyList<TeacherDraftItemDto> weekItems,
        TeacherDraftItemDto snapshot)
    {
        var current = weekItems.FirstOrDefault(item => item.Id == snapshot.Id)
            ?? throw new InvalidOperationException($"Пара #{snapshot.Id} вже не існує. Оновіть таблицю.");
        if (!TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(snapshot, current))
        {
            throw new InvalidOperationException($"Пара #{snapshot.Id} була змінена в іншому вікні. Оновіть таблицю перед перенесенням.");
        }
        return current;
    }

    // Повертає повний незаблокований пакет рядків для атомарного перенесення.
    private static List<TeacherDraftItemDto> ResolveMovableLogicalEventRows(
        IReadOnlyList<TeacherDraftItemDto> weekItems,
        TeacherDraftItemDto source)
    {
        var rows = TeacherDraftEditMutationPlanner
            .SelectLogicalEventRows(weekItems, source)
            .ToList();
        if (rows.Count == 0)
        {
            throw new InvalidOperationException("Не знайдено рядків логічного заняття для перенесення.");
        }
        if (rows.Any(row => row.IsLocked || row.Status != DraftStatusDto.Draft))
        {
            throw new InvalidOperationException("Логічне заняття містить зафіксовані або схвалені рядки й не може бути перенесене частково.");
        }
        return rows;
    }

    // Не приймає часткову відповідь сервера як успішне перенесення.
    private static void EnsureCompleteRelocationResult(TeacherDraftBatchMutationResult result, int expectedCount)
    {
        if (result.Upserted != expectedCount
            || result.UpsertedIds.Count != expectedCount
            || result.Deleted != 0)
        {
            throw new InvalidOperationException("Сервер повернув неповний результат атомарного перенесення.");
        }
    }
    private static string GetStatusBadgeCss(DraftStatusDto status) => status switch
    {
        DraftStatusDto.Published => "badge-published",
        _ => "badge-draft"
    };
    private static string FormatStatus(DraftStatusDto status) => status switch
    {
        DraftStatusDto.Published => "Схвалено",
        _ => "Чернетка"
    };
    // Зберігає поточну чернетку та додаткові дублікати.
    private async Task SaveEdit()
    {
        if (_edit is null || IsDraftMutationBusy) return;
        _ok = _err = null;
        var lessonTypeId = _edit.LessonTypeId;
        if (lessonTypeId <= 0)
        {
            var fallbackLessonTypeId = NoneLessonTypeId;
            if (fallbackLessonTypeId is null)
            {
                _err = "Не знайдено тип заняття \"Без типу\". Оновіть довідник типів занять.";
                return;
            }
            lessonTypeId = fallbackLessonTypeId.Value;
        }
        if (!TryBeginDraftMutation())
        {
            return;
        }
        try
        {
            var requestsToUpsert = new List<DraftUpsertRequest>();
            var deleteIds = new HashSet<int>();
            var primaryCount = 0;
            var isNewDraft = _edit.Id is null;
            var orderedTopicIds = ResolveOrderedEditTopicIds();
            if (IsFinalAssessment(lessonTypeId))
            {
                orderedTopicIds.Clear();
            }
            if (orderedTopicIds.Count > 1
                && !TopicsShareSingleLessonType(_edit.ModuleId, orderedTopicIds, out _))
            {
                _err = MixedTopicLessonTypeError;
                return;
            }
            var primaryTopicId = orderedTopicIds.Count == 0 ? (int?)null : orderedTopicIds[0];
            var payload = ApplyTopicToRequest(_edit with
            {
                LessonTypeId = lessonTypeId,
                ModuleTopicId = primaryTopicId,
                IgnoreValidationErrors = _unrestrictedMode
            }, primaryTopicId);
            var existingLogicalEventRows = new List<TeacherDraftItemDto>();
            if (!isNewDraft)
            {
                if (_editSourceItem is null || _editSourceItem.Id != _edit.Id)
                {
                    _err = "Не вдалося визначити вихідне логічне заняття. Закрийте редактор, оновіть таблицю та повторіть спробу.";
                    return;
                }
                var currentWeekItems = await DraftsApi.GetWeek(FirstMonday(_editSourceItem.Date), null);
                var currentSourceItem = currentWeekItems.FirstOrDefault(item => item.Id == _editSourceItem.Id);
                if (currentSourceItem is null)
                {
                    _err = $"Пара #{_editSourceItem.Id} вже не існує. Оновіть таблицю.";
                    return;
                }
                if (!TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(_editSourceItem, currentSourceItem))
                {
                    _err = $"Пара #{_editSourceItem.Id} була змінена в іншому вікні. Закрийте редактор та оновіть таблицю.";
                    return;
                }
                existingLogicalEventRows = TeacherDraftEditMutationPlanner
                    .SelectLogicalEventRows(currentWeekItems, _editSourceItem)
                    .ToList();
                if (existingLogicalEventRows.Count == 0)
                {
                    _err = "Не знайдено рядків вихідного логічного заняття. Оновіть таблицю.";
                    return;
                }
                if (existingLogicalEventRows.Any(item => item.IsLocked))
                {
                    _err = "Логічне заняття містить зафіксовані рядки й не може бути змінене частково.";
                    return;
                }
            }
            var slotRange = isNewDraft
                ? ResolveSlotRange(payload.Date, payload.TimeStart, payload.TimeEnd)
                : new List<SlotRow>();
            var hasRange = isNewDraft && slotRange.Count > 1;
            var extraGroupIds = isNewDraft
                ? _extraGroups.Select(x => x.GroupId).Where(id => id is > 0).Select(id => id!.Value).Distinct().ToList()
                : new List<int>();
            var extraTeacherIds = isNewDraft
                ? _extraTeachers.Select(x => x.TeacherId).Where(id => id is > 0).Select(id => id!.Value).Distinct().ToList()
                : new List<int>();
            var hasExtras = isNewDraft && (extraGroupIds.Count > 0 || extraTeacherIds.Count > 0);
            var existingBatchKey = string.IsNullOrWhiteSpace(payload.BatchKey) ? null : payload.BatchKey;
            var resolvedBatchKey = (hasExtras || hasRange || orderedTopicIds.Count > 1)
                ? (existingBatchKey ?? $"clone-{Guid.NewGuid():N}")
                : existingBatchKey;
            var singleSlotTopicIds = orderedTopicIds.Count == 0
                ? new List<int?> { primaryTopicId }
                : orderedTopicIds.Select(id => (int?)id).ToList();
            if (!hasRange)
            {
                var firstTopicId = singleSlotTopicIds[0];
                var primaryRequest = ApplyTopicToRequest(payload with { BatchKey = resolvedBatchKey }, firstTopicId);
                if (!isNewDraft)
                {
                    var editPlan = TeacherDraftEditMutationPlanner.BuildPlan(
                        existingLogicalEventRows
                            .Select(item => new TeacherDraftEditExistingRow(item.Id, item.ModuleTopicId, item.TeacherId))
                            .ToList(),
                        singleSlotTopicIds,
                        _editSourceItem!.TeacherId,
                        payload.TeacherId);
                    foreach (var targetRow in editPlan.TargetRows)
                    {
                        var request = ApplyTopicToRequest(payload with
                        {
                            Id = targetRow.ExistingId,
                            ModuleTopicId = targetRow.ModuleTopicId,
                            TeacherId = targetRow.TeacherId,
                            BatchKey = resolvedBatchKey,
                            IgnoreValidationErrors = true
                        }, targetRow.ModuleTopicId);
                        requestsToUpsert.Add(request);
                    }
                    deleteIds.UnionWith(editPlan.DeleteIds);
                }
                else if (!hasExtras)
                {
                    for (var topicIndex = 0; topicIndex < singleSlotTopicIds.Count; topicIndex++)
                    {
                        var topicIdForRequest = singleSlotTopicIds[topicIndex];
                        var request = ApplyTopicToRequest(primaryRequest with
                        {
                            Id = null,
                            BatchKey = resolvedBatchKey ?? primaryRequest.BatchKey ?? $"clone-{Guid.NewGuid():N}",
                            IgnoreValidationErrors = topicIndex > 0 || _unrestrictedMode
                        }, topicIdForRequest);
                        requestsToUpsert.Add(request);
                    }
                }
                else
                {
                    foreach (var topicIdForRequest in singleSlotTopicIds)
                    {
                        var topicRequest = ApplyTopicToRequest(primaryRequest with
                        {
                            Id = null,
                            BatchKey = resolvedBatchKey ?? primaryRequest.BatchKey ?? $"clone-{Guid.NewGuid():N}"
                        }, topicIdForRequest);
                        var requests = BuildDuplicateRequests(topicRequest, extraGroupIds, extraTeacherIds);
                        requestsToUpsert.AddRange(requests);
                        primaryCount += requests.Count(request => IsPrimaryRequest(request, topicRequest));
                    }
                }
            }
            else
            {
                var slotTopicIds = orderedTopicIds.Count == 0
                    ? new List<int?> { primaryTopicId }
                    : orderedTopicIds.Select(id => (int?)id).ToList();
                for (var slotIndex = 0; slotIndex < slotRange.Count; slotIndex++)
                {
                    var slot = slotRange[slotIndex];
                    foreach (var slotTopicId in slotTopicIds)
                    {
                        var slotRequest = ApplyTopicToRequest(payload with
                        {
                            Id = null,
                            BatchKey = resolvedBatchKey,
                            TimeStart = slot.Start,
                            TimeEnd = slot.End,
                            ModuleTopicId = slotTopicId
                        }, slotTopicId);
                        var requests = BuildDuplicateRequests(slotRequest, extraGroupIds, extraTeacherIds);
                        requestsToUpsert.AddRange(requests);
                        primaryCount += requests.Count(request => IsPrimaryRequest(request, slotRequest));
                    }
                }
            }
            if (requestsToUpsert.Count == 0)
            {
                _err = "Немає чернеток для збереження.";
                return;
            }
            if (requestsToUpsert.Count + deleteIds.Count > BatchMutationLimit)
            {
                _err = $"За одну операцію можна змінити загалом не більше {BatchMutationLimit} чернеток. Зменште діапазон, кількість тем або дублів.";
                return;
            }
            List<int> upsertedIds;
            int processed;
            var deleted = 0;
            if (isNewDraft)
            {
                var batchResult = await DraftsApi.UpsertBatch(new TeacherDraftBatchUpsertRequest(
                    requestsToUpsert,
                    Unrestricted: _unrestrictedMode));
                upsertedIds = batchResult.Ids;
                processed = batchResult.Processed;
            }
            else
            {
                var mutationResult = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
                    requestsToUpsert,
                    deleteIds.OrderBy(id => id).ToList(),
                    Confirm: true,
                    Unrestricted: _unrestrictedMode));
                upsertedIds = mutationResult.UpsertedIds;
                processed = mutationResult.Upserted;
                deleted = mutationResult.Deleted;
            }
            if (upsertedIds.Count != requestsToUpsert.Count
                || processed != requestsToUpsert.Count
                || deleted != deleteIds.Count)
            {
                throw new InvalidOperationException("Сервер повернув неповний результат атомарного збереження.");
            }
            var createdItemsForLog = new List<CreatedDraftLogItem>();
            if (isNewDraft)
            {
                for (var requestIndex = 0; requestIndex < requestsToUpsert.Count; requestIndex++)
                {
                    var request = requestsToUpsert[requestIndex];
                    if (request.Id is null)
                    {
                        createdItemsForLog.Add(new CreatedDraftLogItem(upsertedIds[requestIndex], request));
                    }
                }
            }
            if (!isNewDraft)
            {
                _ok = deleted > 0
                    ? $"Логічне заняття синхронізовано: збережено {processed} рядків, видалено зайвих — {deleted}."
                    : $"Логічне заняття синхронізовано: збережено {processed} рядків.";
            }
            else if (!hasRange && !hasExtras)
            {
                _ok = processed == 1
                    ? $"Збережено (Id = {upsertedIds[0]})."
                    : $"Збережено {processed} пар.";
            }
            else
            {
                var extraCount = processed - primaryCount;
                var suffix = extraCount > 0 ? $" (+{extraCount} дубль.)" : string.Empty;
                _ok = $"Збережено {primaryCount} пар{suffix}.";
            }
            _extraGroups.Clear();
            _extraTeachers.Clear();
            await ReloadDraftItemsOnlyAsync();
            CancelEdit();
            await LogManualCreateAsync(createdItemsForLog);
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            EndDraftMutation();
        }
    }
    // Видаляє активну чернетку.
    private async Task DeleteEdit()
    {
        if (_edit?.Id is not int id)
        {
            _err = "Виберіть чернетку для видалення.";
            return;
        }
        var item = _items.FirstOrDefault(x => x.Id == id);
        if (item is null)
        {
            _err = $"Пара #{id} не знайдена у поточному списку.";
            return;
        }
        await DeleteSlotAsync(item);
    }
    private async Task DeleteItemAsync(TeacherDraftItemDto item)
    {
        if (_bulkSelectedIds.Count > 1 && _bulkSelectedIds.Contains(item.Id))
        {
            await DeleteSelectedItemsAsync();
            return;
        }
        await DeleteSlotAsync(item);
    }
    // Видаляє всі виділені пари одним підтвердженням.
    private async Task DeleteSelectedItemsAsync()
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        var selectedItems = _items
            .Where(x => _bulkSelectedIds.Contains(x.Id))
            .OrderBy(x => x.Date)
            .ThenBy(x => x.TimeStart)
            .ToList();
        if (selectedItems.Count == 0)
        {
            _err = "Не знайдено виділених пар для видалення.";
            return;
        }
        var lockedCount = selectedItems.Count(x => x.IsLocked);
        if (lockedCount > 0 && !_unrestrictedMode)
        {
            _err = $"Серед виділених пар є заблоковані ({lockedCount}). Увімкніть режим без обмежень або зніміть їх з вибору.";
            return;
        }
        var idsToDelete = new HashSet<int>();
        var deletedItemsMap = new Dictionary<int, TeacherDraftItemDto>();
        foreach (var selected in selectedItems)
        {
            var batch = CollectSlotItemsForDelete(selected);
            foreach (var entry in batch)
            {
                idsToDelete.Add(entry.Id);
                deletedItemsMap.TryAdd(entry.Id, entry);
            }
        }
        if (idsToDelete.Count == 0)
        {
            _err = "Не знайдено записів для видалення серед виділених пар.";
            return;
        }
        var confirmText = $"Видалити {selectedItems.Count} виділених пар? Буде видалено {idsToDelete.Count} записів. Цю дію неможливо скасувати.";
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed) return;
        if (!TryBeginDraftMutation())
        {
            return;
        }
        try
        {
            var deleteResult = await DraftsApi.DeleteBatch(new TeacherDraftBatchDeleteRequest(
                idsToDelete.OrderBy(id => id).ToList(),
                Unrestricted: _unrestrictedMode));
            _ok = $"Видалено {selectedItems.Count} виділених пар ({deleteResult.Deleted} записів).";
            _edit = null;
            _editSourceItem = null;
            _extraGroups.Clear();
            _extraTeachers.Clear();
            await LogManualDeleteAsync(
                deletedItemsMap.Values.ToList(),
                _ok ?? $"Видалено {selectedItems.Count} виділених пар ({idsToDelete.Count} записів).");
            await ReloadDraftItemsOnlyAsync();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            EndDraftMutation();
        }
    }
    // Видаляє всі записи пари в межах слоту та групи.
    private async Task DeleteSlotAsync(TeacherDraftItemDto item)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        var batch = CollectSlotItemsForDelete(item);
        if (batch.Count == 0)
        {
            _err = "Не знайдено записів для видалення.";
            return;
        }
        var confirmText = batch.Count == 1
            ? $"Видалити пару #{item.Id}? Цю дію неможливо скасувати."
            : $"Видалити пару та всіх викладачів у цьому слоті? Буде видалено {batch.Count} записів. Цю дію неможливо скасувати.";
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed) return;
        if (!TryBeginDraftMutation())
        {
            return;
        }
        try
        {
            var deleteResult = await DraftsApi.DeleteBatch(new TeacherDraftBatchDeleteRequest(
                batch.Select(entry => entry.Id).Distinct().OrderBy(id => id).ToList(),
                Unrestricted: _unrestrictedMode));
            _ok = deleteResult.Deleted == 1
                ? $"Видалено (Id = {item.Id})."
                : $"Видалено {deleteResult.Deleted} записів цієї пари.";
            _edit = null;
            _editSourceItem = null;
            _extraGroups.Clear();
            _extraTeachers.Clear();
            await LogManualDeleteAsync(
                batch,
                _ok ?? (batch.Count == 1 ? $"Видалено (Id = {item.Id})." : $"Видалено {batch.Count} записів цієї пари."));
            RemoveDraftItemsFromState(batch.Select(x => x.Id));
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            EndDraftMutation();
        }
    }
    // Збирає всі записи, що належать до однієї пари.
    private List<TeacherDraftItemDto> CollectSlotItems(TeacherDraftItemDto item)
        => _items
            .Where(x => IsSameSlot(item, x))
            .OrderBy(x => x.Id)
            .ToList();
    // Збирає всі записи пари для видалення незалежно від теми заняття.
    private List<TeacherDraftItemDto> CollectSlotItemsForDelete(TeacherDraftItemDto item)
        => _items
            .Where(x => IsSameSlotForDelete(item, x))
            .OrderBy(x => x.Id)
            .ToList();
    // Перевіряє, чи належать записи до одного слоту та групи.
    private static bool IsSameSlot(TeacherDraftItemDto left, TeacherDraftItemDto right)
        => left.Date == right.Date
           && left.TimeStart == right.TimeStart
           && left.TimeEnd == right.TimeEnd
           && left.GroupId == right.GroupId
           && left.ModuleId == right.ModuleId
           && left.LessonTypeId == right.LessonTypeId
           && left.RoomId == right.RoomId
           && left.IsSelfStudy == right.IsSelfStudy
           && left.ModuleTopicId == right.ModuleTopicId;
    // Перевіряє, чи належать записи до однієї пари без урахування теми.
    private static bool IsSameSlotForDelete(TeacherDraftItemDto left, TeacherDraftItemDto right)
        => left.Date == right.Date
           && left.TimeStart == right.TimeStart
           && left.TimeEnd == right.TimeEnd
           && left.GroupId == right.GroupId
           && left.ModuleId == right.ModuleId
           && left.LessonTypeId == right.LessonTypeId
           && left.RoomId == right.RoomId
           && left.IsSelfStudy == right.IsSelfStudy;
    // Узгоджене відображення помилок API та конфліктів.
    private async Task HandleApiError(ApiErrorException ex)
    {
        var headline = ComposeErrorHeadline(ex);
        _err = headline;
        if (ex.StatusCode == HttpStatusCode.Conflict && (ex.Errors.Count > 0 || ex.Warnings.Count > 0))
        {
            var expanded = _conflictStorage.TryGetValue(CurrentConflictKey, out var existing)
                ? existing.Expanded
                : true;
            var details = new ConflictDetails
            {
                Message = headline,
                Errors = ex.Errors.ToList(),
                Warnings = ex.Warnings.ToList(),
                SavedAt = DateTimeOffset.Now,
                Expanded = expanded
            };
            _conflictStorage[CurrentConflictKey] = details;
            _currentConflict = details;
            await PersistConflictsAsync();
        }
    }
    private static string ComposeErrorHeadline(ApiErrorException ex)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(ex.Message))
        {
            parts.Add(ex.Message.Trim());
        }
        var firstError = ex.Errors.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));
        if (!string.IsNullOrWhiteSpace(firstError))
        {
            parts.Add(firstError!.Trim());
        }
        else
        {
            var firstWarning = ex.Warnings.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
            if (!string.IsNullOrWhiteSpace(firstWarning))
            {
                parts.Add(firstWarning!.Trim());
            }
        }
        if (parts.Count == 0)
        {
            return string.IsNullOrWhiteSpace(ex.TraceId)
                ? "Сталася помилка."
                : $"Сталася помилка. Код запиту: {ex.TraceId}.";
        }
        var headline = parts.Count == 1 ? parts[0] : string.Join(": ", parts.Distinct(StringComparer.Ordinal));
        return string.IsNullOrWhiteSpace(ex.TraceId)
            ? headline
            : $"{headline} Код запиту: {ex.TraceId}.";
    }
    // Завантажує інформацію про конфлікти з локального сховища.
    private async Task LoadConflictsAsync()
    {
        if (_conflictsLoaded) return;
        _conflictsLoaded = true;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ConflictStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var data = JsonSerializer.Deserialize<Dictionary<string, ConflictDetails>>(json, ConflictJsonOptions);
                if (data is not null)
                {
                    _conflictStorage = data;
                }
            }
        }
        catch
        {
            _conflictStorage = new();
        }
    }
    // Зберігає конфлікти у локальне сховище браузера.
    private async Task PersistConflictsAsync()
    {
        try
        {
            if (_conflictStorage.Count == 0)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", ConflictStorageKey);
            }
            else
            {
                var json = JsonSerializer.Serialize(_conflictStorage, ConflictJsonOptions);
                await JS.InvokeVoidAsync("localStorage.setItem", ConflictStorageKey, json);
            }
        }
        catch
        {
        }
    }
    private void SyncCurrentConflict()
    {
        _conflictStorage.TryGetValue(CurrentConflictKey, out _currentConflict);
    }
    // Перемикає видимість деталей конфлікту.
    private async Task ToggleConflictDetails()
    {
        if (_currentConflict is null) return;
        _currentConflict.Expanded = !_currentConflict.Expanded;
        _conflictStorage[CurrentConflictKey] = _currentConflict;
        await PersistConflictsAsync();
    }
    // Очищає збережений конфлікт для поточного фільтра.
    private async Task ClearConflictDetails()
    {
        if (_conflictStorage.Remove(CurrentConflictKey))
        {
            _currentConflict = null;
            await PersistConflictsAsync();
        }
    }
    // Скидає стан редактора.
    private void CancelEdit()
    {
        _edit = null;
        _editSourceItem = null;
        _editTopicIds.Clear();
        _extraGroups.Clear();
        _extraTeachers.Clear();
    }
    // Додає додаткову групу для дублювання заняття.
    private void AddExtraGroup()
    {
        _extraGroups.Add(new ExtraGroupSelection());
    }
    private void RemoveExtraGroup(ExtraGroupSelection item)
    {
        _extraGroups.Remove(item);
    }
    // Додає додаткового викладача для всіх дубльованих груп.
    private void AddExtraTeacher()
    {
        _extraTeachers.Add(new ExtraTeacherSelection());
    }
    private void RemoveExtraTeacher(ExtraTeacherSelection item)
    {
        _extraTeachers.Remove(item);
    }
    private sealed class ExtraGroupSelection
    {
        public int? GroupId { get; set; }
    }
    private sealed class ExtraTeacherSelection
    {
        public int? TeacherId { get; set; }
    }
    // Формує список запитів для дублювання по групах і викладачах.
    private List<DraftUpsertRequest> BuildDuplicateRequests(
        DraftUpsertRequest baseRequest,
        IReadOnlyCollection<int> extraGroupIds,
        IReadOnlyCollection<int> extraTeacherIds)
    {
        var groupIds = new HashSet<int> { baseRequest.GroupId };
        foreach (var gid in extraGroupIds)
        {
            if (gid > 0)
            {
                groupIds.Add(gid);
            }
        }
        var teacherIds = new HashSet<int>(extraTeacherIds.Where(id => id > 0));
        if (baseRequest.TeacherId is int primaryTeacherId)
        {
            teacherIds.Remove(primaryTeacherId);
        }
        var requests = new List<DraftUpsertRequest>();
        foreach (var groupId in groupIds)
        {
            var primary = NormalizeRequest(baseRequest with { Id = null, GroupId = groupId });
            requests.Add(primary);
            foreach (var teacherId in teacherIds)
            {
                var extra = NormalizeRequest(primary with { Id = null, TeacherId = teacherId });
                requests.Add(extra);
            }
        }
        return requests;
    }
    private static bool IsPrimaryRequest(DraftUpsertRequest request, DraftUpsertRequest primaryTemplate)
    {
        return request.GroupId == primaryTemplate.GroupId
            && request.TeacherId == primaryTemplate.TeacherId
            && request.Date == primaryTemplate.Date
            && request.TimeStart == primaryTemplate.TimeStart
            && request.TimeEnd == primaryTemplate.TimeEnd;
    }
    // Записує у журнал ручне створення занять.
    private async Task LogManualCreateAsync(IReadOnlyCollection<CreatedDraftLogItem> createdItems)
    {
        if (createdItems.Count == 0)
        {
            return;
        }
        var ordered = createdItems
            .OrderBy(x => x.Request.Date)
            .ThenBy(x => x.Request.TimeStart, StringComparer.Ordinal)
            .ThenBy(x => x.Request.TimeEnd, StringComparer.Ordinal)
            .ThenBy(x => x.Request.GroupId)
            .ToList();
        var lessonsTrimmed = ordered.Count > LogLessonLimit;
        var lessons = ordered
            .Take(LogLessonLimit)
            .Select(BuildCreatedLesson)
            .ToList();
        var courseId = ResolveSingleCourseId(ordered);
        var summary = ordered.Count == 1
            ? "Створено 1 заняття вручну."
            : $"Створено {ordered.Count} занять вручну.";
        var entry = new AdminScheduleLogEntry(
            Id: Guid.NewGuid().ToString("N"),
            Timestamp: DateTimeOffset.Now,
            ActionCode: LogActionCreate,
            ActionLabel: "Створення заняття",
            Summary: summary,
            Success: true,
            Error: null,
            WeekStart: _weekStart.ToString("yyyy-MM-dd"),
            WeekEnd: _weekStart.AddDays(6).ToString("yyyy-MM-dd"),
            DaysPreset: null,
            AllowDaysOff: null,
            CourseId: courseId,
            CourseName: ResolveCourseName(courseId),
            ModuleHours: new List<AdminScheduleLogModuleHours>(),
            Warnings: new List<string>(),
            GapDetails: new List<AutoGenGapDetail>(),
            Lessons: lessons,
            LessonsTrimmed: lessonsTrimmed
        );
        await TryWriteScheduleLogAsync(entry);
    }
    private AdminScheduleLogLesson BuildCreatedLesson(CreatedDraftLogItem createdItem)
    {
        var request = createdItem.Request;
        return new AdminScheduleLogLesson(
            Id: createdItem.Id,
            Date: request.Date.ToString("yyyy-MM-dd"),
            TimeStart: request.TimeStart,
            TimeEnd: request.TimeEnd,
            Group: ResolveLookupName(_meta?.Groups, request.GroupId),
            Module: ResolveModuleName(request.ModuleId),
            Teacher: ResolveLookupName(_meta?.Teachers, request.TeacherId),
            Room: ResolveLookupName(_meta?.Rooms, request.RoomId),
            LessonType: ResolveLessonTypeName(request.LessonTypeId),
            Status: "Чернетка",
            Source: "Чернетка"
        );
    }
    // Записує у журнал ручне видалення занять.
    private async Task LogManualDeleteAsync(IReadOnlyCollection<TeacherDraftItemDto> deletedItems, string summary)
    {
        if (deletedItems.Count == 0)
        {
            return;
        }
        var ordered = deletedItems
            .OrderBy(x => x.Date)
            .ThenBy(x => x.TimeStart, StringComparer.Ordinal)
            .ThenBy(x => x.TimeEnd, StringComparer.Ordinal)
            .ThenBy(x => x.GroupId)
            .ThenBy(x => x.Id)
            .ToList();
        var lessonsTrimmed = ordered.Count > LogLessonLimit;
        var lessons = ordered
            .Take(LogLessonLimit)
            .Select(item => new AdminScheduleLogLesson(
                Id: item.Id,
                Date: item.Date.ToString("yyyy-MM-dd"),
                TimeStart: item.TimeStart,
                TimeEnd: item.TimeEnd,
                Group: SafeLogValue(item.Group),
                Module: SafeLogValue(item.Module),
                Teacher: SafeLogValue(item.Teacher),
                Room: SafeLogValue(item.Room),
                LessonType: SafeLogValue(item.LessonTypeName),
                Status: FormatStatus(item.Status),
                Source: "Чернетка"
            ))
            .ToList();
        var courseId = ResolveSingleCourseIdByGroups(ordered.Select(item => item.GroupId));
        var entry = new AdminScheduleLogEntry(
            Id: Guid.NewGuid().ToString("N"),
            Timestamp: DateTimeOffset.Now,
            ActionCode: LogActionDelete,
            ActionLabel: "Видалення заняття",
            Summary: summary,
            Success: true,
            Error: null,
            WeekStart: _weekStart.ToString("yyyy-MM-dd"),
            WeekEnd: _weekStart.AddDays(6).ToString("yyyy-MM-dd"),
            DaysPreset: null,
            AllowDaysOff: null,
            CourseId: courseId,
            CourseName: ResolveCourseName(courseId),
            ModuleHours: new List<AdminScheduleLogModuleHours>(),
            Warnings: new List<string>(),
            GapDetails: new List<AutoGenGapDetail>(),
            Lessons: lessons,
            LessonsTrimmed: lessonsTrimmed
        );
        await TryWriteScheduleLogAsync(entry);
    }
    private int? ResolveSingleCourseId(IReadOnlyCollection<CreatedDraftLogItem> createdItems)
    {
        if (_meta is null)
        {
            return null;
        }
        return ResolveSingleCourseIdByGroups(createdItems.Select(item => item.Request.GroupId));
    }
    private int? ResolveSingleCourseIdByGroups(IEnumerable<int> groupIds)
    {
        if (_meta is null)
        {
            return null;
        }
        var courseIds = groupIds
            .Select(groupId => _meta.Groups.FirstOrDefault(group => group.Id == groupId)?.CourseId)
            .Where(id => id is int)
            .Select(id => id!.Value)
            .Distinct()
            .ToList();
        return courseIds.Count == 1 ? courseIds[0] : null;
    }
    private string? ResolveCourseName(int? courseId)
    {
        if (courseId is not int id)
        {
            return null;
        }
        var name = _meta?.Courses.FirstOrDefault(course => course.Id == id)?.Name;
        return string.IsNullOrWhiteSpace(name) ? $"#{id}" : name;
    }
    private string ResolveModuleName(int moduleId)
    {
        var module = _meta?.Modules.FirstOrDefault(item => item.Id == moduleId);
        if (module is null)
        {
            return $"#{moduleId}";
        }
        return string.IsNullOrWhiteSpace(module.Code)
            ? module.Name
            : $"{module.Code} — {module.Name}";
    }
    private string ResolveLessonTypeName(int lessonTypeId)
    {
        var name = _meta?.LessonTypes.FirstOrDefault(item => item.Id == lessonTypeId)?.Name;
        return string.IsNullOrWhiteSpace(name) ? $"#{lessonTypeId}" : name;
    }
    private static string ResolveLookupName(IEnumerable<LookupDto>? source, int? id)
    {
        if (id is not int value)
        {
            return "-";
        }
        var name = source?.FirstOrDefault(item => item.Id == value)?.Name;
        return string.IsNullOrWhiteSpace(name) ? $"#{value}" : name;
    }
    private static string SafeLogValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private async Task TryWriteScheduleLogAsync(AdminScheduleLogEntry entry)
    {
        try
        {
            await LogService.AddAsync(entry);
        }
        catch (Exception)
        {
        }
    }
    private sealed record CreatedDraftLogItem(int Id, DraftUpsertRequest Request);
    private static DateOnly FirstMonday(DateOnly d)
        => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private DateOnly DayToDate(int dayNumber)
    {
        var dow = (DayOfWeek)dayNumber;
        var currentMonday = FirstMonday(_weekStart);
        var byDow = (int)dow == 0 ? 6 : ((int)dow - 1);
        return currentMonday.AddDays(byDow);
    }
    private sealed class ConflictDetails
    {
        public string Message { get; init; } = string.Empty;
        public List<string> Errors { get; init; } = new();
        public List<string> Warnings { get; init; } = new();
        public DateTimeOffset SavedAt { get; init; } = DateTimeOffset.Now;
        public bool Expanded { get; set; } = true;
        public string ToggleLabel => Expanded ? "Згорнути" : "Розгорнути";
    }
    private sealed record EffectiveSlotsResponse(int? courseId, bool usingCourseSpecific, List<TimeSlotDto> slots);
    private int? ResolveCourseIdForSlots()
    {
        if (_courseId is int cid) return cid;
        if (_meta is null || _groupId is null) return null;
        return _groupById.GetValueOrDefault(_groupId.Value)?.CourseId;
    }
    private int? ResolveCourseIdForEdit()
    {
        if (_edit is null || _meta is null) return ResolveCourseIdForSlots();
        var courseId = _groupById.GetValueOrDefault(_edit.GroupId)?.CourseId;
        return courseId ?? ResolveCourseIdForSlots();
    }

static string CssByCode(string code) => code switch
    {
        "CANCELED" => "can",
        "RESCHEDULED" => "res",
        "BREAK" => "brk",
        _ => ""
    };
    private Task PrevWeek() { _weekStart = _weekStart.AddDays(-7); return Reload(); }
    private Task NextWeek() { _weekStart = _weekStart.AddDays(+7); return Reload(); }
    // Змінює тиждень через поле дати та одразу оновлює серверні дані.
    private async Task OnWeekDateChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value) || !DateOnly.TryParse(value, out var date))
        {
            _err = "Оберіть коректну дату.";
            return;
        }
        _weekStart = FirstMonday(date);
        await Reload();
    }
    private void ResetFilters()
    {
        _teacherId = _groupId = _roomId = _courseId = null;
        RebuildDraftDisplayCache();
    }
    private DraftValidationReportDto? ParseWarningReport(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        try
        {
            return JsonSerializer.Deserialize<DraftValidationReportDto>(raw, WarningJsonOptions);
        }
        catch
        {
            return null;
        }
    }
    private static (int errors, int warnings) CountIssues(DraftValidationReportDto report)
    {
        var errors = report.Issues.Count(i => string.Equals(i.Severity, "error", StringComparison.OrdinalIgnoreCase));
        var warnings = report.Issues.Count(i => string.Equals(i.Severity, "warning", StringComparison.OrdinalIgnoreCase));
        return (errors, warnings);
    }
    private void ToggleWarningPanel(int itemId)
    {
        if (_expandedWarningSlots.Contains(itemId))
            _expandedWarningSlots.Remove(itemId);
        else
            _expandedWarningSlots.Add(itemId);
    }
    // Перемикає режим редагування без обмежень.
    private void HandleUnrestrictedChange(ChangeEventArgs e)
    {
        var enabled = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        _unrestrictedMode = enabled;
        if (_edit is not null)
        {
            _edit = _edit with { IgnoreValidationErrors = _unrestrictedMode };
        }
    }

}

