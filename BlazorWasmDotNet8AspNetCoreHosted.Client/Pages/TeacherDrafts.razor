    }
    // Готує форму редагування для існуючої чернетки.
    private async Task StartEdit(TeacherDraftItemDto item)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        if (item.Status != DraftStatusDto.Draft)
        {
            _err = "Схвалене заняття не можна редагувати. За потреби видаліть його в режимі без обмежень і створіть заново.";
            return;
        }
        if (item.IsLocked)
        {
            _err = "Зафіксоване заняття не можна редагувати. За потреби видаліть його в режимі без обмежень і створіть заново.";
            return;
        }
        await EnsureTopicsLoaded(item.ModuleId);
        if (IsDraftMutationBusy)
        {
            return;
        }
        List<TeacherDraftItemDto> weekItems;
        try
        {
            weekItems = await DraftsApi.GetWeek(FirstMonday(item.Date), null);
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
            return;
        }
        catch (Exception ex)
        {
            _err = ex.Message;
            return;
        }
        if (IsDraftMutationBusy)
        {
            return;
        }
        var currentItem = weekItems.FirstOrDefault(candidate => candidate.Id == item.Id);
        if (currentItem is null)
        {
            _err = $"Пара #{item.Id} вже не існує. Оновіть таблицю.";
            return;
        }
        if (!TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(item, currentItem))
        {
            _err = $"Пара #{item.Id} була змінена в іншому вікні. Оновіть таблицю перед редагуванням.";
            return;
        }
        var logicalEventRows = TeacherDraftEditMutationPlanner
            .SelectLogicalEventRows(weekItems, currentItem)
            .ToList();
        if (logicalEventRows.Any(row => row.IsLocked || row.Status != DraftStatusDto.Draft))
        {
            _err = "Логічне заняття містить зафіксовані або схвалені рядки й не може бути змінене частково.";
            return;
        }
        RememberRoom(currentItem.LessonTypeId, currentItem.RoomId);
        var initialRequest = new DraftUpsertRequest(
            Id: currentItem.Id,
            Date: currentItem.Date,
            TimeStart: currentItem.TimeStart,
            TimeEnd: currentItem.TimeEnd,
            GroupId: currentItem.GroupId,
            ModuleId: currentItem.ModuleId,
            ModuleTopicId: currentItem.ModuleTopicId,
            TeacherId: currentItem.TeacherId,
            RoomId: currentItem.RoomId,
            RequiresRoom: currentItem.RequiresRoom,
            LessonTypeId: IsNoneLessonType(currentItem) ? 0 : currentItem.LessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: currentItem.BatchKey,
            IsLocked: currentItem.IsLocked,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: currentItem.IsSelfStudy
        );
        _editSourceItem = currentItem;
        _edit = NormalizeRequest(initialRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        var scopedTopicIds = ResolveEditScopeTopicIds(logicalEventRows, currentItem.ModuleId);
        if (scopedTopicIds.Count > 0)
        {
            foreach (var topicId in scopedTopicIds)
            {
                _editTopicIds.Add(topicId);
            }
        }
        else if (currentItem.ModuleTopicId is int topicId)
        {
            _editTopicIds.Add(topicId);
        }
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
        _extraGroups.Clear();
        _extraTeachers.Clear();
    }
    // Готує форму створення нової чернетки з типовими значеннями.
    private async Task StartCreate(int dayNumber, string start, string end, int groupId)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        _extraGroups.Clear();
        _extraTeachers.Clear();
        _editSourceItem = null;
        if (_meta is null)
        {
            _err = "Метадані не завантажені для створення чернетки.";
            return;
        }
        var date = DayToDate(dayNumber);
        var module = _meta.Modules.FirstOrDefault();
        if (module is null)
        {
            _err = "Немає доступних модулів для створення чернетки.";
            return;
        }
        await EnsureTopicsLoaded(module.Id);
        if (IsDraftMutationBusy)
        {
            return;
        }
        var lessonTypeId = 0;
        var resolvedGroupId = groupId > 0 ? groupId : (_groupId ?? _meta.Groups.FirstOrDefault()?.Id);
        if (resolvedGroupId is null)
        {
            _err = "Немає доступних груп для створення чернетки.";
            return;
        }
        var requiresRoom = LessonTypeRequiresRoom(lessonTypeId);
        var resolvedRoomId = ResolveRoomForType(lessonTypeId, requiresRoom, sameType: false);
        if (requiresRoom && resolvedRoomId is null)
        {
            _err = "Немає доступних аудиторій для цього типу заняття.";
            return;
        }
        RememberRoom(lessonTypeId, resolvedRoomId);
        var draftRequest = new DraftUpsertRequest(
            Id: null,
            Date: date,
            TimeStart: start,
            TimeEnd: end,
            GroupId: resolvedGroupId.Value,
            ModuleId: module.Id,
            ModuleTopicId: null,
            TeacherId: _teacherId,
            RoomId: resolvedRoomId,
            RequiresRoom: requiresRoom,
            LessonTypeId: lessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: null,
            IsLocked: false,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: false
        );
        _edit = NormalizeRequest(draftRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
    }
    private List<DateOnly> GetWeekDates()
        => Enumerable.Range(0, 7)
            .Select(offset => _weekStart.AddDays(offset))
