@inject ITeacherDraftsApi DraftsApi
@inject IJSRuntime JS
@inject AdminScheduleLogService LogService
@inject NavigationManager Nav

@code {
    [Parameter, SupplyParameterFromQuery(Name = "weekStart")]
    public string? QueryWeekStart { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "teacherId")]
    public int? QueryTeacherId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "groupId")]
    public int? QueryGroupId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "roomId")]
    public int? QueryRoomId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "courseId")]
    public int? QueryCourseId { get; set; }
    private MetaResponseDto? _meta;
    private bool _metaLoadInProgress = true;
    private string? _metaLoadError;
    private int? _teacherId;
    private int? _groupId;
    private int? _roomId;
    private int? _courseId;
    private DateOnly _weekStart = FirstMonday(DateOnly.FromDateTime(DateTime.Today));
    private List<TeacherDraftItemDto> _items = new();
    private List<TimeSlotDto> _slots = new();
    private readonly List<ExtraGroupSelection> _extraGroups = new();
    private readonly List<ExtraTeacherSelection> _extraTeachers = new();
    private readonly Dictionary<int, List<ModuleTopicViewDto>> _topicsCache = new();
    private readonly Dictionary<int, int?> _lessonTypeRoomCache = new();
    private readonly List<IdCodeNameDto> _allowedLessonTypes = new();
    private readonly Dictionary<int, ModuleMetaDto> _moduleById = new();
    private readonly Dictionary<int, LookupDto> _groupById = new();
    private readonly Dictionary<int, string> _lessonTypeCodeById = new();
    private readonly Dictionary<int, string> _moduleCourseCaptionById = new();
    private int? _noneLessonTypeId;
    private List<ModuleTopicViewDto> TopicsForModule(int moduleId) => _topicsCache.TryGetValue(moduleId, out var list) ? list : new List<ModuleTopicViewDto>();
    private List<IdCodeNameDto> AllowedLessonTypes => _allowedLessonTypes;
    private int? NoneLessonTypeId => _noneLessonTypeId;
    // Перевіряє, чи тип заняття є підсумковим контролем.
    private bool IsFinalAssessment(int? lessonTypeId)
    {
        if (lessonTypeId is not int ltId || _meta is null) return false;
        var code = _lessonTypeCodeById.GetValueOrDefault(ltId);
        return string.Equals(code, "EXAM", StringComparison.OrdinalIgnoreCase)
               || string.Equals(code, "CREDIT", StringComparison.OrdinalIgnoreCase);
    }
    // Для підсумкових контролів тема модуля не потрібна.
    private void ClearTopicForFinalAssessment()
    {
        if (_edit is null) return;
        if (IsFinalAssessment(_edit.LessonTypeId))
        {
            _edit = _edit with { ModuleTopicId = null };
            _editTopicIds.Clear();
        }
    }
    private DraftUpsertRequest? _edit;
    private TeacherDraftItemDto? _editSourceItem;
    private readonly Dictionary<int, Guid> _editSourceRevisions = new();
    private bool _unrestrictedMode;
    private bool _isExporting;
    private bool _isPublishing;
    private bool _draftMutationInProgress;
    private int _reloadVersion;
    private int _draftItemsReloadVersion;
    private int _editorLoadVersion;
    private bool _reloadInProgress;
    private bool _hasFreshSuccessfulLoad;
    private List<string> _publishWarnings = new();
    private DraftValidationReportDto? _weekValidationReport;
    private string? _weekValidationError;
    private readonly HashSet<DateOnly> _manuallyChangedWeeks = new();
    private readonly HashSet<int> _expandedWarningSlots = new();
    private readonly Dictionary<int, DraftValidationReportDto> _warningReports = new();
    private static readonly JsonSerializerOptions WarningJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private string? _ok, _err, _exportError;
    private readonly HashSet<int> _bulkSelectedIds = new();
    private int? _bulkSelectedDayNumber;
    private readonly HashSet<int> _bulkTeacherIds = new();
    private int? _bulkRoomId;
    private int? _bulkModuleId;
    private readonly HashSet<int> _bulkTopicIds = new();
    private readonly HashSet<int> _editTopicIds = new();
    private bool _bulkApplying;
    private bool _bulkEditOpen;
    private ConflictDetails? _currentConflict;
    private Dictionary<string, ConflictDetails> _conflictStorage = new();
    private bool _conflictsLoaded;
    private static readonly JsonSerializerOptions ConflictJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private const string ConflictStorageKey = "teacherDrafts.conflicts.v1";
    private const string ManualReviewStorageKey = "teacherDrafts.manualReviewWeeks.v1";
    private const string MixedTopicLessonTypeError = "Можна обрати кілька тем лише з однаковим типом заняття.";
    private record SlotRow(string Start, string End) { public string Label => $"{Start}-{End}"; }
    private List<SlotRow> _rows = new();
    private List<TeacherDraftItemDto> _matchingItems = new();
    private List<TeacherDraftItemDto> _filteredItems = new();
    private List<LookupDto> _displayGroups = new();
    private List<DateOnly> _displayWeekDays = new();
    private List<SlotRow> _displaySlots = new();
    private Dictionary<(int DayNumber, string Start, string End, int GroupId), TeacherDraftItemDto> _displayLookup = new();
    private bool _showProblemsOnly;
    private bool _manualEditingEnabled;
    private bool _showPublishedScheduleLink;
    private DateOnly? _loadedWeekStart;
    private int? _loadedCourseId;
    private ElementReference _bulkDialogElement;
    private ElementReference _editDialogElement;
    private bool _bulkDialogWasOpen;
    private bool _editDialogWasOpen;
    private static readonly string[] UkrainianDayNames = { "Неділя", "Понеділок", "Вівторок", "Середа", "Четвер", "П'ятниця", "Субота" };
    private DragPayload? _dragPayload;
    private SlotKey? _dragHover;
    private bool _isProcessingDrop;
    private bool IsDraftMutationBusy
        => _isPublishing || _bulkApplying || _isProcessingDrop || _draftMutationInProgress || _reloadInProgress;
    private bool HasWeekItems
        => _items.Count > 0;
    private IReadOnlyList<DraftValidationIssueDto> VisibleWeekValidationIssues
    {
        get
        {
            var issues = _weekValidationReport?.Issues.ToList() ?? new List<DraftValidationIssueDto>();
            if (_manuallyChangedWeeks.Contains(_weekStart)
                && string.IsNullOrWhiteSpace(_weekValidationError)
                && HasValidatedLoadedWeekScope
                && !issues.Any(issue => string.Equals(
                    issue.Code,
                    "autogen-applied-scope-changed",
                    StringComparison.OrdinalIgnoreCase)))
            {
                issues.Add(new DraftValidationIssueDto(
                    "warning",
                    "manual-week-change",
                    "Ручні зміни потребують перегляду",
                    "Заняття було додано, переміщено, змінено або видалено вручну. Автоматична перевірка завершена; перегляньте порядок і повноту тижня перед публікацією."));
            }
            return issues;
        }
    }
    private bool HasCriticalWeekIssues
        => VisibleWeekValidationIssues.Any(issue =>
            string.Equals(issue.Severity, "error", StringComparison.OrdinalIgnoreCase)) == true;
    private Guid LoadedWeekScopeRevision
        => LogicalRevisionToken.Combine(_items.Select(item =>
            new KeyValuePair<int, Guid>(item.Id, item.Revision)));
    private bool HasValidatedLoadedWeekScope
        => _weekValidationReport is not null
           && _weekValidationReport.ScopeRevision == LoadedWeekScopeRevision;
    private bool CanPublishDrafts
        => _hasFreshSuccessfulLoad
           && HasValidatedLoadedWeekScope
           && string.IsNullOrWhiteSpace(_err)
           && string.IsNullOrWhiteSpace(_weekValidationError)
           && _publishWarnings.Count == 0
           && !HasCriticalWeekIssues
           && HasWeekItems
           && !IsDraftMutationBusy
           && _edit is null
           && !_bulkEditOpen;
    private int ProblemRecordCount
        => _matchingItems.Count(HasReportedIssues);
    private string PublishedScheduleUrl
    {
        get
        {
            var query = new List<string> { $"weekStart={_weekStart:yyyy-MM-dd}" };
            if (_courseId is int courseId)
            {
                query.Add($"courseId={courseId}");
            }
            return $"/schedule?{string.Join("&", query)}";
        }
    }
    private string PublishButtonTitle
        => !HasWeekItems
            ? "Немає записів для публікації"
            : !_hasFreshSuccessfulLoad
                ? "Спочатку оновіть дані та повторно перевірте весь тиждень"
            : !string.IsNullOrWhiteSpace(_weekValidationError) || !HasValidatedLoadedWeekScope
                ? "Спочатку повторіть перевірку всього тижня"
                : HasCriticalWeekIssues
                    ? "Спочатку виправте критичні проблеми тижня"
                    : $"Опублікувати весь тиждень: {FormatRecordCount(_items.Count)} у всіх статусах";
    // Блокує паралельну зміну чернеток під час публікації або іншої серверної операції.
    private bool TryBeginDraftMutation()
    {
        if (IsDraftMutationBusy)
        {
            return false;
        }
        _draftMutationInProgress = true;
        return true;
    }
    // Позначає тиждень після фактично успішної ручної зміни, навіть якщо обов'язкові правила не порушено.
    private async Task MarkManualWeekChangeAsync(DateOnly changedWeekStart)
    {
        var normalizedWeekStart = FirstMonday(changedWeekStart);
        _manuallyChangedWeeks.Add(normalizedWeekStart);
        if (_weekStart == normalizedWeekStart)
        {
            _publishWarnings.Clear();
        }
        await SaveManualReviewWeeksAsync();
    }
    // Оновлює таблицю після зміни лише тоді, коли користувач досі переглядає той самий тиждень.
    private async Task ReloadChangedWeekIfCurrentAsync(DateOnly changedWeekStart)
    {
        if (_weekStart == FirstMonday(changedWeekStart))
        {
            if (_reloadInProgress)
            {
                await Reload();
            }
            else
            {
                await ReloadDraftItemsOnlyAsync();
            }
        }
    }
    // Переносить фокус у щойно відкритий редактор, щоб клавіатура не залишалася на тлі.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var focusBulkDialog = _bulkEditOpen && !_bulkDialogWasOpen;
        var focusEditDialog = _edit is not null && !_editDialogWasOpen;
        _bulkDialogWasOpen = _bulkEditOpen;
        _editDialogWasOpen = _edit is not null;
        try
        {
            if (focusBulkDialog)
            {
                await JS.InvokeVoidAsync("scheduleApp.focusModal", _bulkDialogElement);
            }
            else if (focusEditDialog)
            {
                await JS.InvokeVoidAsync("scheduleApp.focusModal", _editDialogElement);
            }
        }
        catch (JSException)
        {
        }
    }
    private void HandleBulkDialogKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal) && !IsDraftMutationBusy)
        {
            CloseBulkEdit();
        }
    }
    private void HandleEditDialogKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal) && !IsDraftMutationBusy)
        {
            CancelEdit();
        }
    }
    // Знімає блокування після завершення серверної зміни чернеток.
    private void EndDraftMutation()
        => _draftMutationInProgress = false;
    private const int LogLessonLimit = 300;
    private const int BatchMutationLimit = 500;
    private const string LogActionCreate = "create-item";
    private const string LogActionDelete = "delete-item";
    private string CurrentConflictKey => $"{_weekStart:yyyy-MM-dd}|t:{_teacherId?.ToString() ?? "all"}|g:{_groupId?.ToString() ?? "all"}|r:{_roomId?.ToString() ?? "all"}|c:{_courseId?.ToString() ?? "all"}";
    private bool IsOperationContextCurrent(string contextKey)
        => string.Equals(CurrentConflictKey, contextKey, StringComparison.Ordinal);
    // Початкове завантаження метаданих, конфліктів та чернеток.
    protected override async Task OnInitializedAsync()
    {
        await LoadMetaAsync();
    }
    private async Task LoadMetaAsync()
    {
        _metaLoadInProgress = true;
        _metaLoadError = null;
        try
        {
            _meta = await Http.GetFromJsonAsync<MetaResponseDto>("api/meta")
                ?? throw new InvalidOperationException("Сервер повернув порожні довідники.");
            RebuildMetaLookups();
            await LoadConflictsAsync();
            await LoadManualReviewWeeksAsync();
        }
        catch (Exception ex)
        {
            _meta = null;
            RebuildMetaLookups();
            _hasFreshSuccessfulLoad = false;
            ClearLoadedDraftView();
            _metaLoadError = ex.Message;
        }
        finally
        {
            _metaLoadInProgress = false;
        }
    }
    private async Task RetryMetaLoadAsync()
    {
        await LoadMetaAsync();
        if (_meta is null)
        {
            return;
        }
        ApplyQueryFilters();
        if (NavigateToCurrentContext())
        {
            return;
        }
        await Reload();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_meta is null)
        {
            return;
        }
        ApplyQueryFilters();
        if (NavigateToCurrentContext())
        {
            return;
        }
        await Reload();
    }
    // Застосовує фільтри, що прийшли з query string.
    private void ApplyQueryFilters()
    {
        _teacherId = NormalizeQueryId(QueryTeacherId) is int teacherId
            && _meta?.Teachers.Any(teacher => teacher.Id == teacherId) == true
                ? teacherId
                : null;
        _roomId = NormalizeQueryId(QueryRoomId) is int roomId
            && _meta?.Rooms.Any(room => room.Id == roomId) == true
                ? roomId
                : null;
        _courseId = NormalizeQueryId(QueryCourseId) is int courseId
            && _meta?.Courses.Any(course => course.Id == courseId) == true
                ? courseId
                : null;
        _groupId = NormalizeQueryId(QueryGroupId) is int groupId
            && _groupById.ContainsKey(groupId)
            && (_courseId is null || _groupById[groupId].CourseId == _courseId)
                ? groupId
                : null;
        if (DateOnly.TryParse(QueryWeekStart, out var weekStart))
        {
            _weekStart = FirstMonday(weekStart);
        }
    }
    // Будує швидкі довідники для метаданих, щоб не шукати їх у списках під час кожного рендеру.
    private void RebuildMetaLookups()
    {
        _allowedLessonTypes.Clear();
        _moduleById.Clear();
        _groupById.Clear();
        _lessonTypeCodeById.Clear();
        _moduleCourseCaptionById.Clear();
        _noneLessonTypeId = null;

        if (_meta is null)
        {
            return;
        }

        _allowedLessonTypes.AddRange(_meta.LessonTypes
            .Where(lt => !string.Equals(lt.Code, "NONE", StringComparison.OrdinalIgnoreCase)));
        _noneLessonTypeId = _meta.LessonTypes
            .FirstOrDefault(lt => string.Equals(lt.Code, "NONE", StringComparison.OrdinalIgnoreCase))?.Id;

        foreach (var lessonType in _meta.LessonTypes)
        {
            _lessonTypeCodeById[lessonType.Id] = lessonType.Code;
        }
        foreach (var module in _meta.Modules)
        {
            _moduleById[module.Id] = module;
            if (!string.IsNullOrWhiteSpace(module.CourseName))
            {
                _moduleCourseCaptionById[module.Id] = module.CourseName!;
            }
        }
        foreach (var group in _meta.Groups)
        {
            _groupById[group.Id] = group;
        }
    }
    // Перебудовує дані таблиці один раз після завантаження або зміни фільтрів.
    private void RebuildDraftDisplayCache()
    {
        _matchingItems = _items.Where(i =>
            (_teacherId is null || i.TeacherId == _teacherId) &&
            (_groupId is null || i.GroupId == _groupId) &&
            (_roomId is null || i.RoomId == _roomId) &&
            (_courseId is null || _groupById.GetValueOrDefault(i.GroupId)?.CourseId == _courseId)
        ).ToList();
        _filteredItems = _showProblemsOnly
            ? _matchingItems.Where(HasReportedIssues).ToList()
            : _matchingItems;
        _displayGroups = _manualEditingEnabled
            ? ResolveGroups(_matchingItems)
            : ResolveGroupsWithItems(_filteredItems);
        _displayWeekDays = _manualEditingEnabled
            ? GetWeekDates()
            : GetWeekDates()
                .Where(day => _filteredItems.Any(item => item.DayNumber == DayNumberFromDate(day)))
                .ToList();
        _displaySlots = _manualEditingEnabled
            ? MergeSlotRows(_rows, _matchingItems)
            : MergeSlotRows(Array.Empty<SlotRow>(), _filteredItems);
        _displayLookup = BuildLookup(_filteredItems);
    }
    // Прибирає попередній тиждень до завершення завантаження нового контексту.
    private void ClearLoadedDraftView()
    {
        _items = new List<TeacherDraftItemDto>();
        _slots = new List<TimeSlotDto>();
        _rows = new List<SlotRow>();
        _matchingItems = new List<TeacherDraftItemDto>();
        _filteredItems = new List<TeacherDraftItemDto>();
        _displayGroups = new List<LookupDto>();
        _displayWeekDays = new List<DateOnly>();
        _displaySlots = new List<SlotRow>();
        _displayLookup = new Dictionary<(int DayNumber, string Start, string End, int GroupId), TeacherDraftItemDto>();
        _loadedWeekStart = null;
        _loadedCourseId = null;
        _weekValidationReport = null;
        _weekValidationError = null;
        _warningReports.Clear();
        _expandedWarningSlots.Clear();
        ClearBulkSelection();
        CancelEdit();
    }
    private Task OnFilterChangedAsync()
    {
        ResetGridView();
        if (NavigateToCurrentContext())
        {
            return Task.CompletedTask;
        }
        RebuildDraftDisplayCache();
        return Task.CompletedTask;
    }
    private async Task OnCourseFilterChangedAsync()
    {
        if (_courseId is int courseId
            && _groupId is int groupId
            && _groupById.GetValueOrDefault(groupId)?.CourseId is int groupCourseId
            && groupCourseId != courseId)
        {
            _groupId = null;
        }
        ResetGridView();
        if (NavigateToCurrentContext())
        {
            return;
        }
        await Reload();
    }
    private async Task OnGroupFilterChangedAsync()
    {
        ResetGridView();
        if (NavigateToCurrentContext())
        {
            return;
        }
        await Reload();
    }
    // Повертає лише групи, для яких є видимі записи у режимі перевірки.
    private List<LookupDto> ResolveGroupsWithItems(IEnumerable<TeacherDraftItemDto> items)
    {
        if (_meta is null)
        {
            return new List<LookupDto>();
        }
        var groupIds = items.Select(item => item.GroupId).Distinct().ToHashSet();
        return _meta.Groups
            .Where(group => groupIds.Contains(group.Id))
            .OrderBy(group => group.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }
    // Нормалізує query-параметр і перетворює 0/від'ємні значення на відсутність фільтра.
    private static int? NormalizeQueryId(int? value)
        => value is > 0 ? value : null;
    // Перезавантажує чернетки, попередження та тайм-слоти для поточного тижня.
    private async Task Reload()
    {
        var reloadVersion = ++_reloadVersion;
        var draftItemsReloadVersion = ++_draftItemsReloadVersion;
        _editorLoadVersion++;
        var requestedWeekStart = _weekStart;
        var requestedCourseId = _courseId;
        _hasFreshSuccessfulLoad = false;
        ClearLoadedDraftView();
        _reloadInProgress = true;
        _ok = _err = null;
        _exportError = null;
        _showPublishedScheduleLink = false;
        _publishWarnings.Clear();
        _edit = null;
        _editSourceItem = null;
        _editSourceRevisions.Clear();
        _extraGroups.Clear();
        _extraTeachers.Clear();
        _topicsCache.Clear();
        ClearBulkSelection();
        var courseId = ResolveCourseIdForSlots();
        var slotsUrl = "api/admin/config/slots?includeDayOverrides=true";
        if (courseId is int cid)
        {
            slotsUrl += $"&courseId={cid}";
        }
        // Повний тиждень потрібен, щоб жодна відфільтрована тема або співвикладач не випала з атомарної операції.
        var draftsTask = DraftsApi.GetWeek(requestedWeekStart, null);
        var slotsTask = Http.GetFromJsonAsync<EffectiveSlotsResponse>(slotsUrl);
        try
        {
            await Task.WhenAll(draftsTask, slotsTask);
            if (reloadVersion != _reloadVersion
                || draftItemsReloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            await LoadConflictsAsync();
            if (reloadVersion != _reloadVersion
                || draftItemsReloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            ApplyLoadedDraftItems(await draftsTask);
            var eff = await slotsTask;
            _slots = eff?.slots ?? new();
            _rows = _slots
                .Select(s => new SlotRow(s.Start, s.End))
                .GroupBy(x => (x.Start, x.End))
                .Select(g => g.First())
                .OrderBy(x => x.Start)
                .ToList();
            RebuildDraftDisplayCache();
            _loadedWeekStart = requestedWeekStart;
            _loadedCourseId = requestedCourseId;
            await RefreshWeekValidationAsync(
                requestedWeekStart,
                reloadVersion,
                draftItemsReloadVersion);
            if (reloadVersion != _reloadVersion
                || draftItemsReloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            _hasFreshSuccessfulLoad = true;
        }
        catch (ApiErrorException ex)
        {
            if (reloadVersion == _reloadVersion
                && draftItemsReloadVersion == _draftItemsReloadVersion)
            {
                ClearLoadedDraftView();
                await HandleApiError(ex);
            }
        }
        catch (Exception ex)
        {
            if (reloadVersion == _reloadVersion
                && draftItemsReloadVersion == _draftItemsReloadVersion)
            {
                ClearLoadedDraftView();
                _err = ex.Message;
            }
        }
        finally
        {
            if (reloadVersion == _reloadVersion)
            {
                _reloadInProgress = false;
            }
        }
    }
    private async Task ReloadDraftItemsOnlyAsync()
    {
        var reloadVersion = ++_draftItemsReloadVersion;
        var requestedWeekStart = _weekStart;
        var requestedCourseId = _courseId;
        _hasFreshSuccessfulLoad = false;
        try
        {
            await LoadConflictsAsync();
            // Локальні фільтри не повинні звужувати серверний пакет логічного заняття.
            var items = await DraftsApi.GetWeek(requestedWeekStart, null);
            if (reloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            ApplyLoadedDraftItems(items);
            _loadedWeekStart = requestedWeekStart;
            _loadedCourseId = requestedCourseId;
            await RefreshWeekValidationAsync(
                requestedWeekStart,
                expectedDraftItemsReloadVersion: reloadVersion);
            if (reloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            _hasFreshSuccessfulLoad = true;
        }
        catch
        {
            if (reloadVersion != _draftItemsReloadVersion
                || requestedWeekStart != _weekStart
                || requestedCourseId != _courseId)
            {
                return;
            }
            ClearLoadedDraftView();
            throw;
        }
    }
    // Повторно перевіряє весь тиждень після кожної ручної зміни, а не лише змінений запис.
    private async Task RefreshWeekValidationAsync(
        DateOnly requestedWeekStart,
        int? expectedReloadVersion = null,
        int? expectedDraftItemsReloadVersion = null)
    {
        if (requestedWeekStart != _weekStart
            || expectedReloadVersion is int initialVersion && initialVersion != _reloadVersion
            || expectedDraftItemsReloadVersion is int initialItemsVersion
            && initialItemsVersion != _draftItemsReloadVersion)
        {
            return;
        }
        _weekValidationReport = null;
        _weekValidationError = null;
        try
        {
            var report = await DraftsApi.ValidateWeek(requestedWeekStart);
            if (requestedWeekStart != _weekStart
                || expectedReloadVersion is int version && version != _reloadVersion
                || expectedDraftItemsReloadVersion is int itemsVersion
                && itemsVersion != _draftItemsReloadVersion)
            {
                return;
            }
            if (report.ScopeRevision != LoadedWeekScopeRevision)
            {
                _weekValidationError = "Чернетки змінилися під час перевірки. Оновіть дані, щоб побачити актуальний склад тижня.";
                return;
            }
            _weekValidationReport = report;
        }
        catch (Exception ex)
        {
            if (requestedWeekStart != _weekStart
                || expectedReloadVersion is int version && version != _reloadVersion
                || expectedDraftItemsReloadVersion is int itemsVersion
                && itemsVersion != _draftItemsReloadVersion)
            {
                return;
            }
            _weekValidationError = $"Не вдалося повторно перевірити весь тиждень: {ex.Message}";
        }
    }
    private void ApplyLoadedDraftItems(IReadOnlyList<TeacherDraftItemDto> items)
    {
        _items = items.ToList();
        _warningReports.Clear();
        foreach (var draft in _items)
        {
            var report = ParseWarningReport(draft.Warnings);
            if (report is not null)
            {
                _warningReports[draft.Id] = report;
            }
            if (draft.RequiresRoom && draft.RoomId is int rid && !_lessonTypeRoomCache.ContainsKey(draft.LessonTypeId))
            {
                _lessonTypeRoomCache[draft.LessonTypeId] = rid;
            }
        }
        _expandedWarningSlots.RemoveWhere(id => !_warningReports.ContainsKey(id));
        _bulkSelectedIds.RemoveWhere(id => !_items.Any(item => item.Id == id));
        if (_bulkSelectedIds.Count == 0)
        {
            _bulkSelectedDayNumber = null;
            if (_bulkEditOpen)
            {
                CloseBulkEdit();
            }
        }
        if (_edit?.Id is int editId && !_items.Any(item => item.Id == editId))
        {
            _edit = null;
            _editSourceItem = null;
            _editSourceRevisions.Clear();
            _editTopicIds.Clear();
        }
        SyncCurrentConflict();
        RebuildDraftDisplayCache();
    }
    private void RemoveDraftItemsFromState(IEnumerable<int> ids)
    {
        var idSet = ids.ToHashSet();
        if (idSet.Count == 0)
        {
            return;
        }
        _items.RemoveAll(item => idSet.Contains(item.Id));
        foreach (var id in idSet)
        {
            _warningReports.Remove(id);
            _expandedWarningSlots.Remove(id);
            _bulkSelectedIds.Remove(id);
        }
        if (_bulkSelectedIds.Count == 0)
        {
            _bulkSelectedDayNumber = null;
            if (_bulkEditOpen)
            {
                CloseBulkEdit();
            }
        }
        if (_edit?.Id is int editId && idSet.Contains(editId))
        {
            _edit = null;
            _editSourceItem = null;
            _editSourceRevisions.Clear();
            _editTopicIds.Clear();
        }
        SyncCurrentConflict();
        RebuildDraftDisplayCache();
    }
    // Експортує поточний тиждень у формат Excel.
    private async Task ExportScheduleAsync()
    {
        if (_isExporting) return;
        _isExporting = true;
        _exportError = null;
        var exportWeek = _weekStart;
        var exportTeacherId = _teacherId;
        var exportGroupId = _groupId;
        var exportRoomId = _roomId;
        var operationContextKey = CurrentConflictKey;
        try
        {
            var bytes = await DraftsApi.ExportWeek(
                exportWeek,
                exportTeacherId,
                exportGroupId,
                exportRoomId);
            if (bytes is null || bytes.Length == 0)
            {
                if (IsOperationContextCurrent(operationContextKey))
                {
                    _exportError = "Не вдалося сформувати файл Excel.";
                }
                return;
            }
            var fileName = $"Rozklad-{exportWeek:yyyyMMdd}.xlsx";
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadFromBytes", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        catch (Exception ex)
        {
            if (IsOperationContextCurrent(operationContextKey))
            {
                _exportError = ex.Message;
            }
        }
        finally
        {
            _isExporting = false;
        }
    }
    // Публікує чернетку тижня до основного розкладу.
    private async Task PublishWeek()
    {
        if (!CanPublishDrafts)
        {
            return;
        }
        _isPublishing = true;
        _ok = _err = null;
        _showPublishedScheduleLink = false;
        _publishWarnings.Clear();
        var publishWeek = _weekStart;
        var publishScopeRevision = _weekValidationReport!.ScopeRevision;
        var operationContextKey = CurrentConflictKey;
        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Опублікувати весь тиждень {publishWeek:dd.MM.yyyy} – {publishWeek.AddDays(6):dd.MM.yyyy}: {FormatRecordCount(_items.Count)} у всіх статусах, незалежно від активних фільтрів? Увесь пакет буде перевірено, і за наявності порушень не буде опубліковано жодної пари.");
            if (!confirmed)
            {
                return;
            }
            _hasFreshSuccessfulLoad = false;
            var result = await DraftsApi.PublishWeek(new PublishWeekRequest(
                WeekStart: publishWeek,
                TeacherId: null,
                ExpectedScopeRevision: publishScopeRevision
            ));
            if (result.Created > 0
                && result.Skipped == 0
                && !result.Warnings.Any(warning => !string.IsNullOrWhiteSpace(warning)))
            {
                _manuallyChangedWeeks.Remove(publishWeek);
                await SaveManualReviewWeeksAsync();
            }
            await ReloadChangedWeekIfCurrentAsync(publishWeek);
            if (!IsOperationContextCurrent(operationContextKey))
            {
                return;
            }
            _publishWarnings = result.Warnings
                .Where(warning => !string.IsNullOrWhiteSpace(warning))
                .Select(warning => warning.Trim())
                .Distinct(StringComparer.Ordinal)
                .ToList();
            if (result.Skipped > 0 || _publishWarnings.Count > 0)
            {
                if (_publishWarnings.Count == 0)
                {
                    _publishWarnings.Add($"Публікацію не виконано: сервер відхилив {result.Skipped} чернеток.");
                }
            }
            else if (result.Created > 0)
            {
                _ok = $"Опубліковано {result.Created} пар за тиждень {publishWeek:dd.MM.yyyy} – {publishWeek.AddDays(6):dd.MM.yyyy}.";
            }
            else
            {
                _ok = $"Для тижня {publishWeek:dd.MM.yyyy} – {publishWeek.AddDays(6):dd.MM.yyyy} немає чернеток для публікації.";
            }
            _showPublishedScheduleLink = result.Skipped == 0 && _publishWarnings.Count == 0;
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex, operationContextKey);
        }
        catch (Exception ex)
        {
            if (IsOperationContextCurrent(operationContextKey))
            {
                _err = ex.Message;
            }
        }
        finally
        {
            _isPublishing = false;
        }
    }
    // Ліниво завантажує та кешує теми модуля.
    private async Task<bool> EnsureTopicsLoaded(int moduleId, int editorLoadVersion)
    {
        if (moduleId <= 0)
        {
            return editorLoadVersion == _editorLoadVersion;
        }
        if (_topicsCache.ContainsKey(moduleId))
        {
            return editorLoadVersion == _editorLoadVersion;
        }
        try
        {
            var topics = await Http.GetFromJsonAsync<List<ModuleTopicViewDto>>($"api/admin/modules/{moduleId}/topics");
            if (editorLoadVersion != _editorLoadVersion)
            {
                return false;
            }
            _topicsCache[moduleId] = topics ?? new();
            return true;
        }
        catch (Exception ex)
        {
            if (editorLoadVersion != _editorLoadVersion)
            {
                return false;
            }
            _err = ex.Message;
            return false;
        }
    }
    private ModuleTopicViewDto? FindTopic(int moduleId, int? topicId)
    {
        if (moduleId <= 0 || topicId is null) return null;
        return TopicsForModule(moduleId).FirstOrDefault(t => t.Id == topicId);
    }
    private List<ModuleTopicViewDto> OrderedTopicsForModule(int moduleId)
        => TopicsForModule(moduleId)
            .OrderBy(t => t.Order)
            .ThenBy(t => t.TopicCode, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(t => t.Id)
            .ToList();
    private List<int> OrderedTopicIdsForModule(int moduleId, IEnumerable<int> topicIds)
    {
        var selected = topicIds.ToHashSet();
        if (selected.Count == 0)
        {
            return new List<int>();
        }
        return OrderedTopicsForModule(moduleId)
            .Where(t => selected.Contains(t.Id))
            .Select(t => t.Id)
            .ToList();
    }
    // Перевіряє, чи всі обрані теми належать до одного типу заняття.
    private bool TopicsShareSingleLessonType(int moduleId, IReadOnlyCollection<int> topicIds, out int? lessonTypeId)
    {
        lessonTypeId = null;
        if (topicIds.Count == 0)
        {
            return true;
        }
        var orderedTopics = OrderedTopicsForModule(moduleId)
            .Where(topic => topicIds.Contains(topic.Id))
            .ToList();
        if (orderedTopics.Count == 0)
        {
            return true;
        }
        var firstLessonTypeId = orderedTopics[0].LessonTypeId;
        if (orderedTopics.Any(topic => topic.LessonTypeId != firstLessonTypeId))
        {
            return false;
        }
        lessonTypeId = firstLessonTypeId;
        return true;
    }
    private int? ResolvePrimaryEditTopicId()
    {
        if (_edit is null) return null;
        var ordered = OrderedTopicIdsForModule(_edit.ModuleId, _editTopicIds);
        return ordered.Count == 0 ? null : ordered[0];
    }
    private List<int> ResolveOrderedEditTopicIds()
    {
        if (_edit is null) return new List<int>();
        return OrderedTopicIdsForModule(_edit.ModuleId, _editTopicIds);
    }
    private void ApplySelectedEditTopics()
    {
        if (_edit is null) return;
        var primaryTopicId = ResolvePrimaryEditTopicId();
        ApplyTopicSelection(primaryTopicId);
        if (primaryTopicId is null && _edit.Id is null)
        {
            _edit = _edit with { LessonTypeId = 0 };
        }
        ClearTopicForFinalAssessment();
    }
    private void ToggleEditTopic(ChangeEventArgs args, int topicId)
    {
        if (_edit is null) return;
        if (IsChecked(args))
        {
            var proposed = _editTopicIds.Append(topicId).ToHashSet();
            if (!TopicsShareSingleLessonType(_edit.ModuleId, proposed, out _))
            {
                _err = MixedTopicLessonTypeError;
                return;
            }
            _editTopicIds.Add(topicId);
        }
        else
        {
            _editTopicIds.Remove(topicId);
        }
        _err = null;
        ApplySelectedEditTopics();
    }
    private void SelectAllEditTopics()
    {
        if (_edit is null) return;
        var allTopicIds = OrderedTopicsForModule(_edit.ModuleId)
            .Select(topic => topic.Id)
            .ToList();
        if (!TopicsShareSingleLessonType(_edit.ModuleId, allTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        _editTopicIds.Clear();
        foreach (var topicId in allTopicIds)
        {
            _editTopicIds.Add(topicId);
        }
        _err = null;
        ApplySelectedEditTopics();
    }
    private void ClearEditTopics()
    {
        if (_edit is null) return;
        _editTopicIds.Clear();
        _err = null;
        ApplySelectedEditTopics();
    }
    private void ToggleBulkTopic(ChangeEventArgs args, int topicId)
    {
        if (IsChecked(args))
        {
            var moduleId = ResolveEffectiveBulkModuleId();
            if (moduleId is int mid)
            {
                var proposed = _bulkTopicIds.Append(topicId).ToHashSet();
                if (!TopicsShareSingleLessonType(mid, proposed, out _))
                {
                    _err = MixedTopicLessonTypeError;
                    return;
                }
            }
            _bulkTopicIds.Add(topicId);
        }
        else
        {
            _bulkTopicIds.Remove(topicId);
        }
        _err = null;
    }
    private void SelectAllBulkTopics()
    {
        var moduleId = ResolveEffectiveBulkModuleId();
        if (moduleId is not int mid) return;
        var allTopicIds = OrderedTopicsForModule(mid)
            .Select(topic => topic.Id)
            .ToList();
        if (!TopicsShareSingleLessonType(mid, allTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        _bulkTopicIds.Clear();
        foreach (var topicId in allTopicIds)
        {
            _bulkTopicIds.Add(topicId);
        }
        _err = null;
    }
    private void ClearBulkTopics()
    {
        _bulkTopicIds.Clear();
        _err = null;
    }
    private int? ResolveSingleSelectedModuleId()
    {
        var moduleIds = _items
            .Where(i => _bulkSelectedIds.Contains(i.Id))
            .Select(i => i.ModuleId)
            .Distinct()
            .Take(2)
            .ToList();
        return moduleIds.Count == 1 ? moduleIds[0] : null;
    }
    private int? ResolveEffectiveBulkModuleId()
    {
        if (_bulkModuleId is int moduleId)
        {
            return moduleId;
        }
        return ResolveSingleSelectedModuleId();
    }
    private async Task OnBulkModuleChanged(ChangeEventArgs e)
    {
        _err = null;
        var previousModuleId = _bulkModuleId;
        var previousTopicIds = _bulkTopicIds.ToList();
        var editorLoadVersion = ++_editorLoadVersion;
        _bulkModuleId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        _bulkTopicIds.Clear();
        var effectiveModuleId = ResolveEffectiveBulkModuleId();
        if (effectiveModuleId is int moduleId)
        {
            var loaded = await EnsureTopicsLoaded(moduleId, editorLoadVersion);
            if (!loaded && editorLoadVersion == _editorLoadVersion)
            {
                _bulkModuleId = previousModuleId;
                foreach (var topicId in previousTopicIds)
                {
                    _bulkTopicIds.Add(topicId);
                }
            }
        }
    }
    // Застосовує вибір теми й синхронізує залежні поля (тип заняття, викладач).
    private void ApplyTopicSelection(int? topicId)
    {
        if (_edit is null) return;
        if (topicId is int tId)
        {
            var topic = FindTopic(_edit.ModuleId, tId);
            if (topic is not null)
            {
                _edit = _edit with { ModuleTopicId = tId };
                ApplyLessonType(topic.LessonTypeId);
                if (!_unrestrictedMode
                    && topic.DepartmentId is int depId
                    && depId > 0
                    && _edit.TeacherId is int teacherId
                    && _meta?.Teachers.FirstOrDefault(x => x.Id == teacherId)?.DepartmentId != depId)
                {
                    _edit = _edit with { TeacherId = null };
                    _err = "Обраний викладач не належить до кафедри цієї теми, тому його вибір скинуто.";
                }
                return;
            }
        }
        _edit = _edit with { ModuleTopicId = null };
    }
    // Формує список доступних викладачів з урахуванням кафедри.
    private List<LookupDto> AllowedTeachersForTopic(ModuleTopicViewDto? topic)
    {
        if (_meta is null) return new List<LookupDto>();
        if (_unrestrictedMode) return _meta.Teachers;
        if (topic?.DepartmentId is not int depId || depId <= 0)
        {
            return _meta.Teachers;
        }
        return _meta.Teachers
            .Where(t => t.DepartmentId == depId)
            .ToList();
    }
    private bool RoomExists(int roomId) => _meta?.Rooms.Any(r => r.Id == roomId) == true;
    // Визначає, чи вимагає тип заняття аудиторію.
    private bool LessonTypeRequiresRoom(int lessonTypeId)
    {
        if (lessonTypeId <= 0) return true;
        var metaType = _meta?.LessonTypes.FirstOrDefault(lt => lt.Id == lessonTypeId);
        if (metaType is not null)
        {
            return metaType.RequiresRoom;
        }
        var draft = _items.FirstOrDefault(i => i.LessonTypeId == lessonTypeId);
        return draft?.RequiresRoom ?? true;
    }
    private void RememberRoom(int lessonTypeId, int? roomId)
    {
        if (lessonTypeId <= 0 || roomId is not int rid || !RoomExists(rid)) return;
        _lessonTypeRoomCache[lessonTypeId] = rid;
    }
    private int? ResolveRoomForType(int lessonTypeId, bool requiresRoom, bool sameType)
    {
        if (!requiresRoom) return null;
        if (sameType && _edit?.RoomId is int current && RoomExists(current))
        {
            return current;
        }
        if (_lessonTypeRoomCache.TryGetValue(lessonTypeId, out var cached) && cached is int cachedRoom && RoomExists(cachedRoom))
        {
            return cachedRoom;
        }
        if (_roomId is int filtered && RoomExists(filtered))
        {
            return filtered;
        }
        return _meta?.Rooms.FirstOrDefault()?.Id;
    }
    // Оновлює тип заняття та підбирає аудиторію відповідно до правил.
    private void ApplyLessonType(int? lessonTypeId)
    {
        if (_edit is null) return;
        if (lessonTypeId is not int ltId)
        {
            var requiresRoomFallback = LessonTypeRequiresRoom(_edit.LessonTypeId);
            var roomFallback = ResolveRoomForType(_edit.LessonTypeId, requiresRoomFallback, sameType: true);
            _edit = _edit with { RequiresRoom = requiresRoomFallback, RoomId = roomFallback };
            return;
        }
        if (ltId <= 0)
        {
            _edit = _edit with { LessonTypeId = 0 };
            return;
        }
        if (_edit.LessonTypeId != ltId && _edit.RequiresRoom && _edit.RoomId is int previousRoom)
        {
            RememberRoom(_edit.LessonTypeId, previousRoom);
        }
        var requiresRoom = LessonTypeRequiresRoom(ltId);
        var sameType = _edit.LessonTypeId == ltId;
        var resolvedRoom = ResolveRoomForType(ltId, requiresRoom, sameType);
        _edit = _edit with
        {
            LessonTypeId = ltId,
            RequiresRoom = requiresRoom,
            RoomId = resolvedRoom
        };
    }
    // Гарантує, що обраний тип заняття дозволений для поточного режиму.
    private void EnsureAllowedLessonType()
    {
        if (_edit is null) return;
        if (_edit.LessonTypeId <= 0) return;
        var allowed = AllowedLessonTypes;
        if (allowed.Count == 0) return;
        var currentAllowed = allowed.Any(lt => lt.Id == _edit.LessonTypeId);
        var targetId = currentAllowed ? _edit.LessonTypeId : allowed.First().Id;
        ApplyLessonType(targetId);
        ClearTopicForFinalAssessment();
    }
    private void OnRoomChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var value = e.Value?.ToString();
        var roomId = int.TryParse(value, out var parsed) ? parsed : (int?)null;
        _edit = _edit with { RoomId = roomId };
        if (roomId is int rid)
        {
            RememberRoom(_edit.LessonTypeId, rid);
        }
    }
    // Нормалізує запит з урахуванням правил щодо аудиторій.
    private DraftUpsertRequest NormalizeRequest(DraftUpsertRequest request)
    {
        var actualRequiresRoom = LessonTypeRequiresRoom(request.LessonTypeId);
        var normalizedRoomId = actualRequiresRoom ? request.RoomId : null;
        return request with
        {
            RequiresRoom = actualRequiresRoom,
            RoomId = normalizedRoomId,
            ExpectedRevision = request.Id is null ? null : request.ExpectedRevision
        };
    }
    private DraftUpsertRequest ApplyTopicToRequest(DraftUpsertRequest request, int? topicId)
    {
        var normalizedTopicId = topicId;
        if (normalizedTopicId is int topicValue && FindTopic(request.ModuleId, topicValue) is null)
        {
            normalizedTopicId = null;
        }
        var updated = request with { ModuleTopicId = normalizedTopicId };
        if (normalizedTopicId is int resolvedTopicId)
        {
            var topic = FindTopic(request.ModuleId, resolvedTopicId);
            if (topic is not null)
            {
                updated = updated with { LessonTypeId = topic.LessonTypeId };
            }
        }
        return NormalizeRequest(updated);
    }
    private static string DraftLessonModeLabel(bool requiresRoom)
        => requiresRoom ? "Аудиторна година" : "Без аудиторії";
    private async Task OnModuleChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        _err = null;
        var previousEdit = _edit;
        var previousTopicIds = _editTopicIds.ToList();
        var editorLoadVersion = ++_editorLoadVersion;
        var moduleId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 0;
        _editTopicIds.Clear();
        _edit = previousEdit with
        {
            ModuleId = moduleId,
            ModuleTopicId = null,
            LessonTypeId = previousEdit.Id is null ? 0 : previousEdit.LessonTypeId
        };
        var loaded = await EnsureTopicsLoaded(moduleId, editorLoadVersion);
        if (!loaded)
        {
            if (editorLoadVersion == _editorLoadVersion
                && _edit is not null
                && _edit.Id == previousEdit.Id
                && _edit.ExpectedRevision == previousEdit.ExpectedRevision
                && _edit.ModuleId == moduleId)
            {
                _edit = previousEdit;
                _editTopicIds.Clear();
                foreach (var topicId in previousTopicIds)
                {
                    _editTopicIds.Add(topicId);
                }
            }
            return;
        }
        if (editorLoadVersion != _editorLoadVersion
            || _edit is null
            || _edit.Id != previousEdit.Id
            || _edit.ExpectedRevision != previousEdit.ExpectedRevision
            || _edit.ModuleId != moduleId)
        {
            return;
        }
        var topics = OrderedTopicsForModule(moduleId);
        if (_edit.Id is null)
        {
            return;
        }
        var shouldAttachTopic = !IsFinalAssessment(_edit.LessonTypeId);
        if (!shouldAttachTopic)
        {
            return;
        }
        var firstTopic = topics.FirstOrDefault();
        if (firstTopic is not null)
        {
            _editTopicIds.Add(firstTopic.Id);
            ApplyTopicSelection(firstTopic.Id);
        }
    }
    private void OnLessonTypeChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var ltId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        if (ltId is null || ltId <= 0)
        {
            _edit = _edit with { LessonTypeId = 0 };
            return;
        }
        ApplyLessonType(ltId);
        ClearTopicForFinalAssessment();
    }
    private void OnEditDateChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var raw = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw)) return;
        if (!DateOnly.TryParseExact(raw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newDate)
            && !DateOnly.TryParse(raw, out newDate))
        {
            return;
        }
        if (newDate < _weekStart || newDate > _weekStart.AddDays(6))
        {
            _err = "У цьому редакторі заняття можна переносити лише в межах поточного тижня.";
            return;
        }
        var previousSlots = DaySlotsFor(_edit.Date);
        var startIndex = ResolveSlotStartIndex(previousSlots, _edit.TimeStart);
        var endIndex = ResolveSlotEndIndex(previousSlots, _edit.TimeEnd, startIndex);
        var updated = _edit with { Date = newDate };
        var nextSlots = DaySlotsFor(newDate);
        if (nextSlots.Count > 0)
        {
            var normalizedStartIndex = Math.Clamp(startIndex < 0 ? 0 : startIndex, 0, nextSlots.Count - 1);
            var normalizedEndIndex = Math.Clamp(endIndex < 0 ? normalizedStartIndex : endIndex, normalizedStartIndex, nextSlots.Count - 1);
            updated = updated with
            {
                TimeStart = nextSlots[normalizedStartIndex].Start,
                TimeEnd = nextSlots[normalizedEndIndex].End
            };
        }
        _edit = updated;
    }
    private void OnEditStartSlotChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var slots = DaySlotsFor(_edit.Date);
        if (slots.Count == 0) return;
        var raw = e.Value?.ToString();
        if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var selectedNumber)) return;
        var startIndex = selectedNumber - 1;
        if (startIndex < 0 || startIndex >= slots.Count) return;
        var endIndex = ResolveSlotEndIndex(slots, _edit.TimeEnd, startIndex);
        endIndex = Math.Clamp(endIndex < 0 ? startIndex : endIndex, startIndex, slots.Count - 1);
        _edit = _edit with
        {
            TimeStart = slots[startIndex].Start,
            TimeEnd = slots[endIndex].End
        };
    }
    private void OnEditEndSlotChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var slots = DaySlotsFor(_edit.Date);
        if (slots.Count == 0) return;
        var raw = e.Value?.ToString();
        if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var selectedNumber)) return;
        var endIndex = selectedNumber - 1;
        if (endIndex < 0 || endIndex >= slots.Count) return;
        var startIndex = ResolveSlotStartIndex(slots, _edit.TimeStart);
        startIndex = Math.Clamp(startIndex < 0 ? 0 : startIndex, 0, slots.Count - 1);
        if (endIndex < startIndex)
        {
            startIndex = endIndex;
        }
        _edit = _edit with
        {
            TimeStart = slots[startIndex].Start,
            TimeEnd = slots[endIndex].End
        };
    }
    private List<SlotRow> DaySlotsFor(DateOnly date)
    {
        if (_slots.Count == 0) return _rows;
        var courseId = ResolveCourseIdForEdit();
        var scopedSlots = courseId is int cid
            ? _slots.Where(s => s.CourseId is null || s.CourseId == cid).ToList()
            : _slots;
        var dayNumber = DayNumberFromDate(date);
        var daySlots = scopedSlots
            .Where(s => s.DayOfWeek == dayNumber)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Start)
            .ThenBy(s => s.End)
            .Select(s => new SlotRow(s.Start, s.End))
            .ToList();
        if (daySlots.Count > 0) return daySlots;
        var fallback = scopedSlots
            .Where(s => s.DayOfWeek is null)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Start)
            .ThenBy(s => s.End)
            .Select(s => new SlotRow(s.Start, s.End))
            .ToList();
        if (fallback.Count > 0) return fallback;
        return _rows;
    }
    // Парсить час, що може мати секунди.
    private static TimeOnly ParseSlotTime(string value)
    {
        if (TimeOnly.TryParseExact(value, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }
        if (TimeOnly.TryParseExact(value, "HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed))
        {
            return parsed;
        }
        return TimeOnly.Parse(value, CultureInfo.InvariantCulture);
    }
    private static int ResolveSlotStartIndex(List<SlotRow> slots, string start)
    {
        if (slots.Count == 0) return -1;
        var exactIndex = slots.FindIndex(s => string.Equals(s.Start, start, StringComparison.Ordinal));
        if (exactIndex >= 0) return exactIndex;
        var targetTime = ParseSlotTime(start);
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotStart <= targetTime && targetTime < slotEnd)
            {
                return index;
            }
        }
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            if (slotStart > targetTime)
            {
                return Math.Max(0, index - 1);
            }
        }
        return slots.Count - 1;
    }
    private static int ResolveSlotEndIndex(List<SlotRow> slots, string end, int minIndex = -1)
    {
        if (slots.Count == 0) return -1;
        var normalizedMinIndex = Math.Max(minIndex, 0);
        var exactIndex = slots.FindIndex(s => string.Equals(s.End, end, StringComparison.Ordinal));
        if (exactIndex >= 0) return Math.Max(exactIndex, normalizedMinIndex);
        var targetTime = ParseSlotTime(end);
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotStart < targetTime && targetTime <= slotEnd)
            {
                return Math.Max(index, normalizedMinIndex);
            }
        }
        for (var index = 0; index < slots.Count; index++)
        {
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotEnd >= targetTime)
            {
                return Math.Max(index, normalizedMinIndex);
            }
        }
        return Math.Max(slots.Count - 1, normalizedMinIndex);
    }
    // Повертає послідовні слоти між обраними часами.
    private List<SlotRow> ResolveSlotRange(DateOnly date, string start, string end)
    {
        var slots = DaySlotsFor(date);
        var startTime = ParseSlotTime(start);
        var endTime = ParseSlotTime(end);
        var normalized = slots
            .Select(s => new { Row = s, Start = ParseSlotTime(s.Start), End = ParseSlotTime(s.End) })
            .ToList();
        var startIndex = normalized.FindIndex(s => s.Start == startTime);
        var endIndex = normalized.FindIndex(s => s.End == endTime);
        if (startIndex < 0 || endIndex < 0 || endIndex < startIndex)
        {
            return new List<SlotRow>();
        }
        return normalized.Skip(startIndex).Take(endIndex - startIndex + 1).Select(s => s.Row).ToList();
    }
    private string GetSlotNumberLabel(SlotRow slot, int slotIndex)
    {
        var configuredOrders = _slots
            .Where(configured => configured.IsActive
                                 && configured.Start == slot.Start
                                 && configured.End == slot.End
                                 && configured.SortOrder > 0)
            .Select(configured => configured.SortOrder)
            .Distinct()
            .Take(2)
            .ToList();
        if (configuredOrders.Count == 1)
        {
            return configuredOrders[0].ToString("00");
        }
        if (_rows.Count == 0) return (slotIndex + 1).ToString("00");
        var exactIndex = _rows.FindIndex(r => r.Start == slot.Start && r.End == slot.End);
        if (exactIndex >= 0) return (exactIndex + 1).ToString("00");
        var startIndex = _rows.FindIndex(r => r.Start == slot.Start);
        var endIndex = _rows.FindIndex(r => r.End == slot.End);
        if (startIndex >= 0 && endIndex >= 0 && endIndex >= startIndex)
        {
            return $"{startIndex + 1:00}-{endIndex + 1:00}";
        }
        return (slotIndex + 1).ToString("00");
    }
    // Повертає теми, що вже існують у межах поточного заняття.
    private List<int> ResolveEditScopeTopicIds(IEnumerable<TeacherDraftItemDto> logicalEventRows, int moduleId)
    {
        var topicIds = logicalEventRows
            .Select(existing => existing.ModuleTopicId)
            .Where(topicId => topicId is int and > 0)
            .Select(topicId => topicId!.Value)
            .Distinct()
            .ToList();
        return OrderedTopicIdsForModule(moduleId, topicIds);
    }
    // Не відкриває редактор для контексту, який користувач уже змінив під час очікування мережі.
    private bool IsEditorLoadCurrent(
        int version,
        DateOnly weekStart,
        int? courseId,
        int? groupId,
        int? teacherId,
        int? roomId)
        => version == _editorLoadVersion
           && weekStart == _weekStart
           && courseId == _courseId
           && groupId == _groupId
           && teacherId == _teacherId
           && roomId == _roomId
           && !IsDraftMutationBusy;
    // Готує форму редагування для існуючої чернетки.
    private async Task StartEdit(TeacherDraftItemDto item)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        if (item.Status != DraftStatusDto.Draft)
        {
            _err = "Схвалене заняття не можна редагувати. За потреби видаліть його в режимі без обмежень і створіть заново.";
            return;
        }
        if (item.IsLocked)
        {
            _err = "Зафіксоване заняття не можна редагувати. За потреби видаліть його в режимі без обмежень і створіть заново.";
            return;
        }
        _err = null;
        var editorLoadVersion = ++_editorLoadVersion;
        var requestedWeekStart = _weekStart;
        var requestedCourseId = _courseId;
        var requestedGroupId = _groupId;
        var requestedTeacherId = _teacherId;
        var requestedRoomId = _roomId;
        if (!await EnsureTopicsLoaded(item.ModuleId, editorLoadVersion)
            || !IsEditorLoadCurrent(
                editorLoadVersion,
                requestedWeekStart,
                requestedCourseId,
                requestedGroupId,
                requestedTeacherId,
                requestedRoomId))
        {
            return;
        }
        List<TeacherDraftItemDto> weekItems;
        try
        {
            weekItems = await DraftsApi.GetWeek(FirstMonday(item.Date), null);
        }
        catch (ApiErrorException ex)
        {
            if (!IsEditorLoadCurrent(
                    editorLoadVersion,
                    requestedWeekStart,
                    requestedCourseId,
                    requestedGroupId,
                    requestedTeacherId,
                    requestedRoomId))
            {
                return;
            }
            await HandleApiError(ex);
            return;
        }
        catch (Exception ex)
        {
            if (!IsEditorLoadCurrent(
                    editorLoadVersion,
                    requestedWeekStart,
                    requestedCourseId,
                    requestedGroupId,
                    requestedTeacherId,
                    requestedRoomId))
            {
                return;
            }
            _err = ex.Message;
            return;
        }
        if (!IsEditorLoadCurrent(
                editorLoadVersion,
                requestedWeekStart,
                requestedCourseId,
                requestedGroupId,
                requestedTeacherId,
                requestedRoomId))
        {
            return;
        }
        var currentItem = weekItems.FirstOrDefault(candidate => candidate.Id == item.Id);
        if (currentItem is null)
        {
            _err = $"Пара #{item.Id} вже не існує. Оновіть таблицю.";
            return;
        }
        if (!TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(item, currentItem))
        {
            _err = $"Пара #{item.Id} була змінена в іншому вікні. Оновіть таблицю перед редагуванням.";
            return;
        }
        var logicalEventRows = TeacherDraftEditMutationPlanner
            .SelectLogicalEventRows(weekItems, currentItem)
            .ToList();
        if (logicalEventRows.Any(row => row.IsLocked || row.Status != DraftStatusDto.Draft))
        {
            _err = "Логічне заняття містить зафіксовані або схвалені рядки й не може бути змінене частково.";
            return;
        }
        RememberRoom(currentItem.LessonTypeId, currentItem.RoomId);
        var initialRequest = new DraftUpsertRequest(
            Id: currentItem.Id,
            Date: currentItem.Date,
            TimeStart: currentItem.TimeStart,
            TimeEnd: currentItem.TimeEnd,
            GroupId: currentItem.GroupId,
            ModuleId: currentItem.ModuleId,
            ModuleTopicId: currentItem.ModuleTopicId,
            TeacherId: currentItem.TeacherId,
            RoomId: currentItem.RoomId,
            RequiresRoom: currentItem.RequiresRoom,
            LessonTypeId: IsNoneLessonType(currentItem) ? 0 : currentItem.LessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: currentItem.BatchKey,
            IsLocked: currentItem.IsLocked,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: currentItem.IsSelfStudy,
            ExpectedRevision: currentItem.Revision
        );
        _editSourceItem = currentItem;
        _editSourceRevisions.Clear();
        foreach (var row in logicalEventRows)
        {
            _editSourceRevisions[row.Id] = row.Revision;
        }
        _edit = NormalizeRequest(initialRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        var scopedTopicIds = ResolveEditScopeTopicIds(logicalEventRows, currentItem.ModuleId);
        if (scopedTopicIds.Count > 0)
        {
            foreach (var topicId in scopedTopicIds)
            {
                _editTopicIds.Add(topicId);
            }
        }
        else if (currentItem.ModuleTopicId is int topicId)
        {
            _editTopicIds.Add(topicId);
        }
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
        _extraGroups.Clear();
        _extraTeachers.Clear();
    }
    // Готує форму створення нової чернетки з типовими значеннями.
    private async Task StartCreate(int dayNumber, string start, string end, int groupId)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        _err = null;
        var editorLoadVersion = ++_editorLoadVersion;
        var requestedWeekStart = _weekStart;
        var requestedCourseId = _courseId;
        var requestedGroupId = _groupId;
        var requestedTeacherId = _teacherId;
        var requestedRoomId = _roomId;
        _extraGroups.Clear();
        _extraTeachers.Clear();
        _editSourceItem = null;
        _editSourceRevisions.Clear();
        if (_meta is null)
        {
            _err = "Метадані не завантажені для створення чернетки.";
            return;
        }
        var date = DayToDate(dayNumber);
        var module = _meta.Modules.FirstOrDefault();
        if (module is null)
        {
            _err = "Немає доступних модулів для створення чернетки.";
            return;
        }
        if (!await EnsureTopicsLoaded(module.Id, editorLoadVersion)
            || !IsEditorLoadCurrent(
                editorLoadVersion,
                requestedWeekStart,
                requestedCourseId,
                requestedGroupId,
                requestedTeacherId,
                requestedRoomId))
        {
            return;
        }
        var lessonTypeId = 0;
        var resolvedGroupId = groupId > 0 ? groupId : (_groupId ?? _meta.Groups.FirstOrDefault()?.Id);
        if (resolvedGroupId is null)
        {
            _err = "Немає доступних груп для створення чернетки.";
            return;
        }
        var requiresRoom = LessonTypeRequiresRoom(lessonTypeId);
        var resolvedRoomId = ResolveRoomForType(lessonTypeId, requiresRoom, sameType: false);
        if (requiresRoom && resolvedRoomId is null)
        {
            _err = "Немає доступних аудиторій для цього типу заняття.";
            return;
        }
        RememberRoom(lessonTypeId, resolvedRoomId);
        var draftRequest = new DraftUpsertRequest(
            Id: null,
            Date: date,
            TimeStart: start,
            TimeEnd: end,
            GroupId: resolvedGroupId.Value,
            ModuleId: module.Id,
            ModuleTopicId: null,
            TeacherId: requestedTeacherId,
            RoomId: resolvedRoomId,
            RequiresRoom: requiresRoom,
            LessonTypeId: lessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: null,
            IsLocked: false,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: false
        );
        _edit = NormalizeRequest(draftRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
    }
    private List<DateOnly> GetWeekDates()
        => Enumerable.Range(0, 7)
            .Select(offset => _weekStart.AddDays(offset))
            .ToList();
    private List<LookupDto> ResolveGroups(List<TeacherDraftItemDto> filtered)
    {
        if (_meta is null) return new List<LookupDto>();
        if (_groupId is int gid)
        {
            var match = _groupById.GetValueOrDefault(gid);
            return match is null ? new List<LookupDto>() : new List<LookupDto> { match };
        }
        if (_courseId is int cid)
        {
            var groupsByCourse = _meta.Groups
                .Where(g => g.CourseId == cid)
                .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            return groupsByCourse;
        }
        var ids = filtered.Select(i => i.GroupId).Distinct().ToHashSet();
        if (ids.Count == 0)
        {
            return _meta.Groups.OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
        var source = _meta.Groups.Where(g => ids.Contains(g.Id));
        return source
            .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }
