@page "/teacher-drafts"
@using System;
@using Microsoft.AspNetCore.Components;
@using System.Globalization
@using System.Linq
@using System.Net
@using System.Text.Json
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject ITeacherDraftsApi DraftsApi
@inject IJSRuntime JS
@inject AdminScheduleLogService LogService

<h3 class="page-title">
    Графік викладачів <span class="draft-pill">Чернетка</span>
    <span class="weak">(тиждень @_weekStart.ToString("yyyy-MM-dd"))</span>
</h3>

<div class="week-nav">
    <button class="btn btn-ghost" @onclick="PrevWeek">&lt; Попередній тиждень</button>
    <div class="week-label">
        @_weekStart.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", new CultureInfo("uk-UA")) -
        @_weekStart.AddDays(6).ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", new CultureInfo("uk-UA"))
    </div>
    <button class="btn btn-ghost" @onclick="NextWeek">Наступний тиждень &gt;</button>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "weekStart")]
    public string? QueryWeekStart { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "teacherId")]
    public int? QueryTeacherId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "groupId")]
    public int? QueryGroupId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "roomId")]
    public int? QueryRoomId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "courseId")]
    public int? QueryCourseId { get; set; }
    private MetaResponseDto? _meta;
    private int? _teacherId;
    private int? _groupId;
    private int? _roomId;
    private int? _courseId;
    private DateOnly _weekStart = FirstMonday(DateOnly.FromDateTime(DateTime.Today));
    private List<TeacherDraftItemDto> _items = new();
    private List<TimeSlotDto> _slots = new();
    private readonly List<ExtraGroupSelection> _extraGroups = new();
    private readonly List<ExtraTeacherSelection> _extraTeachers = new();
    private readonly Dictionary<int, List<ModuleTopicViewDto>> _topicsCache = new();
    private readonly Dictionary<int, int?> _lessonTypeRoomCache = new();
    private List<ModuleTopicViewDto> TopicsForModule(int moduleId) => _topicsCache.TryGetValue(moduleId, out var list) ? list : new List<ModuleTopicViewDto>();
    private List<IdCodeNameDto> AllowedLessonTypes =>
        _meta?.LessonTypes
            .Where(lt => !string.Equals(lt.Code, "NONE", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new();
    private int? NoneLessonTypeId =>
        _meta?.LessonTypes.FirstOrDefault(lt => string.Equals(lt.Code, "NONE", StringComparison.OrdinalIgnoreCase))?.Id;
    // Перевіряє, чи тип заняття є підсумковим контролем.
    private bool IsFinalAssessment(int? lessonTypeId)
    {
        if (lessonTypeId is not int ltId || _meta is null) return false;
        var code = _meta.LessonTypes.FirstOrDefault(lt => lt.Id == ltId)?.Code;
        return string.Equals(code, "EXAM", StringComparison.OrdinalIgnoreCase)
               || string.Equals(code, "CREDIT", StringComparison.OrdinalIgnoreCase);
    }
    // Для підсумкових контролів тема модуля не потрібна.
    private void ClearTopicForFinalAssessment()
    {
        if (_edit is null) return;
        if (IsFinalAssessment(_edit.LessonTypeId))
        {
            _edit = _edit with { ModuleTopicId = null };
            _editTopicIds.Clear();
        }
    }
    private DraftUpsertRequest? _edit;
    private bool _unrestrictedMode;
    private bool _isExporting;
    private readonly HashSet<int> _expandedWarningSlots = new();
    private readonly Dictionary<int, DraftValidationReportDto> _warningReports = new();
    private static readonly JsonSerializerOptions WarningJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private string? _ok, _err;
    private readonly HashSet<int> _bulkSelectedIds = new();
    private int? _bulkSelectedDayNumber;
    private readonly HashSet<int> _bulkTeacherIds = new();
    private int? _bulkRoomId;
    private int? _bulkModuleId;
    private readonly HashSet<int> _bulkTopicIds = new();
    private readonly HashSet<int> _editTopicIds = new();
    private bool _bulkApplying;
    private bool _bulkEditOpen;
    private ConflictDetails? _currentConflict;
    private Dictionary<string, ConflictDetails> _conflictStorage = new();
    private bool _conflictsLoaded;
    private static readonly JsonSerializerOptions ConflictJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private const string ConflictStorageKey = "teacherDrafts.conflicts.v1";
    private const string MixedTopicLessonTypeError = "Можна обрати кілька тем лише з однаковим типом заняття.";
    private record SlotRow(string Start, string End) { public string Label => $"{Start}-{End}"; }
    private List<SlotRow> _rows = new();
    private static readonly string[] UkrainianDayNames = { "Неділя", "Понеділок", "Вівторок", "Середа", "Четвер", "П'ятниця", "Субота" };
    private DragPayload? _dragPayload;
    private SlotKey? _dragHover;
    private bool _isProcessingDrop;
    private const int LogLessonLimit = 300;
    private const string LogActionCreate = "create-item";
    private const string LogActionDelete = "delete-item";
    private string CurrentConflictKey => $"{_weekStart:yyyy-MM-dd}|t:{_teacherId?.ToString() ?? "all"}|g:{_groupId?.ToString() ?? "all"}|r:{_roomId?.ToString() ?? "all"}|c:{_courseId?.ToString() ?? "all"}";
    // Фільтрує чернетки за поточними параметрами відбору.
    private IEnumerable<TeacherDraftItemDto> Filtered =>
        _items.Where(i =>
            (_teacherId is null || i.TeacherId == _teacherId) &&
            (_groupId is null || i.GroupId == _groupId) &&
            (_roomId is null || i.RoomId == _roomId) &&
            ModuleMatchesCourse(i.ModuleId, _courseId)
        );
    // Початкове завантаження метаданих, конфліктів та чернеток.
    protected override async Task OnInitializedAsync()
    {
        _meta = await Http.GetFromJsonAsync<MetaResponseDto>("api/meta");
        await LoadConflictsAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_meta is null)
        {
            return;
        }
        ApplyQueryFilters();
        await Reload();
    }
    // Застосовує фільтри, що прийшли з query string.
    private void ApplyQueryFilters()
    {
        _teacherId = NormalizeQueryId(QueryTeacherId);
        _groupId = NormalizeQueryId(QueryGroupId);
        _roomId = NormalizeQueryId(QueryRoomId);
        _courseId = NormalizeQueryId(QueryCourseId);
        if (DateOnly.TryParse(QueryWeekStart, out var weekStart))
        {
            _weekStart = FirstMonday(weekStart);
        }
    }
    // Нормалізує query-параметр і перетворює 0/від'ємні значення на відсутність фільтра.
    private static int? NormalizeQueryId(int? value)
        => value is > 0 ? value : null;
    // Перезавантажує чернетки, попередження та тайм-слоти для поточного тижня.
    private async Task Reload()
    {
        await LoadConflictsAsync();
        _ok = _err = null;
        _edit = null;
        _extraGroups.Clear();
        _extraTeachers.Clear();
        _topicsCache.Clear();
        ClearBulkSelection();
        var courseId = ResolveCourseIdForSlots();
        var slotsUrl = "api/admin/config/slots?includeDayOverrides=true";
        if (courseId is int cid)
        {
            slotsUrl += $"&courseId={cid}";
        }
        var draftsTask = DraftsApi.GetWeek(_weekStart, _teacherId);
        var slotsTask = Http.GetFromJsonAsync<EffectiveSlotsResponse>(slotsUrl);
        await Task.WhenAll(draftsTask, slotsTask);
        ApplyLoadedDraftItems(await draftsTask);
        var eff = await slotsTask;
        _slots = eff?.slots ?? new();
        _rows = _slots
            .Select(s => new SlotRow(s.Start, s.End))
            .GroupBy(x => (x.Start, x.End))
            .Select(g => g.First())
            .OrderBy(x => x.Start)
            .ToList();
    }
    private async Task ReloadDraftItemsOnlyAsync()
    {
        await LoadConflictsAsync();
        var items = await DraftsApi.GetWeek(_weekStart, _teacherId);
        ApplyLoadedDraftItems(items);
    }
    private void ApplyLoadedDraftItems(IReadOnlyList<TeacherDraftItemDto> items)
    {
        _items = items.ToList();
        _warningReports.Clear();
        foreach (var draft in _items)
        {
            var report = ParseWarningReport(draft.Warnings);
            if (report is not null)
            {
                _warningReports[draft.Id] = report;
            }
            if (draft.RequiresRoom && draft.RoomId is int rid && !_lessonTypeRoomCache.ContainsKey(draft.LessonTypeId))
            {
                _lessonTypeRoomCache[draft.LessonTypeId] = rid;
            }
        }
        _expandedWarningSlots.RemoveWhere(id => !_warningReports.ContainsKey(id));
        _bulkSelectedIds.RemoveWhere(id => !_items.Any(item => item.Id == id));
        if (_bulkSelectedIds.Count == 0)
        {
            _bulkSelectedDayNumber = null;
            if (_bulkEditOpen)
            {
                CloseBulkEdit();
            }
        }
        if (_edit?.Id is int editId && !_items.Any(item => item.Id == editId))
        {
            _edit = null;
            _editTopicIds.Clear();
        }
        SyncCurrentConflict();
    }
    private void RemoveDraftItemsFromState(IEnumerable<int> ids)
    {
        var idSet = ids.ToHashSet();
        if (idSet.Count == 0)
        {
            return;
        }
        _items.RemoveAll(item => idSet.Contains(item.Id));
        foreach (var id in idSet)
        {
            _warningReports.Remove(id);
            _expandedWarningSlots.Remove(id);
            _bulkSelectedIds.Remove(id);
        }
        if (_bulkSelectedIds.Count == 0)
        {
            _bulkSelectedDayNumber = null;
            if (_bulkEditOpen)
            {
                CloseBulkEdit();
            }
        }
        if (_edit?.Id is int editId && idSet.Contains(editId))
        {
            _edit = null;
            _editTopicIds.Clear();
        }
        SyncCurrentConflict();
    }
    // Експортує поточний тиждень у формат Excel.
    private async Task ExportScheduleAsync()
    {
        if (_isExporting) return;
        _isExporting = true;
        _err = null;
        try
        {
            var bytes = await DraftsApi.ExportWeek(_weekStart, _teacherId, _groupId, _roomId);
            if (bytes is null || bytes.Length == 0)
            {
                _err = "Не вдалося сформувати файл Excel.";
                return;
            }
            var fileName = $"Rozklad-{_weekStart:yyyyMMdd}.xlsx";
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadFromBytes", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _isExporting = false;
        }
    }
    // Публікує чернетку тижня до основного розкладу.
    private async Task PublishWeek()
    {
        _ok = _err = null;
        try
        {
            await DraftsApi.PublishWeek(new PublishWeekRequest(
                WeekStart: _weekStart,
                TeacherId: null
            ));
            _ok = "Опубліковано (перевір правила): створені пари додані у загальний розклад, невідповідні — пропущені.";
            await Reload();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
    }
    // Ліниво завантажує та кешує теми модуля.
    private async Task EnsureTopicsLoaded(int moduleId)
    {
        if (moduleId <= 0) return;
        if (_topicsCache.ContainsKey(moduleId)) return;
        try
        {
            var topics = await Http.GetFromJsonAsync<List<ModuleTopicViewDto>>($"api/admin/modules/{moduleId}/topics");
            _topicsCache[moduleId] = topics ?? new();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
            _topicsCache[moduleId] = new List<ModuleTopicViewDto>();
        }
    }
    private ModuleTopicViewDto? FindTopic(int moduleId, int? topicId)
    {
        if (moduleId <= 0 || topicId is null) return null;
        return TopicsForModule(moduleId).FirstOrDefault(t => t.Id == topicId);
    }
    private List<ModuleTopicViewDto> OrderedTopicsForModule(int moduleId)
        => TopicsForModule(moduleId)
            .OrderBy(t => t.Order)
            .ThenBy(t => t.TopicCode, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(t => t.Id)
            .ToList();
    private List<int> OrderedTopicIdsForModule(int moduleId, IEnumerable<int> topicIds)
    {
        var selected = topicIds.ToHashSet();
        if (selected.Count == 0)
        {
            return new List<int>();
        }
        return OrderedTopicsForModule(moduleId)
            .Where(t => selected.Contains(t.Id))
            .Select(t => t.Id)
            .ToList();
    }
    // Перевіряє, чи всі обрані теми належать до одного типу заняття.
    private bool TopicsShareSingleLessonType(int moduleId, IReadOnlyCollection<int> topicIds, out int? lessonTypeId)
    {
        lessonTypeId = null;
        if (topicIds.Count == 0)
        {
            return true;
        }
        var orderedTopics = OrderedTopicsForModule(moduleId)
            .Where(topic => topicIds.Contains(topic.Id))
            .ToList();
        if (orderedTopics.Count == 0)
        {
            return true;
        }
        var firstLessonTypeId = orderedTopics[0].LessonTypeId;
        if (orderedTopics.Any(topic => topic.LessonTypeId != firstLessonTypeId))
        {
            return false;
        }
        lessonTypeId = firstLessonTypeId;
        return true;
    }
    private int? ResolvePrimaryEditTopicId()
    {
        if (_edit is null) return null;
        var ordered = OrderedTopicIdsForModule(_edit.ModuleId, _editTopicIds);
        return ordered.Count == 0 ? null : ordered[0];
    }
    private List<int> ResolveOrderedEditTopicIds()
    {
        if (_edit is null) return new List<int>();
        return OrderedTopicIdsForModule(_edit.ModuleId, _editTopicIds);
    }
    private void ApplySelectedEditTopics()
    {
        if (_edit is null) return;
        var primaryTopicId = ResolvePrimaryEditTopicId();
        ApplyTopicSelection(primaryTopicId);
        if (primaryTopicId is null && _edit.Id is null)
        {
            _edit = _edit with { LessonTypeId = 0 };
        }
        ClearTopicForFinalAssessment();
    }
    private void ToggleEditTopic(ChangeEventArgs args, int topicId)
    {
        if (_edit is null) return;
        if (IsChecked(args))
        {
            var proposed = _editTopicIds.Append(topicId).ToHashSet();
            if (!TopicsShareSingleLessonType(_edit.ModuleId, proposed, out _))
            {
                _err = MixedTopicLessonTypeError;
                return;
            }
            _editTopicIds.Add(topicId);
        }
        else
        {
            _editTopicIds.Remove(topicId);
        }
        _err = null;
        ApplySelectedEditTopics();
    }
    private void SelectAllEditTopics()
    {
        if (_edit is null) return;
        var allTopicIds = OrderedTopicsForModule(_edit.ModuleId)
            .Select(topic => topic.Id)
            .ToList();
        if (!TopicsShareSingleLessonType(_edit.ModuleId, allTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        _editTopicIds.Clear();
        foreach (var topicId in allTopicIds)
        {
            _editTopicIds.Add(topicId);
        }
        _err = null;
        ApplySelectedEditTopics();
    }
    private void ClearEditTopics()
    {
        if (_edit is null) return;
        _editTopicIds.Clear();
        _err = null;
        ApplySelectedEditTopics();
    }
    private void ToggleBulkTopic(ChangeEventArgs args, int topicId)
    {
        if (IsChecked(args))
        {
            var moduleId = ResolveEffectiveBulkModuleId();
            if (moduleId is int mid)
            {
                var proposed = _bulkTopicIds.Append(topicId).ToHashSet();
                if (!TopicsShareSingleLessonType(mid, proposed, out _))
                {
                    _err = MixedTopicLessonTypeError;
                    return;
                }
            }
            _bulkTopicIds.Add(topicId);
        }
        else
        {
            _bulkTopicIds.Remove(topicId);
        }
        _err = null;
    }
    private void SelectAllBulkTopics()
    {
        var moduleId = ResolveEffectiveBulkModuleId();
        if (moduleId is not int mid) return;
        var allTopicIds = OrderedTopicsForModule(mid)
            .Select(topic => topic.Id)
            .ToList();
        if (!TopicsShareSingleLessonType(mid, allTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        _bulkTopicIds.Clear();
        foreach (var topicId in allTopicIds)
        {
            _bulkTopicIds.Add(topicId);
        }
        _err = null;
    }
    private void ClearBulkTopics()
    {
        _bulkTopicIds.Clear();
        _err = null;
    }
    private int? ResolveSingleSelectedModuleId()
    {
        var moduleIds = _items
            .Where(i => _bulkSelectedIds.Contains(i.Id))
            .Select(i => i.ModuleId)
            .Distinct()
            .Take(2)
            .ToList();
        return moduleIds.Count == 1 ? moduleIds[0] : null;
    }
    private int? ResolveEffectiveBulkModuleId()
    {
        if (_bulkModuleId is int moduleId)
        {
            return moduleId;
        }
        return ResolveSingleSelectedModuleId();
    }
    private async Task OnBulkModuleChanged(ChangeEventArgs e)
    {
        _bulkModuleId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        _bulkTopicIds.Clear();
        var effectiveModuleId = ResolveEffectiveBulkModuleId();
        if (effectiveModuleId is int moduleId)
        {
            await EnsureTopicsLoaded(moduleId);
        }
    }
    // Застосовує вибір теми й синхронізує залежні поля (тип заняття, викладач).
    private void ApplyTopicSelection(int? topicId)
    {
        if (_edit is null) return;
        if (topicId is int tId)
        {
            var topic = FindTopic(_edit.ModuleId, tId);
            if (topic is not null)
            {
                _edit = _edit with { ModuleTopicId = tId };
                ApplyLessonType(topic.LessonTypeId);
                if (!_unrestrictedMode
                    && topic.DepartmentId is int depId
                    && depId > 0
                    && _edit.TeacherId is int teacherId
                    && _meta?.Teachers.FirstOrDefault(x => x.Id == teacherId)?.DepartmentId != depId)
                {
                    _edit = _edit with { TeacherId = null };
                    _err = "Обраний викладач не належить до кафедри цієї теми, тому його вибір скинуто.";
                }
                return;
            }
        }
        _edit = _edit with { ModuleTopicId = null };
    }
    // Формує список доступних викладачів з урахуванням кафедри.
    private List<LookupDto> AllowedTeachersForTopic(ModuleTopicViewDto? topic)
    {
        if (_meta is null) return new List<LookupDto>();
        if (_unrestrictedMode) return _meta.Teachers;
        if (topic?.DepartmentId is not int depId || depId <= 0)
        {
            return _meta.Teachers;
        }
        return _meta.Teachers
            .Where(t => t.DepartmentId == depId)
            .ToList();
    }
    private bool RoomExists(int roomId) => _meta?.Rooms.Any(r => r.Id == roomId) == true;
    // Визначає, чи вимагає тип заняття аудиторію.
    private bool LessonTypeRequiresRoom(int lessonTypeId)
    {
        if (lessonTypeId <= 0) return true;
        var metaType = _meta?.LessonTypes.FirstOrDefault(lt => lt.Id == lessonTypeId);
        if (metaType is not null)
        {
            return metaType.RequiresRoom;
        }
        var draft = _items.FirstOrDefault(i => i.LessonTypeId == lessonTypeId);
        return draft?.RequiresRoom ?? true;
    }
    private void RememberRoom(int lessonTypeId, int? roomId)
    {
        if (lessonTypeId <= 0 || roomId is not int rid || !RoomExists(rid)) return;
        _lessonTypeRoomCache[lessonTypeId] = rid;
    }
    private int? ResolveRoomForType(int lessonTypeId, bool requiresRoom, bool sameType)
    {
        if (!requiresRoom) return null;
        if (sameType && _edit?.RoomId is int current && RoomExists(current))
        {
            return current;
        }
        if (_lessonTypeRoomCache.TryGetValue(lessonTypeId, out var cached) && cached is int cachedRoom && RoomExists(cachedRoom))
        {
            return cachedRoom;
        }
        if (_roomId is int filtered && RoomExists(filtered))
        {
            return filtered;
        }
        return _meta?.Rooms.FirstOrDefault()?.Id;
    }
    // Оновлює тип заняття та підбирає аудиторію відповідно до правил.
    private void ApplyLessonType(int? lessonTypeId)
    {
        if (_edit is null) return;
        if (lessonTypeId is not int ltId)
        {
            var requiresRoomFallback = LessonTypeRequiresRoom(_edit.LessonTypeId);
            var roomFallback = ResolveRoomForType(_edit.LessonTypeId, requiresRoomFallback, sameType: true);
            _edit = _edit with { RequiresRoom = requiresRoomFallback, RoomId = roomFallback };
            return;
        }
        if (ltId <= 0)
        {
            _edit = _edit with { LessonTypeId = 0 };
            return;
        }
        if (_edit.LessonTypeId != ltId && _edit.RequiresRoom && _edit.RoomId is int previousRoom)
        {
            RememberRoom(_edit.LessonTypeId, previousRoom);
        }
        var requiresRoom = LessonTypeRequiresRoom(ltId);
        var sameType = _edit.LessonTypeId == ltId;
        var resolvedRoom = ResolveRoomForType(ltId, requiresRoom, sameType);
        _edit = _edit with
        {
            LessonTypeId = ltId,
            RequiresRoom = requiresRoom,
            RoomId = resolvedRoom
        };
    }
    // Гарантує, що обраний тип заняття дозволений для поточного режиму.
    private void EnsureAllowedLessonType()
    {
        if (_edit is null) return;
        if (_edit.LessonTypeId <= 0) return;
        var allowed = AllowedLessonTypes;
        if (allowed.Count == 0) return;
        var currentAllowed = allowed.Any(lt => lt.Id == _edit.LessonTypeId);
        var targetId = currentAllowed ? _edit.LessonTypeId : allowed.First().Id;
        ApplyLessonType(targetId);
        ClearTopicForFinalAssessment();
    }
    private void OnRoomChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var value = e.Value?.ToString();
        var roomId = int.TryParse(value, out var parsed) ? parsed : (int?)null;
        _edit = _edit with { RoomId = roomId };
        if (roomId is int rid)
        {
            RememberRoom(_edit.LessonTypeId, rid);
        }
    }
    // Нормалізує запит з урахуванням правил щодо аудиторій.
    private DraftUpsertRequest NormalizeRequest(DraftUpsertRequest request)
    {
        var actualRequiresRoom = LessonTypeRequiresRoom(request.LessonTypeId);
        var normalizedRoomId = actualRequiresRoom ? request.RoomId : null;
        return request with
        {
            RequiresRoom = actualRequiresRoom,
            RoomId = normalizedRoomId
        };
    }
    private DraftUpsertRequest ApplyTopicToRequest(DraftUpsertRequest request, int? topicId)
    {
        var normalizedTopicId = topicId;
        if (normalizedTopicId is int topicValue && FindTopic(request.ModuleId, topicValue) is null)
        {
            normalizedTopicId = null;
        }
        var updated = request with { ModuleTopicId = normalizedTopicId };
        if (normalizedTopicId is int resolvedTopicId)
        {
            var topic = FindTopic(request.ModuleId, resolvedTopicId);
            if (topic is not null)
            {
                updated = updated with { LessonTypeId = topic.LessonTypeId };
            }
        }
        return NormalizeRequest(updated);
    }
    private static string DraftLessonModeLabel(bool requiresRoom)
        => requiresRoom ? "Аудиторна година" : "Без аудиторії";
    private async Task OnModuleChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var moduleId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 0;
        await EnsureTopicsLoaded(moduleId);
        var topics = OrderedTopicsForModule(moduleId);
        _editTopicIds.Clear();
        _edit = _edit with { ModuleId = moduleId, ModuleTopicId = null };
        if (_edit.Id is null)
        {
            _edit = _edit with { LessonTypeId = 0 };
            return;
        }
        var shouldAttachTopic = !IsFinalAssessment(_edit.LessonTypeId);
        if (!shouldAttachTopic)
        {
            return;
        }
        var firstTopic = topics.FirstOrDefault();
        if (firstTopic is not null)
        {
            _editTopicIds.Add(firstTopic.Id);
            ApplyTopicSelection(firstTopic.Id);
        }
    }
    private void OnLessonTypeChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var ltId = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        if (ltId is null || ltId <= 0)
        {
            _edit = _edit with { LessonTypeId = 0 };
            return;
        }
        ApplyLessonType(ltId);
        ClearTopicForFinalAssessment();
    }
    private void OnEditDateChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var raw = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw)) return;
        if (!DateOnly.TryParseExact(raw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var newDate)
            && !DateOnly.TryParse(raw, out newDate))
        {
            return;
        }
        var previousSlots = DaySlotsFor(_edit.Date);
        var startIndex = ResolveSlotStartIndex(previousSlots, _edit.TimeStart);
        var endIndex = ResolveSlotEndIndex(previousSlots, _edit.TimeEnd, startIndex);
        var updated = _edit with { Date = newDate };
        var nextSlots = DaySlotsFor(newDate);
        if (nextSlots.Count > 0)
        {
            var normalizedStartIndex = Math.Clamp(startIndex < 0 ? 0 : startIndex, 0, nextSlots.Count - 1);
            var normalizedEndIndex = Math.Clamp(endIndex < 0 ? normalizedStartIndex : endIndex, normalizedStartIndex, nextSlots.Count - 1);
            updated = updated with
            {
                TimeStart = nextSlots[normalizedStartIndex].Start,
                TimeEnd = nextSlots[normalizedEndIndex].End
            };
        }
        _edit = updated;
    }
    private void OnEditStartSlotChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var slots = DaySlotsFor(_edit.Date);
        if (slots.Count == 0) return;
        var raw = e.Value?.ToString();
        if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var selectedNumber)) return;
        var startIndex = selectedNumber - 1;
        if (startIndex < 0 || startIndex >= slots.Count) return;
        var endIndex = ResolveSlotEndIndex(slots, _edit.TimeEnd, startIndex);
        endIndex = Math.Clamp(endIndex < 0 ? startIndex : endIndex, startIndex, slots.Count - 1);
        _edit = _edit with
        {
            TimeStart = slots[startIndex].Start,
            TimeEnd = slots[endIndex].End
        };
    }
    private void OnEditEndSlotChanged(ChangeEventArgs e)
    {
        if (_edit is null) return;
        var slots = DaySlotsFor(_edit.Date);
        if (slots.Count == 0) return;
        var raw = e.Value?.ToString();
        if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var selectedNumber)) return;
        var endIndex = selectedNumber - 1;
        if (endIndex < 0 || endIndex >= slots.Count) return;
        var startIndex = ResolveSlotStartIndex(slots, _edit.TimeStart);
        startIndex = Math.Clamp(startIndex < 0 ? 0 : startIndex, 0, slots.Count - 1);
        if (endIndex < startIndex)
        {
            startIndex = endIndex;
        }
        _edit = _edit with
        {
            TimeStart = slots[startIndex].Start,
            TimeEnd = slots[endIndex].End
        };
    }
    private List<SlotRow> DaySlotsFor(DateOnly date)
    {
        if (_slots.Count == 0) return _rows;
        var courseId = ResolveCourseIdForEdit();
        var scopedSlots = courseId is int cid
            ? _slots.Where(s => s.CourseId is null || s.CourseId == cid).ToList()
            : _slots;
        var dayNumber = DayNumberFromDate(date);
        var daySlots = scopedSlots
            .Where(s => s.DayOfWeek == dayNumber)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Start)
            .ThenBy(s => s.End)
            .Select(s => new SlotRow(s.Start, s.End))
            .ToList();
        if (daySlots.Count > 0) return daySlots;
        var fallback = scopedSlots
            .Where(s => s.DayOfWeek is null)
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Start)
            .ThenBy(s => s.End)
            .Select(s => new SlotRow(s.Start, s.End))
            .ToList();
        if (fallback.Count > 0) return fallback;
        return _rows;
    }
    // Парсить час, що може мати секунди.
    private static TimeOnly ParseSlotTime(string value)
    {
        if (TimeOnly.TryParseExact(value, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }
        if (TimeOnly.TryParseExact(value, "HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed))
        {
            return parsed;
        }
        return TimeOnly.Parse(value, CultureInfo.InvariantCulture);
    }
    private static int ResolveSlotStartIndex(List<SlotRow> slots, string start)
    {
        if (slots.Count == 0) return -1;
        var exactIndex = slots.FindIndex(s => string.Equals(s.Start, start, StringComparison.Ordinal));
        if (exactIndex >= 0) return exactIndex;
        var targetTime = ParseSlotTime(start);
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotStart <= targetTime && targetTime < slotEnd)
            {
                return index;
            }
        }
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            if (slotStart > targetTime)
            {
                return Math.Max(0, index - 1);
            }
        }
        return slots.Count - 1;
    }
    private static int ResolveSlotEndIndex(List<SlotRow> slots, string end, int minIndex = -1)
    {
        if (slots.Count == 0) return -1;
        var normalizedMinIndex = Math.Max(minIndex, 0);
        var exactIndex = slots.FindIndex(s => string.Equals(s.End, end, StringComparison.Ordinal));
        if (exactIndex >= 0) return Math.Max(exactIndex, normalizedMinIndex);
        var targetTime = ParseSlotTime(end);
        for (var index = 0; index < slots.Count; index++)
        {
            var slotStart = ParseSlotTime(slots[index].Start);
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotStart < targetTime && targetTime <= slotEnd)
            {
                return Math.Max(index, normalizedMinIndex);
            }
        }
        for (var index = 0; index < slots.Count; index++)
        {
            var slotEnd = ParseSlotTime(slots[index].End);
            if (slotEnd >= targetTime)
            {
                return Math.Max(index, normalizedMinIndex);
            }
        }
        return Math.Max(slots.Count - 1, normalizedMinIndex);
    }
    // Повертає послідовні слоти між обраними часами.
    private List<SlotRow> ResolveSlotRange(DateOnly date, string start, string end)
    {
        var slots = DaySlotsFor(date);
        var startTime = ParseSlotTime(start);
        var endTime = ParseSlotTime(end);
        var normalized = slots
            .Select(s => new { Row = s, Start = ParseSlotTime(s.Start), End = ParseSlotTime(s.End) })
            .ToList();
        var startIndex = normalized.FindIndex(s => s.Start == startTime);
        var endIndex = normalized.FindIndex(s => s.End == endTime);
        if (startIndex < 0 || endIndex < 0 || endIndex < startIndex)
        {
            return new List<SlotRow>();
        }
        return normalized.Skip(startIndex).Take(endIndex - startIndex + 1).Select(s => s.Row).ToList();
    }
    private string GetSlotNumberLabel(SlotRow slot, int slotIndex)
    {
        if (_rows.Count == 0) return (slotIndex + 1).ToString("00");
        var exactIndex = _rows.FindIndex(r => r.Start == slot.Start && r.End == slot.End);
        if (exactIndex >= 0) return (exactIndex + 1).ToString("00");
        var startIndex = _rows.FindIndex(r => r.Start == slot.Start);
        var endIndex = _rows.FindIndex(r => r.End == slot.End);
        if (startIndex >= 0 && endIndex >= 0 && endIndex >= startIndex)
        {
            return $"{startIndex + 1:00}-{endIndex + 1:00}";
        }
        return (slotIndex + 1).ToString("00");
    }
    // Визначає, чи записи належать до одного заняття для редагування набору тем.
    private static bool IsSameEditTopicScope(TeacherDraftItemDto left, TeacherDraftItemDto right)
        => left.Date == right.Date
           && left.TimeStart == right.TimeStart
           && left.TimeEnd == right.TimeEnd
           && left.GroupId == right.GroupId
           && left.ModuleId == right.ModuleId
           && left.LessonTypeId == right.LessonTypeId
           && left.RoomId == right.RoomId
           && left.IsSelfStudy == right.IsSelfStudy
           && left.TeacherId == right.TeacherId;
    // Повертає теми, що вже існують у межах поточного заняття.
    private List<int> ResolveEditScopeTopicIds(TeacherDraftItemDto item)
    {
        var topicIds = _items
            .Where(existing => IsSameEditTopicScope(item, existing))
            .Select(existing => existing.ModuleTopicId)
            .Where(topicId => topicId is int and > 0)
            .Select(topicId => topicId!.Value)
            .Distinct()
            .ToList();
        return OrderedTopicIdsForModule(item.ModuleId, topicIds);
    }
    // Готує форму редагування для існуючої чернетки.
    private async Task StartEdit(TeacherDraftItemDto item)
    {
        await EnsureTopicsLoaded(item.ModuleId);
        RememberRoom(item.LessonTypeId, item.RoomId);
        var initialRequest = new DraftUpsertRequest(
            Id: item.Id,
            Date: item.Date,
            TimeStart: item.TimeStart,
            TimeEnd: item.TimeEnd,
            GroupId: item.GroupId,
            ModuleId: item.ModuleId,
            ModuleTopicId: item.ModuleTopicId,
            TeacherId: item.TeacherId,
            RoomId: item.RoomId,
            RequiresRoom: item.RequiresRoom,
            LessonTypeId: IsNoneLessonType(item) ? 0 : item.LessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: item.BatchKey,
            IsLocked: item.IsLocked,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: item.IsSelfStudy
        );
        _edit = NormalizeRequest(initialRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        var scopedTopicIds = ResolveEditScopeTopicIds(item);
        if (scopedTopicIds.Count > 0)
        {
            foreach (var topicId in scopedTopicIds)
            {
                _editTopicIds.Add(topicId);
            }
        }
        else if (item.ModuleTopicId is int topicId)
        {
            _editTopicIds.Add(topicId);
        }
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
        _extraGroups.Clear();
        _extraTeachers.Clear();
    }
    // Готує форму створення нової чернетки з типовими значеннями.
    private async Task StartCreate(int dayNumber, string start, string end, int groupId)
    {
        _extraGroups.Clear();
        _extraTeachers.Clear();
        if (_meta is null)
        {
            _err = "Метадані не завантажені для створення чернетки.";
            return;
        }
        var date = DayToDate(dayNumber);
        var module = _meta.Modules.FirstOrDefault();
        if (module is null)
        {
            _err = "Немає доступних модулів для створення чернетки.";
            return;
        }
        await EnsureTopicsLoaded(module.Id);
        var lessonTypeId = 0;
        var resolvedGroupId = groupId > 0 ? groupId : (_groupId ?? _meta.Groups.FirstOrDefault()?.Id);
        if (resolvedGroupId is null)
        {
            _err = "Немає доступних груп для створення чернетки.";
            return;
        }
        var requiresRoom = LessonTypeRequiresRoom(lessonTypeId);
        var resolvedRoomId = ResolveRoomForType(lessonTypeId, requiresRoom, sameType: false);
        if (requiresRoom && resolvedRoomId is null)
        {
            _err = "Немає доступних аудиторій для цього типу заняття.";
            return;
        }
        RememberRoom(lessonTypeId, resolvedRoomId);
        var draftRequest = new DraftUpsertRequest(
            Id: null,
            Date: date,
            TimeStart: start,
            TimeEnd: end,
            GroupId: resolvedGroupId.Value,
            ModuleId: module.Id,
            ModuleTopicId: null,
            TeacherId: _teacherId,
            RoomId: resolvedRoomId,
            RequiresRoom: requiresRoom,
            LessonTypeId: lessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: null,
            IsLocked: false,
            IgnoreValidationErrors: _unrestrictedMode,
            IsSelfStudy: false
        );
        _edit = NormalizeRequest(draftRequest);
        ApplyLessonType(_edit.LessonTypeId);
        _editTopicIds.Clear();
        ApplySelectedEditTopics();
        EnsureAllowedLessonType();
    }
    private List<DateOnly> GetWeekDates()
        => Enumerable.Range(0, 7)
            .Select(offset => _weekStart.AddDays(offset))
            .ToList();
    private List<LookupDto> ResolveGroups(List<TeacherDraftItemDto> filtered)
    {
        if (_meta is null) return new List<LookupDto>();
        if (_groupId is int gid)
        {
            var match = _meta.Groups.FirstOrDefault(g => g.Id == gid);
            return match is null ? new List<LookupDto>() : new List<LookupDto> { match };
        }
        if (_courseId is int cid)
        {
            var groupsByCourse = _meta.Groups
                .Where(g => g.CourseId == cid)
                .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            if (groupsByCourse.Count > 0)
            {
                return groupsByCourse;
            }
        }
        var ids = filtered.Select(i => i.GroupId).Distinct().ToHashSet();
        if (ids.Count == 0)
        {
            return _meta.Groups.OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
        var source = _meta.Groups.Where(g => ids.Contains(g.Id));
        return source
            .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }
    private ModuleMetaDto? FindModule(int moduleId) => _meta?.Modules.FirstOrDefault(m => m.Id == moduleId);
    private int? ModuleCourseId(int moduleId) => FindModule(moduleId)?.CourseId;
    private bool ModuleMatchesCourse(int moduleId, int? courseId)
    {
        if (courseId is null) return true;
        var module = FindModule(moduleId);
        if (module is null) return false;
        if (module.CourseId == courseId) return true;
        return module.CourseIds.Contains(courseId.Value);
    }
    private string ModuleCourseCaption(int moduleId)
    {
        var course = FindModule(moduleId)?.CourseName;
        return string.IsNullOrWhiteSpace(course) ? string.Empty : course!;
    }
    private static string ModuleOptionCaption(ModuleMetaDto module)
    {
        var codePart = string.IsNullOrWhiteSpace(module.Code) ? null : module.Code.Trim();
        var title = codePart is null ? module.Name : $"{codePart} {module.Name}";
        var course = string.IsNullOrWhiteSpace(module.CourseName) ? null : module.CourseName.Trim();
        return course is null ? title : $"{title} - {course}";
    }
    private IEnumerable<LookupDto> CourseScopedGroups()
    {
        if (_meta is null) return Enumerable.Empty<LookupDto>();
        if (_courseId is null)
        {
            return _meta.Groups.OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
        var matchedByCourse = _meta.Groups
            .Where(g => g.CourseId == _courseId)
            .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        if (matchedByCourse.Count > 0) return matchedByCourse;
        var ids = _items
            .Where(i => ModuleMatchesCourse(i.ModuleId, _courseId))
            .Select(i => i.GroupId)
            .Distinct()
            .ToHashSet();
        return _meta.Groups
            .Where(g => ids.Contains(g.Id))
            .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }
    private static string TopicOptionCaption(ModuleTopicViewDto topic)
    {
        var codePart = string.IsNullOrWhiteSpace(topic.TopicCode) ? null : topic.TopicCode.Trim();
        var caption = codePart ?? string.Empty;
        if (topic.SelfStudyBySupervisor && topic.SelfStudyHours > 0)
        {
            caption = string.IsNullOrWhiteSpace(caption) ? "Самостійні години (керівник)" : $"{caption} | керівник";
        }
        return caption;
    }
    // Перевіряє, чи можна агрегувати записи в межах однієї клітинки розкладу.
    private static bool IsSameCellDisplayScope(TeacherDraftItemDto left, TeacherDraftItemDto right)
        => left.ModuleId == right.ModuleId
           && left.LessonTypeId == right.LessonTypeId
           && left.RoomId == right.RoomId
           && left.IsSelfStudy == right.IsSelfStudy;
    // Перевіряє, чи тип заняття можна візуально об'єднати між групами як лекцію.
    private static bool IsLectureTypeForGroupMerge(TeacherDraftItemDto item)
    {
        if (item.IsSelfStudy || IsBreak(item) || IsCanceled(item))
        {
            return false;
        }
        var code = item.LessonTypeCode?.Trim();
        if (!string.IsNullOrWhiteSpace(code))
        {
            if (string.Equals(code, "LECTURE", StringComparison.OrdinalIgnoreCase)
                || string.Equals(code, "LECT", StringComparison.OrdinalIgnoreCase)
                || string.Equals(code, "LEC", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        var name = item.LessonTypeName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return false;
        }
        return name.Contains("ЛЕКЦ", StringComparison.CurrentCultureIgnoreCase)
               || name.Contains("LECTURE", StringComparison.OrdinalIgnoreCase);
    }
    // Перевіряє, чи в обох елементів збігається призначення викладача.
    private static bool HasSameTeacherForGroupMerge(TeacherDraftItemDto left, TeacherDraftItemDto right)
    {
        if (left.TeacherId.HasValue || right.TeacherId.HasValue)
        {
            return left.TeacherId == right.TeacherId;
        }
        var leftTeacher = left.Teacher?.Trim();
        var rightTeacher = right.Teacher?.Trim();
        return string.Equals(leftTeacher, rightTeacher, StringComparison.CurrentCultureIgnoreCase);
    }
    // Перевіряє, чи дві клітинки можна показати як одну спільну лекцію.
    private static bool CanMergeLectureAcrossGroups(TeacherDraftItemDto left, TeacherDraftItemDto right)
    {
        if (!IsLectureTypeForGroupMerge(left) || !IsLectureTypeForGroupMerge(right))
        {
            return false;
        }
        return left.ModuleId == right.ModuleId
               && left.LessonTypeId == right.LessonTypeId
               && left.RoomId == right.RoomId
               && left.ModuleTopicId == right.ModuleTopicId
               && HasSameTeacherForGroupMerge(left, right);
    }
    // Обчислює ширину об'єднаного блоку лекції (в кількості групових колонок).
    private static int ResolveGroupMergeSpan(
        Dictionary<(int DayNumber, string Start, string End, int GroupId), TeacherDraftItemDto> lookup,
        int dayNumber,
        SlotRow slot,
        IReadOnlyList<LookupDto> groups,
        int startGroupIndex)
    {
        if (startGroupIndex < 0 || startGroupIndex >= groups.Count)
        {
            return 1;
        }
        var anchorGroup = groups[startGroupIndex];
        var anchorItem = FindItem(lookup, dayNumber, slot, anchorGroup.Id);
        if (anchorItem is null || !IsLectureTypeForGroupMerge(anchorItem))
        {
            return 1;
        }
        var span = 1;
        for (var index = startGroupIndex + 1; index < groups.Count; index++)
        {
            var nextItem = FindItem(lookup, dayNumber, slot, groups[index].Id);
            if (nextItem is null || !CanMergeLectureAcrossGroups(anchorItem, nextItem))
            {
                break;
            }
            span++;
        }
        return span;
    }
    // Формує підпис переліку груп, що входять до спільної лекції.
    private static string BuildMergedGroupsLabel(IReadOnlyList<LookupDto> groups, int startGroupIndex, int span)
    {
        if (span <= 1 || startGroupIndex < 0 || startGroupIndex >= groups.Count)
        {
            return string.Empty;
        }
        return string.Join(", ", groups.Skip(startGroupIndex).Take(span).Select(group => group.Name));
    }
    // Будує словник для швидкого пошуку елементів у таблиці.
    private static Dictionary<(int DayNumber, string Start, string End, int GroupId), TeacherDraftItemDto> BuildLookup(IEnumerable<TeacherDraftItemDto> items)
        => items
            .GroupBy(i => (i.DayNumber, i.TimeStart, i.TimeEnd, i.GroupId))
            .ToDictionary(g => g.Key, g =>
            {
                var ordered = g.OrderBy(item => item.Id).ToList();
                var primary = ordered[0];
                var related = ordered
                    .Where(item => IsSameCellDisplayScope(primary, item))
                    .ToList();
                var topicCodes = related
                    .Select(item => item.TopicCode?.Trim())
                    .Where(code => !string.IsNullOrWhiteSpace(code))
                    .Select(code => code!)
                    .Distinct(StringComparer.CurrentCultureIgnoreCase)
                    .OrderBy(code => code, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
                var teacherNames = related
                    .SelectMany(item => item.TeacherNames ?? new List<string>())
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Distinct(StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
                if (teacherNames.Count == 0)
                {
                    teacherNames = related
                        .Select(item => item.Teacher?.Trim())
                        .Where(name => !string.IsNullOrWhiteSpace(name))
                        .Select(name => name!)
                        .Distinct(StringComparer.CurrentCultureIgnoreCase)
                        .ToList();
                }
                var topicCaption = topicCodes.Count == 0 ? primary.TopicCode : string.Join(", ", topicCodes);
                var teacherCaption = teacherNames.Count == 0 ? primary.Teacher : string.Join(", ", teacherNames);
                return primary with
                {
                    TopicCode = topicCaption,
                    Teacher = teacherCaption,
                    TeacherNames = teacherNames.Count > 0 ? teacherNames : primary.TeacherNames
                };
            });
    // Додає часові проміжки чернеток до базового списку слотів.
    private static List<SlotRow> MergeSlotRows(IEnumerable<SlotRow> baseRows, IEnumerable<TeacherDraftItemDto> items)
        => baseRows
            .Concat(items.Select(i => new SlotRow(i.TimeStart, i.TimeEnd)))
            .GroupBy(x => (x.Start, x.End))
            .Select(g => g.First())
            .OrderBy(x => x.Start)
            .ThenBy(x => x.End)
            .ToList();
    private static TeacherDraftItemDto? FindItem(Dictionary<(int DayNumber, string Start, string End, int GroupId), TeacherDraftItemDto> lookup, int dayNumber, SlotRow slot, int groupId)
        => lookup.TryGetValue((dayNumber, slot.Start, slot.End, groupId), out var value) ? value : null;
