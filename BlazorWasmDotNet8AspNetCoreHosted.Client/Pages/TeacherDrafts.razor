    private static int DayNumberFromDate(DateOnly date) => date.DayOfWeek switch
    {
        DayOfWeek.Sunday => 0,
        _ => (int)date.DayOfWeek
    };
    private static string GetDayName(DateOnly date) => UkrainianDayNames[(int)date.DayOfWeek];
    private static bool IsBreak(TeacherDraftItemDto item) => string.Equals(item.LessonTypeCode, "BREAK", StringComparison.OrdinalIgnoreCase);
    private static bool IsCanceled(TeacherDraftItemDto item) => string.Equals(item.LessonTypeCode, "CANCELED", StringComparison.OrdinalIgnoreCase);
    private static bool IsNoneLessonType(TeacherDraftItemDto item) => string.Equals(item.LessonTypeCode, "NONE", StringComparison.OrdinalIgnoreCase);
    private static string GetCellCss(TeacherDraftItemDto? item)
    {
        if (item is null) return "td-cell-body td-cell-body--empty";
        var classes = new List<string> { "td-cell-body" };
        var tone = string.IsNullOrWhiteSpace(item.LessonTypeCss)
            ? CssByCode(item.LessonTypeCode)
            : item.LessonTypeCss;
        if (!string.IsNullOrWhiteSpace(tone))
        {
            classes.Add($"td-cell-body--{tone}");
        }
        if (item.IsLocked)
        {
            classes.Add("td-cell-body--locked");
        }
        if (item.Status == DraftStatusDto.Published)
        {
            classes.Add("td-cell-body--published");
        }
        if (IsBreak(item))
        {
            classes.Add("td-cell-body--break");
        }
        if (IsCanceled(item))
        {
            classes.Add("td-cell-body--canceled");
        }
        if (item.IsRescheduled)
        {
            classes.Add("td-cell-body--res");
        }
        return string.Join(' ', classes);
    }
    // Перевіряє, чи позначена пара для масового редагування.
    private bool IsBulkSelected(TeacherDraftItemDto item)
        => _bulkSelectedIds.Contains(item.Id);
    private bool CanDragItem(TeacherDraftItemDto? item)
        => !IsDraftMutationBusy && item is { IsLocked: false, Status: DraftStatusDto.Draft };
    private bool CanDeleteItem(TeacherDraftItemDto item)
        => !IsDraftMutationBusy
           && (!item.IsLocked || _unrestrictedMode)
           && (item.Status == DraftStatusDto.Draft || _unrestrictedMode);
    private string GetCellFrameCss(SlotKey key, TeacherDraftItemDto? item)
    {
        var css = "td-cell";
        if (_dragPayload?.Origin == key)
        {
            css += " td-cell--drag-source";
        }
        if (_dragHover is { } hover && hover == key)
        {
            css += item is null ? " td-cell--drop-free" : " td-cell--drop-swap";
        }
        if (item?.IsLocked == true)
        {
            css += " td-cell--locked";
        }
        return css;
    }
    private string BuildCellContainerCss(string baseCss, SlotKey key, TeacherDraftItemDto? item)
    {
        var css = baseCss;
        if (CanDragItem(item))
        {
            css += " td-cell-body--draggable";
        }
        if (_dragPayload?.ItemId == item?.Id)
        {
            css += " td-cell-body--dragging";
        }
        if (_dragHover is { } hover && hover == key)
        {
            css += item is null ? " td-cell-body--drop-free" : " td-cell-body--drop-swap";
        }
        if (item is not null && IsBulkSelected(item))
        {
            css += " td-cell-body--selected";
        }
        return css;
    }
    // Обробляє вибір пари для масового редагування.
    private void ToggleBulkSelection(TeacherDraftItemDto item)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        if (IsBreak(item) || IsCanceled(item))
        {
            return;
        }
        if (item.Status != DraftStatusDto.Draft && !_unrestrictedMode)
        {
            _err = "Схвалені заняття можна вибирати лише для видалення в режимі без обмежень.";
            return;
        }
        if (_bulkSelectedDayNumber is null)
        {
            _bulkSelectedDayNumber = item.DayNumber;
        }
        else if (_bulkSelectedDayNumber != item.DayNumber)
        {
            _err = "Не можна обирати пари з різних днів.";
            return;
        }
        _err = null;
        if (_bulkSelectedIds.Contains(item.Id))
        {
            _bulkSelectedIds.Remove(item.Id);
            if (_bulkSelectedIds.Count == 0)
            {
                _bulkSelectedDayNumber = null;
            }
            return;
        }
        _bulkSelectedIds.Add(item.Id);
    }
    // Очищає вибір пар для масового редагування.
    private void ClearBulkSelection()
    {
        _bulkSelectedIds.Clear();
        _bulkSelectedDayNumber = null;
        CloseBulkEdit();
    }
    // Відкриває масове редагування для вибраних пар.
    private async Task OpenBulkEditAsync(TeacherDraftItemDto item)
    {
        if (IsDraftMutationBusy)
        {
            return;
        }
        if (_bulkSelectedIds.Count > 1)
        {
            if (!_bulkSelectedIds.Contains(item.Id))
            {
                _err = "Для масового редагування оберіть одну з виділених пар.";
                return;
            }
            _err = null;
            var editorLoadVersion = ++_editorLoadVersion;
            var requestedWeekStart = _weekStart;
            var requestedCourseId = _courseId;
            var requestedGroupId = _groupId;
            var requestedTeacherId = _teacherId;
            var requestedRoomId = _roomId;
            _bulkTopicIds.Clear();
            _bulkModuleId = null;
            var moduleId = ResolveEffectiveBulkModuleId();
            if (moduleId is int mid)
            {
                if (!await EnsureTopicsLoaded(mid, editorLoadVersion))
                {
                    return;
                }
            }
            if (!IsEditorLoadCurrent(
                    editorLoadVersion,
                    requestedWeekStart,
                    requestedCourseId,
                    requestedGroupId,
                    requestedTeacherId,
                    requestedRoomId))
            {
                return;
            }
            _bulkEditOpen = true;
            return;
        }
        await StartEdit(item);
    }
    // Закриває масове редагування.
    private void CloseBulkEdit()
    {
        _editorLoadVersion++;
        _bulkEditOpen = false;
        _bulkTeacherIds.Clear();
        _bulkRoomId = null;
        _bulkModuleId = null;
        _bulkTopicIds.Clear();
    }
    // Розпізнає стан прапорця з події зміни.
    private static bool IsChecked(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            return boolValue;
        }
        return args.Value is string text && bool.TryParse(text, out var parsed) && parsed;
    }
    // Перемикає вибір викладача для масового редагування.
    private void ToggleBulkTeacher(ChangeEventArgs args, int teacherId)
    {
        if (IsChecked(args)) _bulkTeacherIds.Add(teacherId);
        else _bulkTeacherIds.Remove(teacherId);
    }
    // Обирає всіх викладачів для масового редагування.
    private void SelectAllBulkTeachers()
    {
        if (_meta is null) return;
        foreach (var teacher in _meta.Teachers)
        {
            _bulkTeacherIds.Add(teacher.Id);
        }
    }
    // Очищає вибір викладачів для масового редагування.
    private void ClearBulkTeachers()
    {
        _bulkTeacherIds.Clear();
    }
    // Формує підпис для обраного дня у масовому редагуванні.
    private string BulkSelectedDayLabel()
        => _bulkSelectedDayNumber is int dayNumber ? DayToDate(dayNumber).ToString("dd.MM.yyyy") : "—";
    // Повертає підпис для викладача.
    private string ResolveTeacherLabel(int? teacherId)
    {
        if (teacherId is not int id) return "без змін";
        return _meta?.Teachers.FirstOrDefault(t => t.Id == id)?.Name ?? $"#{id}";
    }
    // Повертає підпис для аудиторії.
    private string ResolveRoomLabel(int? roomId)
    {
        if (roomId is not int id) return "без змін";
        return _meta?.Rooms.FirstOrDefault(r => r.Id == id)?.Name ?? $"#{id}";
    }
    // Повертає підпис для модуля.
    private string ResolveModuleLabel(int? moduleId)
    {
        if (moduleId is not int id) return "без змін";
        var module = FindModule(id);
        return module is null ? $"#{id}" : ModuleOptionCaption(module);
    }
    private string ResolveTopicListLabel(int? moduleId, IReadOnlyCollection<int> topicIds)
    {
        if (topicIds.Count == 0) return "без змін";
        if (moduleId is not int mid) return string.Join(", ", topicIds.Select(id => $"#{id}"));
        var labels = OrderedTopicsForModule(mid)
            .Where(t => topicIds.Contains(t.Id))
            .Select(TopicOptionCaption)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();
        return labels.Count == 0 ? "без змін" : string.Join(", ", labels);
    }
    // Виконує масове оновлення викладача/аудиторії/модуля/тем для обраних пар.
    private async Task ApplyBulkEditAsync()
    {
        if (IsDraftMutationBusy) return;
        _ok = _err = null;
        if (_meta is null)
        {
            _err = "Метадані не завантажені.";
            return;
        }
        if (_bulkSelectedIds.Count == 0)
        {
            _err = "Оберіть хоча б одну пару.";
            return;
        }
        var selectedItems = _items.Where(i => _bulkSelectedIds.Contains(i.Id)).ToList();
        if (selectedItems.Count == 0)
        {
            _err = "Обрані пари не знайдені у поточному тижні.";
            return;
        }
        var changedWeekStart = FirstMonday(selectedItems[0].Date);
        var operationContextKey = CurrentConflictKey;
        if (selectedItems.Any(item => item.Status != DraftStatusDto.Draft))
        {
            _err = "Схвалені заняття не можна масово редагувати. Видаліть їх у режимі без обмежень або опублікуйте без змін.";
            return;
        }
        if (selectedItems.Select(i => i.DayNumber).Distinct().Count() > 1)
        {
            _err = "Не можна редагувати пари з різних днів.";
            return;
        }
        var effectiveModuleId = ResolveEffectiveBulkModuleId();
        var orderedBulkTopicIds = effectiveModuleId is int moduleIdForTopics
            ? OrderedTopicIdsForModule(moduleIdForTopics, _bulkTopicIds)
            : new List<int>();
        if (_bulkTopicIds.Count > 0 && effectiveModuleId is null)
        {
            _err = "Щоб змінити теми, оберіть модуль або пари лише з одного модуля.";
            return;
        }
        if (effectiveModuleId is int moduleIdForValidation
            && orderedBulkTopicIds.Count > 1
            && !TopicsShareSingleLessonType(moduleIdForValidation, orderedBulkTopicIds, out _))
        {
            _err = MixedTopicLessonTypeError;
            return;
        }
        var moduleWillChange = _bulkModuleId is int;
        var topicsWillChange = orderedBulkTopicIds.Count > 0;
        if (_bulkTeacherIds.Count == 0 && _bulkRoomId is null && !moduleWillChange && !topicsWillChange)
        {
            _err = "Оберіть, що саме змінювати: викладачів, аудиторію, модуль або теми.";
            return;
        }
        var dayLabel = DayToDate(selectedItems.First().DayNumber).ToString("dd.MM.yyyy");
        var moduleLabel = ResolveModuleLabel(_bulkModuleId ?? effectiveModuleId);
        var confirmText = $"Застосувати зміни до {selectedItems.Count} пар за {dayLabel}? " +
                          $"Викладачі: {ResolveTeacherListLabel()}. " +
                          $"Аудиторія: {ResolveRoomLabel(_bulkRoomId)}. " +
                          $"Модуль: {moduleLabel}. " +
                          $"Теми: {ResolveTopicListLabel(effectiveModuleId, orderedBulkTopicIds)}.";
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed) return;
        _bulkApplying = true;
        var updated = 0;
        var skipped = 0;
        var skippedLocked = 0;
        var processedSlots = new HashSet<string>(StringComparer.Ordinal);
        var upsertRequests = new List<DraftUpsertRequest>();
        var deleteIds = new HashSet<int>();
        try
        {
            foreach (var item in selectedItems)
            {
                var slotKey = BuildBulkSlotKey(item);
                if (!processedSlots.Add(slotKey))
                {
                    continue;
                }
                if (IsBreak(item) || IsCanceled(item))
                {
                    skipped++;
                    continue;
                }
                var batch = TeacherDraftEditMutationPlanner
                    .SelectLogicalEventRows(_items, item)
                    .ToList();
                if (batch.Count == 0)
                {
                    skipped++;
                    continue;
                }
                if (!_unrestrictedMode && batch.Any(x => x.IsLocked))
                {
                    skippedLocked++;
                    continue;
                }
                if (batch.Any(x => x.Status != DraftStatusDto.Draft))
                {
                    _err = "Логічне заняття містить схвалені рядки й не може бути змінене частково.";
                    return;
                }
                var targetModuleId = _bulkModuleId ?? item.ModuleId;
                var topicIdsForSlot = orderedBulkTopicIds.Count == 0
                    ? _bulkModuleId is int
                        ? new List<int?> { null }
                        : batch
                            .OrderBy(entry => entry.Id)
                            .Select(entry => entry.ModuleTopicId)
                            .Distinct()
                            .ToList()
                    : orderedBulkTopicIds.Select(id => (int?)id).ToList();
                var newRoomId = _bulkRoomId ?? item.RoomId;
                var desiredTeachers = (_bulkTeacherIds.Count > 0
                        ? _bulkTeacherIds.Select(id => (int?)id)
                        : batch.OrderBy(entry => entry.Id).Select(entry => entry.TeacherId))
                    .Distinct()
                    .OrderBy(id => id is null ? 0 : 1)
                    .ThenBy(id => id)
                    .ToList();
                var batchKey = item.BatchKey ?? $"bulk-{Guid.NewGuid():N}";
                var plan = TeacherDraftEditMutationPlanner.BuildReplacementPlan(
                    batch.Select(entry => new TeacherDraftEditExistingRow(
                            entry.Id,
                            entry.ModuleTopicId,
                            entry.TeacherId))
                        .ToList(),
                    topicIdsForSlot,
                    desiredTeachers);
                foreach (var targetRow in plan.TargetRows)
                {
                    var source = targetRow.ExistingId is int existingId
                        ? batch.First(entry => entry.Id == existingId)
                        : item;
                    var slot = BuildSlotKey(source);
                    var request = ApplyTopicToRequest(BuildUpsertRequest(source, slot, ignoreValidation: true) with
                    {
                        Id = targetRow.ExistingId,
                        TeacherId = targetRow.TeacherId,
                        RoomId = newRoomId,
                        ModuleId = targetModuleId,
                        BatchKey = batchKey,
                        IgnoreValidationErrors = true,
                        ExpectedRevision = targetRow.ExistingId is null ? null : source.Revision
                    }, targetRow.ModuleTopicId);
                    upsertRequests.Add(request);
                }
                deleteIds.UnionWith(plan.DeleteIds);
            }
            if (upsertRequests.Count + deleteIds.Count > BatchMutationLimit)
            {
                _err = $"Одна масова операція може змінити й видалити загалом не більше {BatchMutationLimit} чернеток. Зменште вибір і повторіть спробу.";
                return;
            }
            updated = 0;
            if (upsertRequests.Count > 0 || deleteIds.Count > 0)
            {
                _hasFreshSuccessfulLoad = false;
                var mutationResult = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
                    upsertRequests,
                    deleteIds.OrderBy(id => id).ToList(),
                    Confirm: true,
                    Unrestricted: _unrestrictedMode,
                    DeleteExpectedRevisions: BuildExpectedRevisionMap(deleteIds, _items)));
                updated = mutationResult.Upserted + mutationResult.Deleted;
                await MarkManualWeekChangeAsync(changedWeekStart);
                await ReloadChangedWeekIfCurrentAsync(changedWeekStart);
                if (!IsOperationContextCurrent(operationContextKey))
                {
                    return;
                }
            }
            _ok = $"Оновлено пар: {updated}. Пропущено: {skipped}.";
            if (skippedLocked > 0)
            {
                _ok += $" Заблокованих: {skippedLocked}.";
            }
            ClearBulkSelection();
            CloseBulkEdit();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex, operationContextKey);
        }
        catch (Exception ex)
        {
            if (IsOperationContextCurrent(operationContextKey))
            {
                _err = ex.Message;
            }
        }
        finally
        {
            _bulkApplying = false;
        }
    }
    // Формує ключ слоту для уникнення дублювання під час масового редагування.
    private static string BuildBulkSlotKey(TeacherDraftItemDto item)
        => string.IsNullOrWhiteSpace(item.BatchKey)
            ? $"id:{item.Id}"
            : $"b:{item.BatchKey}|{item.Date:yyyyMMdd}|{item.TimeStart}|{item.TimeEnd}|g{item.GroupId}|m{item.ModuleId}|lt{item.LessonTypeId}";
    // Формує унікальну назву перемикача для користувачів програм зчитування з екрана.
    private static string BuildBulkSelectionLabel(TeacherDraftItemDto item, string groupName)
    {
        var moduleName = string.IsNullOrWhiteSpace(item.Module) ? "без назви" : item.Module.Trim();
        return $"Обрати пару: група {groupName}, дата {item.Date:dd.MM.yyyy}, час {item.TimeStart}–{item.TimeEnd}, модуль {moduleName}";
    }
    // Формує підпис списку викладачів.
    private string ResolveTeacherListLabel()
    {
        if (_bulkTeacherIds.Count == 0) return "без змін";
        if (_meta is null) return string.Join(", ", _bulkTeacherIds);
        var labels = _meta.Teachers
            .Where(t => _bulkTeacherIds.Contains(t.Id))
            .Select(t => t.Name)
            .ToList();
        return labels.Count == 0 ? "без змін" : string.Join(", ", labels);
    }
    private SlotKey BuildSlotKey(TeacherDraftItemDto item)
        => new(item.DayNumber, item.TimeStart, item.TimeEnd, item.GroupId);
    private DraftUpsertRequest BuildUpsertRequest(TeacherDraftItemDto item, SlotKey slot, bool ignoreValidation)
        => NormalizeRequest(new(
            Id: item.Id,
            Date: DayToDate(slot.DayNumber),
            TimeStart: slot.Start,
            TimeEnd: slot.End,
            GroupId: slot.GroupId,
            ModuleId: item.ModuleId,
            ModuleTopicId: item.ModuleTopicId,
            TeacherId: item.TeacherId,
            RoomId: item.RoomId,
            RequiresRoom: item.RequiresRoom,
            LessonTypeId: item.LessonTypeId,
            OverrideNonWorkingDay: false,
            BatchKey: item.BatchKey,
            IsLocked: item.IsLocked,
            IgnoreValidationErrors: ignoreValidation,
            IsSelfStudy: item.IsSelfStudy,
            ExpectedRevision: item.Revision
        ));
    // Формує повний набір очікуваних ревізій для атомарного видалення.
    private static Dictionary<int, Guid> BuildExpectedRevisionMap(
        IEnumerable<int> ids,
        IEnumerable<TeacherDraftItemDto> items)
        => BuildExpectedRevisionMap(
            ids,
            items.ToDictionary(item => item.Id, item => item.Revision));
    // Не дозволяє видалення без ревізії кожного рядка пакета.
    private static Dictionary<int, Guid> BuildExpectedRevisionMap(
        IEnumerable<int> ids,
        IReadOnlyDictionary<int, Guid> revisions)
        => ids
            .Distinct()
            .OrderBy(id => id)
            .ToDictionary(id => id, id => RequireExpectedRevision(id, revisions));
    // Повертає ревізію рядка або зупиняє небезпечну зміну за застарілими даними.
    private static Guid RequireExpectedRevision(int id, IReadOnlyDictionary<int, Guid> revisions)
    {
        if (!revisions.TryGetValue(id, out var revision) || revision == Guid.Empty)
        {
            throw new InvalidOperationException($"Не вдалося визначити актуальну ревізію пари #{id}. Оновіть таблицю та повторіть спробу.");
        }
        return revision;
    }
    // Старт перетягування елемента розкладу.
    private void OnItemDragStart(SlotKey origin, TeacherDraftItemDto? item, DragEventArgs e)
    {
        if (!CanDragItem(item))
        {
            return;
        }
        var snapshot = item! with { };
        var eventSnapshot = TeacherDraftEditMutationPlanner
            .SelectLogicalEventRows(_items, item)
            .Select(row => row with { })
            .ToList();
        _dragPayload = new DragPayload(item.Id, origin, snapshot, eventSnapshot);
        _dragHover = origin;
        if (e.DataTransfer is not null)
        {
            e.DataTransfer.DropEffect = "move";
            e.DataTransfer.EffectAllowed = "move";
        }
    }
    private void OnItemDragEnd()
    {
        _dragPayload = null;
        _dragHover = null;
        StateHasChanged();
    }
    private void OnSlotDragEnter(SlotKey key, TeacherDraftItemDto? target)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        if (target is not null
            && target.Id != _dragPayload.ItemId
            && (target.IsLocked || target.Status != DraftStatusDto.Draft))
        {
            return;
        }
        if (_dragHover != key)
        {
            _dragHover = key;
            StateHasChanged();
        }
    }
    private void OnSlotDragLeave(SlotKey key)
    {
        if (_dragHover is { } hover && hover == key)
        {
            _dragHover = null;
            StateHasChanged();
        }
    }
    private void OnSlotDragOver(SlotKey key, TeacherDraftItemDto? target, DragEventArgs e)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        if (target is not null
            && target.Id != _dragPayload.ItemId
            && (target.IsLocked || target.Status != DraftStatusDto.Draft))
        {
            return;
        }
        if (e.DataTransfer is not null)
        {
            e.DataTransfer.DropEffect = "move";
        }
        if (_dragHover != key)
        {
            _dragHover = key;
            StateHasChanged();
        }
    }
    // Обробляє скидання у слот (переміщення або обмін).
    private async Task OnSlotDropAsync(SlotKey targetKey, TeacherDraftItemDto? targetItem)
    {
        if (_dragPayload is null || IsDraftMutationBusy)
        {
            return;
        }
        var sourceItem = _dragPayload.Snapshot;
        var sourceEventSnapshot = _dragPayload.EventSnapshot;
        var changedWeekStart = FirstMonday(sourceItem.Date);
        var operationContextKey = CurrentConflictKey;
        if (targetItem?.IsLocked == true && targetItem.Id != sourceItem.Id)
        {
            _err = "Неможливо перенести пару у заблокований слот.";
            _dragHover = null;
            StateHasChanged();
            return;
        }
        if (_dragPayload.Origin == targetKey || targetItem?.Id == sourceItem.Id)
        {
            return;
        }
        _ok = null;
        _err = null;
        _isProcessingDrop = true;
        _hasFreshSuccessfulLoad = false;
        try
        {
            if (targetItem is null)
            {
                var targetDate = DayToDate(targetKey.DayNumber);
                await MoveItemAsync(sourceItem, sourceEventSnapshot, targetKey, targetDate);
            }
            else
            {
                var targetEventSnapshot = TeacherDraftEditMutationPlanner
                    .SelectLogicalEventRows(_items, targetItem)
                    .Select(row => row with { })
                    .ToList();
                await SwapItemsAsync(
                    sourceItem,
                    sourceEventSnapshot,
                    targetItem,
                    targetEventSnapshot,
                    targetKey);
            }
            await MarkManualWeekChangeAsync(changedWeekStart);
            await ReloadChangedWeekIfCurrentAsync(changedWeekStart);
            if (!IsOperationContextCurrent(operationContextKey))
            {
                return;
            }
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex, operationContextKey);
        }
        catch (Exception ex)
        {
            if (IsOperationContextCurrent(operationContextKey))
            {
                _err = ex.Message;
            }
        }
        finally
        {
            _dragPayload = null;
            _dragHover = null;
            _isProcessingDrop = false;
            StateHasChanged();
        }
    }
    private async Task MoveItemAsync(
        TeacherDraftItemDto sourceItem,
        IReadOnlyList<TeacherDraftItemDto> sourceEventSnapshot,
        SlotKey targetKey,
        DateOnly targetDate)
    {
        var weekItems = await DraftsApi.GetWeek(FirstMonday(sourceItem.Date), null);
        var currentSource = ResolveCurrentLogicalEventSource(weekItems, sourceItem);
        var sourceRows = ResolveMovableLogicalEventRows(weekItems, currentSource);
        EnsureLogicalEventSnapshotCurrent(sourceEventSnapshot, sourceRows);
        var target = new TeacherDraftRelocationTarget(
            targetDate,
            targetKey.Start,
            targetKey.End,
            targetKey.GroupId);
        var requests = TeacherDraftEditMutationPlanner
            .BuildRelocationRequests(sourceRows, target, _unrestrictedMode)
            .Select(NormalizeRequest)
            .ToList();
        var result = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
            requests,
            new List<int>(),
            Confirm: true,
            Unrestricted: _unrestrictedMode));
        EnsureCompleteRelocationResult(result, requests.Count);
    }
    private async Task SwapItemsAsync(
        TeacherDraftItemDto sourceItem,
        IReadOnlyList<TeacherDraftItemDto> sourceEventSnapshot,
        TeacherDraftItemDto targetItem,
        IReadOnlyList<TeacherDraftItemDto> targetEventSnapshot,
        SlotKey targetKey)
    {
        var weekItems = await DraftsApi.GetWeek(FirstMonday(sourceItem.Date), null);
        var currentSource = ResolveCurrentLogicalEventSource(weekItems, sourceItem);
        var currentTarget = ResolveCurrentLogicalEventSource(weekItems, targetItem);
        var sourceRows = ResolveMovableLogicalEventRows(weekItems, currentSource);
        var targetRows = ResolveMovableLogicalEventRows(weekItems, currentTarget);
        EnsureLogicalEventSnapshotCurrent(sourceEventSnapshot, sourceRows);
        EnsureLogicalEventSnapshotCurrent(targetEventSnapshot, targetRows);
        if (sourceRows.Select(row => row.Id).Intersect(targetRows.Select(row => row.Id)).Any())
        {
            return;
        }
        var sourceTarget = new TeacherDraftRelocationTarget(
            currentTarget.Date,
            currentTarget.TimeStart,
            currentTarget.TimeEnd,
            currentTarget.GroupId);
        var targetTarget = new TeacherDraftRelocationTarget(
            currentSource.Date,
            currentSource.TimeStart,
            currentSource.TimeEnd,
            currentSource.GroupId);
        // Проміжні колізії допустимі лише всередині транзакції; сервер повторно перевіряє кінцевий стан перед її фіксацією.
        var requests = TeacherDraftEditMutationPlanner
            .BuildRelocationRequests(sourceRows, sourceTarget, ignoreValidationErrors: true)
            .Concat(TeacherDraftEditMutationPlanner.BuildRelocationRequests(
                targetRows,
                targetTarget,
                ignoreValidationErrors: true))
            .Select(NormalizeRequest)
            .ToList();
        var result = await DraftsApi.MutateBatch(new TeacherDraftBatchMutationRequest(
            requests,
            new List<int>(),
            Confirm: true,
            Unrestricted: _unrestrictedMode));
        EnsureCompleteRelocationResult(result, requests.Count);
    }

    // Перевіряє, що рядок не змінився в іншому вікні після початку перетягування.
    private static TeacherDraftItemDto ResolveCurrentLogicalEventSource(
        IReadOnlyList<TeacherDraftItemDto> weekItems,
        TeacherDraftItemDto snapshot)
    {
        var current = weekItems.FirstOrDefault(item => item.Id == snapshot.Id)
            ?? throw new InvalidOperationException($"Пара #{snapshot.Id} вже не існує. Оновіть таблицю.");
        if (!TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(snapshot, current))
        {
            throw new InvalidOperationException($"Пара #{snapshot.Id} була змінена в іншому вікні. Оновіть таблицю перед перенесенням.");
        }
        return current;
    }

    // Перевіряє склад і версії всіх рядків події, зафіксованих на початку перетягування.
    private static void EnsureLogicalEventSnapshotCurrent(
        IReadOnlyCollection<TeacherDraftItemDto> snapshotRows,
        IReadOnlyCollection<TeacherDraftItemDto> currentRows)
    {
        var currentById = currentRows.ToDictionary(row => row.Id);
        if (snapshotRows.Count != currentRows.Count
            || snapshotRows.Any(snapshot =>
                !currentById.TryGetValue(snapshot.Id, out var current)
                || !TeacherDraftEditMutationPlanner.HasSameOriginalIdentity(snapshot, current)))
        {
            throw new InvalidOperationException(
                "Склад або дані логічного заняття змінилися в іншому вікні. Оновіть таблицю перед перенесенням.");
        }
    }

    // Повертає повний незаблокований пакет рядків для атомарного перенесення.
    private static List<TeacherDraftItemDto> ResolveMovableLogicalEventRows(
        IReadOnlyList<TeacherDraftItemDto> weekItems,
        TeacherDraftItemDto source)
    {
        var rows = TeacherDraftEditMutationPlanner
            .SelectLogicalEventRows(weekItems, source)
            .ToList();
        if (rows.Count == 0)
        {
            throw new InvalidOperationException("Не знайдено рядків логічного заняття для перенесення.");
        }
        if (rows.Any(row => row.IsLocked || row.Status != DraftStatusDto.Draft))
        {
            throw new InvalidOperationException("Логічне заняття містить зафіксовані або схвалені рядки й не може бути перенесене частково.");
        }
        return rows;
    }

    // Не приймає часткову відповідь сервера як успішне перенесення.
    private static void EnsureCompleteRelocationResult(TeacherDraftBatchMutationResult result, int expectedCount)
    {
        if (result.Upserted != expectedCount
            || result.UpsertedIds.Count != expectedCount
            || result.Deleted != 0)
        {
            throw new InvalidOperationException("Сервер повернув неповний результат атомарного перенесення.");
        }
    }
