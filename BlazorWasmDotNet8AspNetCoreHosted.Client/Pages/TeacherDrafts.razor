            <span>Готуємо курси, групи, викладачів та аудиторії.</span>
        </div>
    </div>
}
else if (_meta is null)
{
    <div class="alert alert-err meta-load-error" role="alert">
        <div>
            <strong>Не вдалося завантажити довідники</strong>
            <div>@(_metaLoadError ?? "Сервер тимчасово не відповідає.")</div>
        </div>
        <button class="btn btn-ghost"
                type="button"
                disabled="@_metaLoadInProgress"
                @onclick="RetryMetaLoadAsync">
            Спробувати ще раз
        </button>
    </div>
}
else
{
@if (_hasFreshSuccessfulLoad
     && string.IsNullOrWhiteSpace(_err)
     && string.IsNullOrWhiteSpace(_weekValidationError)
     && HasValidatedLoadedWeekScope)
{
    var knownIssues = CountAllKnownIssues();
    var readinessClass = !HasWeekItems
        ? "readiness-panel--empty"
        : knownIssues.critical > 0
            ? "readiness-panel--critical"
            : knownIssues.warnings > 0
                ? "readiness-panel--warning"
                : "readiness-panel--ready";
    var readinessTitle = !HasWeekItems
        ? "Немає записів для перевірки"
        : knownIssues.critical > 0
            ? "Потрібні виправлення"
            : knownIssues.warnings > 0
                ? "Перевірте застереження"
                : "Готово до фінальної перевірки";
    <section class="readiness-panel @readinessClass" aria-labelledby="readiness-title">
        <div class="readiness-main">
            <div class="readiness-eyebrow">Готовність до публікації</div>
            <h2 id="readiness-title">@readinessTitle</h2>
            <p>
                @if (!HasWeekItems)
                {
                    <span>Сформуйте план або додайте заняття вручну. Порожній тиждень опублікувати неможливо.</span>
                }
                else if (knownIssues.critical > 0)
                {
                    <span>Виправте критичні проблеми та повторіть перевірку. Перед публікацією сервер перевірить увесь тиждень ще раз.</span>
                }
                else
                {
                    <span>Перегляньте застереження. Перед публікацією сервер повторно перевірить усі записи тижня.</span>
                }
            </p>
            <div class="readiness-metrics" aria-label="Підсумок перевірки">
                <div class="readiness-metric">
                    <strong>@_items.Count</strong>
                    <span>Записів</span>
                </div>
                <div class="readiness-metric readiness-metric--critical">
                    <strong>@knownIssues.critical</strong>
                    <span>Критичних</span>
                </div>
                <div class="readiness-metric readiness-metric--warning">
                    <strong>@knownIssues.warnings</strong>
                    <span>Застережень</span>
                </div>
            </div>
            <label class="problems-toggle">
                <input type="checkbox"
                       checked="@_showProblemsOnly"
                       disabled="@(ProblemRecordCount == 0 || IsDraftMutationBusy)"
                       @onchange="HandleProblemsOnlyChange" />
                <span>Показати лише проблемні записи (@ProblemRecordCount)</span>
            </label>
        </div>
        <div class="readiness-action">
            <button class="btn btn-primary btn-publish"
                    @onclick="PublishWeek"
                    disabled="@(!CanPublishDrafts)"
                    title="@PublishButtonTitle">
                <span class="btn-icon" aria-hidden="true">➤</span>
                @(_isPublishing ? "Публікуємо..." : $"Опублікувати весь тиждень · {_items.Count}")
            </button>
            <span class="publish-action-hint">
                Усі статуси й активні фільтри не змінюють склад публікації: @FormatRecordCount(_items.Count).
            </span>
        </div>
    </section>
}

@if (_hasFreshSuccessfulLoad && VisibleWeekValidationIssues.Count > 0)
{
    var weekIssues = VisibleWeekValidationIssues;
    var weekIssueCounts = CountIssues(new DraftValidationReportDto(
        _weekValidationReport?.GeneratedAt ?? DateTimeOffset.UtcNow,
        weekIssues));
    <section class="week-validation-panel" aria-labelledby="week-validation-title">
        <div class="week-validation-head">
            <div>
                <div class="week-validation-eyebrow">Автоматична перевірка після ручних змін</div>
                <h2 id="week-validation-title">@(weekIssueCounts.errors > 0 ? "Знайдено проблеми у всьому тижні" : "Перевірте ручні зміни тижня")</h2>
                <p>Перевірка оновлюється після додавання, перенесення, обміну, редагування та видалення занять.</p>
            </div>
            <div class="week-validation-counters" aria-label="Підсумок перевірки тижня">
                @if (weekIssueCounts.errors > 0)
                {
                    <span class="week-validation-counter week-validation-counter--error">Критичних: @weekIssueCounts.errors</span>
                }
                @if (weekIssueCounts.warnings > 0)
                {
                    <span class="week-validation-counter week-validation-counter--warning">Застережень: @weekIssueCounts.warnings</span>
                }
            </div>
        </div>
        <div class="week-validation-list">
            @foreach (var issue in weekIssues.Take(12))
            {
                var issueCss = string.Equals(issue.Severity, "error", StringComparison.OrdinalIgnoreCase)
                    ? "week-validation-item week-validation-item--error"
                    : "week-validation-item week-validation-item--warning";
                <article class="@issueCss">
                    <strong>@issue.Title</strong>
                    <span>@issue.Description</span>
                </article>
            }
        </div>
        @if (weekIssues.Count > 12)
        {
            <div class="week-validation-more">Показано 12 із @weekIssues.Count проблем. Виправте їх і оновіть перевірку.</div>
        }
    </section>
}

@if (!_reloadInProgress && !string.IsNullOrWhiteSpace(_weekValidationError))
{
    <div class="alert alert-err week-validation-error" role="alert">
        <span>@_weekValidationError</span>
        <button class="btn btn-ghost btn-sm" type="button" @onclick="Reload" disabled="@IsDraftMutationBusy">Перевірити ще раз</button>
    </div>
}

<div class="week-nav">
    <button class="btn btn-ghost week-nav-btn" @onclick="PrevWeek" disabled="@IsDraftMutationBusy">
        <span aria-hidden="true">←</span>
        Попередній тиждень
    </button>
    <div class="week-label">
        <span class="week-label-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3.5" y="5.5" width="17" height="15" rx="3" stroke="currentColor" stroke-width="1.8" />
                <path d="M7.5 3.75V7.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <path d="M16.5 3.75V7.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <path d="M3.5 9H20.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <path d="M8 12.25H8.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <path d="M12 12.25H12.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <path d="M16 12.25H16.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <path d="M8 16.25H8.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <path d="M12 16.25H12.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
        </span>
        @_weekStart.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", new CultureInfo("uk-UA")) -
        @_weekStart.AddDays(6).ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", new CultureInfo("uk-UA"))
    </div>
    <button class="btn btn-ghost week-nav-btn" @onclick="NextWeek" disabled="@IsDraftMutationBusy">
        Наступний тиждень
        <span aria-hidden="true">→</span>
    </button>
</div>

<div class="toolbar">
    <div class="toolbar-filters">
        <label class="filter-field">
            <span class="filter-label">Курс</span>
            <select class="select"
                    @bind="_courseId"
                    @bind:after="OnCourseFilterChangedAsync"
                    disabled="@IsDraftMutationBusy">
                <option value="">Всі курси</option>
                @if (_meta is not null)
                {
                    foreach (var c in _meta.Courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </label>
        <label class="filter-field">
            <span class="filter-label">Група</span>
            <select class="select"
                    @bind="_groupId"
                    @bind:after="OnGroupFilterChangedAsync"
                    disabled="@IsDraftMutationBusy">
                <option value="">Всі групи</option>
                @foreach (var g in CourseScopedGroups())
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </select>
        </label>
        <label class="filter-field filter-field--date">
            <span class="filter-label">Тиждень</span>
            <input type="date"
                   class="select"
                   value="@_weekStart.ToString("yyyy-MM-dd")"
                   @onchange="OnWeekDateChangedAsync"
                   disabled="@IsDraftMutationBusy" />
        </label>
    </div>
    <div class="toolbar-actions">
        <button class="btn btn-ghost" @onclick="Reload" disabled="@IsDraftMutationBusy">
            <span class="btn-icon" aria-hidden="true">↻</span>
            Оновити
        </button>
        <button class="btn btn-ghost" @onclick="ResetFilters" disabled="@IsDraftMutationBusy">Очистити фільтри</button>
    </div>
</div>

<details class="additional-filters" open="@(_teacherId is not null || _roomId is not null)">
    <summary>
        <span>Додаткові фільтри</span>
        @if (_teacherId is not null || _roomId is not null)
        {
            <span class="additional-filters-status">Застосовано</span>
        }
    </summary>
    <div class="additional-filters-body">
        <label class="filter-field">
            <span class="filter-label">Викладач</span>
            <select class="select"
                    @bind="_teacherId"
                    @bind:after="OnFilterChangedAsync"
                    disabled="@IsDraftMutationBusy">
                <option value="">Всі викладачі</option>
                @if (_meta is not null)
                {
                    foreach (var t in _meta.Teachers)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                }
            </select>
        </label>
        <label class="filter-field">
            <span class="filter-label">Аудиторія</span>
            <select class="select"
                    @bind="_roomId"
                    @bind:after="OnFilterChangedAsync"
                    disabled="@IsDraftMutationBusy">
                <option value="">Всі аудиторії</option>
                @if (_meta is not null)
                {
                    foreach (var r in _meta.Rooms)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                }
            </select>
        </label>
    </div>
</details>

<details class="additional-actions" open="@_unrestrictedMode">
    <summary>
        <span>Додаткові дії</span>
        @if (_unrestrictedMode)
        {
            <span class="additional-actions-status">Без обмежень увімкнено</span>
        }
    </summary>
    <div class="additional-actions-body">
        <div class="additional-action-row">
            <div class="additional-action-copy">
                <strong>Експорт розкладу</strong>
                <span>Завантажити Excel-файл за поточний тиждень з урахуванням фільтрів викладача, групи та аудиторії.</span>
            </div>
            <button class="btn btn-excel" type="button" @onclick="ExportScheduleAsync" disabled="@(_isExporting || IsDraftMutationBusy)">
                <span class="btn-icon btn-icon--svg" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 3.5V11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M6.75 8.75L10 12L13.25 8.75" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M4.5 14.5H15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M6.5 17H13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                @(_isExporting ? "Генерую Excel..." : "Експорт в Excel")
            </button>
        </div>
        <div class="unrestricted-toggle">
            <label class="unrestricted-check">
                <input type="checkbox" checked="@_unrestrictedMode" @onchange="HandleUnrestrictedChange" />
                <span>Редагування без обмежень</span>
            </label>
            <div class="unrestricted-hint">
                Дозволяє видаляти схвалені заняття та ігнорувати частину перевірок під час редагування. Використовуйте лише для виправлення виняткових ситуацій.
            </div>
        </div>
    </div>
</details>

@if (!string.IsNullOrWhiteSpace(_ok))
{
    <div class="alert alert-ok publish-success">
        <span>@_ok</span>
        @if (_showPublishedScheduleLink)
        {
            <a class="btn btn-primary" href="@PublishedScheduleUrl">Перейти до розкладу</a>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(_err))
{
    <div class="alert alert-err" role="alert">@_err</div>
}
@if (!string.IsNullOrWhiteSpace(_exportError))
{
    <div class="alert alert-err" role="alert">@_exportError</div>
}
@if (_publishWarnings.Count > 0)
{
    <div class="alert alert-conflict">
        <strong>Чернетку не опубліковано.</strong>
        <div>Жодної пари не додано до офіційного розкладу. Усуньте порушення та повторіть публікацію.</div>
        <ul class="mb-0 mt-2">
            @foreach (var warning in _publishWarnings.Take(12))
            {
                <li>@warning</li>
            }
        </ul>
        @if (_publishWarnings.Count > 12)
        {
            <div class="mt-2">Показано 12 із @_publishWarnings.Count повідомлень.</div>
        }
    </div>
}
@if (_currentConflict is not null)
{
    <div class="alert alert-conflict">
        <div class="conflict-head">
            <div>
                <strong>Конфлікт чернеток:</strong> @_currentConflict.Message
                <div class="conflict-meta">
                    Тиждень: @_weekStart.ToString("dd.MM.yyyy") - @_weekStart.AddDays(6).ToString("dd.MM.yyyy"). Збережено @_currentConflict.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm").
                </div>
            </div>
            <div class="conflict-actions">
                <button class="btn btn-ghost btn-sm" type="button" @onclick="ToggleConflictDetails">@_currentConflict.ToggleLabel</button>
                <button class="btn btn-ghost btn-sm" type="button" @onclick="ClearConflictDetails">Очистити</button>
            </div>
        </div>
        @if (_currentConflict.Expanded && _currentConflict.Errors.Count > 0)
        {
            <ul class="conflict-list">
                @foreach (var err in _currentConflict.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
        @if (_currentConflict.Expanded && _currentConflict.Warnings.Count > 0)
        {
            <div class="conflict-warnings">
                <div class="conflict-warnings-title">Попередження:</div>
                <ul class="conflict-list">
                    @foreach (var warn in _currentConflict.Warnings)
                    {
                        <li>@warn</li>
                    }
                </ul>
            </div>
        }
    </div>
}

@if (_reloadInProgress || (!_hasFreshSuccessfulLoad && string.IsNullOrWhiteSpace(_err)))
{
    <div class="review-empty-state" role="status">
        <div class="review-empty-copy">
            <strong>Завантажуємо чернетку…</strong>
            <span>Попередні дані приховано, щоб вони не відображалися під новою датою або курсом.</span>
        </div>
    </div>
}
else if (!_hasFreshSuccessfulLoad)
{
    @* Повідомлення про помилку вже показано вище; звичайний порожній стан тут буде оманливим. *@
}
else if (!string.IsNullOrWhiteSpace(_err)
         && ((_rows.Count == 0 && _items.Count == 0)
             || (!_manualEditingEnabled && _filteredItems.Count == 0)))
{
    @* За наявності помилки не підміняємо її звичайним повідомленням про відсутність даних. *@
}
else if (_rows.Count == 0 && _items.Count == 0)
{
    <div class="empty">Немає визначених тайм-слотів — додайте їх у конфігурації.</div>
}
else if (!_manualEditingEnabled && _filteredItems.Count == 0)
{
    <div class="review-empty-state">
        <div class="review-empty-icon" aria-hidden="true">✓</div>
        <div class="review-empty-copy">
            <strong>@(_showProblemsOnly ? "Проблемних записів не знайдено" : "За вибраними параметрами записів немає")</strong>
            <span>
                @(_showProblemsOnly
                    ? "У локальних звітах перевірки немає записів із критичними проблемами або застереженнями."
                    : "Змініть фільтри або відкрийте ручне редагування, щоб додати заняття у порожні слоти.")
            </span>
        </div>
        <div class="review-empty-actions">
            @if (_showProblemsOnly)
            {
                <button class="btn btn-primary" type="button" @onclick="ShowAllRecords">Показати всі записи</button>
            }
            else
            {
                <button class="btn btn-ghost" type="button" @onclick="ResetFilters">Очистити фільтри</button>
                @if (_rows.Count > 0)
                {
                    <button class="btn btn-primary" type="button" @onclick="EnableManualEditing">Редагувати вручну</button>
                }
            }
        </div>
    </div>
}
else
{
    var groups = _displayGroups;
    var weekDays = _displayWeekDays;
    var slots = _displaySlots;
    var lookup = _displayLookup;
    var monday = _weekStart;
    var isoWeek = ISOWeek.GetWeekOfYear(monday.ToDateTime(TimeOnly.MinValue));
    if (groups.Count == 0)
    {
        <div class="alert alert-info">Немає груп для відображення. Виберіть параметри через фільтри.</div>
    }
    else if (slots.Count == 0)
    {
        <div class="alert alert-info">Немає визначених часових слотів для відображення.</div>
    }
    else
    {
        <div class="teacher-drafts-grid-shell">
            <div class="grid-controls">
                <div class="grid-mode">
                    <strong>@(_manualEditingEnabled ? "Ручне редагування" : _showProblemsOnly ? "Лише проблемні записи" : "Зайняті слоти")</strong>
                    <span>Усі групи: @_displayGroups.Count · використовуйте нижню горизонтальну прокрутку</span>
                </div>
                @if (_manualEditingEnabled)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="DisableManualEditing" disabled="@IsDraftMutationBusy">
                        Завершити ручне редагування
                    </button>
                }
                else if (!_showProblemsOnly)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="EnableManualEditing" disabled="@IsDraftMutationBusy">
                        Редагувати порожні слоти
                    </button>
                }
            </div>
            <div class="teacher-drafts-print-header">
                <div class="teacher-drafts-print-title">Розклад навчальних занять (чернетка)</div>
                <div class="teacher-drafts-print-dates">Тиждень № @isoWeek | @monday.ToString("dd.MM.yyyy") - @monday.AddDays(6).ToString("dd.MM.yyyy")</div>
            </div>
            <div class="teacher-drafts-table-wrapper">
                <table class="teacher-drafts-table">
                <thead>
                    <tr>
                        <th class="td-day-col">День</th>
                        <th class="td-slot-col">Година</th>
                        @foreach (var group in groups)
                        {
                            <th class="td-group-col">@group.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in weekDays)
                    {
                        var dayNumber = DayNumberFromDate(day);
                        var totalSlots = slots.Count;
                        for (var slotIndex = 0; slotIndex < totalSlots; slotIndex++)
                        {
                            var slot = slots[slotIndex];
                            <tr>
                                @if (slotIndex == 0)
                                {
                                    <th class="td-day-col td-day-cell" rowspan="@totalSlots">
                                        <div class="td-day-name">@GetDayName(day)</div>
                                        <div class="td-day-date">@day.ToString("dd.MM.yyyy")</div>
                                    </th>
                                }
                                <th class="td-slot-col td-slot-cell">
                                    <div class="td-slot-number">@GetSlotNumberLabel(slot, slotIndex)</div>
                                    <div class="td-slot-time">@slot.Label</div>
                                </th>
                                @for (var groupIndex = 0; groupIndex < groups.Count; groupIndex++)
                                {
                                    var group = groups[groupIndex];
                                    var mergeSpan = ResolveGroupMergeSpan(lookup, dayNumber, slot, groups, groupIndex);
                                    var item = FindItem(lookup, dayNumber, slot, group.Id);
                                    var mergedGroupLabel = BuildMergedGroupsLabel(groups, groupIndex, mergeSpan);
                                    var bulkSelectionGroupLabel = mergeSpan > 1 && !string.IsNullOrWhiteSpace(mergedGroupLabel)
                                        ? mergedGroupLabel
                                        : group.Name;
                                    var cellCss = GetCellCss(item);
                                    var slotKey = new SlotKey(dayNumber, slot.Start, slot.End, group.Id);
                                    var tdCss = GetCellFrameCss(slotKey, item);
                                    if (mergeSpan > 1 && item is not null)
                                    {
                                        tdCss += " td-cell--merged";
                                    }
                                    var wrapperCss = BuildCellContainerCss(cellCss, slotKey, item);
                                    var canDrag = CanDragItem(item);
                                    <td class="@tdCss"
                                        colspan="@(mergeSpan > 1 ? mergeSpan : 1)"
                                        @ondragover="e => OnSlotDragOver(slotKey, item, e)" @ondragover:preventDefault
                                        @ondragenter="() => OnSlotDragEnter(slotKey, item)"
                                        @ondragleave="() => OnSlotDragLeave(slotKey)"
                                        @ondrop="async e => await OnSlotDropAsync(slotKey, item)" @ondrop:preventDefault>
                                        <div class="@wrapperCss"
                                             data-drag-id="@((canDrag && item is not null) ? item.Id.ToString() : null)">
                                            @if (item is not null && !IsBreak(item) && !IsCanceled(item))
                                            {
                                                <label class="td-cell-select" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@IsBulkSelected(item)"
                                                           disabled="@(IsDraftMutationBusy || (item.Status != DraftStatusDto.Draft && !_unrestrictedMode))"
                                                           aria-label="@BuildBulkSelectionLabel(item, bulkSelectionGroupLabel)"
                                                           @onchange="_ => ToggleBulkSelection(item)" />
                                                    <span>Вибрати</span>
                                                </label>
                                            }
                                            @if (canDrag && item is not null)
                                            {
                                                <div class="td-cell-drag-handle"
                                                     draggable="true"
                                                     title="Перетягнути пару"
                                                     aria-hidden="true"
                                                     @onclick:stopPropagation="true"
                                                     @onmousedown:preventDefault
                                                     @ondragstart="e => OnItemDragStart(slotKey, item, e)"
                                                     @ondragend="OnItemDragEnd">
                                                    <span aria-hidden="true">&#9776;</span>
                                                </div>
                                            }
                                            @if (item is null)
                                            {
                                                <div class="td-empty-box">
                                                    <span class="td-empty">@(_showProblemsOnly ? "Без проблем" : "Вільно")</span>
                                                    @if (!_showProblemsOnly)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-ghost btn-sm td-empty-add"
                                                                disabled="@IsDraftMutationBusy"
                                                                @onclick="async () => await StartCreate(dayNumber, slot.Start, slot.End, group.Id)">
                                                            <span aria-hidden="true">＋</span>
                                                            <span>Додати</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (IsBreak(item) || IsCanceled(item))
                                            {
                                                <div class="td-cell-title">@item.LessonTypeName</div>
                                                <div class="td-cell-meta">@slot.Label</div>
                                                <div class="td-cell-actions">
                                                    <button class="btn btn-ghost btn-sm td-edit-btn text-danger" title="Редагувати або перенести" disabled="@IsDraftMutationBusy" @onclick="async () => await OpenBulkEditAsync(item)" @onclick:stopPropagation="true">
                                                        <span class="td-edit-icon" aria-hidden="true">✎</span>
                                                    </button>
                                                    <button class="btn btn-ghost btn-sm td-edit-btn text-danger"
                                                            title="Видалити"
                                                            disabled="@(!CanDeleteItem(item))"
                                                            @onclick="async () => await DeleteItemAsync(item)"
                                                            @onclick:stopPropagation="true">
                                                        <span class="td-edit-icon" aria-hidden="true">🗑</span>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                var moduleCourse = ModuleCourseCaption(item.ModuleId);
                                                <div class="td-cell-title">
                                                    <div>@item.Module</div>
                                                    @if (!string.IsNullOrWhiteSpace(moduleCourse))
                                                    {
                                                        <div class="td-cell-course text-muted small">@moduleCourse</div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.TopicCode))
                                                {
                                                <div class="td-topic text-muted">@item.TopicCode</div>
                                                }
                                                @if (item.TeacherNames is { Count: > 0 })
                                                {
                                                    <div class="td-cell-teacher">
                                                        @foreach (var teacherName in item.TeacherNames)
                                                        {
                                                            <div>@teacherName</div>
                                                        }
                                                    </div>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item.Teacher))
                                                {
                                                    <div class="td-cell-teacher">@item.Teacher</div>
                                                }
                                                <div class="td-cell-meta">
                                                    <span>@item.LessonTypeName</span>
                                                    <span class="td-slot-mode">@((item.IsSelfStudy ? "Самостійна година" : "Аудиторна година"))</span>
                                                    @if (!item.IsSelfStudy && item.RequiresRoom && !string.IsNullOrWhiteSpace(item.Room))
                                                    {
                                                        <span>Ауд. @item.Room</span>
                                                    }
                                                </div>
                                                @if (mergeSpan > 1 && !string.IsNullOrWhiteSpace(mergedGroupLabel))
                                                {
                                                    <div class="td-merged-groups" title="@mergedGroupLabel">Об'єднана лекція: @mergedGroupLabel</div>
                                                }
                                                @if (item.IsRescheduled)
                                                {
                                                    <div class="td-cell-flag">Перенесено</div>
                                                }
                                                @if (_warningReports.TryGetValue(item.Id, out var report))
                                                {
                                                    var expanded = _expandedWarningSlots.Contains(item.Id);
                                                    var (errorCount, warningCount) = CountIssues(report);
                                                    <div class="td-slot-alert">
                                                        <div class="td-slot-alert-head">
                                                            <button type="button" class="td-slot-alert-toggle" @onclick="() => ToggleWarningPanel(item.Id)" @onclick:stopPropagation="true">
                                                                @(expanded ? "Згорнути попередження" : "Розгорнути попередження")
                                                            </button>
                                                            <div class="td-slot-alert-summary">
                                                                <span class="td-slot-alert-badge td-slot-alert-badge--error">Критичних: @errorCount</span>
                                                                <span class="td-slot-alert-badge td-slot-alert-badge--warn">Застережень: @warningCount</span>
                                                                <span class="td-slot-alert-time">Оновлено: @report.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                            </div>
                                                        </div>
                                                        @if (expanded)
                                                        {
                                                            <div class="td-slot-alert-body">
                                                                @foreach (var issue in report.Issues)
                                                                {
                                                                    <div class="@(string.Equals(issue.Severity, "error", StringComparison.OrdinalIgnoreCase) ? "td-slot-issue td-slot-issue--error" : "td-slot-issue td-slot-issue--warning")">
                                                                        <div class="td-slot-issue-title">@issue.Title</div>
                                                                        <div class="td-slot-issue-text">@issue.Description</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                <div class="td-cell-footer">
                                                    <span class="badge @GetStatusBadgeCss(item.Status)">@FormatStatus(item.Status)</span>
                                                    <div class="td-cell-actions">
                                                        <button class="btn btn-ghost btn-sm td-edit-btn text-danger" title="Редагувати або перенести" disabled="@IsDraftMutationBusy" @onclick="async () => await OpenBulkEditAsync(item)" @onclick:stopPropagation="true">
                                                            <span class="td-edit-icon" aria-hidden="true">✎</span>
                                                        </button>
                                                        <button class="btn btn-ghost btn-sm td-edit-btn text-danger"
                                                                title="Видалити"
                                                                disabled="@(!CanDeleteItem(item))"
                                                                @onclick="async () => await DeleteItemAsync(item)"
                                                                @onclick:stopPropagation="true">
                                                            <span class="td-edit-icon" aria-hidden="true">🗑</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    if (mergeSpan > 1)
                                    {
                                        groupIndex += mergeSpan - 1;
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_bulkEditOpen && _meta is not null)
{
    <div class="editor-overlay" @onclick="() => { if (!IsDraftMutationBusy) CloseBulkEdit(); }">
        <div class="editor editor-modal bulk-editor"
             role="dialog"
             aria-modal="true"
             aria-labelledby="bulk-editor-title"
             tabindex="-1"
             @ref="_bulkDialogElement"
             @onkeydown="HandleBulkDialogKeyDown"
             @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div id="bulk-editor-title" class="editor-title">Масове редагування пар</div>
                    <div class="editor-subtitle">
                        Обрано: @_bulkSelectedIds.Count, день: @BulkSelectedDayLabel()
                    </div>
                </div>
                <button class="btn btn-ghost editor-close" type="button" aria-label="Закрити масове редагування" @onclick="CloseBulkEdit" disabled="@IsDraftMutationBusy">×</button>
            </div>
            <fieldset class="editor-operation-fieldset" disabled="@IsDraftMutationBusy">
            @{
                var effectiveBulkModuleId = ResolveEffectiveBulkModuleId();
                var bulkTopics = effectiveBulkModuleId is int moduleId
                    ? OrderedTopicsForModule(moduleId)
                    : new List<ModuleTopicViewDto>();
            }
            <div class="editor-grid">
                <div class="editor-field editor-field--wide">
                    <label>Викладачі (можна кілька)</label>
                    <div class="bulk-editor-teachers">
                        @foreach (var teacher in _meta.Teachers.OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase))
                        {
                            var selected = _bulkTeacherIds.Contains(teacher.Id);
                            <label class="bulk-editor-teacher-row">
                                <input type="checkbox"
                                       checked="@selected"
                                       aria-label="@($"Викладач {teacher.Name}")"
                                       @onchange="(e) => ToggleBulkTeacher(e, teacher.Id)" />
                                <span>@teacher.Name</span>
                            </label>
                        }
                    </div>
                    <div class="bulk-editor-actions">
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="SelectAllBulkTeachers">Обрати всіх</button>
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="ClearBulkTeachers">Очистити</button>
                    </div>
                    <div class="bulk-editor-hint">Порожній список означає: викладачів не змінювати.</div>
                </div>
                <div class="editor-field">
                    <label for="teacher-drafts-bulk-room">Аудиторія</label>
                    <select id="teacher-drafts-bulk-room" class="select" @bind="_bulkRoomId">
                        <option value="">Без змін</option>
                        @foreach (var room in _meta.Rooms.OrderBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase))
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </div>
                <div class="editor-field editor-field--wide">
                    <label for="teacher-drafts-bulk-module">Модуль</label>
                    <select id="teacher-drafts-bulk-module" class="select" @onchange="OnBulkModuleChanged">
                        <option value="" selected="@(_bulkModuleId is null)">Без змін</option>
                        @foreach (var module in _meta.Modules.OrderBy(m => m.Code, NaturalStringComparer.CurrentCultureIgnoreCase).ThenBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase))
                        {
                            <option value="@module.Id" selected="@(_bulkModuleId == module.Id)">@ModuleOptionCaption(module)</option>
                        }
                    </select>
                    <div class="bulk-editor-hint">Якщо модуль не вибрано, теми можна змінити лише коли всі обрані пари з одного модуля.</div>
                </div>
                <div class="editor-field editor-field--wide">
                    <label>Теми заняття (можна кілька)</label>
                    @if (effectiveBulkModuleId is null)
                    {
                        <div class="bulk-editor-hint">Оберіть модуль, щоб змінити теми.</div>
                    }
                    else if (bulkTopics.Count == 0)
                    {
                        <div class="bulk-editor-hint">Для обраного модуля теми відсутні.</div>
                    }
                    else
                    {
                        <div class="bulk-editor-teachers">
                            @foreach (var topic in bulkTopics)
                            {
                                var selected = _bulkTopicIds.Contains(topic.Id);
                                <label class="bulk-editor-teacher-row">
                                    <input type="checkbox"
                                           checked="@selected"
                                           aria-label="@($"Тема заняття {TopicOptionCaption(topic)}")"
                                           @onchange="(e) => ToggleBulkTopic(e, topic.Id)" />
                                    <span>@TopicOptionCaption(topic)</span>
                                </label>
                            }
                        </div>
                        <div class="bulk-editor-actions">
                            <button class="btn btn-ghost btn-sm" type="button" @onclick="SelectAllBulkTopics">Обрати всі</button>
                            <button class="btn btn-ghost btn-sm" type="button" @onclick="ClearBulkTopics">Очистити</button>
                        </div>
                        <div class="bulk-editor-hint">Усі обрані теми будуть додані до кожної обраної пари. Дозволені лише теми з однаковим типом заняття.</div>
                    }
                </div>
            </div>
            <div class="editor-actions">
                <button class="btn btn-primary" type="button" @onclick="ApplyBulkEditAsync" disabled="@IsDraftMutationBusy">
                    @(_bulkApplying ? "Застосовую..." : "Застосувати")
                </button>
                <button class="btn btn-ghost" type="button" @onclick="CloseBulkEdit">Скасувати</button>
            </div>
            </fieldset>
        </div>
    </div>
}

@if (_edit is not null && _meta is not null)
{
    <div class="editor-overlay" @onclick="() => { if (!IsDraftMutationBusy) CancelEdit(); }">
        <div class="editor editor-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="teacher-draft-editor-title"
             tabindex="-1"
             @ref="_editDialogElement"
             @onkeydown="HandleEditDialogKeyDown"
             @onclick:stopPropagation="true">
            <div class="editor-modal-head">
                <div>
                    <div id="teacher-draft-editor-title" class="editor-title">Редагування пари</div>
                    <div class="editor-subtitle">@_edit!.Date.ToString("dd.MM.yyyy") · @_edit!.TimeStart-@_edit!.TimeEnd</div>
                </div>
                <button type="button" class="btn btn-ghost editor-close" aria-label="Закрити редагування" title="Закрити" @onclick="CancelEdit" disabled="@IsDraftMutationBusy">×</button>
            </div>
            <fieldset class="editor-operation-fieldset" disabled="@IsDraftMutationBusy">
            @{
                var moduleTopics = OrderedTopicsForModule(_edit!.ModuleId);
                var selectedTopicIds = OrderedTopicIdsForModule(_edit!.ModuleId, _editTopicIds);
                var selectedModule = _meta.Modules.FirstOrDefault(m => m.Id == _edit!.ModuleId);
                var selectedTopic = selectedTopicIds.Count > 0
                    ? moduleTopics.FirstOrDefault(t => t.Id == selectedTopicIds[0])
                    : null;
                var teacherOptions = AllowedTeachersForTopic(selectedTopic);
                var topicSelectionDisabled = IsFinalAssessment(_edit!.LessonTypeId);
                var editDaySlots = DaySlotsFor(_edit!.Date);
                var editStartSlotIndex = ResolveSlotStartIndex(editDaySlots, _edit!.TimeStart);
                if (editDaySlots.Count > 0)
                {
                    editStartSlotIndex = Math.Clamp(editStartSlotIndex < 0 ? 0 : editStartSlotIndex, 0, editDaySlots.Count - 1);
                }
                var editEndSlotIndex = ResolveSlotEndIndex(editDaySlots, _edit!.TimeEnd, editStartSlotIndex);
                if (editDaySlots.Count > 0)
                {
                    editEndSlotIndex = Math.Clamp(editEndSlotIndex < 0 ? editStartSlotIndex : editEndSlotIndex, editStartSlotIndex, editDaySlots.Count - 1);
                }
            }
            <div class="editor-grid">
            <div class="editor-field">
                <label for="teacher-draft-edit-date">Дата</label>
                <input id="teacher-draft-edit-date" type="date" class="select"
                       min="@_weekStart.ToString("yyyy-MM-dd")"
                       max="@_weekStart.AddDays(6).ToString("yyyy-MM-dd")"
                       value="@_edit!.Date.ToString("yyyy-MM-dd")"
                       @onchange="OnEditDateChanged" />
            </div>
            <div class="editor-field">
                <label for="teacher-draft-edit-start-slot">З якої години</label>
                <select id="teacher-draft-edit-start-slot" class="select"
                        value="@(editStartSlotIndex >= 0 ? (editStartSlotIndex + 1).ToString(CultureInfo.InvariantCulture) : string.Empty)"
                        @onchange="OnEditStartSlotChanged"
                        disabled="@(editDaySlots.Count == 0)">
                    @if (editDaySlots.Count == 0)
                    {
                        <option value="">Немає доступних пар</option>
                    }
                    else
                    {
                        @for (var slotIndex = 0; slotIndex < editDaySlots.Count; slotIndex++)
                        {
                            var slot = editDaySlots[slotIndex];
                            <option value="@(slotIndex + 1)">
                                @($"{slotIndex + 1:00} ({slot.Start}-{slot.End})")
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="editor-field">
                <label for="teacher-draft-edit-end-slot">До якої години</label>
                <select id="teacher-draft-edit-end-slot" class="select"
                        value="@(editEndSlotIndex >= 0 ? (editEndSlotIndex + 1).ToString(CultureInfo.InvariantCulture) : string.Empty)"
                        @onchange="OnEditEndSlotChanged"
                        disabled="@(editDaySlots.Count == 0)">
                    @if (editDaySlots.Count == 0)
                    {
                        <option value="">Немає доступних пар</option>
                    }
                    else
                    {
                        @for (var slotIndex = Math.Max(editStartSlotIndex, 0); slotIndex < editDaySlots.Count; slotIndex++)
                        {
                            var slot = editDaySlots[slotIndex];
                            <option value="@(slotIndex + 1)">
                                @($"{slotIndex + 1:00} ({slot.Start}-{slot.End})")
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="editor-field">
                <label for="teacher-draft-edit-group">Група</label>
                <select id="teacher-draft-edit-group" class="select" @onchange="e => _edit = _edit! with { GroupId = int.Parse((string)e.Value!) }">
                    @foreach (var g in _meta.Groups)
                    {
                        <option value="@g.Id" selected="@(@g.Id == _edit!.GroupId)">@g.Name</option>
                    }
                </select>
            </div>
            <div class="editor-field">
                <label for="teacher-draft-edit-teacher">Викладач</label>
                <select id="teacher-draft-edit-teacher" class="select" @onchange="e => _edit = _edit! with { TeacherId = int.TryParse((string?)e.Value, out var v) ? v : (int?)null }">
                    <option value="">(без викладача)</option>
                    @foreach (var t in teacherOptions)
                    {
                        <option value="@t.Id" selected="@(@t.Id == _edit!.TeacherId)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="editor-field editor-field--wide">
                <label for="teacher-draft-edit-module">
                    Модуль
                    @if (!string.IsNullOrWhiteSpace(selectedModule?.Code))
                    {
                        <span class="editor-code">@selectedModule?.Code</span>
                    }
                </label>
                <select id="teacher-draft-edit-module" class="select" @onchange="OnModuleChanged">
                    @foreach (var m in _meta.Modules)
                    {
                        <option value="@m.Id" selected="@(@m.Id == _edit!.ModuleId)">@ModuleOptionCaption(m)</option>
                    }
                </select>
            </div>
            <div class="editor-field editor-field--wide">
                <label>
                    Теми заняття
                    @if (!string.IsNullOrWhiteSpace(selectedTopic?.TopicCode))
                    {
                        <span class="editor-code">@selectedTopic?.TopicCode</span>
                    }
                </label>
                @if (moduleTopics.Count == 0)
                {
                    <div class="bulk-editor-hint">Теми заняття відсутні.</div>
                }
                else
                {
                    <div class="bulk-editor-teachers">
                        @foreach (var topic in moduleTopics)
                        {
                            var selected = selectedTopicIds.Contains(topic.Id);
                            <label class="bulk-editor-teacher-row">
                                <input type="checkbox"
                                       checked="@selected"
                                       disabled="@topicSelectionDisabled"
                                       aria-label="@($"Тема заняття {TopicOptionCaption(topic)}")"
                                       @onchange="(e) => ToggleEditTopic(e, topic.Id)" />
                                <span>@TopicOptionCaption(topic)</span>
                            </label>
                        }
                    </div>
                    <div class="bulk-editor-actions">
                        <button class="btn btn-ghost btn-sm"
                                type="button"
                                @onclick="SelectAllEditTopics"
                                disabled="@topicSelectionDisabled">
                            Обрати всі
                        </button>
                        <button class="btn btn-ghost btn-sm"
                                type="button"
                                @onclick="ClearEditTopics"
                                disabled="@topicSelectionDisabled">
                            Очистити
                        </button>
                    </div>
                    @if (topicSelectionDisabled)
                    {
                        <div class="bulk-editor-hint">Для підсумкового контролю тема заняття не використовується.</div>
                    }
                    else
                    {
                        <div class="bulk-editor-hint">Під час збереження всі обрані теми додаються до кожної пари. Дозволені лише теми з однаковим типом заняття.</div>
                    }
                }
            </div>
            <div class="editor-field">
                <label for="teacher-draft-edit-lesson-type">Тип заняття</label>
                <select id="teacher-draft-edit-lesson-type" class="select" @onchange="OnLessonTypeChanged">
                    <option value="" selected="@(_edit!.LessonTypeId <= 0)">Оберіть тип заняття</option>
                    @foreach (var lt in AllowedLessonTypes)
                    {
                        <option value="@lt.Id" selected="@(@lt.Id == _edit!.LessonTypeId)">
                            @lt.Name
                        </option>
                    }
                </select>
            </div>
            <div class="editor-field editor-field--wide editor-field--room-left">
                <label for="teacher-draft-edit-room">
                    Аудиторія
                </label>
                <select id="teacher-draft-edit-room" class="select" @onchange="OnRoomChanged" disabled="@(!_edit.RequiresRoom)">
                    <option value="">(без аудиторії)</option>
                    @foreach (var r in _meta.Rooms)
                    {
                        <option value="@r.Id" selected="@(@r.Id == _edit!.RoomId)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="editor-field editor-field--full editor-lock">
                <label class="ck">
                    <input type="checkbox" checked="@_edit.IsLocked"
                           aria-label="Зафіксувати пару"
                           @onchange="e => _edit = _edit! with { IsLocked = (bool)e.Value! }" />
                    <span>🔒 Зафіксувати</span>
                </label>
            </div>
        </div>
        @if (_edit?.Id is null)
        {
            <div class="extra-duplicates">
                <div class="extra-duplicates-header">Дублювання пари</div>
                <p class="extra-duplicates-hint">Оберіть додаткові групи та викладачів — вони будуть додані до всіх дубльованих пар разом з основним викладачем.</p>
                <div class="extra-duplicates-grid">
                    <div class="extra-duplicates-section">
                        <div class="extra-duplicates-title">Додаткові групи</div>
                        @if (_extraGroups.Count == 0)
                        {
                            <div class="extra-duplicates-empty">Додаткові групи не вибрані.</div>
                        }
                        @foreach (var extra in _extraGroups)
                        {
                            <div class="extra-duplicates-row" @key="extra">
                                <div>
                                    <label>Обрати додаткову групу</label>
                                    <select class="select"
                                            aria-label="Обрати додаткову групу"
                                            @onchange="e => extra.GroupId = int.TryParse((string?)e.Value, out var g) ? g : (int?)null">
                                        <option value="">(не вибрано)</option>
                                        @foreach (var g in _meta.Groups)
                                        {
                                            <option value="@g.Id" selected="@(@g.Id == extra.GroupId)">@g.Name</option>
                                        }
                                    </select>
                                </div>
                                <button type="button"
                                        class="btn btn-ghost extra-duplicates-remove"
                                        title="Прибрати групу"
                                        @onclick="() => RemoveExtraGroup(extra)">×</button>
                            </div>
                        }
                        <button type="button" class="btn btn-secondary extra-duplicates-add" @onclick="AddExtraGroup">Додати групу</button>
                    </div>
                    <div class="extra-duplicates-section">
                        <div class="extra-duplicates-title">Додаткові викладачі (для всіх груп)</div>
                        @if (_extraTeachers.Count == 0)
                        {
                            <div class="extra-duplicates-empty">Додаткові викладачі не вибрані.</div>
                        }
                        @foreach (var extra in _extraTeachers)
                        {
                            <div class="extra-duplicates-row" @key="extra">
                                <div>
                                    <label>Обрати додаткового викладача</label>
                                    <select class="select"
                                            aria-label="Обрати додаткового викладача"
                                            @onchange="e => extra.TeacherId = int.TryParse((string?)e.Value, out var t) ? t : (int?)null">
                                        <option value="">(не вибрано)</option>
                                        @foreach (var t in teacherOptions)
                                        {
                                            <option value="@t.Id" selected="@(@t.Id == extra.TeacherId)">@t.Name</option>
                                        }
                                    </select>
                                </div>
                                <button type="button"
                                        class="btn btn-ghost extra-duplicates-remove"
                                        title="Прибрати викладача"
                                        @onclick="() => RemoveExtraTeacher(extra)">×</button>
                            </div>
                        }
                        <button type="button" class="btn btn-secondary extra-duplicates-add" @onclick="AddExtraTeacher">Додати викладача</button>
                    </div>
                </div>
            </div>
        }
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="SaveEdit" disabled="@IsDraftMutationBusy">Зберегти</button>
            @if (_edit?.Id is int)
            {
                <button class="btn btn-ghost" @onclick="DeleteEdit" disabled="@IsDraftMutationBusy">Видалити</button>
            }
            <button class="btn btn-ghost" @onclick="CancelEdit">Скасувати</button>
        </div>
        </fieldset>
        </div>
    </div>
}
}

</div>

