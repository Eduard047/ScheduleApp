    // Формує підпис для обраного дня у масовому редагуванні.
    private string BulkSelectedDayLabel()
        => _bulkSelectedDayNumber is int dayNumber ? DayToDate(dayNumber).ToString("dd.MM.yyyy") : "—";
    // Повертає підпис для викладача.
    private string ResolveTeacherLabel(int? teacherId)
    {
        if (teacherId is not int id) return "без змін";
        return _meta?.Teachers.FirstOrDefault(t => t.Id == id)?.Name ?? $"#{id}";
    }
    // Повертає підпис для аудиторії.
    private string ResolveRoomLabel(int? roomId)
    {
        if (roomId is not int id) return "без змін";
        return _meta?.Rooms.FirstOrDefault(r => r.Id == id)?.Name ?? $"#{id}";
