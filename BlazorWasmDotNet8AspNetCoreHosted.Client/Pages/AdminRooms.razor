@* Сторінка адміністрування аудиторій *@
@page "/admin/rooms"
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Admin
@inject IJSRuntime JS

<PageTitle>Адмін • Аудиторії</PageTitle>

<h3 class="mb-3">Аудиторії</h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreate">Додати аудиторію</button>
        <AdminSearchBox @bind-Value="filter" Class="ms-auto" Style="max-width:360px;" Placeholder="Id / назва / місткість / корпус" />
        <div class="small text-muted">Показано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(RoomEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">Id</SortableHeader>
                    <SortableHeader Field="@nameof(RoomEditDto.Name)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                    <SortableHeader Field="@nameof(RoomEditDto.Capacity)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Місткість</SortableHeader>
                    <SortableHeader Field="@BuildingField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Корпус</SortableHeader>
                    <th style="width:220px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in SortedAndFiltered)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td>@r.Name</td>
                        <td>@r.Capacity</td>
                        <td>@NameOf(buildings, r.BuildingId)</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEdit(r)">Редагувати</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(r.Id!.Value)">Видалити</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (editorOpen)
{
    <AdminEditorModal Title="@RoomEditorTitle"
                      Subtitle="Заповніть назву, місткість та виберіть корпус."
                      CssClass="room-editor"
                      OnClose="@CloseEditor">
        <div class="row g-3">
            <div class="col-12 col-md-5">
                <label class="form-label">Назва</label>
                <input class="form-control" @bind="form.Name" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Місткість</label>
                <input type="number" min="0" class="form-control" @bind="form.Capacity" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Корпус</label>
                <select class="form-select" @bind="form.BuildingId">
                    <option value="0">— Оберіть —</option>
                    @foreach (var b in buildings)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="Save">Зберегти</button>
            <button class="btn btn-outline-secondary" @onclick="CloseEditor">Скасувати</button>
        </div>
    </AdminEditorModal>
}

@code {

    private string? error, ok;
    private List<RoomEditDto> items = new();
    private RoomEditDto form = NewForm();
    private List<BuildingEditDto> buildings = new();
    private bool editorOpen;
    private const string BuildingField = "Building";
    private string sortField = nameof(RoomEditDto.Name);
    private bool sortAsc = true;
    private string? filter;
    private string RoomEditorTitle => form.Id is null
        ? "Створення аудиторії"
        : $"Редагування аудиторії #{form.Id}";
    private static RoomEditDto NewForm() => new() { Id = null, Name = "", Capacity = 0, BuildingId = 0 };
    private void OpenCreate()
    {
        form = NewForm();
        editorOpen = true;
    }
    private void OpenEdit(RoomEditDto room)
    {
        form = new(room.Id, room.Name, room.Capacity, room.BuildingId);
        editorOpen = true;
    }
    private void CloseEditor()
    {
        editorOpen = false;
        form = NewForm();
    }
    // Початкове завантаження аудиторій і корпусів.
    protected override async Task OnInitializedAsync() => await Load();
    // Завантажує список аудиторій та корпусів.
    private async Task Load()
    {
        try
        {
            error = ok = null;
            items = await Admin.GetRooms();
            buildings = await Admin.GetBuildings();
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Повертає назву корпусу за ідентифікатором.
    private static string NameOf(IEnumerable<BuildingEditDto> list, int id)
        => list.FirstOrDefault(x => x.Id == id)?.Name ?? $"#{id}";
    // Зберігає аудиторію через API.
    private async Task Save()
    {
        try
        {
            await Admin.UpsertRoom(form);
            await Load();
            ok = "Збережено.";
            CloseEditor();
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Видаляє аудиторію після підтвердження.
    private async Task Delete(int id)
    {
        try
        {
            var room = items.FirstOrDefault(r => r.Id == id);
            var caption = room is null ? $"#{id}" : $"{room.Name} (#{id})";
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити аудиторію {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            await Admin.DeleteRoom(id);
            await Load();
            ok = "Видалено.";
        }
        catch (Exception ex) { error = ex.Message; }
    }
    // Фільтрує аудиторії за пошуковим рядком.
    private IEnumerable<RoomEditDto> ApplyFilter(IEnumerable<RoomEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(r =>
            r.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) == true ||
            (r.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            r.Capacity.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ||
            NameOf(buildings, r.BuildingId).Contains(f, StringComparison.OrdinalIgnoreCase)
        );
    }
    // Сортує аудиторії за вибраним полем.
    private IEnumerable<RoomEditDto> ApplySort(IEnumerable<RoomEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(RoomEditDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(RoomEditDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(RoomEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(RoomEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(RoomEditDto.Capacity), true) => seq.OrderBy(x => x.Capacity),
            (nameof(RoomEditDto.Capacity), false) => seq.OrderByDescending(x => x.Capacity),
            (BuildingField, true) => seq.OrderBy(x => NameOf(buildings, x.BuildingId)).ThenBy(x => x.Name),
            (BuildingField, false) => seq.OrderByDescending(x => NameOf(buildings, x.BuildingId)).ThenByDescending(x => x.Name),
            _ => seq
        };
    }
    private IEnumerable<RoomEditDto> SortedAndFiltered => ApplySort(ApplyFilter(items));
    // Перемикає напрямок сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
}
