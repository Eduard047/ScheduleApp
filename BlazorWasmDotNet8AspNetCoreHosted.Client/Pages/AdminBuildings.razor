@* Сторінка адміністрування будівель *@
@page "/admin/buildings"
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Admin
@inject IJSRuntime JS

<PageTitle>Адмін • Корпуси</PageTitle>

<h1 class="h3 mb-3">Корпуси</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
        @if (loadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoad" disabled="@(loading || mutationInProgress)">
                    Повторити завантаження
                </button>
            </div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}

@if (loading)
{
    <div class="alert alert-info" role="status" aria-live="polite">Завантаження…</div>
}
else
{
    <fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <button class="btn btn-primary" @onclick="OpenCreateBuilding">Додати корпус</button>
            <AdminSearchBox @bind-Value="filterBuildings" Class="ms-auto" Style="max-width:360px;" Placeholder="Id / назва / адреса" />
            <div class="small text-muted">Показано: @SortedBuildings.Count() з @buildings.Count</div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <SortableHeader Field="@nameof(BuildingEditDto.Id)" ActiveField="@sortFieldB" SortAscending="@sortAscB" OnSort="@ToggleSortB" Style="width:80px;">Id</SortableHeader>
                        <SortableHeader Field="@nameof(BuildingEditDto.Name)" ActiveField="@sortFieldB" SortAscending="@sortAscB" OnSort="@ToggleSortB">Назва</SortableHeader>
                        <SortableHeader Field="@nameof(BuildingEditDto.Address)" ActiveField="@sortFieldB" SortAscending="@sortAscB" OnSort="@ToggleSortB">Адреса</SortableHeader>
                        <th style="width:220px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in SortedBuildings)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td>@b.Name</td>
                            <td>@b.Address</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditBuilding(b)">Редагувати</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBuilding(b.Id!.Value)">Видалити</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <h4 class="mt-4 mb-2">Час на дорогу між корпусами</h4>
    <div class="card p-3">
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <button class="btn btn-primary" @onclick="OpenCreateTravel">Додати маршрут</button>
            <AdminSearchBox @bind-Value="filterTravels" Class="ms-auto" Style="max-width:420px;" Placeholder="з / до / хвилин" />
            <div class="small text-muted">Показано: @SortedTravels.Count() з @travels.Count</div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <SortableHeader Field="@FromField" ActiveField="@sortFieldT" SortAscending="@sortAscT" OnSort="@ToggleSortT">З</SortableHeader>
                        <SortableHeader Field="@ToField" ActiveField="@sortFieldT" SortAscending="@sortAscT" OnSort="@ToggleSortT">До</SortableHeader>
                        <SortableHeader Field="@nameof(BuildingTravelEditDto.Minutes)" ActiveField="@sortFieldT" SortAscending="@sortAscT" OnSort="@ToggleSortT" Style="width:120px;">Хвилин</SortableHeader>
                        <th style="width:220px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in SortedTravels)
                    {
                        <tr>
                            <td>@NameOf(t.FromBuildingId)</td>
                            <td>@NameOf(t.ToBuildingId)</td>
                            <td>@t.Minutes</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditTravel(t)">Редагувати</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTravel(t)">Видалити</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </fieldset>
}

@if (buildingEditorOpen)
{
    <AdminEditorModal Title="@BuildingEditorTitle"
                      Subtitle="Вкажіть назву корпусу та за потреби адресу."
                      CssClass="building-editor"
                      Busy="@(loading || mutationInProgress)"
                      OnClose="@CloseBuildingEditor">
        @if (loadFailed)
        {
            <div class="alert alert-danger" role="alert">
                <div class="fw-semibold">Операцію виконано, але дані не оновлено.</div>
                <div class="small mt-1">@error</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="RetryLoad"
                        disabled="@(loading || mutationInProgress)">
                    @(loading ? "Завантаження…" : "Повторити лише завантаження")
                </button>
            </div>
        }
        <fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" for="building-name">Назва</label>
                <input id="building-name" class="form-control" @bind="form.Name" />
            </div>
            <div class="col-12">
                <label class="form-label" for="building-address">Адреса</label>
                <input id="building-address" class="form-control" @bind="form.Address" />
            </div>
        </div>
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="SaveBuilding">@(saving ? "Збереження…" : "Зберегти")</button>
            <button class="btn btn-outline-secondary" @onclick="CloseBuildingEditor">Скасувати</button>
        </div>
        </fieldset>
    </AdminEditorModal>
}

@if (travelEditorOpen)
{
    <AdminEditorModal Title="@TravelEditorTitle"
                      Subtitle="Виберіть корпуси та вкажіть час у хвилинах."
                      CssClass="travel-editor"
                      Busy="@(loading || mutationInProgress)"
                      OnClose="@CloseTravelEditor">
        @if (loadFailed)
        {
            <div class="alert alert-danger" role="alert">
                <div class="fw-semibold">Операцію виконано, але дані не оновлено.</div>
                <div class="small mt-1">@error</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="RetryLoad"
                        disabled="@(loading || mutationInProgress)">
                    @(loading ? "Завантаження…" : "Повторити лише завантаження")
                </button>
            </div>
        }
        <fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
        <div class="row g-3">
            <div class="col-12 col-md-5">
                <label class="form-label" for="travel-from-building">З корпусу</label>
                <select id="travel-from-building" class="form-select" @bind="travelFromId">
                    <option value="0">— Оберіть —</option>
                    @foreach (var b in buildings.OrderBy(x => x.Name))
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label" for="travel-to-building">До корпусу</label>
                <select id="travel-to-building" class="form-select" @bind="travelToId">
                    <option value="0">— Оберіть —</option>
                    @foreach (var b in buildings.OrderBy(x => x.Name))
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label" for="travel-minutes">Хвилин</label>
                <input id="travel-minutes" type="number" min="0" class="form-control" @bind="travelMinutes" />
            </div>
        </div>
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="SaveTravel">@(saving ? "Збереження…" : "Зберегти")</button>
            <button class="btn btn-outline-secondary" @onclick="CloseTravelEditor">Скасувати</button>
        </div>
        </fieldset>
    </AdminEditorModal>
}

@code {
    private sealed class BuildingsVm
    {
        public List<BuildingEditDto> buildings { get; set; } = new();
        public List<BuildingTravelEditDto> travels { get; set; } = new();
    }
    private bool loading, saving, loadFailed, mutationInProgress;
    private bool IsInteractionBlocked => loading || mutationInProgress || loadFailed;
    private Action? pendingRefreshCompletion;
    private string? pendingRefreshSuccessMessage;
    private string? error, ok;
    private List<BuildingEditDto> buildings = new();
    private List<BuildingTravelEditDto> travels = new();
    private BuildingEditDto form = NewBuildingForm();
    private bool buildingEditorOpen;
    private bool travelEditorOpen;
    private bool travelEditing;
    private int travelFromId, travelToId, travelMinutes;
    private string? filterBuildings;
    private string sortFieldB = nameof(BuildingEditDto.Name);
    private bool sortAscB = true;
    private string? filterTravels;
    private const string FromField = "From";
    private const string ToField = "To";
    private string sortFieldT = FromField;
    private bool sortAscT = true;
    private string BuildingEditorTitle => form.Id is null
        ? "Створення корпусу"
        : $"Редагування корпусу #{form.Id}";
    private string TravelEditorTitle => travelEditing
        ? "Редагування маршруту між корпусами"
        : "Створення маршруту між корпусами";
    private static BuildingEditDto NewBuildingForm() => new() { Id = null, Name = string.Empty, Address = null };
    private void OpenCreateBuilding()
    {
        form = NewBuildingForm();
        buildingEditorOpen = true;
    }
    private void OpenEditBuilding(BuildingEditDto building)
    {
        form = new() { Id = building.Id, Name = building.Name, Address = building.Address };
        buildingEditorOpen = true;
    }
    private void CloseBuildingEditor()
    {
        buildingEditorOpen = false;
        form = NewBuildingForm();
    }
    private void OpenCreateTravel()
    {
        travelEditing = false;
        travelFromId = 0;
        travelToId = 0;
        travelMinutes = 0;
        travelEditorOpen = true;
    }
    private void OpenEditTravel(BuildingTravelEditDto travel)
    {
        travelEditing = true;
        travelFromId = travel.FromBuildingId;
        travelToId = travel.ToBuildingId;
        travelMinutes = travel.Minutes;
        travelEditorOpen = true;
    }
    private void CloseTravelEditor()
    {
        travelEditorOpen = false;
        travelEditing = false;
        travelFromId = 0;
        travelToId = 0;
        travelMinutes = 0;
    }
    // Початкове завантаження корпусів і маршрутів.
    protected override async Task OnInitializedAsync() => await Load();
    // Завантажує корпуси та маршрути з API.
    private async Task<bool> Load(bool clearMessages = true)
    {
        error = null;
        if (clearMessages) ok = null;
        loading = true;
        loadFailed = false;
        try
        {
            var loadedBuildings = await Admin.GetBuildings();
            var loadedTravels = await Admin.GetBuildingTravels();
            buildings = loadedBuildings;
            travels = loadedTravels;
            return true;
        }
        catch (Exception ex)
        {
            loadFailed = true;
            error = $"Не вдалося завантажити корпуси та маршрути: {ex.Message}";
            return false;
        }
        finally { loading = false; }
    }
    // Повторює лише завантаження після вже виконаної серверної операції.
    private async Task RetryLoad()
    {
        if (loading || mutationInProgress) return;
        if (!await Load(clearMessages: false)) return;
        var completion = pendingRefreshCompletion;
        var successMessage = pendingRefreshSuccessMessage;
        pendingRefreshCompletion = null;
        pendingRefreshSuccessMessage = null;
        completion?.Invoke();
        if (!string.IsNullOrWhiteSpace(successMessage)) ok = successMessage;
    }
    // Зберігає корпус через API.
    private async Task SaveBuilding()
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        saving = true;
        try
        {
            error = ok = null;
            form.Id = await Admin.UpsertBuilding(form);
            await FinishMutationAsync(
                "Корпус збережено",
                "Збережено.",
                "повторно зберігати корпус не потрібно",
                CloseBuildingEditor);
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            saving = false;
            mutationInProgress = false;
        }
    }
    // Видаляє корпус після підтвердження.
    private async Task DeleteBuilding(int id)
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        try
        {
            error = ok = null;
            var caption = NameOf(id);
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити корпус {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            await Admin.DeleteBuilding(id);
            await FinishMutationAsync(
                "Корпус видалено",
                "Видалено.",
                "повторно видаляти корпус не потрібно",
                buildingEditorOpen && form.Id == id ? CloseBuildingEditor : null);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { mutationInProgress = false; }
    }
    // Зберігає маршрут між корпусами.
    private async Task SaveTravel()
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        saving = true;
        try
        {
            error = ok = null;
            var dto = new BuildingTravelEditDto(travelFromId, travelToId, travelMinutes);
            await Admin.UpsertBuildingTravel(dto);
            await FinishMutationAsync(
                "Маршрут збережено",
                "Збережено.",
                "повторно зберігати маршрут не потрібно",
                CloseTravelEditor);
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            saving = false;
            mutationInProgress = false;
        }
    }
    // Видаляє маршрут між корпусами.
    private async Task DeleteTravel(BuildingTravelEditDto t)
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        try
        {
            error = ok = null;
            var fromCaption = NameOf(t.FromBuildingId);
            var toCaption = NameOf(t.ToBuildingId);
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити маршрут {fromCaption} -> {toCaption}? Дію не можна скасувати.");
            if (!confirmed) return;
            await Admin.DeleteBuildingTravel(t.FromBuildingId, t.ToBuildingId);
            await FinishMutationAsync(
                "Маршрут видалено",
                "Видалено.",
                "повторно видаляти маршрут не потрібно",
                travelEditorOpen && travelEditing && travelFromId == t.FromBuildingId && travelToId == t.ToBuildingId
                    ? CloseTravelEditor
                    : null);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { mutationInProgress = false; }
    }
    // Завершує мутацію лише після успішного оновлення локальних списків.
    private async Task FinishMutationAsync(
        string completedAction,
        string successMessage,
        string repeatWarning,
        Action? completion = null)
    {
        if (await Load(clearMessages: false))
        {
            completion?.Invoke();
            ok = successMessage;
            return;
        }

        var refreshError = error;
        ok = null;
        pendingRefreshCompletion = completion;
        pendingRefreshSuccessMessage = successMessage;
        error = $"{completedAction}, але оновити дані не вдалося. Повторіть завантаження; {repeatWarning}. Причина: {refreshError}";
    }
    // Повертає назву корпусу за ідентифікатором.
    private string NameOf(int id) => buildings.FirstOrDefault(b => b.Id == id)?.Name ?? $"#{id}";
    // Фільтрує корпуси за пошуковим рядком.
    private IEnumerable<BuildingEditDto> ApplyFilterB(IEnumerable<BuildingEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filterBuildings)) return seq;
        var f = filterBuildings.Trim();
        return seq.Where(b =>
            b.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) == true ||
            (b.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.Address?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
        );
    }
    // Сортує корпуси за вибраним полем.
    private IEnumerable<BuildingEditDto> ApplySortB(IEnumerable<BuildingEditDto> seq)
    {
        return (sortFieldB, sortAscB) switch
        {
            (nameof(BuildingEditDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(BuildingEditDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(BuildingEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(BuildingEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(BuildingEditDto.Address), true) => seq.OrderBy(x => x.Address).ThenBy(x => x.Name),
            (nameof(BuildingEditDto.Address), false) => seq.OrderByDescending(x => x.Address).ThenByDescending(x => x.Name),
            _ => seq
        };
    }
    private IEnumerable<BuildingEditDto> SortedBuildings => ApplySortB(ApplyFilterB(buildings));
    // Перемикає сортування корпусів.
    private void ToggleSortB(string field)
    {
        if (sortFieldB == field) sortAscB = !sortAscB;
        else { sortFieldB = field; sortAscB = true; }
    }
    // Фільтрує маршрути за пошуковим рядком.
    private IEnumerable<BuildingTravelEditDto> ApplyFilterT(IEnumerable<BuildingTravelEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filterTravels)) return seq;
        var f = filterTravels.Trim();
        return seq.Where(t =>
            NameOf(t.FromBuildingId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            NameOf(t.ToBuildingId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            t.Minutes.ToString().Contains(f, StringComparison.OrdinalIgnoreCase)
        );
    }
    // Сортує маршрути за вибраним полем.
    private IEnumerable<BuildingTravelEditDto> ApplySortT(IEnumerable<BuildingTravelEditDto> seq)
    {
        return (sortFieldT, sortAscT) switch
        {
            (FromField, true) => seq.OrderBy(x => NameOf(x.FromBuildingId)).ThenBy(x => NameOf(x.ToBuildingId)),
            (FromField, false) => seq.OrderByDescending(x => NameOf(x.FromBuildingId)).ThenByDescending(x => NameOf(x.ToBuildingId)),
            (ToField, true) => seq.OrderBy(x => NameOf(x.ToBuildingId)).ThenBy(x => NameOf(x.FromBuildingId)),
            (ToField, false) => seq.OrderByDescending(x => NameOf(x.ToBuildingId)).ThenByDescending(x => NameOf(x.FromBuildingId)),
            (nameof(BuildingTravelEditDto.Minutes), true) => seq.OrderBy(x => x.Minutes).ThenBy(x => NameOf(x.FromBuildingId)),
            (nameof(BuildingTravelEditDto.Minutes), false) => seq.OrderByDescending(x => x.Minutes).ThenByDescending(x => NameOf(x.FromBuildingId)),
            _ => seq
        };
    }
    private IEnumerable<BuildingTravelEditDto> SortedTravels => ApplySortT(ApplyFilterT(travels));
    // Перемикає сортування маршрутів.
    private void ToggleSortT(string field)
    {
        if (sortFieldT == field) sortAscT = !sortAscT;
        else { sortFieldT = field; sortAscT = true; }
    }
}
