@* Сторінка адміністрування навчальних груп *@
@page "/admin/groups"
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@inject IAdminApi Api
@inject IJSRuntime JS

<PageTitle>Адмін • Групи</PageTitle>

<h1 class="h3 mb-3">Групи</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
        @if (loadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoad" disabled="@(loading || mutationInProgress)">
                    Повторити завантаження
                </button>
            </div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}

@if (loading)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Завантаження груп…</div>
}

<fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenCreate">Додати групу</button>
        <AdminSearchBox @bind-Value="filter" Class="ms-auto" Style="max-width:320px;" Placeholder="Id / назва / студенти / курс" />
        <div class="text-muted small">Показано: @SortedAndFiltered.Count() з @items.Count</div>
    </div>
    <div class="table-responsive" role="region" aria-label="Список груп" tabindex="0">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <SortableHeader Field="@nameof(GroupEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:80px;">Id</SortableHeader>
                    <SortableHeader Field="@nameof(GroupEditDto.Name)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                    <SortableHeader Field="@nameof(GroupEditDto.StudentsCount)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Студентів</SortableHeader>
                    <SortableHeader Field="@CourseField" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Курс</SortableHeader>
                    <th style="width:220px;"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!loading && !loadFailed && !SortedAndFiltered.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted text-center py-3">
                            <span class="admin-table-empty-state" role="status">
                                @(items.Count == 0
                                    ? "Поки що немає груп."
                                    : "За вашим пошуком груп не знайдено.")
                            </span>
                        </td>
                    </tr>
                }
                @foreach (var g in SortedAndFiltered)
                {
                    <tr>
                        <td>@g.Id</td>
                        <td>@g.Name</td>
                        <td>@g.StudentsCount</td>
                        <td>@NameOfCourse(g.CourseId)</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-2"
                                    @onclick="() => OpenEdit(g)">
                                Редагувати
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => Delete(g.Id!.Value)">
                                Видалити
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</fieldset>

@if (editorOpen)
{
    <AdminEditorModal Title="@GroupEditorTitle"
                      Subtitle="Оберіть курс і вкажіть кількість студентів."
                      CssClass="group-editor"
                      Busy="@(loading || mutationInProgress)"
                      OnClose="@CloseEditor">
        @if (loadFailed)
        {
            <div class="alert alert-danger" role="alert">
                <div class="fw-semibold">Операцію виконано, але дані не оновлено.</div>
                <div class="small mt-1">@error</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="RetryLoad"
                        disabled="@(loading || mutationInProgress)">
                    @(loading ? "Завантаження…" : "Повторити лише завантаження")
                </button>
            </div>
        }
        <fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label" for="group-name">Назва</label>
                <input id="group-name" class="form-control" @bind="form.Name" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="group-students">Студентів</label>
                <input id="group-students" type="number" min="0" class="form-control" @bind="form.StudentsCount" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="group-course">Курс</label>
                <select id="group-course" class="form-select" @bind="form.CourseId">
                    <option value="0">— Оберіть —</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="editor-actions">
            <button class="btn btn-primary" @onclick="Save">@(saving ? "Збереження…" : "Зберегти")</button>
            <button class="btn btn-outline-secondary" @onclick="CloseEditor">Скасувати</button>
        </div>
        </fieldset>
    </AdminEditorModal>
}

@code {

    private string? error, ok;
    private List<GroupEditDto> items = new();
    private GroupEditDto form = NewForm();
    private List<LookupDto> courses = new();
    private bool editorOpen;
    private bool loading, saving, loadFailed, mutationInProgress;
    private bool IsInteractionBlocked => loading || mutationInProgress || loadFailed;
    private Action? pendingRefreshCompletion;
    private string? pendingRefreshSuccessMessage;
    private const string CourseField = "CourseName";
    private string sortField = nameof(GroupEditDto.Name);
    private bool sortAsc = true;
    private string? filter;
    private string GroupEditorTitle => form.Id is null
        ? "Створення групи"
        : $"Редагування групи #{form.Id}";
    private static GroupEditDto NewForm() => new() { Id = null, Name = "", StudentsCount = 0, CourseId = 0 };
    private void OpenCreate()
    {
        form = NewForm();
        editorOpen = true;
    }
    private void OpenEdit(GroupEditDto group)
    {
        form = new(group.Id, group.Name, group.StudentsCount, group.CourseId);
        editorOpen = true;
    }
    private void CloseEditor()
    {
        editorOpen = false;
        form = NewForm();
    }
    // Початкове завантаження груп і курсів.
    protected override async Task OnInitializedAsync() => await Load();
    // Завантажує список груп і довідник курсів.
    private async Task<bool> Load(bool clearMessages = true)
    {
        error = null;
        if (clearMessages) ok = null;
        loading = true;
        loadFailed = false;
        try
        {
            var loadedItems = await Api.GetGroups();
            var meta = await Api.GetMeta();
            items = loadedItems;
            courses = meta.Courses ?? new();
            return true;
        }
        catch (Exception ex)
        {
            loadFailed = true;
            error = $"Не вдалося завантажити групи: {ex.Message}";
            return false;
        }
        finally { loading = false; }
    }
    // Повторює лише завантаження після вже виконаної серверної операції.
    private async Task RetryLoad()
    {
        if (loading || mutationInProgress) return;
        if (!await Load(clearMessages: false)) return;
        var completion = pendingRefreshCompletion;
        var successMessage = pendingRefreshSuccessMessage;
        pendingRefreshCompletion = null;
        pendingRefreshSuccessMessage = null;
        completion?.Invoke();
        if (!string.IsNullOrWhiteSpace(successMessage)) ok = successMessage;
    }
    // Повертає назву курсу за ідентифікатором.
    private string NameOfCourse(int id) => courses.FirstOrDefault(c => c.Id == id)?.Name ?? $"#{id}";
    // Зберігає групу через API.
    private async Task Save()
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        saving = true;
        try
        {
            error = ok = null;
            form.Id = await Api.UpsertGroup(form);
            await FinishMutationAsync(
                "Групу збережено",
                "Збережено.",
                "повторно зберігати групу не потрібно",
                CloseEditor);
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            saving = false;
            mutationInProgress = false;
        }
    }
    // Видаляє групу з підтвердженням та можливим force.
    private async Task Delete(int id)
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        error = ok = null;
        try
        {
            var group = items.FirstOrDefault(g => g.Id == id);
            var caption = group?.Name ?? $"#{id}";
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"Видалити групу {caption}? Дію не можна скасувати.");
            if (!confirmed) return;
            try
            {
                await Api.DeleteGroup(id);
                await FinishMutationAsync(
                    "Групу видалено",
                    "Видалено.",
                    "повторно видаляти групу не потрібно",
                    editorOpen && form.Id == id ? CloseEditor : null);
                return;
            }
            catch (ApiErrorException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var sure = await JS.InvokeAsync<bool>("confirm",
                    "Група використовується у розкладі. Видалити всі пов’язані заняття?");
                if (!sure) { error = "Дію скасовано користувачем."; return; }
                await Api.DeleteGroup(id, force: true);
                await FinishMutationAsync(
                    "Групу та пов’язані записи видалено",
                    "Групу та пов’язані записи видалено.",
                    "повторно видаляти групу не потрібно",
                    editorOpen && form.Id == id ? CloseEditor : null);
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { mutationInProgress = false; }
    }
    // Завершує мутацію лише після успішного оновлення локального списку.
    private async Task FinishMutationAsync(
        string completedAction,
        string successMessage,
        string repeatWarning,
        Action? completion = null)
    {
        if (await Load(clearMessages: false))
        {
            completion?.Invoke();
            ok = successMessage;
            return;
        }

        var refreshError = error;
        ok = null;
        pendingRefreshCompletion = completion;
        pendingRefreshSuccessMessage = successMessage;
        error = $"{completedAction}, але оновити дані не вдалося. Повторіть завантаження; {repeatWarning}. Причина: {refreshError}";
    }
    // Фільтрує групи за пошуковим рядком.
    private IEnumerable<GroupEditDto> ApplyFilter(IEnumerable<GroupEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(g =>
            (g.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (g.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            g.StudentsCount.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ||
            NameOfCourse(g.CourseId).Contains(f, StringComparison.OrdinalIgnoreCase)
        );
    }
    // Сортує список груп за вибраним полем.
    private IEnumerable<GroupEditDto> ApplySort(IEnumerable<GroupEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(GroupEditDto.Id), true) => seq.OrderBy(x => x.Id ?? 0),
            (nameof(GroupEditDto.Id), false) => seq.OrderByDescending(x => x.Id ?? 0),
            (nameof(GroupEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(GroupEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(GroupEditDto.StudentsCount), true) => seq.OrderBy(x => x.StudentsCount),
            (nameof(GroupEditDto.StudentsCount), false) => seq.OrderByDescending(x => x.StudentsCount),
            (CourseField, true) => seq.OrderBy(x => NameOfCourse(x.CourseId)),
            (CourseField, false) => seq.OrderByDescending(x => NameOfCourse(x.CourseId)),
            _ => seq
        };
    }
    private IEnumerable<GroupEditDto> SortedAndFiltered
        => ApplySort(ApplyFilter(items));
    // Перемикає напрямок сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
}
