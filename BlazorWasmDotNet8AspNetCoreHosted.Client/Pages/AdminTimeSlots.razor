@* Сторінка адміністрування часових слотів *@
@page "/admin/time-slots"
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject HttpClient Http
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.TimeSlotsApi Api

<h3>Слоти часу</h3>

<div class="mb-3">
    <label class="form-label">Рівень</label>
    <div class="d-flex gap-2 flex-wrap">
        <select class="form-select" style="max-width: 280px" @bind="_scope">
            <option value="Global">Глобально (для всіх курсів)</option>
            <option value="Course">Тільки для обраного курсу</option>
        </select>
        @if (_scope == Scope.Course)
        {
            <select class="form-select" style="max-width: 360px" @bind="_courseId">
                <option value="">- оберіть курс -</option>
                @foreach (var c in _courses)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        }
        <select class="form-select" style="max-width: 240px" @bind="_dayOfWeek">
            <option value="">Усі дні (за замовчуванням)</option>
            @foreach (var day in DayOptions)
            {
                <option value="@day.Value">@day.Label</option>
            }
        </select>
        <button class="btn btn-outline-secondary" @onclick="LoadRaw">Завантажити</button>
    </div>
    <div class="form-text">Оберіть день, завантажте або скопіюйте шаблон, відредагуйте та збережіть.</div>
</div>

<div class="mb-3">
    <label class="form-label">Копіювання шаблону</label>
    <div class="d-flex gap-2 flex-wrap">
        <select class="form-select" style="max-width: 240px" @bind="_copyFromDay">
            <option value="">Шаблон за замовчуванням (усі дні)</option>
            @foreach (var day in DayOptions)
            {
                <option value="@day.Value">@day.Label</option>
            }
        </select>
        <button class="btn btn-outline-info" @onclick="CopyFromDay">Скопіювати у поточний день</button>
    </div>
    <div class="form-text">Копіювання бере ефективні слоти з вибраного дня.</div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_ok is not null)
{
    <div class="alert alert-success">@_ok</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <div class="fw-semibold">Ліміт слота для типу з прапорцем "Бажано першим у тижні"</div>
                <div class="form-text">
                    Вкажіть номер пари (слота), до якої автоген намагатиметься ставити цей тип занять раніше за інші. Значення <code>0</code> вимикає обмеження.
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0" for="preferredFirstSlotLimit">До слота</label>
                <input id="preferredFirstSlotLimit" class="form-control" style="width:110px"
                       type="number" min="0" step="1" @bind="_preferredFirstMaxSlotOrder" />
                <button class="btn btn-outline-primary" @onclick="SavePreferredFirstSlotLimit">Зберегти ліміт</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="form-text">
                Слоти використовуються автогенерацією 1-в-1. Перекритя недопустимі. Час вводиться у форматі <code>HH:mm</code>.
            </div>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="AddRow">Додати слот</button>
                <button class="btn btn-sm btn-primary" @onclick="Save">Зберегти</button>
            </div>
        </div>
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:90px">№</th>
                    <th style="width:140px">Старт</th>
                    <th style="width:140px">Фініш</th>
                    <th style="width:140px">Активен</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">Немає слотів</td></tr>
                }
                else
                {
                    @foreach (var r in _rows.OrderBy(x => x.SortOrder).ThenBy(x => x.Start))
                    {
                        <tr>
                            <td>
                                <input class="form-control form-control-sm" style="width:90px"
                                       type="number" min="0" @bind="r.SortOrder" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" style="width:120px"
                                       placeholder="09:00" @bind="r.Start" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" style="width:120px"
                                       placeholder="09:45" @bind="r.End" />
                            </td>
                            <td>
                                <input class="form-check-input" type="checkbox" @bind="r.IsActive" />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRow(r)">Видалити</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="form-text">
            Порада: Тримайте тривалості однаковими (наприклад, 45 хвилин). Автогенерація використовує ці слоти 1-в-1 без окремого обіднього конфігу.
        </div>
    </div>
</div>

@code {
    private static readonly TimeOnly DefaultStart = new(9, 0);
    private static readonly TimeSpan DefaultDuration = TimeSpan.FromMinutes(45);
    private static readonly TimeSpan DefaultBreak = TimeSpan.FromMinutes(10);
    private static readonly (int Value, string Label)[] DayOptions = new[]
    {
        (1, "Понеділок"),
        (2, "Вівторок"),
        (3, "Середа"),
        (4, "Четвер"),
        (5, "П'ятниця"),
        (6, "Субота"),
        (0, "Неділя")
    };
    enum Scope { Global, Course }
    private Scope _scope = Scope.Global;
    private int? _courseId;
    private int? _dayOfWeek;
    private int? _copyFromDay;
    private List<LookupDto> _courses = new();
    private List<TimeSlotDto> _rows = new();
    private int _preferredFirstMaxSlotOrder;
    private string? _error;
    private string? _ok;
    // Завантажує метадані курсів при старті сторінки.
    protected override async Task OnInitializedAsync()
    {
        var meta = await Http.GetFromJsonAsync<MetaResponseDto>("api/meta");
        _courses = meta?.Courses ?? new();
        await LoadPreferredFirstSlotLimit();
    }
    // Завантажує сирі слоти для обраного рівня.
    private async Task LoadRaw()
    {
        _error = _ok = null;
        if (_scope == Scope.Course && _courseId is null) { _error = "Вибери курс."; return; }
        try
        {
            _rows = await Api.GetRawAsync(CurrentCourseId(), _dayOfWeek);
            await LoadPreferredFirstSlotLimit();
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            _error = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    // Копіює ефективні слоти з обраного дня.
    private async Task CopyFromDay()
    {
        _error = _ok = null;
        if (_scope == Scope.Course && _courseId is null) { _error = "Вибери курс."; return; }
        try
        {
            var courseId = _scope == Scope.Global ? null : _courseId;
            var source = await Api.GetEffectiveAsync(courseId, _copyFromDay);
            if (source.Count == 0)
            {
                _rows = new List<TimeSlotDto>();
                _error = "Немає слотів для копіювання.";
                return;
            }
            _rows = source.Select(s => new TimeSlotDto
            {
                Id = 0,
                CourseId = courseId,
                DayOfWeek = _dayOfWeek,
                SortOrder = s.SortOrder,
                Start = s.Start,
                End = s.End,
                IsActive = s.IsActive
            }).ToList();
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            _error = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    // Обчислює наступний слот з урахуванням перерв.
    private (string start, string end) CalculateNextSlot()
    {
        var valid = _rows
            .Select(r => new
            {
                Row = r,
                Start = TryTime(r.Start, out var s) ? s : (TimeOnly?)null,
                End = TryTime(r.End, out var e) ? e : (TimeOnly?)null
            })
            .Where(x => x.Start is not null && x.End is not null && x.Start < x.End)
            .OrderBy(x => x.Row.SortOrder)
            .ThenBy(x => x.Start);
        var nextStart = valid.LastOrDefault()?.End?.Add(DefaultBreak) ?? DefaultStart;
        var nextEnd = nextStart.Add(DefaultDuration);
        return (nextStart.ToString("HH:mm"), nextEnd.ToString("HH:mm"));
    }
    // Додає новий рядок слота.
    private void AddRow()
    {
        var maxOrder = _rows.Count == 0 ? 1 : _rows.Max(x => x.SortOrder) + 1;
        var (start, end) = CalculateNextSlot();
        _rows.Add(new TimeSlotDto
        {
            Id = 0,
            CourseId = _scope == Scope.Global ? null : _courseId,
            DayOfWeek = _dayOfWeek,
            SortOrder = maxOrder,
            Start = start,
            End = end,
            IsActive = true
        });
    }
    // Видаляє рядок слота зі списку.
    private void RemoveRow(TimeSlotDto r) => _rows.Remove(r);
    // Перевіряє коректність часу у форматі HH:mm.
    private static bool TryTime(string s, out TimeOnly t) => TimeOnly.TryParseExact(s, "HH:mm", out t);
    // Позначає слот як обідній і знімає прапорець з інших.
    // Валідатор слотів перед збереженням.
    private string? Validate()
    {
        foreach (var r in _rows)
        {
            if (!TryTime(r.Start, out var s) || !TryTime(r.End, out var e))
                return $"Невірний час у рядку з порядком {r.SortOrder}. Формат HH:mm";
            if (s >= e) return $"Старт >= фініш у рядку {r.SortOrder}.";
        }
        var actives = _rows.Where(x => x.IsActive).ToList();
        for (int i = 0; i < actives.Count; i++)
            for (int j = i + 1; j < actives.Count; j++)
            {
                var a = actives[i]; var b = actives[j];
                TryTime(a.Start, out var as1); TryTime(a.End, out var ae1);
                TryTime(b.Start, out var bs1); TryTime(b.End, out var be1);
                var overlap = as1 < be1 && bs1 < ae1;
                if (overlap) return $"Перекриття між слотами {a.SortOrder} і {b.SortOrder}.";
            }
        return null;
    }
    // Зберігає слоти та перезавантажує дані.
    // Повертає курс для поточного рівня налаштування (null = глобально).
    private int? CurrentCourseId() => _scope == Scope.Global ? null : _courseId;
    // Завантажує ліміт слота для типу з прапорцем "Бажано першим у тижні".
    private async Task LoadPreferredFirstSlotLimit()
    {
        try
        {
            var dto = await Api.GetPreferredFirstSlotLimitAsync(CurrentCourseId());
            _preferredFirstMaxSlotOrder = Math.Max(0, dto.MaxSlotOrder);
        }
        catch
        {
            _preferredFirstMaxSlotOrder = 0;
        }
    }
    // Зберігає ліміт слота для типу з прапорцем "Бажано першим у тижні".
    private async Task SavePreferredFirstSlotLimit()
    {
        _error = _ok = null;
        if (_scope == Scope.Course && _courseId is null)
        {
            _error = "Вибери курс.";
            return;
        }
        if (_preferredFirstMaxSlotOrder < 0)
        {
            _error = "Ліміт слота не може бути від'ємним.";
            return;
        }
        try
        {
            await Api.SavePreferredFirstSlotLimitAsync(CurrentCourseId(), _preferredFirstMaxSlotOrder);
            _ok = "Ліміт збережено.";
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            _error = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    private async Task Save()
    {
        _error = _ok = null;
        _error = Validate();
        if (_error is not null) return;
        try
        {
            var courseId = CurrentCourseId();
            foreach (var row in _rows)
            {
                row.CourseId = courseId;
                row.DayOfWeek = _dayOfWeek;
                row.IsLunch = false;
            }
            await Api.SaveAsync(courseId, _rows, _dayOfWeek);
            await LoadRaw();
            if (_error is null)
            {
                _ok = "Збережено.";
            }
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            _error = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
