@* Візуальний редактор послідовності пар для одного або всіх курсів. *@
@page "/admin/time-slots"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject TimeSlotsApi Api
@inject IJSRuntime JS

<PageTitle>Адмін • Графік пар</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="HandleBeforeInternalNavigation" />

<div class="time-slots-page">
    <header class="time-slots-header">
        <div class="time-slots-eyebrow">Налаштування розкладу</div>
        <h1>Графік пар</h1>
        <p>Побудуйте навчальний день як послідовність пар і перерв. Нумерація оновлюється автоматично.</p>
    </header>

    <section class="context-panel" aria-labelledby="target-heading">
        <div class="context-step">
            <div class="context-step__number" aria-hidden="true">1</div>
            <div class="context-step__body">
                <h2 id="target-heading">Для кого діє графік</h2>
                <div class="target-switch" role="group" aria-label="Область застосування графіка">
                    <button type="button"
                            class="@TargetButtonClass(TimeSlotEditorTargetMode.Course)"
                            aria-pressed="@(_targetMode == TimeSlotEditorTargetMode.Course)"
                            disabled="@AreContextControlsDisabled"
                            @onclick="() => SelectTargetAsync(TimeSlotEditorTargetMode.Course)">
                        <span>Один курс</span>
                        <small>Окремі налаштування</small>
                    </button>
                    <button type="button"
                            class="@TargetButtonClass(TimeSlotEditorTargetMode.AllCourses)"
                            aria-pressed="@(_targetMode == TimeSlotEditorTargetMode.AllCourses)"
                            disabled="@AreContextControlsDisabled"
                            @onclick="() => SelectTargetAsync(TimeSlotEditorTargetMode.AllCourses)">
                        <span>Усі курси</span>
                        <small>Спільний графік</small>
                    </button>
                </div>

                @if (_targetMode == TimeSlotEditorTargetMode.Course)
                {
                    <div class="course-field">
                        <label class="form-label" for="time-slot-course">Курс</label>
                        <select id="time-slot-course"
                                class="form-select"
                                value="@_courseId"
                                disabled="@AreContextControlsDisabled"
                                @onchange="OnCourseSelectionChangedAsync">
                            <option value="">Оберіть курс</option>
                            @foreach (var course in _courses)
                            {
                                <option value="@course.Id">@course.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>

        <div class="context-step context-step--day">
            <div class="context-step__number" aria-hidden="true">2</div>
            <div class="context-step__body">
                <h2>Який день налаштовуємо</h2>
                <div class="active-day-label">
                    <span>@GetDayLabel(_dayOfWeek)</span>
                    @if (_context is not null && !IsScopeSelectionIncomplete)
                    {
                        <span class="@InheritanceBadgeClass()">@GetInheritanceLabel()</span>
                    }
                </div>
                <div class="form-text">Основний графік працює щодня. Виняток змінює лише обраний день тижня.</div>
                <details class="day-options" open="@(_dayOfWeek is not null)">
                    <summary>@(_dayOfWeek is null ? "Винятки для окремих днів" : "Змінити день або повернути основний графік")</summary>
                    <div class="day-options__body">
                        <label class="form-label" for="time-slot-day">Варіант графіка</label>
                        <select id="time-slot-day"
                                class="form-select"
                                value="@DaySelectValue"
                                disabled="@AreContextControlsDisabled"
                                @onchange="OnDaySelectionChangedAsync">
                            <option value="">Основний графік</option>
                            @foreach (var day in DayOptions)
                            {
                                <option value="@day.Value">@day.Label — окремий виняток</option>
                            }
                        </select>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <div class="status-stack" aria-live="polite" aria-atomic="true">
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">
                <div>@_error</div>
                @if (_initialLoadFailed)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="InitializeAsync" disabled="@_initializing">
                        Повторити завантаження
                    </button>
                }
                else if (SlotsLoadFailed || _staleData)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="RefreshAsync" disabled="@AreContextControlsDisabled">
                        Оновити дані
                    </button>
                }
            </div>
        }
        @if (_ok is not null)
        {
            <div class="alert alert-success" role="status">@_ok</div>
        }
        @if (_initializing || _slotsLoading)
        {
            <div class="loading-state" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                Завантажуємо графік…
            </div>
        }
    </div>

    @if (!IsScopeSelectionIncomplete && _slotsLoadSucceeded)
    {
        <section class="inheritance-strip" aria-label="Спосіб налаштування">
            <div>
                <strong>@GetContextLabel()</strong>
                <span>@GetContextExplanation()</span>
            </div>
            @if (_targetMode == TimeSlotEditorTargetMode.Course)
            {
                <div class="inheritance-actions">
                    @if (_context?.IsInherited == true)
                    {
                        <button type="button" class="btn btn-primary" @onclick="ConfigureSeparately" disabled="@(!CanMutateSlotEditor)">
                            Налаштувати окремо
                        </button>
                    }
                    @if ((_context?.GlobalSlots.Count ?? 0) > 0)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="TakeGlobalAsBasis" disabled="@(!CanEditSequence)">
                            Взяти за основу
                        </button>
                    }
                    @if (CanResetToGlobal)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="RequestResetToGlobal" disabled="@(!CanMutateSlotEditor)">
                            Повернути спільний графік
                        </button>
                    }
                </div>
            }
            @if (CanRequestDayOverrideRemoval)
            {
                <div class="inheritance-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="RequestDayOverrideRemoval" disabled="@(!CanMutateSlotEditor)">
                        Прибрати виняток і повернути основний графік
                    </button>
                </div>
            }
        </section>

        @if (_resetCourseToGlobal)
        {
            <div class="reset-notice" role="status">
                <div>
                    <strong>Повертаємо успадкований графік</strong>
                    <span>Власні налаштування цього курсу буде прибрано лише після перевірки та підтвердження.</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelResetToGlobal">Скасувати</button>
            </div>
        }
        else if (_removeDayOverrideRequested)
        {
            <div class="reset-notice" role="status">
                <div>
                    <strong>Повертаємо основний графік</strong>
                    <span>Окремий виняток для цього дня буде прибрано лише після перевірки та підтвердження.</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelDayOverrideRemoval">Скасувати</button>
            </div>
        }

        <div class="editor-layout">
            <section class="timeline-section" aria-labelledby="timeline-heading">
                <div class="section-heading">
                    <div>
                        <div class="section-kicker">Послідовність дня</div>
                        <h2 id="timeline-heading">Пари та перерви</h2>
                    </div>
                    <span class="period-count">@GetPeriodCountText()</span>
                </div>

                @if (_rows.Count == 0)
                {
                    <div class="timeline-empty">
                        <h3>День поки порожній</h3>
                        <p>Скористайтеся швидкою побудовою або додайте першу пару вручну.</p>
                        <button type="button" class="btn btn-outline-primary" @onclick="AddRow" disabled="@(!CanEditSequence)">Додати першу пару</button>
                    </div>
                }
                else
                {
                    <ol class="day-timeline" aria-label="Послідовність пар">
                        @for (var index = 0; index < _rows.Count; index++)
                        {
                            var rowIndex = index;
                            var row = _rows[rowIndex];
                            var inheritedLunch = IsInheritedLunchRow(row);
                            <li class="timeline-item">
                                <article class="@PeriodCardClass(row)">
                                    <header class="period-card__header">
                                        <div>
                                            <span class="period-card__number">Пара @(rowIndex + 1)</span>
                                            <strong class="period-card__range">@FormatRange(row)</strong>
                                        </div>
                                        <div class="period-card__meta">
                                            <span>@GetDurationLabel(row)</span>
                                            @if (!row.IsActive)
                                            {
                                                <span class="inactive-badge">Не використовується</span>
                                            }
                                            @if (row.IsLunch)
                                            {
                                                <span class="lunch-badge">Обідня перерва</span>
                                            }
                                        </div>
                                    </header>

                                    <div class="period-card__body">
                                        <div class="time-field">
                                            <label for="slot-start-@rowIndex">Початок</label>
                                            <input id="slot-start-@rowIndex"
                                                   class="form-control time-input"
                                                   type="time"
                                                   step="60"
                                                   value="@row.Start"
                                                   disabled="@(!CanEditSequence)"
                                                   aria-label="Час початку пари @(rowIndex + 1)"
                                                   @oninput="args => UpdateTime(rowIndex, true, args)" />
                                        </div>
                                        <div class="time-separator" aria-hidden="true">—</div>
                                        <div class="time-field">
                                            <label for="slot-end-@rowIndex">Завершення</label>
                                            <input id="slot-end-@rowIndex"
                                                   class="form-control time-input"
                                                   type="time"
                                                   step="60"
                                                   value="@row.End"
                                                   disabled="@(!CanEditSequence)"
                                                   aria-label="Час завершення пари @(rowIndex + 1)"
                                                   @oninput="args => UpdateTime(rowIndex, false, args)" />
                                        </div>
                                    </div>

                                    <div class="period-card__options">
                                        <label class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   checked="@row.IsActive"
                                                   disabled="@(!CanEditSequence)"
                                                   @onchange="args => ToggleActive(rowIndex, args)" />
                                            <span class="form-check-label">Використовувати в розкладі</span>
                                        </label>
                                        @if (_dayOfWeek is null)
                                        {
                                            <label class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@row.IsLunch"
                                                       disabled="@(!CanEditSequence || !row.IsActive || inheritedLunch)"
                                                       aria-describedby="@(inheritedLunch ? $"inherited-lunch-note-{rowIndex}" : null)"
                                                       @onchange="args => ToggleLunch(rowIndex, args)" />
                                                <span class="form-check-label">Це обідня перерва</span>
                                                @if (inheritedLunch)
                                                {
                                                    <small id="inherited-lunch-note-@rowIndex" class="inherited-lunch-note">Успадковано; оберіть іншу активну пару, щоб змінити.</small>
                                                }
                                            </label>
                                        }
                                    </div>

                                    <footer class="period-card__actions" aria-label="Дії з парою @(rowIndex + 1)">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Перемістити пару @(rowIndex + 1) вище" @onclick="() => MoveRow(rowIndex, -1)" disabled="@(!CanEditSequence || rowIndex == 0)">Вище</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Перемістити пару @(rowIndex + 1) нижче" @onclick="() => MoveRow(rowIndex, 1)" disabled="@(!CanEditSequence || rowIndex == _rows.Count - 1)">Нижче</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" aria-label="Вставити нову пару після пари @(rowIndex + 1)" @onclick="() => InsertAfter(rowIndex)" disabled="@(!CanEditSequence || _rows.Count >= TimeSlotSequenceRules.MaxSlotsPerScope)">Вставити після</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-auto" aria-label="Видалити пару @(rowIndex + 1)" @onclick="() => RemoveRow(rowIndex)" disabled="@(!CanEditSequence)">Видалити</button>
                                    </footer>
                                </article>

                                @if (rowIndex < _rows.Count - 1)
                                {
                                    <div class="break-connector @GetBreakClass(rowIndex)">
                                        <span>@GetBreakLabel(rowIndex)</span>
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                    <button type="button" class="add-period-button" @onclick="AddRow" disabled="@(!CanEditSequence || _rows.Count >= TimeSlotSequenceRules.MaxSlotsPerScope)">
                        Додати наступну пару
                    </button>
                }
            </section>

            <aside class="editor-sidebar" aria-label="Інструменти графіка">
                <section class="builder-panel" aria-labelledby="builder-heading">
                    <div class="section-kicker">Швидка побудова</div>
                    <h2 id="builder-heading">Створити день за хвилину</h2>
                    <p>Задайте правила — усі пари та перерви з’являться одразу.</p>
                    <div class="builder-grid">
                        <div class="builder-field builder-field--wide">
                            <label for="builder-start">Початок дня</label>
                            <input id="builder-start" class="form-control time-input" type="time" step="60" value="@_builderStart" @oninput="UpdateBuilderStart" disabled="@(!CanEditSequence)" />
                        </div>
                        <div class="builder-field">
                            <label for="builder-count">Кількість пар</label>
                            <input id="builder-count" class="form-control" type="number" min="1" max="100" step="1" @bind="_builderCount" disabled="@(!CanEditSequence)" />
                        </div>
                        <div class="builder-field">
                            <label for="builder-duration">Тривалість, хв</label>
                            <input id="builder-duration" class="form-control" type="number" min="1" max="240" step="1" @bind="_builderDurationMinutes" disabled="@(!CanEditSequence)" />
                        </div>
                        <div class="builder-field">
                            <label for="builder-break">Перерва, хв</label>
                            <input id="builder-break" class="form-control" type="number" min="0" max="180" step="1" @bind="_builderBreakMinutes" disabled="@(!CanEditSequence)" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary w-100" @onclick="BuildSequence" disabled="@(!CanEditSequence)">
                        Побудувати послідовність
                    </button>
                </section>

                <details class="advanced-panel">
                    <summary>
                        <span>Додаткові налаштування</span>
                        <small>Обід і пріоритет першої пари</small>
                    </summary>
                    <div class="advanced-panel__body">
                        <section aria-labelledby="lunch-heading">
                            <h3 id="lunch-heading">Обідня перерва</h3>
                            <p>@GetLunchStatusText()</p>
                            @if (_dayOfWeek is not null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenCommonLunchEditorAsync" disabled="@(!CanMutateSlotEditor)">
                                    Відкрити основний графік
                                </button>
                            }
                            else if (_lunchMutation == TimeSlotLunchMutationMode.Remove)
                            {
                                <div class="lunch-mutation-notice" role="status">
                                    <span>@GetLunchRemovalNotice()</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelLunchRemoval" disabled="@(!CanMutateSlotEditor)">Скасувати</button>
                                </div>
                            }
                            else if (CanRequestLunchRemoval)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RequestLunchRemoval" disabled="@(!CanMutateSlotEditor)">
                                    @GetLunchRemovalActionLabel()
                                </button>
                            }
                        </section>

                        <section class="advanced-divider" aria-labelledby="preferred-heading">
                            <h3 id="preferred-heading">Бажано першою в тижні</h3>
                            <p>До якої пари автогенерація намагатиметься поставити заняття з цим прапорцем. Значення 0 вимикає обмеження.</p>
                            <div class="preferred-limit-row">
                                <label for="preferred-first-limit">До пари</label>
                                <input id="preferred-first-limit"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="1"
                                       @bind="_preferredFirstMaxSlotOrder"
                                       disabled="@(!CanEditPreferredFirstLimit)" />
                                <button type="button" class="btn btn-outline-primary" @onclick="SavePreferredFirstSlotLimit" disabled="@(!CanSavePreferredFirstLimit)">
                                    Зберегти
                                </button>
                            </div>
                            @if (_context?.PreferredFirstInherited == true)
                            {
                                <div class="form-text">Поточне значення успадковано зі спільних налаштувань.</div>
                            }
                            @if (_preferredFirstLimitLoadError is not null)
                            {
                                <div class="text-danger small mt-2" role="alert">@_preferredFirstLimitLoadError</div>
                            }
                        </section>
                    </div>
                </details>

                <section class="guidance-panel" aria-label="Підказка">
                    <strong>Як це працює</strong>
                    <p>Система бере активні пари зверху вниз. Час не може перетинатися, а окремий день замінює основний графік лише для цього дня.</p>
                </section>
            </aside>
        </div>

        @if (_rows.Count == 0 && !_resetCourseToGlobal && _dayOfWeek is null)
        {
            <label class="clear-confirmation">
                <input class="form-check-input" type="checkbox" checked="@_clearRequested" @onchange="ToggleClearIntent" disabled="@(!CanMutateSlotEditor)" />
                <span>
                    <strong>Так, очистити графік для «@GetContextLabel()»</strong>
                    <small>Порожній список застосовується лише з цією явною позначкою.</small>
                </span>
            </label>
        }
        else if (_rows.Count == 0 && !_resetCourseToGlobal && !_removeDayOverrideRequested && _dayOfWeek is not null)
        {
            <div class="empty-day-guidance" role="note">
                Щоб залишити день без занять, не видаляйте пари: поверніть зміни й вимкніть «Використовувати в розкладі» для кожної пари.
            </div>
        }

        @if (_preview is not null)
        {
            <section class="preview-panel" aria-labelledby="preview-heading">
                <div class="preview-panel__heading">
                    <div>
                        <div class="section-kicker">Крок перед збереженням</div>
                        <h2 id="preview-heading">Перевірка впливу</h2>
                    </div>
                    <span class="@PreviewStatusClass()">@PreviewStatusText()</span>
                </div>
                <dl class="impact-grid">
                    <div><dt>Курсів</dt><dd>@_preview.AffectedCourseCount</dd></div>
                    <div><dt>Власних графіків буде замінено</dt><dd>@_preview.CourseOverridesToReplace</dd></div>
                    <div><dt>Курсів отримають повну копію тижня</dt><dd>@_preview.MaterializedCourseCount</dd></div>
                    <div><dt>Конфліктів</dt><dd>@_preview.ConflictCount</dd></div>
                </dl>
                @if (_preview.ConflictSamples.Count > 0)
                {
                    <details class="conflict-samples">
                        <summary>Показати приклади конфліктів</summary>
                        <ul>
                            @foreach (var sample in _preview.ConflictSamples)
                            {
                                <li><strong>@sample.GroupName</strong> — @sample.Date, @sample.Start–@sample.End (@sample.Source)</li>
                            }
                        </ul>
                    </details>
                }
                @if (_preview.CanApply && !_preview.NoChanges)
                {
                    <p class="preview-confirmation">Перевірка завершена. Підтвердьте застосування до <strong>@GetContextLabel()</strong>.</p>
                }
                else if (_preview.NoChanges)
                {
                    <p class="preview-confirmation">Сервер підтвердив: графік уже має такий стан.</p>
                }
                else
                {
                    <p class="preview-warning">Спочатку усуньте конфлікти — графік не буде застосовано частково.</p>
                }
            </section>
        }

        <footer class="save-bar" aria-label="Збереження графіка">
            <div class="save-bar__summary">
                <strong>@GetSaveTargetLabel()</strong>
                <span>@GetPeriodCountText()@GetPendingOperationSuffix()</span>
            </div>
            <div class="save-bar__actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="RevertChanges" disabled="@(!HasUnsavedChanges || IsMutationInProgress)">Скасувати зміни</button>
                @if (_preview?.CanApply == true && !_preview.NoChanges)
                {
                    <button type="button" class="btn btn-success" @onclick="ApplyPreviewAsync" disabled="@(!CanApplyPreview)">
                        @(_applying ? "Застосовуємо…" : "Застосувати графік")
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="PreviewAsync" disabled="@(!CanPreviewChanges)">
                        @(_previewing ? "Перевіряємо…" : "Перевірити зміни")
                    </button>
                }
            </div>
        </footer>
    }
</div>

@code {
    private static readonly TimeOnly DefaultStart = new(9, 0);
    private static readonly TimeSpan DefaultDuration = TimeSpan.FromMinutes(45);
    private static readonly TimeSpan DefaultBreak = TimeSpan.FromMinutes(10);
    private static readonly (int Value, string Label)[] DayOptions =
    [
        (1, "Понеділок"),
        (2, "Вівторок"),
        (3, "Середа"),
        (4, "Четвер"),
        (5, "П’ятниця"),
        (6, "Субота"),
        (0, "Неділя")
    ];

    private TimeSlotEditorTargetMode _targetMode = TimeSlotEditorTargetMode.AllCourses;
    private int? _courseId;
    private int? _dayOfWeek;
    private List<TimeSlotEditorCourseDto> _courses = [];
    private List<TimeSlotDto> _rows = [];
    private List<TimeSlotDto> _loadedRowsSnapshot = [];
    private TimeSlotEditorContextDto? _context;
    private TimeSlotSequencePreviewDto? _preview;
    private string _currentRevision = string.Empty;
    private string _builderStart = "09:00";
    private int _builderCount = 8;
    private int _builderDurationMinutes = 45;
    private int _builderBreakMinutes = 10;
    private int _preferredFirstMaxSlotOrder;
    private int _loadedPreferredFirstMaxSlotOrder;
    private int _contextLoadVersion;
    private string? _error;
    private string? _ok;
    private string? _preferredFirstLimitLoadError;
    private bool _initializing;
    private bool _initialLoadFailed;
    private bool _metaLoadSucceeded;
    private bool _slotsLoading;
    private bool _slotsLoadSucceeded;
    private bool _previewing;
    private bool _applying;
    private bool _savingSlots;
    private bool _savingPreferredFirstLimit;
    private bool _hasLoadedPreferredFirstLimit;
    private bool _explicitOverrideRequested;
    private TimeSlotLunchMutationMode _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
    private bool _resetCourseToGlobal;
    private bool _removeDayOverrideRequested;
    private bool _clearRequested;
    private bool _staleData;

    private string DaySelectValue => _dayOfWeek?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    private bool IsMutationInProgress => _previewing || _applying || _savingSlots || _savingPreferredFirstLimit;
    private bool IsScopeSelectionIncomplete => _targetMode == TimeSlotEditorTargetMode.Course && _courseId is null;
    private bool SlotsLoadFailed => _metaLoadSucceeded
                                    && !IsScopeSelectionIncomplete
                                    && !_slotsLoading
                                    && !_slotsLoadSucceeded
                                    && _error is not null;
    private bool CanMutateSlotEditor => !_initializing
                                        && _metaLoadSucceeded
                                        && !IsScopeSelectionIncomplete
                                        && _slotsLoadSucceeded
                                        && !_slotsLoading
                                        && !IsMutationInProgress;
    private bool CanEditSequence => CanMutateSlotEditor
                                    && !_resetCourseToGlobal
                                    && !_removeDayOverrideRequested;
    private bool AreContextControlsDisabled => _initializing
                                               || !_metaLoadSucceeded
                                               || _slotsLoading
                                               || IsMutationInProgress;
    private bool HasUnsavedSequenceChanges => _explicitOverrideRequested
                                              || !AreRowsEquivalent(_rows, _loadedRowsSnapshot);
    private bool HasUnsavedLunchChanges => _lunchMutation != TimeSlotLunchMutationMode.Unchanged;
    private bool HasUnsavedSlotChanges => _resetCourseToGlobal
                                          || _removeDayOverrideRequested
                                          || HasUnsavedSequenceChanges
                                          || HasUnsavedLunchChanges;
    private bool HasUnsavedPreferredFirstLimit => _hasLoadedPreferredFirstLimit
                                                   && _preferredFirstMaxSlotOrder != _loadedPreferredFirstMaxSlotOrder;
    private bool HasUnsavedChanges => HasUnsavedSlotChanges || HasUnsavedPreferredFirstLimit;
    private bool CanEditPreferredFirstLimit => CanMutateSlotEditor
                                               && _hasLoadedPreferredFirstLimit
                                               && _preferredFirstLimitLoadError is null;
    private bool CanSavePreferredFirstLimit => CanEditPreferredFirstLimit && HasUnsavedPreferredFirstLimit;
    private bool CanResetToGlobal => CanMutateSlotEditor
                                     && !_resetCourseToGlobal
                                     && _targetMode == TimeSlotEditorTargetMode.Course
                                     && _dayOfWeek is null
                                     && (_context?.HasCourseOverride == true || _context?.HasDayOverride == true);
    private bool CanRequestLunchRemoval => _dayOfWeek is null
                                           && _context is not null
                                           && (_targetMode == TimeSlotEditorTargetMode.AllCourses
                                               ? _context.EffectiveLunch is not null
                                               : _context.ExplicitLunch is not null);
    private bool CanRequestDayOverrideRemoval => _dayOfWeek is not null
                                                 && _context?.HasDayOverride == true
                                                 && !_removeDayOverrideRequested;
    private bool CanPreviewChanges => CanMutateSlotEditor
                                      && HasUnsavedSlotChanges
                                      && (_resetCourseToGlobal
                                          || _removeDayOverrideRequested
                                          || (HasUnsavedLunchChanges && !HasUnsavedSequenceChanges)
                                          || (HasUnsavedSequenceChanges && (_rows.Count > 0 || CanClearCurrentScope)));
    private bool CanClearCurrentScope => _clearRequested
                                         && _dayOfWeek is null;
    private bool CanApplyPreview => CanMutateSlotEditor
                                    && _preview is { CanApply: true, NoChanges: false }
                                    && !string.IsNullOrWhiteSpace(_preview.PreviewToken);

    protected override async Task OnInitializedAsync() => await InitializeAsync();

    private async Task InitializeAsync()
    {
        if (_initializing) return;
        _initializing = true;
        _initialLoadFailed = false;
        _metaLoadSucceeded = true;
        try
        {
            await LoadContextAsync();
            _initialLoadFailed = !_slotsLoadSucceeded;
        }
        finally
        {
            _initializing = false;
        }
    }

    private async Task HandleBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!HasUnsavedChanges) return;
        var discard = await JS.InvokeAsync<bool>("confirm", "У редакторі є незбережені зміни. Залишити сторінку та відкинути їх?");
        if (!discard) context.PreventNavigation();
    }

    private async Task SelectTargetAsync(TimeSlotEditorTargetMode targetMode)
    {
        if (targetMode == _targetMode || AreContextControlsDisabled) return;
        if (!await ConfirmDiscardChangesAsync()) return;
        _targetMode = targetMode;
        _courseId = targetMode == TimeSlotEditorTargetMode.Course ? _courseId ?? _courses.FirstOrDefault()?.Id : null;
        await LoadContextAsync();
    }

    private async Task OnCourseSelectionChangedAsync(ChangeEventArgs args)
    {
        var nextCourseId = int.TryParse(args.Value?.ToString(), out var value) ? value : (int?)null;
        if (nextCourseId == _courseId || AreContextControlsDisabled) return;
        if (!await ConfirmDiscardChangesAsync()) { StateHasChanged(); return; }
        _courseId = nextCourseId;
        await LoadContextAsync();
    }

    private async Task OnDaySelectionChangedAsync(ChangeEventArgs args)
    {
        var nextDay = int.TryParse(args.Value?.ToString(), out var value) ? value : (int?)null;
        if (nextDay == _dayOfWeek || AreContextControlsDisabled) return;
        if (!await ConfirmDiscardChangesAsync()) { StateHasChanged(); return; }
        _dayOfWeek = nextDay;
        await LoadContextAsync();
    }

    private async Task<bool> ConfirmDiscardChangesAsync()
        => !HasUnsavedChanges
           || await JS.InvokeAsync<bool>("confirm", "У редакторі є незбережені зміни. Відкинути їх і завантажити інший графік?");

    private async Task RefreshAsync()
    {
        if (AreContextControlsDisabled || !await ConfirmDiscardChangesAsync()) return;
        await LoadContextAsync();
    }

    // Сумісна назва для цільових тестів на застарілі відповіді завантаження.
    private Task LoadRaw() => LoadContextAsync();

    private async Task LoadContextAsync(bool preservePreferredDraft = false)
    {
        var loadVersion = ++_contextLoadVersion;
        var requestedTarget = _targetMode;
        var requestedCourseId = _courseId;
        var requestedDay = _dayOfWeek;
        var preferredDraft = _preferredFirstMaxSlotOrder;
        var hadPreferredDraft = preservePreferredDraft && HasUnsavedPreferredFirstLimit;
        bool IsStillCurrent() => loadVersion == _contextLoadVersion
                                 && requestedTarget == _targetMode
                                 && requestedCourseId == _courseId
                                 && requestedDay == _dayOfWeek;

        _slotsLoading = true;
        _slotsLoadSucceeded = false;
        _error = _ok = null;
        _preview = null;
        _staleData = false;

        if (IsScopeSelectionIncomplete)
        {
            _rows = [];
            _loadedRowsSnapshot = [];
            _context = null;
            _currentRevision = string.Empty;
            _slotsLoading = false;
            _hasLoadedPreferredFirstLimit = false;
            _explicitOverrideRequested = false;
            _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
            _resetCourseToGlobal = false;
            _removeDayOverrideRequested = false;
            _clearRequested = false;
            return;
        }

        try
        {
            var context = await Api.GetEditorContextAsync(requestedTarget, requestedCourseId, requestedDay);
            if (!IsStillCurrent()) return;

            _context = context;
            _courses = context.Courses;
            _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
            var sourceRows = context.ExplicitSlots.Count > 0 ? context.ExplicitSlots : context.EffectiveSlots;
            _rows = CloneRows(sourceRows);
            NormalizeRows();
            RestoreLunchIntent(CaptureLunchIntent());
            _loadedRowsSnapshot = CloneRows(_rows);
            _currentRevision = context.CurrentRevision;
            _preferredFirstMaxSlotOrder = context.PreferredFirstMaxSlotOrder;
            _loadedPreferredFirstMaxSlotOrder = context.PreferredFirstMaxSlotOrder;
            _hasLoadedPreferredFirstLimit = true;
            if (hadPreferredDraft) _preferredFirstMaxSlotOrder = preferredDraft;
            _preferredFirstLimitLoadError = null;
            _explicitOverrideRequested = false;
            _resetCourseToGlobal = false;
            _removeDayOverrideRequested = false;
            _clearRequested = false;
            _slotsLoadSucceeded = true;
        }
        catch (ApiErrorException ex)
        {
            if (!IsStillCurrent()) return;
            _error = $"Не вдалося завантажити графік: {GetApiMessage(ex)}";
            ClearFailedContext();
        }
        catch (Exception ex)
        {
            if (!IsStillCurrent()) return;
            _error = $"Не вдалося завантажити графік: {ex.Message}";
            ClearFailedContext();
        }
        finally
        {
            if (IsStillCurrent()) _slotsLoading = false;
        }
    }

    private void ClearFailedContext()
    {
        _rows = [];
        _loadedRowsSnapshot = [];
        _context = null;
        _currentRevision = string.Empty;
        _hasLoadedPreferredFirstLimit = false;
        _explicitOverrideRequested = false;
        _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        _resetCourseToGlobal = false;
        _removeDayOverrideRequested = false;
        _clearRequested = false;
    }

    private void ConfigureSeparately()
    {
        if (!CanMutateSlotEditor || _context is null) return;
        var lunchIntent = CaptureLunchIntent();
        _rows = CloneRows(_context.EffectiveSlots);
        RestoreLunchIntent(lunchIntent);
        NormalizeRows();
        _explicitOverrideRequested = true;
        _resetCourseToGlobal = false;
        _removeDayOverrideRequested = false;
        _clearRequested = false;
        InvalidatePreview();
        _ok = "Успадкований графік відкрито для окремого налаштування цього курсу.";
    }

    private void TakeGlobalAsBasis()
    {
        if (!CanEditSequence || _context is null || _context.GlobalSlots.Count == 0) return;
        var lunchIntent = CaptureLunchIntent();
        _rows = CloneRows(_context.GlobalSlots);
        RestoreLunchIntent(lunchIntent);
        NormalizeRows();
        _explicitOverrideRequested = _targetMode == TimeSlotEditorTargetMode.Course;
        _clearRequested = false;
        InvalidatePreview();
        _ok = "Спільний графік взято за основу. Можете змінити його перед перевіркою.";
    }

    private void RequestResetToGlobal()
    {
        if (!CanResetToGlobal) return;
        _resetCourseToGlobal = true;
        _removeDayOverrideRequested = false;
        _explicitOverrideRequested = false;
        _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        _clearRequested = false;
        InvalidatePreview();
        _ok = null;
    }

    private void CancelResetToGlobal()
    {
        if (IsMutationInProgress) return;
        _resetCourseToGlobal = false;
        InvalidatePreview();
    }

    private void RequestDayOverrideRemoval()
    {
        if (!CanMutateSlotEditor || !CanRequestDayOverrideRemoval) return;
        _removeDayOverrideRequested = true;
        _explicitOverrideRequested = false;
        _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        _clearRequested = false;
        InvalidatePreview();
    }

    private void CancelDayOverrideRemoval()
    {
        if (IsMutationInProgress) return;
        _removeDayOverrideRequested = false;
        InvalidatePreview();
    }

    private void BuildSequence()
    {
        if (!CanEditSequence) return;
        _error = _ok = null;
        var lunchIntent = CaptureLunchIntent();
        if (!TimeOnly.TryParseExact(_builderStart, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var current))
        {
            _error = "Вкажіть коректний час початку дня.";
            return;
        }
        if (_builderCount < 1 || _builderCount > TimeSlotSequenceRules.MaxSlotsPerScope)
        {
            _error = $"Кількість пар має бути від 1 до {TimeSlotSequenceRules.MaxSlotsPerScope}.";
            return;
        }
        if (_builderDurationMinutes < 1 || _builderDurationMinutes > 240 || _builderBreakMinutes < 0 || _builderBreakMinutes > 180)
        {
            _error = "Перевірте тривалість пари та перерви.";
            return;
        }

        var rows = new List<TimeSlotDto>(_builderCount);
        for (var index = 0; index < _builderCount; index++)
        {
            var end = current.AddMinutes(_builderDurationMinutes);
            if (end <= current)
            {
                _error = "Побудована послідовність виходить за межі поточного дня. Зменште кількість або тривалість.";
                return;
            }
            rows.Add(CreateRow(index + 1, current, end));
            if (index < _builderCount - 1)
            {
                var next = end.AddMinutes(_builderBreakMinutes);
                if (next < end)
                {
                    _error = "Побудована послідовність виходить за межі поточного дня. Зменште кількість або тривалість.";
                    return;
                }
                current = next;
            }
        }

        _rows = rows;
        var lunchRestored = RestoreLunchIntent(lunchIntent);
        if (!lunchRestored && _lunchMutation == TimeSlotLunchMutationMode.Set)
        {
            _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        }
        _explicitOverrideRequested |= _targetMode == TimeSlotEditorTargetMode.Course && _context?.IsInherited == true;
        _clearRequested = false;
        InvalidatePreview();
        _ok = !lunchRestored && lunchIntent is not null
            ? $"Побудовано {_builderCount} пар. Попередня обідня перерва не збігається з новими парами, тому залишиться без змін."
            : $"Побудовано {_builderCount} пар. Перевірте час і застосуйте графік.";
    }

    private void UpdateBuilderStart(ChangeEventArgs args)
        => _builderStart = NormalizeTimeInputValue(args.Value?.ToString());

    private void AddRow()
    {
        if (!CanEditSequence || _rows.Count >= TimeSlotSequenceRules.MaxSlotsPerScope) return;
        var previousEnd = default(TimeOnly);
        if (_rows.Count > 0 && !TryTime(_rows[^1].End, out previousEnd))
        {
            _error = "Спочатку виправте час завершення останньої пари.";
            return;
        }
        var (start, end) = CalculateNextSlot(_rows.Count - 1);
        if (end <= start || (_rows.Count > 0 && start < previousEnd))
        {
            _error = "Наступна пара виходить за межі поточного дня. Змініть завершення останньої пари.";
            return;
        }
        _rows.Add(CreateRow(_rows.Count + 1, start, end));
        _explicitOverrideRequested |= _targetMode == TimeSlotEditorTargetMode.Course && _context?.IsInherited == true;
        _clearRequested = false;
        InvalidatePreview();
    }

    private void InsertAfter(int index)
    {
        if (!CanEditSequence || index < 0 || index >= _rows.Count || _rows.Count >= TimeSlotSequenceRules.MaxSlotsPerScope) return;
        var lunchRow = _rows.FirstOrDefault(row => row.IsLunch);
        (string Start, string End)? previousLunchRange = lunchRow is null
            ? null
            : (lunchRow.Start, lunchRow.End);
        if (!TryTime(_rows[index].End, out var previousEnd))
        {
            _error = "Спочатку виправте час завершення цієї пари.";
            return;
        }
        var (start, end) = CalculateNextSlot(index);
        if (end <= start || start < previousEnd)
        {
            _error = "Нову пару неможливо вставити без переходу на наступний день.";
            return;
        }
        if (index < _rows.Count - 1)
        {
            if (!TryTime(_rows[index + 1].Start, out var nextStart))
            {
                _error = "Спочатку виправте час початку наступної пари.";
                return;
            }
            var minimumNextStart = end.Add(DefaultBreak);
            if (minimumNextStart > nextStart)
            {
                var shift = minimumNextStart - nextStart;
                if (!TryShiftRows(index + 1, shift))
                {
                    _error = "Нову пару неможливо вставити без переходу на наступний день. Змініть час вручну.";
                    return;
                }
            }
        }
        _rows.Insert(index + 1, CreateRow(index + 2, start, end));
        MarkLunchAsSetWhenChanged(lunchRow, previousLunchRange);
        NormalizeRows();
        _explicitOverrideRequested |= _targetMode == TimeSlotEditorTargetMode.Course && _context?.IsInherited == true;
        InvalidatePreview();
    }

    private bool TryShiftRows(int firstIndex, TimeSpan shift)
    {
        var shifted = new List<(TimeOnly Start, TimeOnly End)>();
        for (var index = firstIndex; index < _rows.Count; index++)
        {
            if (!TryTime(_rows[index].Start, out var start) || !TryTime(_rows[index].End, out var end)) return false;
            var shiftedStart = start.Add(shift);
            var shiftedEnd = end.Add(shift);
            if (shiftedStart < start || shiftedEnd < end || shiftedEnd <= shiftedStart) return false;
            shifted.Add((shiftedStart, shiftedEnd));
        }
        for (var offset = 0; offset < shifted.Count; offset++)
        {
            var row = _rows[firstIndex + offset];
            row.Start = shifted[offset].Start.ToString("HH:mm", CultureInfo.InvariantCulture);
            row.End = shifted[offset].End.ToString("HH:mm", CultureInfo.InvariantCulture);
        }
        return true;
    }

    private (TimeOnly Start, TimeOnly End) CalculateNextSlot(int afterIndex)
    {
        if (afterIndex >= 0 && afterIndex < _rows.Count && TryTime(_rows[afterIndex].End, out var previousEnd))
        {
            var start = previousEnd.Add(DefaultBreak);
            var end = start.Add(DefaultDuration);
            return (start, end);
        }
        return (DefaultStart, DefaultStart.Add(DefaultDuration));
    }

    private TimeSlotDto CreateRow(int order, TimeOnly start, TimeOnly end)
        => new()
        {
            CourseId = _targetMode == TimeSlotEditorTargetMode.Course ? _courseId : null,
            DayOfWeek = _dayOfWeek,
            SortOrder = order,
            Start = start.ToString("HH:mm", CultureInfo.InvariantCulture),
            End = end.ToString("HH:mm", CultureInfo.InvariantCulture),
            IsActive = true
        };

    private void RemoveRow(int index)
    {
        if (!CanEditSequence || index < 0 || index >= _rows.Count) return;
        if (_rows[index].IsLunch)
        {
            _lunchMutation = IsInheritedLunchRow(_rows[index])
                ? TimeSlotLunchMutationMode.Unchanged
                : TimeSlotLunchMutationMode.Remove;
        }
        _rows.RemoveAt(index);
        NormalizeRows();
        _clearRequested = false;
        InvalidatePreview();
    }

    private void MoveRow(int index, int direction)
    {
        if (!CanEditSequence) return;
        var target = index + direction;
        if (index < 0 || index >= _rows.Count || target < 0 || target >= _rows.Count) return;
        var lunchRow = _rows.FirstOrDefault(row => row.IsLunch);
        (string Start, string End)? previousLunchRange = lunchRow is null
            ? null
            : (lunchRow.Start, lunchRow.End);
        var selectedLunchMoved = _rows[index].IsLunch;
        if (!TryReflowMove(index, target))
        {
            _error = "Спочатку виправте час у послідовності — тоді пару можна буде безпечно перемістити.";
            return;
        }
        if (selectedLunchMoved)
        {
            _lunchMutation = TimeSlotLunchMutationMode.Set;
        }
        else
        {
            MarkLunchAsSetWhenChanged(lunchRow, previousLunchRange);
        }
        NormalizeRows();
        InvalidatePreview();
    }

    private bool TryReflowMove(int index, int target)
    {
        if (_rows.Count == 0 || !TryTime(_rows[0].Start, out var firstStart)) return false;

        var durations = new List<TimeSpan>(_rows.Count);
        var gaps = new List<TimeSpan>(Math.Max(0, _rows.Count - 1));
        for (var rowIndex = 0; rowIndex < _rows.Count; rowIndex++)
        {
            if (!TryTime(_rows[rowIndex].Start, out var start)
                || !TryTime(_rows[rowIndex].End, out var end)
                || end <= start)
            {
                return false;
            }
            durations.Add(end - start);
            if (rowIndex < _rows.Count - 1)
            {
                if (!TryTime(_rows[rowIndex + 1].Start, out var nextStart) || nextStart < end) return false;
                gaps.Add(nextStart - end);
            }
        }

        (durations[index], durations[target]) = (durations[target], durations[index]);
        var recalculated = new List<(TimeOnly Start, TimeOnly End)>(_rows.Count);
        var current = firstStart;
        for (var rowIndex = 0; rowIndex < durations.Count; rowIndex++)
        {
            var end = current.Add(durations[rowIndex]);
            if (end <= current) return false;
            recalculated.Add((current, end));
            if (rowIndex < gaps.Count)
            {
                var next = end.Add(gaps[rowIndex]);
                if (next < end) return false;
                current = next;
            }
        }

        (_rows[index], _rows[target]) = (_rows[target], _rows[index]);
        for (var rowIndex = 0; rowIndex < _rows.Count; rowIndex++)
        {
            _rows[rowIndex].Start = recalculated[rowIndex].Start.ToString("HH:mm", CultureInfo.InvariantCulture);
            _rows[rowIndex].End = recalculated[rowIndex].End.ToString("HH:mm", CultureInfo.InvariantCulture);
        }
        return true;
    }

    private void UpdateTime(int index, bool isStart, ChangeEventArgs args)
    {
        if (!CanEditSequence || index < 0 || index >= _rows.Count) return;
        var value = NormalizeTimeInputValue(args.Value?.ToString());
        if (isStart) _rows[index].Start = value;
        else _rows[index].End = value;
        if (_rows[index].IsLunch) _lunchMutation = TimeSlotLunchMutationMode.Set;
        InvalidatePreview();
    }

    private void ToggleActive(int index, ChangeEventArgs args)
    {
        if (!CanEditSequence || index < 0 || index >= _rows.Count) return;
        var active = ReadCheckbox(args);
        var wasLunch = _rows[index].IsLunch;
        var wasInheritedLunch = wasLunch && IsInheritedLunchRow(_rows[index]);
        _rows[index].IsActive = active;
        if (!active)
        {
            _rows[index].IsLunch = false;
            if (wasLunch)
            {
                _lunchMutation = wasInheritedLunch
                    ? TimeSlotLunchMutationMode.Unchanged
                    : TimeSlotLunchMutationMode.Remove;
            }
        }
        else if (_lunchMutation == TimeSlotLunchMutationMode.Unchanged && MatchesInheritedLunchInterval(_rows[index]))
        {
            _rows[index].IsLunch = true;
        }
        InvalidatePreview();
        if (!active && wasInheritedLunch)
        {
            _ok = "Спільна обідня перерва не змінюється. Щоб перенести її, позначте іншу активну пару або відкрийте спільний графік.";
        }
    }

    private void ToggleLunch(int index, ChangeEventArgs args)
    {
        if (!CanEditSequence || _dayOfWeek is not null || index < 0 || index >= _rows.Count) return;
        var selected = ReadCheckbox(args);
        if (!selected && IsInheritedLunchRow(_rows[index]))
        {
            _ok = "Ця перерва успадкована зі спільного графіка. Позначте іншу активну пару або змініть спільну перерву.";
            return;
        }
        foreach (var row in _rows) row.IsLunch = false;
        if (selected && _rows[index].IsActive)
        {
            _rows[index].IsLunch = true;
            _lunchMutation = TimeSlotLunchMutationMode.Set;
        }
        else
        {
            _lunchMutation = TimeSlotLunchMutationMode.Remove;
        }
        InvalidatePreview();
    }

    private void ToggleClearIntent(ChangeEventArgs args)
    {
        if (_dayOfWeek is not null) return;
        _clearRequested = ReadCheckbox(args);
        InvalidatePreview();
    }

    private void RequestLunchRemoval()
    {
        if (!CanMutateSlotEditor || !CanRequestLunchRemoval) return;
        foreach (var row in _rows) row.IsLunch = false;
        _lunchMutation = TimeSlotLunchMutationMode.Remove;
        InvalidatePreview();
    }

    private void CancelLunchRemoval()
    {
        if (!CanMutateSlotEditor || _lunchMutation != TimeSlotLunchMutationMode.Remove) return;
        _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        RestoreLunchIntent(CaptureLunchIntent());
        InvalidatePreview();
    }

    private static bool ReadCheckbox(ChangeEventArgs args)
        => args.Value is bool selected ? selected : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

    private (string Start, string End)? CaptureLunchIntent()
    {
        if (_dayOfWeek is not null) return null;
        if (_lunchMutation == TimeSlotLunchMutationMode.Remove) return null;
        if (_lunchMutation == TimeSlotLunchMutationMode.Set)
        {
            var selected = _rows.FirstOrDefault(row => row.IsLunch && row.IsActive);
            return selected is null ? null : (selected.Start, selected.End);
        }
        var effective = _context?.EffectiveLunch;
        return effective is null ? null : (effective.Start, effective.End);
    }

    private bool RestoreLunchIntent((string Start, string End)? lunchIntent)
    {
        foreach (var row in _rows) row.IsLunch = false;
        if (_lunchMutation == TimeSlotLunchMutationMode.Remove || lunchIntent is null) return true;
        var matching = _rows.FirstOrDefault(row =>
            row.IsActive
            && string.Equals(row.Start, lunchIntent.Value.Start, StringComparison.Ordinal)
            && string.Equals(row.End, lunchIntent.Value.End, StringComparison.Ordinal));
        if (matching is null) return false;
        matching.IsLunch = true;
        return true;
    }

    private void MarkLunchAsSetWhenChanged(
        TimeSlotDto? lunchRow,
        (string Start, string End)? previousRange)
    {
        if (_dayOfWeek is not null || lunchRow is null || previousRange is null) return;
        if (!string.Equals(lunchRow.Start, previousRange.Value.Start, StringComparison.Ordinal)
            || !string.Equals(lunchRow.End, previousRange.Value.End, StringComparison.Ordinal))
        {
            _lunchMutation = TimeSlotLunchMutationMode.Set;
        }
    }

    private void NormalizeRows()
    {
        for (var index = 0; index < _rows.Count; index++)
        {
            _rows[index].SortOrder = index + 1;
            _rows[index].CourseId = _targetMode == TimeSlotEditorTargetMode.Course ? _courseId : null;
            _rows[index].DayOfWeek = _dayOfWeek;
            if (_dayOfWeek is not null) _rows[index].IsLunch = false;
        }
    }

    private void InvalidatePreview()
    {
        _preview = null;
        _error = null;
        _ok = null;
        _staleData = false;
    }

    private void RevertChanges()
    {
        if (IsMutationInProgress || !HasUnsavedChanges) return;
        _rows = CloneRows(_loadedRowsSnapshot);
        _preferredFirstMaxSlotOrder = _loadedPreferredFirstMaxSlotOrder;
        _explicitOverrideRequested = false;
        _lunchMutation = TimeSlotLunchMutationMode.Unchanged;
        _resetCourseToGlobal = false;
        _removeDayOverrideRequested = false;
        _clearRequested = false;
        _preview = null;
        _error = null;
        _ok = "Зміни скасовано.";
    }

    private string? Validate()
    {
        if (_resetCourseToGlobal || _removeDayOverrideRequested) return null;
        if (_lunchMutation == TimeSlotLunchMutationMode.Set
            && !_rows.Any(row => row.IsLunch && row.IsActive))
        {
            return "Оберіть активну пару для обідньої перерви.";
        }
        if (!HasUnsavedSequenceChanges) return null;
        if (_rows.Count == 0 && !CanClearCurrentScope)
        {
            return _dayOfWeek is null
                ? "Щоб очистити графік, підтвердьте явний намір під редактором."
                : "Порожній день налаштовується вимкненням усіх пар, а не видаленням основного графіка.";
        }
        var result = TimeSlotSequenceRules.Validate(_rows, _dayOfWeek);
        return result.IsValid ? null : string.Join(" ", result.Errors);
    }

    private async Task PreviewAsync()
    {
        if (!CanPreviewChanges) return;
        _error = _ok = null;
        var validationError = Validate();
        if (validationError is not null) { _error = validationError; return; }

        var version = _contextLoadVersion;
        _previewing = _savingSlots = true;
        try
        {
            var preview = await Api.PreviewEditorAsync(BuildRequest());
            if (version != _contextLoadVersion) return;
            _preview = preview;
            if (preview.NoChanges) _ok = "Графік уже актуальний — зберігати нічого не потрібно.";
            else if (!preview.CanApply) _error = "Перевірка знайшла конфлікти. Зміни не застосовано.";
        }
        catch (ApiErrorException ex)
        {
            if (version == _contextLoadVersion) HandleMutationError(ex);
        }
        catch (Exception ex)
        {
            if (version == _contextLoadVersion) _error = ex.Message;
        }
        finally
        {
            _previewing = _savingSlots = false;
        }
    }

    private async Task ApplyPreviewAsync()
    {
        if (!CanApplyPreview || _preview is null) return;
        var version = _contextLoadVersion;
        var previewToken = _preview.PreviewToken;
        _applying = _savingSlots = true;
        _error = _ok = null;
        try
        {
            var result = await Api.ApplyEditorAsync(BuildRequest(previewToken));
            if (version != _contextLoadVersion) return;
            await LoadContextAsync(preservePreferredDraft: true);
            if (_slotsLoadSucceeded)
            {
                _ok = result.NoChanges ? "Графік уже був актуальним." : $"Графік застосовано. Оновлено курсів: {result.AffectedCourseCount}.";
            }
        }
        catch (ApiErrorException ex)
        {
            if (version == _contextLoadVersion) HandleMutationError(ex);
        }
        catch (Exception ex)
        {
            if (version == _contextLoadVersion) _error = ex.Message;
        }
        finally
        {
            _applying = _savingSlots = false;
        }
    }

    private TimeSlotSequenceApplyRequestDto BuildRequest(string? previewToken = null)
    {
        NormalizeRows();
        var applySlots = !_resetCourseToGlobal
                         && (_removeDayOverrideRequested || HasUnsavedSequenceChanges);
        var lunchMutation = _resetCourseToGlobal || _removeDayOverrideRequested
            ? TimeSlotLunchMutationMode.Unchanged
            : _lunchMutation;
        var lunchSlot = !applySlots && lunchMutation == TimeSlotLunchMutationMode.Set
            ? _rows.FirstOrDefault(row => row.IsLunch && row.IsActive)
            : null;
        var requestDay = !applySlots && lunchMutation != TimeSlotLunchMutationMode.Unchanged
            ? null
            : _dayOfWeek;
        return new TimeSlotSequenceApplyRequestDto
        {
            TargetMode = _targetMode,
            CourseId = _targetMode == TimeSlotEditorTargetMode.Course ? _courseId : null,
            DayOfWeek = requestDay,
            Slots = applySlots && !_removeDayOverrideRequested ? CloneRows(_rows) : [],
            CurrentRevision = _currentRevision,
            PreviewToken = previewToken,
            ApplySlots = applySlots,
            Clear = _removeDayOverrideRequested
                    || (applySlots && _dayOfWeek is null && _rows.Count == 0 && _clearRequested),
            ResetCourseToGlobal = _resetCourseToGlobal,
            LunchMutation = lunchMutation,
            LunchSlot = lunchSlot is null ? null : CloneRows([lunchSlot]).Single()
        };
    }

    private void HandleMutationError(ApiErrorException ex)
    {
        _preview = null;
        if (string.Equals(ex.Code, "Stale", StringComparison.OrdinalIgnoreCase))
        {
            _staleData = true;
            _error = "Налаштування змінилися в іншому вікні. Ваші правки збережено в редакторі — оновіть дані та повторіть перевірку.";
            return;
        }
        _staleData = false;
        _error = GetApiMessage(ex);
    }

    private async Task OpenCommonLunchEditorAsync()
    {
        if (!CanMutateSlotEditor || !await ConfirmDiscardChangesAsync()) return;
        _dayOfWeek = null;
        await LoadContextAsync();
    }

    private async Task SavePreferredFirstSlotLimit()
    {
        if (!CanSavePreferredFirstLimit) return;
        _error = _ok = null;
        if (_preferredFirstMaxSlotOrder < 0) { _error = "Номер пари не може бути від’ємним."; return; }
        var version = _contextLoadVersion;
        var courseId = _targetMode == TimeSlotEditorTargetMode.Course ? _courseId : null;
        _savingPreferredFirstLimit = true;
        try
        {
            await Api.SavePreferredFirstSlotLimitAsync(courseId, _preferredFirstMaxSlotOrder);
            if (version != _contextLoadVersion) return;
            _loadedPreferredFirstMaxSlotOrder = _preferredFirstMaxSlotOrder;
            _ok = "Пріоритет першої пари збережено.";
        }
        catch (ApiErrorException ex)
        {
            if (version == _contextLoadVersion) _error = GetApiMessage(ex);
        }
        catch (Exception ex)
        {
            if (version == _contextLoadVersion) _error = ex.Message;
        }
        finally
        {
            _savingPreferredFirstLimit = false;
        }
    }

    private string TargetButtonClass(TimeSlotEditorTargetMode mode)
        => _targetMode == mode ? "target-option target-option--selected" : "target-option";

    private string GetDayLabel(int? dayOfWeek)
    {
        if (dayOfWeek is null) return "Основний графік";
        var day = DayOptions.FirstOrDefault(option => option.Value == dayOfWeek);
        return string.IsNullOrWhiteSpace(day.Label) ? $"День {dayOfWeek}" : $"{day.Label} — окремий виняток";
    }

    private string GetCourseName()
        => _courseId is int courseId ? _courses.FirstOrDefault(course => course.Id == courseId)?.Name ?? $"Курс #{courseId}" : "курс не обрано";

    private string GetContextLabel()
        => _targetMode == TimeSlotEditorTargetMode.AllCourses
            ? $"усі курси, {GetDayLabel(_dayOfWeek).ToLowerInvariant()}"
            : $"{GetCourseName()}, {GetDayLabel(_dayOfWeek).ToLowerInvariant()}";

    private string GetSaveTargetLabel()
        => _targetMode == TimeSlotEditorTargetMode.AllCourses ? "Застосування до всіх курсів" : $"Застосування до курсу «{GetCourseName()}»";

    private string GetPendingOperationSuffix()
    {
        if (_resetCourseToGlobal) return " · повернення до спільного графіка";
        if (_removeDayOverrideRequested) return " · повернення до основного графіка";
        if (_lunchMutation == TimeSlotLunchMutationMode.Remove)
            return _targetMode == TimeSlotEditorTargetMode.AllCourses
                ? " · видалення спільної перерви"
                : " · повернення до спільної перерви";
        return string.Empty;
    }

    private string GetContextExplanation()
    {
        if (_targetMode == TimeSlotEditorTargetMode.AllCourses)
            return "Після перевірки система оновить спільний графік одним кроком без часткових змін і покаже, скільки власних налаштувань буде замінено.";
        if (_context?.IsInherited == true)
            return "Зараз курс використовує спільний графік. Натисніть «Налаштувати окремо», щоб створити власний.";
        if (_dayOfWeek is null) return "Курс має власний основний графік.";
        return _context?.HasDayOverride == true
            ? "Для цього дня налаштовано окремий виняток."
            : "Для цього дня окремого винятку немає — показано основний графік курсу.";
    }

    private string GetInheritanceLabel()
    {
        if (_targetMode == TimeSlotEditorTargetMode.AllCourses) return "Спільний";
        if (_context?.IsInherited == true) return "Успадковано";
        if (_dayOfWeek is null) return "Власний";
        return _context?.HasDayOverride == true ? "Виняток" : "Основний";
    }

    private string InheritanceBadgeClass()
        => _context?.IsInherited == true ? "inheritance-badge inheritance-badge--inherited" : "inheritance-badge";

    private string GetPeriodCountText()
    {
        if (_rows.Count == 1) return "1 пара";
        if (_rows.Count >= 2 && _rows.Count <= 4) return $"{_rows.Count} пари";
        return $"{_rows.Count} пар";
    }

    private static string PeriodCardClass(TimeSlotDto row)
    {
        var classes = "period-card";
        if (!row.IsActive) classes += " period-card--inactive";
        if (row.IsLunch) classes += " period-card--lunch";
        return classes;
    }

    private static string FormatRange(TimeSlotDto row)
        => $"{(string.IsNullOrWhiteSpace(row.Start) ? "--:--" : row.Start)}–{(string.IsNullOrWhiteSpace(row.End) ? "--:--" : row.End)}";

    private static string GetDurationLabel(TimeSlotDto row)
    {
        if (!TryTime(row.Start, out var start) || !TryTime(row.End, out var end) || end <= start) return "Перевірте час";
        return $"{(int)(end - start).TotalMinutes} хв";
    }

    private string GetBreakLabel(int index)
    {
        if (index < 0 || index >= _rows.Count - 1 || !TryTime(_rows[index].End, out var end) || !TryTime(_rows[index + 1].Start, out var nextStart))
            return "Перевірте час перерви";
        var minutes = (int)(nextStart - end).TotalMinutes;
        if (minutes < 0) return $"Перетин на {Math.Abs(minutes)} хв";
        return minutes == 0 ? "Без перерви" : $"Перерва {minutes} хв";
    }

    private string GetBreakClass(int index)
        => GetBreakLabel(index).StartsWith("Перетин", StringComparison.Ordinal) ? "break-connector--error" : string.Empty;

    private string GetLunchStatusText()
    {
        if (_lunchMutation == TimeSlotLunchMutationMode.Remove)
            return _targetMode == TimeSlotEditorTargetMode.AllCourses
                ? "Спільну обідню перерву буде прибрано після підтвердження."
                : "Власну обідню перерву курсу буде прибрано після підтвердження.";
        var draftLunch = _rows.FirstOrDefault(row => row.IsLunch && row.IsActive);
        if (_dayOfWeek is null && _lunchMutation == TimeSlotLunchMutationMode.Set && draftLunch is not null)
            return $"У поточній чернетці: {draftLunch.Start}–{draftLunch.End}.";
        if (_context?.EffectiveLunch is null) return "Обідню перерву не налаштовано. Позначте одну активну пару в основному графіку.";
        var lunch = _context.EffectiveLunch;
        var inherited = _targetMode == TimeSlotEditorTargetMode.Course && _context.ExplicitLunch is null;
        var unmatched = _dayOfWeek is null
                        && !_rows.Any(row => row.IsActive
                                            && string.Equals(row.Start, lunch.Start, StringComparison.Ordinal)
                                            && string.Equals(row.End, lunch.End, StringComparison.Ordinal));
        var status = $"Поточна перерва: {lunch.Start}–{lunch.End}{(inherited ? " (успадковано зі спільного графіка)" : string.Empty)}";
        if (unmatched) status += ". Вона не збігається з жодною парою чернетки й залишиться без змін";
        if (inherited) status += ". Щоб змінити, позначте іншу активну пару або відкрийте спільний графік";
        return status + ".";
    }

    private bool IsInheritedLunchRow(TimeSlotDto row)
        => row.IsLunch
           && _lunchMutation == TimeSlotLunchMutationMode.Unchanged
           && MatchesInheritedLunchInterval(row);

    private bool MatchesInheritedLunchInterval(TimeSlotDto row)
        => _dayOfWeek is null
           && _targetMode == TimeSlotEditorTargetMode.Course
           && _context?.ExplicitLunch is null
           && _context?.EffectiveLunch is { } lunch
           && string.Equals(row.Start, lunch.Start, StringComparison.Ordinal)
           && string.Equals(row.End, lunch.End, StringComparison.Ordinal);

    private string GetLunchRemovalActionLabel()
        => _targetMode == TimeSlotEditorTargetMode.AllCourses
            ? "Прибрати спільну перерву"
            : "Прибрати власну перерву й успадковувати спільну";

    private string GetLunchRemovalNotice()
        => _targetMode == TimeSlotEditorTargetMode.AllCourses
            ? "Спільну обідню перерву буде прибрано для всіх курсів після підтвердження."
            : "Власну перерву курсу буде прибрано; після підтвердження курс перейде на спільне налаштування перерви.";

    private string PreviewStatusClass()
    {
        if (_preview?.NoChanges == true) return "preview-status preview-status--neutral";
        return _preview?.CanApply == true ? "preview-status preview-status--ready" : "preview-status preview-status--blocked";
    }

    private string PreviewStatusText()
    {
        if (_preview?.NoChanges == true) return "Без змін";
        return _preview?.CanApply == true ? "Можна застосувати" : "Потрібна увага";
    }

    private static bool TryTime(string? value, out TimeOnly time)
        => TimeOnly.TryParseExact(value, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out time);

    private static string NormalizeTimeInputValue(string? value)
    {
        var raw = value?.Trim() ?? string.Empty;
        return TimeOnly.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed.ToString("HH:mm", CultureInfo.InvariantCulture)
            : raw;
    }

    private static List<TimeSlotDto> CloneRows(IEnumerable<TimeSlotDto> rows)
        => rows.Select(row => new TimeSlotDto
        {
            Id = row.Id,
            CourseId = row.CourseId,
            DayOfWeek = row.DayOfWeek,
            SortOrder = row.SortOrder,
            Start = row.Start,
            End = row.End,
            IsActive = row.IsActive,
            IsLunch = row.IsLunch
        }).ToList();

    private static bool AreRowsEquivalent(IReadOnlyList<TimeSlotDto> left, IReadOnlyList<TimeSlotDto> right)
    {
        if (left.Count != right.Count) return false;
        for (var index = 0; index < left.Count; index++)
        {
            if (!string.Equals(left[index].Start?.Trim(), right[index].Start?.Trim(), StringComparison.Ordinal)
                || !string.Equals(left[index].End?.Trim(), right[index].End?.Trim(), StringComparison.Ordinal)
                || left[index].IsActive != right[index].IsActive)
                return false;
        }
        return true;
    }

    private static string GetApiMessage(ApiErrorException ex) => ex.Errors.FirstOrDefault() ?? ex.Message;
}
