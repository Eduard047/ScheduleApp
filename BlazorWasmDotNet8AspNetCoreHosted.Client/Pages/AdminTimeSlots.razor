@* Сторінка адміністрування часових слотів *@
@page "/admin/time-slots"
@using Microsoft.AspNetCore.Components.Routing
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.TimeSlotsApi Api
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi AdminApi
@inject IJSRuntime JS

<PageTitle>Адмін • Слоти часу</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="HandleBeforeInternalNavigation" />

<h1 class="h3">Слоти часу</h1>

<div class="mb-3">
    <label class="form-label" for="time-slot-scope">Рівень</label>
    <div class="d-flex gap-2 flex-wrap">
        <select id="time-slot-scope" class="form-select" style="max-width: 280px" @bind="_scope" @bind:after="OnScopeChangedAsync" disabled="@AreContextControlsDisabled">
            <option value="Global">Глобально (для всіх курсів)</option>
            <option value="Course">Тільки для обраного курсу</option>
        </select>
        @if (_scope == Scope.Course)
        {
            <label class="visually-hidden" for="time-slot-course">Курс</label>
            <select id="time-slot-course" class="form-select" style="max-width: 360px" @bind="_courseId" @bind:after="OnCourseChangedAsync" disabled="@AreContextControlsDisabled">
                <option value="">- оберіть курс -</option>
                @foreach (var c in _courses)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        }
        <label class="visually-hidden" for="time-slot-day">День тижня</label>
        <select id="time-slot-day" class="form-select" style="max-width: 240px" @bind="_dayOfWeek" @bind:after="OnDayChangedAsync" disabled="@AreContextControlsDisabled">
            <option value="">Усі дні (за замовчуванням)</option>
            @foreach (var day in DayOptions)
            {
                <option value="@day.Value">@day.Label</option>
            }
        </select>
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@AreContextControlsDisabled">Оновити</button>
    </div>
    <div class="form-text">Редагуєте: <strong>@GetContextLabel()</strong>.</div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="fw-semibold mb-2">Копіювання з шаблону</div>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-6">
                <label class="form-label mb-1" for="time-slot-copy-source">Шаблон-джерело</label>
                <select id="time-slot-copy-source" class="form-select" @bind="_copySourceMode" @bind:after="OnCopySettingsChangedAsync" disabled="@AreContextControlsDisabled">
                    <option value="@CopySourceMode.CurrentScopeOnly">Шаблон поточного рівня</option>
                    @if (_scope == Scope.Course)
                    {
                        <option value="@CopySourceMode.GlobalOnly">Глобальний шаблон</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-3">
                <div class="form-text mb-1">Куди копіюємо</div>
                <div class="border rounded p-2 bg-light">@GetContextLabel()</div>
            </div>
            <div class="col-12 col-lg-3 d-grid gap-2">
                <button class="btn btn-primary" @onclick="CopyTemplateToEditor" disabled="@(!CanCopyToEditor)">Копіювати шаблон в редактор</button>
                <button class="btn btn-outline-primary" @onclick="SaveEditorAsTemplateAsync" disabled="@(!CanSaveEditorAsTemplate)">Створити/оновити шаблон</button>
            </div>
        </div>
        <div class="form-text mt-2">Шаблон — це слоти без прив'язки до дня (режим «Усі дні»).</div>
        <div class="form-text">Щоб створити шаблон: підготуйте слоти у редакторі нижче, потім натисніть «Створити/оновити шаблон».</div>
        <div class="form-text">@GetCopyHint()</div>
        @if (_copyPreviewError is not null)
        {
            <div class="alert alert-danger py-2 mt-2 mb-0" role="alert">
                @_copyPreviewError
                <div class="mt-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="LoadCopyPreviewAsync"
                            disabled="@(_copyPreviewLoading || !CanMutateSlotEditor)">
                        Повторити завантаження шаблону
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        @_error
        @if (_initialLoadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="InitializeAsync" disabled="@_initializing">
                    Повторити завантаження
                </button>
            </div>
        }
        else if (SlotsLoadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetrySlotsLoadAsync" disabled="@_slotsLoading">
                    Повторити завантаження слотів
                </button>
            </div>
        }
    </div>
}
@if (_ok is not null)
{
    <div class="alert alert-success" role="status">@_ok</div>
}
@if (_initializing)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Завантаження налаштувань слотів…</div>
}
else if (_slotsLoading)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Завантаження слотів поточного контексту…</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <div class="fw-semibold">Ліміт слота для типу з прапорцем "Бажано першим у тижні"</div>
                <div class="form-text">
                    Вкажіть номер пари (слота), до якої автоген намагатиметься ставити цей тип занять раніше за інші. Значення <code>0</code> вимикає обмеження.
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0" for="preferredFirstSlotLimit">До слота</label>
                @if (_hasLoadedPreferredFirstLimit)
                {
                    <input id="preferredFirstSlotLimit" class="form-control" style="width:110px"
                           type="number" min="0" step="1"
                           aria-invalid="@(_preferredFirstLimitLoadError is not null)"
                           disabled="@(!CanEditPreferredFirstLimit)"
                           @bind="_preferredFirstMaxSlotOrder" />
                }
                else
                {
                    <input id="preferredFirstSlotLimit" class="form-control text-muted" style="width:110px"
                           type="number" placeholder="—" aria-label="Ліміт не завантажено" disabled />
                }
                <button class="btn btn-outline-primary"
                        @onclick="SavePreferredFirstSlotLimit"
                        disabled="@(!CanSavePreferredFirstLimit)">
                    Зберегти ліміт
                </button>
            </div>
        </div>
        @if (_preferredFirstLimitLoading)
        {
            <div class="form-text mt-2" role="status" aria-live="polite">Завантаження ліміту…</div>
        }
        else if (_preferredFirstLimitLoadError is not null)
        {
            <div class="alert alert-danger py-2 mt-2 mb-0" role="alert">
                @_preferredFirstLimitLoadError
                <div class="mt-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="RetryPreferredFirstSlotLimitAsync"
                            disabled="@(_preferredFirstLimitLoading || IsMutationInProgress)">
                        Повторити завантаження ліміту
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <div>
                <div class="form-text">
                    Слоти використовуються автогенерацією 1-в-1. Перекриття недопустимі. Час вводиться у форматі <code>HH:mm</code>.
                </div>
                <div class="form-text mt-1">@GetEditorStateHint()</div>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="AddRow" disabled="@(!CanMutateSlotEditor)">Додати слот</button>
                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="RevertChanges" disabled="@(!HasUnsavedChanges || !CanMutateSlotEditor)">Скасувати зміни</button>
                <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@(!CanSaveChanges)">Зберегти</button>
            </div>
        </div>
        <div class="alert alert-info py-2 mb-3">
            <div class="fw-semibold">Обідня перерва — спільна для всіх днів</div>
            <div>@GetLunchStatusText()</div>
            @if (CanManageLunch)
            {
                <div class="small mt-1">
                    Позначте один активний слот у колонці «Обід». Щоб прибрати власну перерву,
                    зніміть позначку та збережіть шаблон.
                </div>
                @if (HasExplicitLunchForCurrentScope())
                {
                    <button class="btn btn-sm btn-outline-danger mt-2"
                            disabled="@(_removeExplicitLunchRequested || !CanMutateSlotEditor)"
                            @onclick="RequestExplicitLunchRemoval">
                        @(_removeExplicitLunchRequested ? "Перерву буде прибрано" : "Прибрати власну перерву")
                    </button>
                }
            }
            else if (CanMutateSlotEditor)
            {
                <div class="small mt-1">
                    У режимі окремого дня перерва лише відображається і не змінюється.
                    Налаштування доступне в режимі «Усі дні».
                </div>
                <button class="btn btn-sm btn-outline-primary mt-2" @onclick="OpenCommonLunchEditorAsync" disabled="@(!CanMutateSlotEditor)">
                    Перейти до «Усі дні»
                </button>
            }
        </div>
        <div class="table-responsive" role="region" aria-label="Редактор часових слотів" tabindex="0">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width:90px">№</th>
                    <th scope="col" style="width:140px">Старт</th>
                    <th scope="col" style="width:140px">Фініш</th>
                    <th scope="col" style="width:140px">Активний</th>
                    <th scope="col" style="width:110px">Обід</th>
                    <th scope="col"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
                @if (_slotsLoading)
                {
                    <tr><td colspan="6" class="text-muted"><span role="status">Завантаження слотів…</span></td></tr>
                }
                else if (IsScopeSelectionIncomplete)
                {
                    <tr><td colspan="6" class="text-muted">Оберіть курс, щоб відкрити редактор слотів.</td></tr>
                }
                else if (!_slotsLoadSucceeded)
                {
                    <tr><td colspan="6" class="text-danger">Слоти недоступні. Повторіть завантаження.</td></tr>
                }
                else if (_rows.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">Немає слотів</td></tr>
                }
                else
                {
                    @foreach (var r in _rows.OrderBy(x => x.SortOrder).ThenBy(x => x.Start))
                    {
                        <tr>
                            <td>
                                <input class="form-control form-control-sm" style="width:90px"
                                       type="number" min="0" aria-label="Порядковий номер слота @r.SortOrder" disabled="@(!CanMutateSlotEditor)" @bind="r.SortOrder" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" style="width:120px"
                                       placeholder="09:00" aria-label="Час початку слота @r.SortOrder" disabled="@(!CanMutateSlotEditor)" @bind="r.Start" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" style="width:120px"
                                       placeholder="09:45" aria-label="Час завершення слота @r.SortOrder" disabled="@(!CanMutateSlotEditor)" @bind="r.End" />
                            </td>
                            <td>
                                <input class="form-check-input" type="checkbox" aria-label="Активувати слот @r.SortOrder" disabled="@(!CanMutateSlotEditor)" @bind="r.IsActive" />
                            </td>
                            <td>
                                @if (CanManageLunch)
                                {
                                    <input class="form-check-input" type="checkbox"
                                           checked="@r.IsLunch"
                                           disabled="@(!r.IsActive || !CanMutateSlotEditor)"
                                           aria-label="Позначити слот @r.SortOrder як обід"
                                           @onchange="args => ToggleLunch(r, args)" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRow(r)" disabled="@(!CanMutateSlotEditor)">Видалити</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
        <div class="form-text">
            Порада: тримайте тривалості однаковими (наприклад, 45 хвилин). Автогенерація використовує
            активні слоти та виключає ті, що перетинаються зі спільною обідньою перервою.
        </div>
    </div>
</div>

@code {
    private static readonly TimeOnly DefaultStart = new(9, 0);
    private static readonly TimeSpan DefaultDuration = TimeSpan.FromMinutes(45);
    private static readonly TimeSpan DefaultBreak = TimeSpan.FromMinutes(10);
    private static readonly (int Value, string Label)[] DayOptions = new[]
    {
        (1, "Понеділок"),
        (2, "Вівторок"),
        (3, "Середа"),
        (4, "Четвер"),
        (5, "П'ятниця"),
        (6, "Субота"),
        (0, "Неділя")
    };
    enum Scope { Global, Course }
    enum CopySourceMode { CurrentScopeOnly, GlobalOnly }
    private Scope _scope = Scope.Global;
    private int? _courseId;
    private int? _dayOfWeek;
    private CopySourceMode _copySourceMode = CopySourceMode.CurrentScopeOnly;
    private List<LookupDto> _courses = new();
    private List<LunchConfigEditDto> _lunches = new();
    private List<TimeSlotDto> _rows = new();
    private List<TimeSlotDto> _loadedRowsSnapshot = new();
    private List<TimeSlotDto> _copyPreviewRows = new();
    private int _preferredFirstMaxSlotOrder;
    private int _loadedPreferredFirstMaxSlotOrder;
    private bool _removeExplicitLunchRequested;
    private int _contextLoadVersion;
    private int _copyPreviewLoadVersion;
    private bool _hasLoadedContext;
    private Scope _loadedScope = Scope.Global;
    private int? _loadedCourseId;
    private int? _loadedDayOfWeek;
    private string? _error;
    private string? _ok;
    private string? _copyPreviewError;
    private string? _preferredFirstLimitLoadError;
    private bool _initializing;
    private bool _initialLoadFailed;
    private bool _metaLoadSucceeded;
    private bool _slotsLoading;
    private bool _slotsLoadSucceeded;
    private bool _copyPreviewLoading;
    private bool _preferredFirstLimitLoading;
    private bool _savingSlots;
    private bool _savingTemplate;
    private bool _savingPreferredFirstLimit;
    private bool _hasLoadedPreferredFirstLimit;
    private int? _preferredFirstLimitCourseId;
    private bool IsMutationInProgress => _savingSlots || _savingTemplate || _savingPreferredFirstLimit;
    private bool IsScopeSelectionIncomplete => _scope == Scope.Course && _courseId is null;
    private bool SlotsLoadFailed => _metaLoadSucceeded
                                    && !IsScopeSelectionIncomplete
                                    && !_slotsLoading
                                    && !_slotsLoadSucceeded
                                    && _error is not null;
    private bool CanMutateSlotEditor => !_initializing
                                        && _metaLoadSucceeded
                                        && !IsScopeSelectionIncomplete
                                        && _slotsLoadSucceeded
                                        && !_slotsLoading
                                        && !IsMutationInProgress;
    private bool AreContextControlsDisabled => _initializing
                                               || !_metaLoadSucceeded
                                               || _slotsLoading
                                               || IsMutationInProgress;
    private bool CanCopyToEditor => CanMutateSlotEditor
                                    && !_copyPreviewLoading
                                    && _copyPreviewError is null
                                    && _copyPreviewRows.Count > 0;
    private bool CanSaveEditorAsTemplate => CanMutateSlotEditor
                                             && _rows.Count > 0;
    private bool HasUnsavedSlotChanges => _removeExplicitLunchRequested
                                          || !AreRowsEquivalent(_rows, _loadedRowsSnapshot);
    private bool HasUnsavedPreferredFirstLimit
        => _hasLoadedPreferredFirstLimit
           && _preferredFirstMaxSlotOrder != _loadedPreferredFirstMaxSlotOrder;
    private bool HasUnsavedChanges => HasUnsavedSlotChanges || HasUnsavedPreferredFirstLimit;
    private bool CanSaveChanges => CanMutateSlotEditor
                                   && HasUnsavedSlotChanges;
    private bool CanEditPreferredFirstLimit => !IsScopeSelectionIncomplete
                                               && _hasLoadedPreferredFirstLimit
                                               && !_preferredFirstLimitLoading
                                               && !IsMutationInProgress
                                               && _preferredFirstLimitLoadError is null;
    private bool CanSavePreferredFirstLimit => CanEditPreferredFirstLimit && HasUnsavedPreferredFirstLimit;
    private bool CanManageLunch => CanMutateSlotEditor && _dayOfWeek is null;
    // Завантажує метадані курсів при старті сторінки.
    protected override async Task OnInitializedAsync()
    {
        await InitializeAsync();
    }
    // Безпечно завантажує довідники та початковий контекст із можливістю повторної спроби.
    private async Task InitializeAsync()
    {
        if (_initializing) return;
        _initializing = true;
        _initialLoadFailed = false;
        _metaLoadSucceeded = false;
        _error = _ok = null;
        MetaResponseDto meta;
        try
        {
            meta = await AdminApi.GetMeta();
        }
        catch (ApiErrorException ex)
        {
            _initialLoadFailed = true;
            var details = ex.Errors.FirstOrDefault() ?? ex.Message;
            _error = $"Не вдалося завантажити довідник курсів: {details}";
            _initializing = false;
            return;
        }
        catch (Exception ex)
        {
            _initialLoadFailed = true;
            _error = $"Не вдалося завантажити довідник курсів: {ex.Message}";
            _initializing = false;
            return;
        }
        _metaLoadSucceeded = true;
        _courses = meta.Courses ?? new();
        try
        {
            await LoadRaw();
        }
        catch (Exception ex)
        {
            _slotsLoading = false;
            _slotsLoadSucceeded = false;
            _error = $"Не вдалося завантажити слоти: {ex.Message}";
        }
        finally
        {
            _initializing = false;
        }
    }
    // Не дозволяє внутрішню навігацію без підтвердження, якщо редактор змінено.
    private async Task HandleBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!HasUnsavedChanges) return;
        var discard = await JS.InvokeAsync<bool>(
            "confirm",
            "У редакторі є незбережені зміни. Залишити сторінку та відкинути їх?");
        if (!discard)
        {
            context.PreventNavigation();
        }
    }
    // Оновлює контекст при перемиканні рівня.
    private async Task OnScopeChangedAsync()
    {
        if (!await BeginSlotsContextTransitionAsync(restoreContextOnCancel: true))
        {
            return;
        }
        if (_scope == Scope.Global)
        {
            _courseId = null;
            _copySourceMode = CopySourceMode.CurrentScopeOnly;
        }
        await LoadRaw();
    }
    // Оновлює дані після вибору курсу.
    private async Task OnCourseChangedAsync()
    {
        if (!await BeginSlotsContextTransitionAsync(restoreContextOnCancel: true))
        {
            return;
        }
        await LoadRaw();
    }
    // Оновлює дані після вибору дня.
    private async Task OnDayChangedAsync()
    {
        if (!await BeginSlotsContextTransitionAsync(restoreContextOnCancel: true))
        {
            return;
        }
        await LoadRaw();
    }
    // Оновлює редактор лише після явного підтвердження втрати незбережених змін.
    private async Task RefreshAsync()
    {
        if (!await BeginSlotsContextTransitionAsync(restoreContextOnCancel: false))
        {
            return;
        }
        await LoadRaw();
    }
    // Блокує редактор одразу після зміни селектора або запуску оновлення.
    private async Task<bool> BeginSlotsContextTransitionAsync(bool restoreContextOnCancel)
    {
        if (_slotsLoading || IsMutationInProgress)
        {
            if (restoreContextOnCancel)
            {
                RestoreLoadedContext();
            }
            return false;
        }
        var previouslySucceeded = _slotsLoadSucceeded;
        _slotsLoading = true;
        _slotsLoadSucceeded = false;
        try
        {
            if (await ConfirmDiscardChangesAsync())
            {
                return true;
            }
        }
        catch
        {
            if (restoreContextOnCancel)
            {
                RestoreLoadedContext();
            }
            _slotsLoading = false;
            _slotsLoadSucceeded = previouslySucceeded;
            throw;
        }
        if (restoreContextOnCancel)
        {
            RestoreLoadedContext();
        }
        _slotsLoading = false;
        _slotsLoadSucceeded = previouslySucceeded;
        return false;
    }
    // Повторно завантажує поточний контекст після видимої помилки.
    private async Task RetrySlotsLoadAsync()
    {
        if (_slotsLoading || IsMutationInProgress || IsScopeSelectionIncomplete)
        {
            return;
        }
        await LoadRaw();
    }
    // Запитує підтвердження перед зміною контексту, яка замінить поточний редактор.
    private async Task<bool> ConfirmDiscardChangesAsync()
        => !HasUnsavedChanges
           || await JS.InvokeAsync<bool>(
               "confirm",
               "У редакторі є незбережені зміни. Відкинути їх і завантажити інший контекст?");
    // Повертає селектори до останнього завантаженого контексту після відмови користувача.
    private void RestoreLoadedContext()
    {
        if (!_hasLoadedContext)
        {
            return;
        }
        _scope = _loadedScope;
        _courseId = _loadedCourseId;
        _dayOfWeek = _loadedDayOfWeek;
    }
    // Запам'ятовує контекст, якому відповідають поточні рядки редактора.
    private void RememberLoadedContext(Scope scope, int? courseId, int? dayOfWeek)
    {
        _hasLoadedContext = true;
        _loadedScope = scope;
        _loadedCourseId = courseId;
        _loadedDayOfWeek = dayOfWeek;
    }
    // Перевіряє, що відповідь ще належить поточним селекторам редактора.
    private bool IsCurrentContext(Scope scope, int? courseId, int? dayOfWeek)
        => _scope == scope && _courseId == courseId && _dayOfWeek == dayOfWeek;
    // Не дозволяє завершенню старого запиту змінити вже відкритий новий контекст.
    private bool IsCurrentMutationContext(int contextLoadVersion, Scope scope, int? courseId, int? dayOfWeek)
        => contextLoadVersion == _contextLoadVersion
           && IsCurrentContext(scope, courseId, dayOfWeek);
    // Готує стан ліміту до завантаження та не переносить значення між курсами.
    private void PreparePreferredFirstLimitContext(int? courseId)
    {
        if (!_hasLoadedPreferredFirstLimit || _preferredFirstLimitCourseId != courseId)
        {
            _preferredFirstMaxSlotOrder = 0;
            _loadedPreferredFirstMaxSlotOrder = 0;
            _hasLoadedPreferredFirstLimit = false;
            _preferredFirstLimitCourseId = courseId;
        }
        _preferredFirstLimitLoadError = null;
        _preferredFirstLimitLoading = true;
    }
    // Скидає ліміт, коли контекст курсу ще не обрано.
    private void ResetPreferredFirstLimitContext()
    {
        _preferredFirstMaxSlotOrder = 0;
        _loadedPreferredFirstMaxSlotOrder = 0;
        _hasLoadedPreferredFirstLimit = false;
        _preferredFirstLimitCourseId = null;
        _preferredFirstLimitLoadError = null;
        _preferredFirstLimitLoading = false;
    }
    // Оновлює попередній перегляд після зміни джерела копіювання.
    private async Task OnCopySettingsChangedAsync()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        await LoadCopyPreviewAsync();
    }
    // Завантажує сирі слоти для обраного рівня.
    private async Task LoadRaw()
    {
        var loadVersion = ++_contextLoadVersion;
        var requestedScope = _scope;
        var requestedCourseId = _courseId;
        var requestedDayOfWeek = _dayOfWeek;
        var apiCourseId = requestedScope == Scope.Global ? null : requestedCourseId;
        bool IsStillCurrent()
            => loadVersion == _contextLoadVersion
               && IsCurrentContext(requestedScope, requestedCourseId, requestedDayOfWeek);
        _slotsLoading = true;
        _slotsLoadSucceeded = false;
        _error = _ok = null;
        _copyPreviewLoadVersion++;
        _copyPreviewRows = new();
        _copyPreviewError = null;
        _copyPreviewLoading = true;
        PreparePreferredFirstLimitContext(apiCourseId);
        if (IsScopeSelectionIncomplete)
        {
            _rows = new();
            _loadedRowsSnapshot = new();
            _slotsLoading = false;
            _copyPreviewLoading = false;
            ResetPreferredFirstLimitContext();
            _removeExplicitLunchRequested = false;
            RememberLoadedContext(requestedScope, requestedCourseId, requestedDayOfWeek);
            return;
        }
        try
        {
            var rowsTask = Api.GetRawAsync(apiCourseId, requestedDayOfWeek);
            var lunchesTask = AdminApi.GetLunch();
            await Task.WhenAll(rowsTask, lunchesTask);
            if (!IsStillCurrent())
            {
                return;
            }
            _rows = rowsTask.Result;
            _lunches = lunchesTask.Result;
            _loadedRowsSnapshot = CloneRows(_rows);
            _removeExplicitLunchRequested = false;
            RememberLoadedContext(requestedScope, requestedCourseId, requestedDayOfWeek);
            await LoadPreferredFirstSlotLimit(apiCourseId, loadVersion);
            if (!IsStillCurrent())
            {
                return;
            }
            await LoadCopyPreviewAsync();
            if (!IsStillCurrent())
            {
                return;
            }
            _slotsLoadSucceeded = true;
            _slotsLoading = false;
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            if (!IsStillCurrent())
            {
                return;
            }
            _rows = new();
            _loadedRowsSnapshot = new();
            _slotsLoadSucceeded = false;
            _slotsLoading = false;
            _copyPreviewRows = new();
            _copyPreviewLoading = false;
            _preferredFirstLimitLoading = false;
            var details = ex.Errors.FirstOrDefault() ?? ex.Message;
            _error = $"Не вдалося завантажити слоти: {details}";
            RememberLoadedContext(requestedScope, requestedCourseId, requestedDayOfWeek);
        }
        catch (Exception ex)
        {
            if (!IsStillCurrent())
            {
                return;
            }
            _rows = new();
            _loadedRowsSnapshot = new();
            _slotsLoadSucceeded = false;
            _slotsLoading = false;
            _copyPreviewRows = new();
            _copyPreviewLoading = false;
            _preferredFirstLimitLoading = false;
            _error = $"Не вдалося завантажити слоти: {ex.Message}";
            RememberLoadedContext(requestedScope, requestedCourseId, requestedDayOfWeek);
        }
    }
    // Завантажує попередній перегляд джерела копіювання.
    private async Task LoadCopyPreviewAsync()
    {
        var previewVersion = ++_copyPreviewLoadVersion;
        var requestedScope = _scope;
        var requestedCourseId = _courseId;
        var requestedDayOfWeek = _dayOfWeek;
        var sourceCourseId = ResolveCopySourceCourseId();
        bool IsStillCurrent()
            => previewVersion == _copyPreviewLoadVersion
               && IsCurrentContext(requestedScope, requestedCourseId, requestedDayOfWeek)
               && sourceCourseId == ResolveCopySourceCourseId();
        if (IsScopeSelectionIncomplete)
        {
            _copyPreviewRows = new();
            _copyPreviewError = null;
            _copyPreviewLoading = false;
            return;
        }
        _copyPreviewRows = new();
        _copyPreviewError = null;
        _copyPreviewLoading = true;
        try
        {
            var rows = await Api.GetRawAsync(sourceCourseId, dayOfWeek: null);
            if (!IsStillCurrent())
            {
                return;
            }
            _copyPreviewRows = rows;
        }
        catch (ApiErrorException ex)
        {
            if (IsStillCurrent())
            {
                _copyPreviewRows = new();
                var details = ex.Errors.FirstOrDefault() ?? ex.Message;
                _copyPreviewError = $"Не вдалося завантажити шаблон «{GetCopySourceLabel()}»: {details}";
            }
        }
        catch (Exception ex)
        {
            if (IsStillCurrent())
            {
                _copyPreviewRows = new();
                _copyPreviewError = $"Не вдалося завантажити шаблон «{GetCopySourceLabel()}»: {ex.Message}";
            }
        }
        finally
        {
            if (IsStillCurrent())
            {
                _copyPreviewLoading = false;
            }
        }
    }
    // Копіює шаблон-джерело у поточний контекст редактора.
    private async Task CopyTemplateToEditor()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        _error = _ok = null;
        if (IsScopeSelectionIncomplete)
        {
            _error = "Оберіть курс для копіювання шаблону.";
            return;
        }
        if (HasUnsavedSlotChanges)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "У редакторі є незбережені зміни. Замінити їх шаблоном?");
            if (!confirmed) return;
        }
        try
        {
            var targetCourseId = CurrentCourseId();
            var source = _copyPreviewRows;
            if (source.Count == 0)
            {
                _error = $"У шаблоні-джерелі «{GetCopySourceLabel()}» немає слотів.";
                return;
            }
            _rows = source.Select(s => new TimeSlotDto
            {
                Id = 0,
                CourseId = targetCourseId,
                DayOfWeek = _dayOfWeek,
                SortOrder = s.SortOrder,
                Start = s.Start,
                End = s.End,
                IsActive = s.IsActive,
                IsLunch = _dayOfWeek is null && s.IsLunch
            }).ToList();
            _removeExplicitLunchRequested = false;
            _ok = "Шаблон завантажено в редактор. Натисніть «Зберегти», щоб застосувати зміни.";
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            _error = ex.Errors.FirstOrDefault() ?? ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    // Зберігає поточні слоти редактора як шаблон (без прив'язки до дня).
    private async Task SaveEditorAsTemplateAsync()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        _error = _ok = null;
        if (IsScopeSelectionIncomplete)
        {
            _error = "Оберіть курс, щоб зберегти шаблон.";
            return;
        }
        if (_rows.Count == 0)
        {
            _error = "У редакторі немає слотів для створення шаблону.";
            return;
        }
        _error = Validate();
        if (_error is not null) return;
        var contextLoadVersion = _contextLoadVersion;
        var requestedScope = _scope;
        var requestedCourseId = _courseId;
        var requestedDayOfWeek = _dayOfWeek;
        var courseId = CurrentCourseId();
        var removeExplicitLunchRequested = _removeExplicitLunchRequested;
        var templateRows = CloneRows(_rows);
        bool IsStillCurrent()
            => IsCurrentMutationContext(
                contextLoadVersion,
                requestedScope,
                requestedCourseId,
                requestedDayOfWeek);
        foreach (var row in templateRows)
        {
            row.CourseId = courseId;
            row.DayOfWeek = null;
        }
        if (requestedDayOfWeek is not null && !TryPreserveExplicitLunch(templateRows, courseId))
        {
            _error = "Поточна обідня перерва не збігається з жодним активним слотом редактора. Відкрийте режим «Усі дні» та оберіть слот обіду вручну.";
            return;
        }
        _savingTemplate = true;
        try
        {
            var existingTemplate = await Api.GetRawAsync(courseId, dayOfWeek: null);
            if (!IsStillCurrent())
            {
                return;
            }
            if (existingTemplate.Count > 0)
            {
                if (!removeExplicitLunchRequested && AreRowsEquivalent(existingTemplate, templateRows))
                {
                    _copySourceMode = CopySourceMode.CurrentScopeOnly;
                    await LoadCopyPreviewAsync();
                    if (IsStillCurrent())
                    {
                        _ok = "Шаблон вже актуальний.";
                    }
                    return;
                }
                var confirmed = await JS.InvokeAsync<bool>("confirm", "Шаблон вже існує. Перезаписати його поточними слотами?");
                if (!confirmed || !IsStillCurrent()) return;
            }
            await Api.SaveAsync(courseId, templateRows, dayOfWeek: null);
            if (!IsStillCurrent())
            {
                return;
            }
            _copySourceMode = CopySourceMode.CurrentScopeOnly;
            await ReloadContextPreservingPreferredFirstDraftAsync(
                requestedScope,
                requestedCourseId,
                requestedDayOfWeek);
            if (IsCurrentContext(requestedScope, requestedCourseId, requestedDayOfWeek)
                && _error is null)
            {
                _ok = "Шаблон збережено. Тепер його можна копіювати у будь-який день.";
            }
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Errors.FirstOrDefault() ?? ex.Message;
            }
        }
        catch (Exception ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _savingTemplate = false;
        }
    }
    // Обчислює наступний слот з урахуванням перерв.
    private (string start, string end) CalculateNextSlot()
    {
        var valid = _rows
            .Select(r => new
            {
                Row = r,
                Start = TryTime(r.Start, out var s) ? s : (TimeOnly?)null,
                End = TryTime(r.End, out var e) ? e : (TimeOnly?)null
            })
            .Where(x => x.Start is not null && x.End is not null && x.Start < x.End)
            .OrderBy(x => x.Row.SortOrder)
            .ThenBy(x => x.Start);
        var nextStart = valid.LastOrDefault()?.End?.Add(DefaultBreak) ?? DefaultStart;
        var nextEnd = nextStart.Add(DefaultDuration);
        return (nextStart.ToString("HH:mm"), nextEnd.ToString("HH:mm"));
    }
    // Додає новий рядок слота.
    private void AddRow()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        var maxOrder = _rows.Count == 0 ? 1 : _rows.Max(x => x.SortOrder) + 1;
        var (start, end) = CalculateNextSlot();
        _rows.Add(new TimeSlotDto
        {
            Id = 0,
            CourseId = _scope == Scope.Global ? null : _courseId,
            DayOfWeek = _dayOfWeek,
            SortOrder = maxOrder,
            Start = start,
            End = end,
            IsActive = true
        });
    }
    // Видаляє рядок слота зі списку.
    private void RemoveRow(TimeSlotDto r)
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        if (r.IsLunch && HasExplicitLunchForCurrentScope())
        {
            _removeExplicitLunchRequested = true;
        }
        _rows.Remove(r);
    }
    // Повертає редактор до останньої завантаженої/збереженої версії.
    private void RevertChanges()
    {
        if (!CanMutateSlotEditor || !HasUnsavedChanges) return;
        _rows = CloneRows(_loadedRowsSnapshot);
        _preferredFirstMaxSlotOrder = _loadedPreferredFirstMaxSlotOrder;
        _removeExplicitLunchRequested = false;
        _ok = "Зміни в редакторі скасовано.";
    }
    // Перевіряє коректність часу у форматі HH:mm.
    private static bool TryTime(string s, out TimeOnly t) => TimeOnly.TryParseExact(s, "HH:mm", out t);
    // Клонує список слотів, щоб уникнути побічних змін через прив'язку.
    private static List<TimeSlotDto> CloneRows(IEnumerable<TimeSlotDto> rows)
        => rows.Select(r => new TimeSlotDto
        {
            Id = r.Id,
            CourseId = r.CourseId,
            DayOfWeek = r.DayOfWeek,
            SortOrder = r.SortOrder,
            Start = r.Start,
            End = r.End,
            IsActive = r.IsActive,
            IsLunch = r.IsLunch
        }).ToList();
    // Порівнює два набори слотів для визначення незбережених змін.
    private static bool AreRowsEquivalent(IReadOnlyCollection<TimeSlotDto> left, IReadOnlyCollection<TimeSlotDto> right)
    {
        if (left.Count != right.Count) return false;
        var leftNormalized = left
            .OrderBy(r => r.SortOrder)
            .ThenBy(r => r.Start, StringComparer.Ordinal)
            .ThenBy(r => r.End, StringComparer.Ordinal)
            .Select(r => (r.SortOrder, Start: r.Start?.Trim() ?? string.Empty, End: r.End?.Trim() ?? string.Empty, r.IsActive, r.IsLunch))
            .ToList();
        var rightNormalized = right
            .OrderBy(r => r.SortOrder)
            .ThenBy(r => r.Start, StringComparer.Ordinal)
            .ThenBy(r => r.End, StringComparer.Ordinal)
            .Select(r => (r.SortOrder, Start: r.Start?.Trim() ?? string.Empty, End: r.End?.Trim() ?? string.Empty, r.IsActive, r.IsLunch))
            .ToList();
        for (var i = 0; i < leftNormalized.Count; i++)
        {
            if (leftNormalized[i] != rightNormalized[i])
            {
                return false;
            }
        }
        return true;
    }
    // Позначає один активний слот як спільну обідню перерву або знімає позначку.
    private void ToggleLunch(TimeSlotDto target, ChangeEventArgs args)
    {
        if (!CanManageLunch) return;
        var selected = args.Value is bool value && value;
        foreach (var row in _rows)
        {
            row.IsLunch = false;
        }
        if (selected && target.IsActive)
        {
            target.IsLunch = true;
            _removeExplicitLunchRequested = false;
        }
        else
        {
            _removeExplicitLunchRequested = HasExplicitLunchForCurrentScope();
        }
    }
    // Фіксує явний намір прибрати перерву, навіть якщо вона не збігається зі слотом шаблону.
    private void RequestExplicitLunchRemoval()
    {
        if (!CanManageLunch || !HasExplicitLunchForCurrentScope()) return;
        _error = null;
        foreach (var row in _rows)
        {
            row.IsLunch = false;
        }
        _removeExplicitLunchRequested = true;
        _ok = "Власну обідню перерву буде прибрано після збереження.";
    }
    // Відкриває шаблон «Усі дні», де дозволено змінювати спільну перерву.
    private async Task OpenCommonLunchEditorAsync()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }
        _dayOfWeek = null;
        await LoadRaw();
    }
    // Валідатор слотів перед збереженням.
    private string? Validate()
    {
        if (_rows.Count(row => row.IsLunch) > 1)
            return "Можна обрати лише один слот для обідньої перерви.";
        if (CanManageLunch
            && HasExplicitLunchForCurrentScope()
            && !_rows.Any(row => row.IsLunch)
            && !_removeExplicitLunchRequested)
        {
            return "Оберіть слот обіду або натисніть «Прибрати власну перерву», щоб підтвердити її видалення.";
        }
        foreach (var r in _rows)
        {
            if (!TryTime(r.Start, out var s) || !TryTime(r.End, out var e))
                return $"Невірний час у рядку з порядком {r.SortOrder}. Формат HH:mm";
            if (s >= e) return $"Старт >= фініш у рядку {r.SortOrder}.";
            if (r.IsLunch && !r.IsActive)
                return $"Слот обіду з порядком {r.SortOrder} має бути активним.";
        }
        var actives = _rows.Where(x => x.IsActive).ToList();
        for (int i = 0; i < actives.Count; i++)
            for (int j = i + 1; j < actives.Count; j++)
            {
                var a = actives[i]; var b = actives[j];
                TryTime(a.Start, out var as1); TryTime(a.End, out var ae1);
                TryTime(b.Start, out var bs1); TryTime(b.End, out var be1);
                var overlap = as1 < be1 && bs1 < ae1;
                if (overlap) return $"Перекриття між слотами {a.SortOrder} і {b.SortOrder}.";
            }
        return null;
    }
    // Зберігає слоти та перезавантажує дані.
    // Повертає курс для поточного рівня налаштування (null = глобально).
    private int? CurrentCourseId() => _scope == Scope.Global ? null : _courseId;
    // Визначає курс-джерело для копіювання.
    private int? ResolveCopySourceCourseId()
        => _copySourceMode == CopySourceMode.GlobalOnly ? null : CurrentCourseId();
    // Повертає назву курсу для підписів.
    private string GetCourseName(int? courseId)
    {
        if (courseId is not int cid) return "усі курси";
        return _courses.FirstOrDefault(c => c.Id == cid)?.Name ?? $"Курс #{cid}";
    }
    // Повертає текстовий підпис дня.
    private string GetDayLabel(int? dayOfWeek)
    {
        if (dayOfWeek is null) return "шаблон за замовчуванням (усі дні)";
        var day = DayOptions.FirstOrDefault(d => d.Value == dayOfWeek);
        return string.IsNullOrWhiteSpace(day.Label) ? $"День #{dayOfWeek}" : day.Label;
    }
    // Повертає підпис активного контексту редагування.
    private string GetContextLabel()
    {
        var scopeLabel = _scope == Scope.Global
            ? "глобальний шаблон"
            : _courseId is int
                ? $"курс «{GetCourseName(_courseId)}»"
                : "курс не обрано";
        return $"{scopeLabel}, {GetDayLabel(_dayOfWeek)}";
    }
    // Повертає підпис джерела для копіювання.
    private string GetCopySourceLabel()
    {
        if (_copySourceMode == CopySourceMode.GlobalOnly)
        {
            return "глобальний шаблон";
        }
        return _scope == Scope.Global
            ? "поточний глобальний шаблон"
            : _courseId is int
                ? $"поточний курс «{GetCourseName(_courseId)}»"
                : "поточний курс (не обрано)";
    }
    // Повертає підказку до блоку копіювання.
    private string GetCopyHint()
    {
        if (IsScopeSelectionIncomplete)
        {
            return "Оберіть курс, щоб працювати з копіюванням.";
        }
        if (_slotsLoading)
        {
            return "Завантаження поточного контексту слотів…";
        }
        if (!_slotsLoadSucceeded)
        {
            return "Копіювання недоступне, доки слоти поточного контексту не буде успішно завантажено.";
        }
        if (_copyPreviewLoading)
        {
            return $"Завантаження шаблону «{GetCopySourceLabel()}»…";
        }
        if (_copyPreviewError is not null)
        {
            return $"Попередній перегляд шаблону «{GetCopySourceLabel()}» недоступний.";
        }
        if (_copyPreviewRows.Count == 0)
        {
            return $"У шаблоні «{GetCopySourceLabel()}» немає слотів. Спочатку створіть шаблон кнопкою вище.";
        }
        return $"У шаблоні «{GetCopySourceLabel()}»: {_copyPreviewRows.Count} слот(ів). Кроки: «Копіювати шаблон в редактор» → «Зберегти».";
    }
    // Повертає короткий статус редактора слотів.
    private string GetEditorStateHint()
    {
        if (IsScopeSelectionIncomplete)
        {
            return "Оберіть курс, щоб відкрити редактор.";
        }
        if (_slotsLoading)
        {
            return "Завантаження слотів поточного контексту…";
        }
        if (!_slotsLoadSucceeded)
        {
            return "Редактор недоступний: повторіть завантаження слотів.";
        }
        return HasUnsavedChanges
            ? $"Є незбережені зміни. Слотів у редакторі: {_rows.Count}."
            : $"Слотів у редакторі: {_rows.Count}.";
    }
    // Повертає явну або успадковану обідню перерву для поточного рівня.
    private LunchConfigEditDto? GetEffectiveLunch()
    {
        var courseId = CurrentCourseId();
        var exact = _lunches.FirstOrDefault(lunch => lunch.CourseId == courseId);
        if (exact is not null || courseId is null)
        {
            return exact;
        }
        return _lunches.FirstOrDefault(lunch => lunch.CourseId is null);
    }
    // Перевіряє наявність власної перерви саме для поточного рівня.
    private bool HasExplicitLunchForCurrentScope()
        => !IsScopeSelectionIncomplete
           && _lunches.Any(lunch => lunch.CourseId == CurrentCourseId());
    // Переносить явну перерву рівня до шаблону, створеного з окремого дня.
    private bool TryPreserveExplicitLunch(IReadOnlyCollection<TimeSlotDto> rows, int? courseId)
    {
        foreach (var row in rows)
        {
            row.IsLunch = false;
        }
        var explicitLunch = _lunches.FirstOrDefault(lunch => lunch.CourseId == courseId);
        if (explicitLunch is null)
        {
            return true;
        }
        var matchingRow = rows.FirstOrDefault(row =>
            row.IsActive
            && string.Equals(row.Start?.Trim(), explicitLunch.Start, StringComparison.Ordinal)
            && string.Equals(row.End?.Trim(), explicitLunch.End, StringComparison.Ordinal));
        if (matchingRow is null)
        {
            return false;
        }
        matchingRow.IsLunch = true;
        return true;
    }
    // Формує зрозумілий статус спільної обідньої перерви та її успадкування.
    private string GetLunchStatusText()
    {
        if (IsScopeSelectionIncomplete)
        {
            return "Оберіть курс, щоб побачити його власну або успадковану перерву.";
        }
        if (_slotsLoading)
        {
            return "Завантаження налаштування обідньої перерви…";
        }
        if (!_slotsLoadSucceeded)
        {
            return "Налаштування обідньої перерви недоступне, доки слоти не буде успішно завантажено.";
        }
        if (_removeExplicitLunchRequested)
        {
            var globalLunch = _scope == Scope.Course
                ? _lunches.FirstOrDefault(lunch => lunch.CourseId is null)
                : null;
            return globalLunch is null
                ? "Власну перерву буде прибрано після збереження."
                : $"Власну перерву буде прибрано після збереження; курс успадкує глобальну {globalLunch.Start}–{globalLunch.End}.";
        }
        var lunch = GetEffectiveLunch();
        if (lunch is null)
        {
            return _scope == Scope.Course
                ? "Для курсу та глобального рівня перерву не налаштовано."
                : "Глобальну перерву не налаштовано.";
        }
        var interval = $"{lunch.Start}–{lunch.End}";
        var isExplicitForCurrentScope = lunch.CourseId == CurrentCourseId();
        if (CanManageLunch
            && isExplicitForCurrentScope
            && !_rows.Any(row => row.IsLunch))
        {
            return $"Поточна перерва: {interval}, але вона не збігається з активним слотом шаблону. Оберіть слот обіду або збережіть без позначки, щоб прибрати власну перерву.";
        }
        if (_scope == Scope.Course && lunch.CourseId is null)
        {
            return $"Поточна перерва: {interval} (успадковано з глобального рівня).";
        }
        return _scope == Scope.Course
            ? $"Поточна перерва курсу: {interval}."
            : $"Поточна глобальна перерва: {interval}.";
    }
    // Завантажує ліміт слота для типу з прапорцем "Бажано першим у тижні".
    private async Task LoadPreferredFirstSlotLimit(int? courseId, int contextLoadVersion)
    {
        bool IsStillCurrent()
            => contextLoadVersion == _contextLoadVersion && courseId == CurrentCourseId();
        if (!IsStillCurrent())
        {
            return;
        }
        if (_preferredFirstLimitCourseId != courseId)
        {
            PreparePreferredFirstLimitContext(courseId);
        }
        else
        {
            _preferredFirstLimitLoadError = null;
            _preferredFirstLimitLoading = true;
        }
        try
        {
            var dto = await Api.GetPreferredFirstSlotLimitAsync(courseId);
            if (IsStillCurrent())
            {
                _preferredFirstMaxSlotOrder = Math.Max(0, dto.MaxSlotOrder);
                _loadedPreferredFirstMaxSlotOrder = _preferredFirstMaxSlotOrder;
                _preferredFirstLimitCourseId = courseId;
                _hasLoadedPreferredFirstLimit = true;
            }
        }
        catch (ApiErrorException ex)
        {
            if (IsStillCurrent())
            {
                var details = ex.Errors.FirstOrDefault() ?? ex.Message;
                _preferredFirstLimitLoadError = $"Не вдалося завантажити ліміт слота: {details}";
            }
        }
        catch (Exception ex)
        {
            if (IsStillCurrent())
            {
                _preferredFirstLimitLoadError = $"Не вдалося завантажити ліміт слота: {ex.Message}";
            }
        }
        finally
        {
            if (IsStillCurrent())
            {
                _preferredFirstLimitLoading = false;
            }
        }
    }
    // Повторно завантажує ліміт, не стираючи введену користувачем чернетку.
    private async Task RetryPreferredFirstSlotLimitAsync()
    {
        if (IsScopeSelectionIncomplete || _preferredFirstLimitLoading || IsMutationInProgress)
        {
            return;
        }
        var courseId = CurrentCourseId();
        var contextLoadVersion = _contextLoadVersion;
        var draft = _preferredFirstMaxSlotOrder;
        var preserveDraft = HasUnsavedPreferredFirstLimit;
        await LoadPreferredFirstSlotLimit(courseId, contextLoadVersion);
        if (preserveDraft
            && _preferredFirstLimitLoadError is null
            && contextLoadVersion == _contextLoadVersion
            && courseId == CurrentCourseId())
        {
            _preferredFirstMaxSlotOrder = draft;
        }
    }
    // Зберігає ліміт слота для типу з прапорцем "Бажано першим у тижні".
    private async Task SavePreferredFirstSlotLimit()
    {
        if (IsMutationInProgress)
        {
            return;
        }
        _error = _ok = null;
        if (_scope == Scope.Course && _courseId is null)
        {
            _error = "Вибери курс.";
            return;
        }
        if (!CanEditPreferredFirstLimit)
        {
            _error = "Спочатку успішно завантажте поточний ліміт і повторіть збереження.";
            return;
        }
        if (_preferredFirstMaxSlotOrder < 0)
        {
            _error = "Ліміт слота не може бути від'ємним.";
            return;
        }
        var contextLoadVersion = _contextLoadVersion;
        var requestedScope = _scope;
        var requestedCourseId = _courseId;
        var requestedDayOfWeek = _dayOfWeek;
        var courseId = CurrentCourseId();
        var savedValue = _preferredFirstMaxSlotOrder;
        bool IsStillCurrent()
            => IsCurrentMutationContext(
                contextLoadVersion,
                requestedScope,
                requestedCourseId,
                requestedDayOfWeek);
        _savingPreferredFirstLimit = true;
        try
        {
            await Api.SavePreferredFirstSlotLimitAsync(courseId, savedValue);
            if (IsStillCurrent())
            {
                _loadedPreferredFirstMaxSlotOrder = savedValue;
                _ok = "Ліміт збережено.";
            }
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Errors.FirstOrDefault() ?? ex.Message;
            }
        }
        catch (Exception ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _savingPreferredFirstLimit = false;
        }
    }
    private async Task Save()
    {
        if (!CanMutateSlotEditor)
        {
            return;
        }
        _error = _ok = null;
        if (!CanSaveChanges)
        {
            _ok = "Немає змін для збереження.";
            return;
        }
        _error = Validate();
        if (_error is not null) return;
        var contextLoadVersion = _contextLoadVersion;
        var requestedScope = _scope;
        var requestedCourseId = _courseId;
        var requestedDayOfWeek = _dayOfWeek;
        var courseId = CurrentCourseId();
        var rowsToSave = CloneRows(_rows);
        bool IsStillCurrent()
            => IsCurrentMutationContext(
                contextLoadVersion,
                requestedScope,
                requestedCourseId,
                requestedDayOfWeek);
        foreach (var row in rowsToSave)
        {
            row.CourseId = courseId;
            row.DayOfWeek = requestedDayOfWeek;
            if (requestedDayOfWeek is not null)
            {
                row.IsLunch = false;
            }
        }
        _savingSlots = true;
        try
        {
            await Api.SaveAsync(courseId, rowsToSave, requestedDayOfWeek);
            if (!IsStillCurrent())
            {
                return;
            }
            await ReloadContextPreservingPreferredFirstDraftAsync(
                requestedScope,
                requestedCourseId,
                requestedDayOfWeek);
            if (IsCurrentContext(requestedScope, requestedCourseId, requestedDayOfWeek)
                && _error is null)
            {
                _ok = "Збережено.";
            }
        }
        catch (BlazorWasmDotNet8AspNetCoreHosted.Client.Services.ApiErrorException ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Errors.FirstOrDefault() ?? ex.Message;
            }
        }
        catch (Exception ex)
        {
            if (IsStillCurrent())
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _savingSlots = false;
        }
    }
    // Оновлює слоти після їх збереження, не втрачаючи окремо незбережений ліміт.
    private async Task ReloadContextPreservingPreferredFirstDraftAsync(
        Scope requestedScope,
        int? requestedCourseId,
        int? requestedDayOfWeek)
    {
        var draft = _preferredFirstMaxSlotOrder;
        var preserveDraft = HasUnsavedPreferredFirstLimit;
        var preferredFirstCourseId = CurrentCourseId();
        var expectedLoadVersion = _contextLoadVersion + 1;
        await LoadRaw();
        if (preserveDraft
            && expectedLoadVersion == _contextLoadVersion
            && IsCurrentContext(requestedScope, requestedCourseId, requestedDayOfWeek)
            && preferredFirstCourseId == CurrentCourseId())
        {
            _preferredFirstMaxSlotOrder = draft;
        }
    }
}
