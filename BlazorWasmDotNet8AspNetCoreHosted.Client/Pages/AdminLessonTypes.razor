@* Сторінка адміністрування типів занять *@
@page "/admin/lesson-types"
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@inject BlazorWasmDotNet8AspNetCoreHosted.Client.Services.IAdminApi Api
@inject IJSRuntime JS

<PageTitle>Адмін • Типи занять</PageTitle>

<h1 class="h3 mb-3">Типи занять</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
        @if (loadFailed)
        {
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoad" disabled="@(loading || mutationInProgress)">
                    Повторити завантаження
                </button>
            </div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success" role="status">@ok</div>
}
@if (loading)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Завантаження типів занять…</div>
}
else if (paletteRefreshInProgress)
{
    <div class="text-muted mb-3" role="status" aria-live="polite">Оновлення палітри кольорів…</div>
}

<fieldset class="border-0 p-0 m-0 w-100" disabled="@IsInteractionBlocked">
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 m-0">@((form.Id is null ? "Додати тип" : $"Редагувати тип #{form.Id}"))</h2>
                <button class="btn btn-sm btn-success" @onclick="NewItem">+ Новий</button>
            </div>
            <div class="mb-2">
                <label class="form-label" for="lesson-type-code">Код</label>
                <input id="lesson-type-code" class="form-control" @bind="form.Code" placeholder="LECTURE / SEMINAR / LAB / BREAK / CANCELED / PRACTICE / EXAM ..." />
            </div>
            <div class="mb-2">
                <label class="form-label" for="lesson-type-name">Назва</label>
                <input id="lesson-type-name" class="form-control" @bind="form.Name" />
            </div>
            <div class="row g-2">
                <fieldset class="col-12">
                    <legend class="form-label">Колір на розкладі</legend>
                    @if (palette.Count == 0)
                    {
                        <div class="form-text text-muted">Завантаження палітри…</div>
                    }
                    else
                    {
                        <InputRadioGroup TValue="string" @bind-Value="form.CssKey" Name="color" @bind-Value:after="OnCssSelected">
                            <div class="palette-grid">
                                @foreach (var c in palette)
                                {
                                    var isMine = form.Id.HasValue && c.UsedByTypeId.HasValue && c.UsedByTypeId.Value == form.Id.Value;
                                    var usedByOther = c.IsUsed && !isMine;
                                    var itemClass = usedByOther ? "palette-item palette-item--used" : "palette-item";
                                    <label class="@itemClass" title="@($"{c.Name} ({c.Key})")">
                                        <InputRadio TValue="string" Value="@c.Key" />
                                        <span class="swatch @c.Key"></span>
                                        <span class="caption">
                                            <code>@c.Key</code>
                                            <small class="text-muted d-block">@c.Name</small>
                                            @if (usedByOther)
                                            {
                                                <small class="badge bg-light text-muted">зайнято</small>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        </InputRadioGroup>
                        <div class="small text-muted mt-1">Можна обрати будь-який колір. Зайняті позначені, але залишаються доступними.</div>
                    }
                </fieldset>
                <div class="col-12 form-check ms-2">
                    <input id="lesson-type-active" type="checkbox" class="form-check-input" @bind="form.IsActive" />
                    <label class="form-check-label" for="lesson-type-active">Активний</label>
                </div>
            </div>
            <hr />
            <div class="row row-cols-1 row-cols-md-2 g-2">
                <div class="col"><div class="form-check"><input id="lesson-type-requires-room" class="form-check-input" type="checkbox" @bind="form.RequiresRoom" /> <label class="form-check-label" for="lesson-type-requires-room">Потребує аудиторію</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-requires-teacher" class="form-check-input" type="checkbox" @bind="form.RequiresTeacher" /> <label class="form-check-label" for="lesson-type-requires-teacher">Потребує викладача</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-blocks-room" class="form-check-input" type="checkbox" @bind="form.BlocksRoom" /> <label class="form-check-label" for="lesson-type-blocks-room">Блокує аудиторію</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-blocks-teacher" class="form-check-input" type="checkbox" @bind="form.BlocksTeacher" /> <label class="form-check-label" for="lesson-type-blocks-teacher">Блокує викладача</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-count-plan" class="form-check-input" type="checkbox" @bind="form.CountInPlan" /> <label class="form-check-label" for="lesson-type-count-plan">Рахується у плані</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-count-load" class="form-check-input" type="checkbox" @bind="form.CountInLoad" /> <label class="form-check-label" for="lesson-type-count-load">Рахується у навант.</label></div></div>
                <div class="col"><div class="form-check"><input id="lesson-type-first-week" class="form-check-input" type="checkbox" @bind="form.PreferredFirstInWeek" disabled="@PreferredFirstInWeekLocked" /> <label class="form-check-label" for="lesson-type-first-week">Бажано першим у тижні</label></div></div>
            </div>
            <div class="mt-3 d-grid">
                <button class="btn btn-primary" @onclick="Save">@(saving ? "Збереження…" : "Зберегти")</button>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <h2 class="h6 m-0">Список типів</h2>
                <AdminSearchBox @bind-Value="filter" Style="max-width:360px;" Placeholder="Id / код / назва / css" />
            </div>
            <div class="table-responsive" role="region" aria-label="Список типів занять" tabindex="0">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.Id)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Style="width:60px;">Id</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.Code)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Код</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.Name)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">Назва</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.CssKey)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort">CSS</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.IsActive)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Активний">Act</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.RequiresRoom)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Потребує аудиторію">ReqR</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.RequiresTeacher)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Потребує викладача">ReqT</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.BlocksRoom)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Блокує аудиторію">BlkR</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.BlocksTeacher)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Блокує викладача">BlkT</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.CountInPlan)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Врах. у плані">Plan</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.CountInLoad)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Врах. у навантаж.">Load</SortableHeader>
                            <SortableHeader Field="@nameof(LessonTypeEditDto.PreferredFirstInWeek)" ActiveField="@sortField" SortAscending="@sortAsc" OnSort="@ToggleSort" Class="text-center" Title="Першим у тижні">1st</SortableHeader>
                            <th style="width:220px;"><span class="visually-hidden">Дії</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in SortedItems)
                        {
                            <tr>
                                <td>@x.Id</td>
                                <td>@x.Code</td>
                                <td><span class="badge-soft @x.CssKey">@x.Name</span></td>
                                <td><code>@x.CssKey</code></td>
                                <td class="text-center">@(x.IsActive ? "✓" : "—")</td>
                                <td class="text-center">@(x.RequiresRoom ? "✓" : "—")</td>
                                <td class="text-center">@(x.RequiresTeacher ? "✓" : "—")</td>
                                <td class="text-center">@(x.BlocksRoom ? "✓" : "—")</td>
                                <td class="text-center">@(x.BlocksTeacher ? "✓" : "—")</td>
                                <td class="text-center">@(x.CountInPlan ? "✓" : "—")</td>
                                <td class="text-center">@(x.CountInLoad ? "✓" : "—")</td>
                                <td class="text-center">@(x.PreferredFirstInWeek ? "✓" : "—")</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(x)">Редагувати</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(x.Id!.Value)">Видалити</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between">
                <small class="text-muted">Показано: @SortedItems.Count() з @items.Count</small>
                <small class="text-muted">Підказка: <code>BREAK</code> з вимкнутими Requires/Blocks/Count — це «перерва».</small>
            </div>
        </div>
    </div>
</div>
</fieldset>

@code {
    private string? error, ok;
    private bool loading, saving, loadFailed, mutationInProgress, paletteRefreshInProgress;
    private int paletteRefreshVersion;
    private bool IsInteractionBlocked => loading || mutationInProgress || loadFailed || paletteRefreshInProgress;
    private Action? pendingRefreshCompletion;
    private string? pendingRefreshSuccessMessage;
    private List<LessonTypeEditDto> items = new();
    private LessonTypeEditDto form = NewForm();
    private List<LessonColorDto> palette = new();
    private string? filter;
    private string sortField = nameof(LessonTypeEditDto.Id);
    private bool sortAsc = true;
    // Початкове завантаження типів занять і палітри.
    protected override async Task OnInitializedAsync() => await Load();
    // Створює порожню форму типу заняття.
    private static LessonTypeEditDto NewForm() => new()
    {
        Id = null,
        Code = "",
        Name = "",
        IsActive = true,
        RequiresRoom = true,
        RequiresTeacher = true,
        BlocksRoom = true,
        BlocksTeacher = true,
        CountInPlan = true,
        CountInLoad = true,
        PreferredFirstInWeek = false,
        CssKey = null
    };
    // Клонує DTO для редагування.
    private static LessonTypeEditDto Clone(LessonTypeEditDto x) => new()
    {
        Id = x.Id,
        Code = x.Code,
        Name = x.Name,
        IsActive = x.IsActive,
        RequiresRoom = x.RequiresRoom,
        RequiresTeacher = x.RequiresTeacher,
        BlocksRoom = x.BlocksRoom,
        BlocksTeacher = x.BlocksTeacher,
        CountInPlan = x.CountInPlan,
        CountInLoad = x.CountInLoad,
        PreferredFirstInWeek = x.PreferredFirstInWeek,
        CssKey = x.CssKey
    };
    // Завантажує типи занять і палітру кольорів.
    private async Task<bool> Load(bool clearMessages = true)
    {
        error = null;
        if (clearMessages) ok = null;
        loading = true;
        loadFailed = false;
        try
        {
            var loadedItems = await Api.GetLessonTypes();
            var loadedPalette = await Api.GetLessonColorPalette();
            items = loadedItems;
            palette = loadedPalette;
            if (form.Id is null && string.IsNullOrWhiteSpace(form.CssKey))
            {
                var free = palette.FirstOrDefault(p => !p.IsUsed);
                if (free is not null) form.CssKey = free.Key;
            }
            return true;
        }
        catch (Exception ex)
        {
            loadFailed = true;
            error = $"Не вдалося завантажити типи занять: {ex.Message}";
            return false;
        }
        finally { loading = false; }
    }
    // Повторює лише завантаження після вже виконаної серверної операції.
    private async Task RetryLoad()
    {
        if (loading || mutationInProgress) return;
        if (!await Load(clearMessages: false)) return;
        var completion = pendingRefreshCompletion;
        var successMessage = pendingRefreshSuccessMessage;
        pendingRefreshCompletion = null;
        pendingRefreshSuccessMessage = null;
        completion?.Invoke();
        if (!string.IsNullOrWhiteSpace(successMessage)) ok = successMessage;
    }
    // Скидає форму для створення нового типу.
    private void NewItem()
    {
        form = NewForm();
        var free = palette.FirstOrDefault(c => !c.IsUsed);
        if (free is not null) form.CssKey = free.Key;
    }
    // Заповнює форму даними для редагування.
    private async Task Edit(LessonTypeEditDto x)
    {
        if (IsInteractionBlocked) return;
        error = ok = null;
        form = Clone(x);
        await RefreshPalette();
    }
    // Оновлює палітру кольорів.
    private async Task RefreshPalette()
    {
        var refreshVersion = ++paletteRefreshVersion;
        paletteRefreshInProgress = true;
        try
        {
            var loadedPalette = await Api.GetLessonColorPalette();
            if (refreshVersion == paletteRefreshVersion)
            {
                palette = loadedPalette;
            }
        }
        catch (Exception ex)
        {
            if (refreshVersion == paletteRefreshVersion)
            {
                ok = null;
                error = $"Не вдалося оновити палітру кольорів: {ex.Message}";
            }
        }
        finally
        {
            if (refreshVersion == paletteRefreshVersion)
            {
                paletteRefreshInProgress = false;
            }
        }
    }
    // Зберігає тип заняття через API.
    private async Task Save()
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        saving = true;
        try
        {
            error = ok = null;
            await Api.UpsertLessonType(form);
            await FinishMutationAsync(
                "Тип заняття збережено",
                "Збережено.",
                "повторно зберігати тип заняття не потрібно",
                NewItem);
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            saving = false;
            mutationInProgress = false;
        }
    }
    // Видаляє тип заняття після підтвердження.
    private async Task Delete(int id)
    {
        if (IsInteractionBlocked) return;
        mutationInProgress = true;
        try
        {
            error = ok = null;
            if (!await JS.InvokeAsync<bool>("confirm", $"Видалити тип #{id}?")) return;
            await Api.DeleteLessonType(id);
            await FinishMutationAsync(
                "Тип заняття видалено",
                "Видалено.",
                "повторно видаляти тип заняття не потрібно",
                form.Id == id ? NewItem : null);
        }
        catch (ApiErrorException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            error = "Тип заняття використовується у розкладі. Видалення заборонено. Ви можете вимкнути його (IsActive = Ні).";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { mutationInProgress = false; }
    }
    // Завершує мутацію лише після успішного оновлення локального списку.
    private async Task FinishMutationAsync(
        string completedAction,
        string successMessage,
        string repeatWarning,
        Action? completion = null)
    {
        if (await Load(clearMessages: false))
        {
            completion?.Invoke();
            ok = successMessage;
            return;
        }

        var refreshError = error;
        ok = null;
        pendingRefreshCompletion = completion;
        pendingRefreshSuccessMessage = successMessage;
        error = $"{completedAction}, але оновити дані не вдалося. Повторіть завантаження; {repeatWarning}. Причина: {refreshError}";
    }
    // Оновлює UI після вибору кольору.
    private void OnCssSelected() => StateHasChanged();
    // Фільтрує список типів за пошуковим рядком.
    private IEnumerable<LessonTypeEditDto> ApplyFilter(IEnumerable<LessonTypeEditDto> seq)
    {
        if (string.IsNullOrWhiteSpace(filter)) return seq;
        var f = filter.Trim();
        return seq.Where(x =>
            (x.Id?.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.Code?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.CssKey?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
        );
    }
    // Сортує список типів за вибраним полем.
    private IEnumerable<LessonTypeEditDto> ApplySort(IEnumerable<LessonTypeEditDto> seq)
    {
        return (sortField, sortAsc) switch
        {
            (nameof(LessonTypeEditDto.Id), true) => seq.OrderBy(x => x.Id),
            (nameof(LessonTypeEditDto.Id), false) => seq.OrderByDescending(x => x.Id),
            (nameof(LessonTypeEditDto.Code), true) => seq.OrderBy(x => x.Code),
            (nameof(LessonTypeEditDto.Code), false) => seq.OrderByDescending(x => x.Code),
            (nameof(LessonTypeEditDto.Name), true) => seq.OrderBy(x => x.Name),
            (nameof(LessonTypeEditDto.Name), false) => seq.OrderByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.CssKey), true) => seq.OrderBy(x => x.CssKey),
            (nameof(LessonTypeEditDto.CssKey), false) => seq.OrderByDescending(x => x.CssKey),
            (nameof(LessonTypeEditDto.IsActive), true) => seq.OrderBy(x => x.IsActive).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.IsActive), false) => seq.OrderByDescending(x => x.IsActive).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.RequiresRoom), true) => seq.OrderBy(x => x.RequiresRoom).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.RequiresRoom), false) => seq.OrderByDescending(x => x.RequiresRoom).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.RequiresTeacher), true) => seq.OrderBy(x => x.RequiresTeacher).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.RequiresTeacher), false) => seq.OrderByDescending(x => x.RequiresTeacher).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.BlocksRoom), true) => seq.OrderBy(x => x.BlocksRoom).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.BlocksRoom), false) => seq.OrderByDescending(x => x.BlocksRoom).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.BlocksTeacher), true) => seq.OrderBy(x => x.BlocksTeacher).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.BlocksTeacher), false) => seq.OrderByDescending(x => x.BlocksTeacher).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.CountInPlan), true) => seq.OrderBy(x => x.CountInPlan).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.CountInPlan), false) => seq.OrderByDescending(x => x.CountInPlan).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.CountInLoad), true) => seq.OrderBy(x => x.CountInLoad).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.CountInLoad), false) => seq.OrderByDescending(x => x.CountInLoad).ThenByDescending(x => x.Name),
            (nameof(LessonTypeEditDto.PreferredFirstInWeek), true) => seq.OrderBy(x => x.PreferredFirstInWeek).ThenBy(x => x.Name),
            (nameof(LessonTypeEditDto.PreferredFirstInWeek), false) => seq.OrderByDescending(x => x.PreferredFirstInWeek).ThenByDescending(x => x.Name),
            _ => seq
        };
    }
    private IEnumerable<LessonTypeEditDto> SortedItems => ApplySort(ApplyFilter(items));
    private bool PreferredFirstInWeekLocked
        => !form.PreferredFirstInWeek
           && items.Any(x => x.PreferredFirstInWeek && x.Id != form.Id);
    // Перемикає напрямок сортування.
    private void ToggleSort(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }
}
