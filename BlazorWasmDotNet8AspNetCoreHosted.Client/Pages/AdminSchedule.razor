        => JS.InvokeAsync<string?>(useLocal ? "localStorage.getItem" : "sessionStorage.getItem", key);
    // Записує значення у сховище браузера.
    private ValueTask SetStorageAsync(string key, string value, bool useLocal)
        => JS.InvokeVoidAsync(useLocal ? "localStorage.setItem" : "sessionStorage.setItem", key, value);
    // Видаляє ключ зі сховища браузера.
