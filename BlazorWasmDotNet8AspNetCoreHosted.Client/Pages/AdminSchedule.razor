    private bool _metaLoadInProgress;
    private string? _metaLoadError;
    private int breakTypeId;
    private int canceledTypeId;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _generationFromDate = GetMonday(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly _generationToDate = GetMonday(DateOnly.FromDateTime(DateTime.Today)).AddDays(4);
    private WeekPreset _daysPreset = WeekPreset.MonFri;
    private int? _selectedCourseId;
    private readonly List<ModuleWeekRow> _moduleWeekRows = new();
    private readonly List<TableItem> _generationRangeItems = new();
    private readonly LatestAsyncRequestGuard _generationRangeLoadGuard = new();
    private readonly LatestAsyncRequestGuard _weekLoadGuard = new();
    private readonly LatestAsyncRequestGuard _statusRestoreGuard = new();
    private readonly LatestAsyncRequestGuard _weekSelectionGuard = new();
    private readonly LatestAsyncRequestGuard _rollbackablePlanLoadGuard = new();
    private readonly LatestAsyncRequestGuard _autoGenConfigRestoreGuard = new();
    private readonly LatestAsyncRequestGuard _activeAutoGenRestoreGuard = new();
    private readonly List<CourseGroupRow> _courseGroupRows = new();
    private List<BuildingEditDto> _buildingOptions = new();
    private List<RoomEditDto> _roomOptions = new();
    private bool _roomCatalogLoaded;
    private string? _roomCatalogError;
    private string? ok;
    private string? error;
    private List<string> okWarnings = new();
    private List<AutoGenWarningDetail> _latestWarningDetails = new();
    private bool okWarningsExpanded;
    private List<AutoGenGapDetail> _latestGapDetails = new();
    private List<AutoGenGapSummaryItem> _latestGapSummary = new();
    private List<AutoGenPreflightItem> _latestPreflight = new();
    private AutoGenRunReport? _latestAutoGenReport;
