            Source: item.SourceLabel
        );
        var entry = new AdminScheduleLogEntry(
            Id: Guid.NewGuid().ToString("N"),
            Timestamp: DateTimeOffset.Now,
            ActionCode: LogActionDelete,
            ActionLabel: "Видалення заняття",
            Summary: summary,
            Success: true,
            Error: null,
            WeekStart: GetMonday(item.Date).ToString("yyyy-MM-dd"),
            WeekEnd: null,
            DaysPreset: null,
            AllowDaysOff: null,
            CourseId: null,
            CourseName: null,
