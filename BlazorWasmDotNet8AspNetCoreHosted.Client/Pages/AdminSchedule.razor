    // Перевіряє, чи для групи задано хоча б один ручний пріоритет.
    private static bool HasManualGroupRoomPreference(CourseGroupRow row)
        => row.PreferredBuildingId is int || row.PreferredRoomIds.Count > 0;
    // Нормалізує вибір аудиторій після зміни корпусу.
    private void NormalizeGroupRoomPreference(CourseGroupRow row)
    {
        if (row.PreferredBuildingId is not int buildingId)
        {
            row.PreferredRoomIds.Clear();
            return;
        }
        var validRoomIds = GetRoomsForBuilding(buildingId)
            .Select(room => room.Id!.Value)
            .ToHashSet();
        row.PreferredRoomIds = row.PreferredRoomIds
            .Where(validRoomIds.Contains)
            .Distinct()
            .ToList();
    }
    // Обробляє зміну корпусу для групи.
    private async Task OnGroupBuildingChangedAsync(CourseGroupRow row, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        row.PreferredBuildingId = int.TryParse(rawValue, out var buildingId) ? buildingId : null;
        NormalizeGroupRoomPreference(row);
        await PersistAutoGenConfigAsync();
    }
    // Перемикає аудиторію в ручному наборі групи.
    private async Task OnGroupRoomToggleAsync(CourseGroupRow row, int roomId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;
        if (isChecked)
        {
            if (!row.PreferredRoomIds.Contains(roomId))
            {
                row.PreferredRoomIds.Add(roomId);
