    // Запускає візуальний прогрес для довгих операцій автогенерації.
    private async Task StartAutoGenProgressAsync(string title, AutoGenProgressKind kind)
    {
        StopAutoGenProgress();
        _autoGenCancelRequested = false;
        var (fromDate, toDate) = GetNormalizedGenerationDateRange();
        _autoGenProgress = new AutoGenProgressState
        {
            Title = title,
            Kind = kind,
            RangeStartDate = fromDate,
            RangeEndDate = toDate,
            TotalSteps = Math.Max(1, BuildGenerationWeekStarts().Count),
            StartedAt = DateTimeOffset.Now,
            CurrentStepStartedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now,
            CurrentMessage = "Підготовка запиту..."
        };
        _autoGenProgressTimerCts = new CancellationTokenSource();
        _ = RunAutoGenProgressTimerAsync(_autoGenProgressTimerCts.Token);
        await InvokeAsync(StateHasChanged);
    }
    // Запускає візуальний прогрес для очищення тижня.
    private async Task StartClearProgressAsync(string title, string message, DateOnly weekStart, DateOnly weekEnd, AutoGenProgressKind kind)
    {
        StopAutoGenProgress();
        _autoGenCancelRequested = false;
        var now = DateTimeOffset.Now;
        _autoGenProgress = new AutoGenProgressState
        {
            Title = title,
            Kind = kind,
            RangeStartDate = weekStart,
            RangeEndDate = weekEnd,
            TotalSteps = 1,
            CurrentStepNumber = 1,
            CurrentWeekStartDate = weekStart,
            CurrentRangeStartDate = weekStart,
            CurrentRangeEndDate = weekEnd,
            StartedAt = now,
            CurrentStepStartedAt = now,
            LastUpdatedAt = now,
            CurrentMessage = message,
            Percent = 15
        };
        _autoGenProgressTimerCts = new CancellationTokenSource();
        _ = RunAutoGenProgressTimerAsync(_autoGenProgressTimerCts.Token);
        await InvokeAsync(StateHasChanged);
    }
    // Оновлює таймер прогресу, щоб інтерфейс не виглядав завислим під час одного довгого HTTP-запиту.
    private async Task RunAutoGenProgressTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_autoGenProgress is null)
                {
                    return;
                }
                _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
    // Зупиняє прогрес і звільняє таймер.
    private void StopAutoGenProgress()
    {
        _autoGenProgressTimerCts?.Cancel();
        _autoGenProgressTimerCts?.Dispose();
        _autoGenProgressTimerCts = null;
        _autoGenProgress = null;
        _currentAutoGenJobId = null;
        _autoGenCancelRequested = false;
    }
    // Надсилає запит на скасування поточної серверної задачі автогенерації.
    private async Task CancelAutoGenAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentAutoGenJobId))
        {
            return;
        }
        _autoGenCancelRequested = true;
        if (_autoGenProgress is not null)
        {
            _autoGenProgress.CancellationRequested = true;
            _autoGenProgress.CurrentMessage = "Скасування запитано, очікуємо безпечного завершення...";
            _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        }
        await InvokeAsync(StateHasChanged);
        try
        {
            var status = await Drafts.CancelAutogenJob(_currentAutoGenJobId);
            ApplyAutoGenJobStatus(status);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            error = $"Не вдалося скасувати автогенерацію: {ex.Message}";
        }
    }
    // Переносить серверний стан задачі автогенерації у локальну модель прогресу.
    private void ApplyAutoGenJobStatus(AutoGenJobStatus status)
    {
        var now = DateTimeOffset.Now;
        var totalWeeks = Math.Max(1, status.TotalWeeks);
        var currentStepNumber = status.CurrentWeekNumber > 0
            ? status.CurrentWeekNumber
            : Math.Min(totalWeeks, Math.Max(1, status.CompletedWeeks + 1));
        if (_autoGenProgress is null || _autoGenProgress.JobId != status.JobId)
        {
            _autoGenProgress = new AutoGenProgressState
            {
                JobId = status.JobId,
                Title = status.Title,
                Kind = MapProgressKind(status.Kind),
                RangeStartDate = status.RangeStartDate,
                RangeEndDate = status.RangeEndDate,
                TotalSteps = totalWeeks,
                StartedAt = (status.StartedAt ?? status.CreatedAt).ToLocalTime(),
                CurrentStepStartedAt = now,
                LastUpdatedAt = now
            };
        }
        var currentWeekChanged = status.CurrentWeekStartDate is not null
            && _autoGenProgress.CurrentWeekStartDate != status.CurrentWeekStartDate;
        if (currentWeekChanged)
        {
            _autoGenProgress.CurrentStepStartedAt = now;
        }
        _currentAutoGenJobId = status.JobId;
        _autoGenProgress.JobId = status.JobId;
        _autoGenProgress.State = status.State;
        _autoGenProgress.Title = status.Title;
        _autoGenProgress.Kind = MapProgressKind(status.Kind);
        _autoGenProgress.RangeStartDate = status.RangeStartDate;
        _autoGenProgress.RangeEndDate = status.RangeEndDate;
        _autoGenProgress.TotalSteps = totalWeeks;
        _autoGenProgress.CompletedSteps = Math.Clamp(status.CompletedWeeks, 0, totalWeeks);
        _autoGenProgress.CurrentStepNumber = currentStepNumber;
        _autoGenProgress.CurrentWeekStartDate = status.CurrentWeekStartDate;
        _autoGenProgress.CurrentRangeStartDate = status.CurrentRangeStartDate;
        _autoGenProgress.CurrentRangeEndDate = status.CurrentRangeEndDate;
        _autoGenProgress.LastUpdatedAt = now;
        _autoGenProgress.CurrentMessage = status.CurrentStage;
        _autoGenProgress.LastCompletedMessage = status.LastCompletedMessage;
        _autoGenProgress.Created = status.Created;
        _autoGenProgress.WarningCount = status.WarningCount;
        _autoGenProgress.GapCount = status.GapCount;
        _autoGenProgress.DeficitCount = status.DeficitCount;
        _autoGenProgress.Percent = Math.Clamp(status.Percent, 0, 100);
        _autoGenProgress.CancellationRequested = status.CancellationRequested || _autoGenCancelRequested;
        if (status.Report is not null)
        {
            _latestAutoGenReport = status.Report;
        }
    }
    private static bool IsAutoGenJobTerminal(AutoGenJobState state)
        => state is AutoGenJobState.Succeeded or AutoGenJobState.Failed or AutoGenJobState.Canceled;
    private static AutoGenProgressKind MapProgressKind(AutoGenJobKind kind)
        => kind switch
        {
            AutoGenJobKind.Preflight => AutoGenProgressKind.Preflight,
            AutoGenJobKind.Fill => AutoGenProgressKind.Fill,
            _ => AutoGenProgressKind.Generate
        };
    private static AutoGenJobKind BuildAutoGenJobKind(bool softFill, bool preflightOnly)
        => preflightOnly ? AutoGenJobKind.Preflight : softFill ? AutoGenJobKind.Fill : AutoGenJobKind.Generate;
    // Позначає початок обробки конкретного тижня.
    private async Task UpdateAutoGenProgressBeforeWeekAsync(
        int weekIndex,
        DateOnly weekStart,
        DateOnly rangeStartDate,
        DateOnly rangeEndDate)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        _autoGenProgress.CurrentStepNumber = weekIndex + 1;
        _autoGenProgress.CurrentWeekStartDate = weekStart;
        _autoGenProgress.CurrentRangeStartDate = rangeStartDate;
        _autoGenProgress.CurrentRangeEndDate = rangeEndDate;
        _autoGenProgress.CurrentStepStartedAt = DateTimeOffset.Now;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        _autoGenProgress.CurrentMessage = $"{GetAutoGenProgressVerb(_autoGenProgress.Kind)} {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy}";
        await InvokeAsync(StateHasChanged);
