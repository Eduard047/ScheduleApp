    private List<int> GetSelectedGroupIds()
        => _courseGroupRows
            .Where(row => row.Selected)
            .Select(row => row.GroupId)
            .Distinct()
            .ToList();
    private HashSet<int> GetGroupIdsForCourse(int courseId)
        => meta?.Groups
            .Where(group => group.CourseId == courseId)
            .Select(group => group.Id)
            .ToHashSet()
           ?? new HashSet<int>();
    // Рахує, скільки годин модуля вже є у чернетках поточного завантаженого тижня.
    private (int Generated, int Planned, int Missing, int Over) GetModuleGeneratedHours(ModuleWeekRow row)
    {
        var selectedGroupIds = GetSelectedGroupIds().ToHashSet();
        var planned = row.Selected && row.Hours > 0
            ? row.Hours * selectedGroupIds.Count
            : 0;
        if (planned <= 0 || selectedGroupIds.Count == 0)
        {
            return (0, planned, Math.Max(0, planned), 0);
        }
        var weekStart = GetMonday(_selectedDate);
        var weekEnd = weekStart.AddDays(6);
        var generated = tableItems.Count(item =>
            item.Source == TableItemSource.Draft
            && item.ModuleId == row.ModuleId
            && selectedGroupIds.Contains(item.GroupId)
            && item.Date >= weekStart
            && item.Date <= weekEnd
            && !IsServiceLessonType(item.LessonTypeId));
        return (generated, planned, Math.Max(0, planned - generated), Math.Max(0, generated - planned));
    }
    private static string FormatModuleGeneratedHours(int generated, int planned)
        => planned <= 0 ? "—" : $"{generated} / {planned}";
    private static string GetModuleGeneratedHoursClass(int generated, int planned)
    {
        var state = planned <= 0
            ? "empty"
            : generated >= planned
                ? "complete"
                : generated > 0
                    ? "partial"
                    : "missing";
        return $"module-generated-hours module-generated-hours--{state}";
    }
    // Повертає корпуси у зрозумілому для UI порядку.
    private IEnumerable<BuildingEditDto> GetOrderedBuildings()
        => _buildingOptions.OrderBy(building => building.Name, StringComparer.CurrentCultureIgnoreCase);
    // Повертає аудиторії конкретного корпусу.
    private IEnumerable<RoomEditDto> GetRoomsForBuilding(int buildingId)
