    // Обробляє помилки API та зберігає конфлікти.
    private async Task HandleApiError(ApiErrorException ex)
    {
        var headline = ComposeErrorHeadline(ex);
        error = headline;
        if (ex.StatusCode == HttpStatusCode.Conflict && (ex.Errors.Count > 0 || ex.Warnings.Count > 0))
        {
            var expanded = _conflictStorage.TryGetValue(CurrentWeekKey, out var existing)
                ? existing.Expanded
                : true;
            var details = new ConflictDetails
            {
                Message = headline,
                Errors = ex.Errors.ToList(),
                Warnings = ex.Warnings.ToList(),
                SavedAt = DateTimeOffset.Now,
                Expanded = expanded
            };
            _conflictStorage[CurrentWeekKey] = details;
            _currentConflict = details;
            await PersistConflictsAsync();
        }
    }
    // Формує короткий заголовок помилки з деталей API.
    private static string ComposeErrorHeadline(ApiErrorException ex)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(ex.Message))
        {
            parts.Add(ex.Message.Trim());
        }
        var firstError = ex.Errors.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));
        if (!string.IsNullOrWhiteSpace(firstError))
        {
            parts.Add(firstError!.Trim());
        }
        else
        {
            var firstWarning = ex.Warnings.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
            if (!string.IsNullOrWhiteSpace(firstWarning))
            {
                parts.Add(firstWarning!.Trim());
            }
        }
        if (parts.Count == 0)
        {
            return string.IsNullOrWhiteSpace(ex.TraceId)
                ? "Невідома помилка."
                : $"Невідома помилка. Код запиту: {ex.TraceId}.";
        }
        var headline = parts.Count == 1 ? parts[0] : string.Join(": ", parts.Distinct(StringComparer.Ordinal));
        return string.IsNullOrWhiteSpace(ex.TraceId)
            ? headline
            : $"{headline} Код запиту: {ex.TraceId}.";
    }
    // Завантажує конфлікти з localStorage.
    private async Task LoadConflictsAsync()
    {
        if (_conflictsLoaded) return;
        _conflictsLoaded = true;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ConflictStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var data = JsonSerializer.Deserialize<Dictionary<string, ConflictDetails>>(json, ConflictJsonOptions);
                if (data is not null)
                {
                    _conflictStorage = data;
                }
            }
        }
        catch
        {
            _conflictStorage = new();
        }
    }
    // Зберігає конфлікти у localStorage.
    private async Task PersistConflictsAsync()
    {
        try
        {
            if (_conflictStorage.Count == 0)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", ConflictStorageKey);
            }
            else
            {
                var json = JsonSerializer.Serialize(_conflictStorage, ConflictJsonOptions);
                await JS.InvokeVoidAsync("localStorage.setItem", ConflictStorageKey, json);
            }
        }
        catch
        {
        }
    }
    // Синхронізує поточний конфлікт із кешем.
    private void SyncCurrentConflict()
    {
        _conflictStorage.TryGetValue(CurrentWeekKey, out _currentConflict);
    }
    // Перемикає видимість деталей конфлікту.
    private async Task ToggleConflictDetails()
    {
        if (_currentConflict is null) return;
        _currentConflict.Expanded = !_currentConflict.Expanded;
        _conflictStorage[CurrentWeekKey] = _currentConflict;
        await PersistConflictsAsync();
    }
    // Очищає конфлікт для поточного тижня.
    private async Task ClearConflictDetails()
    {
        if (_conflictStorage.Remove(CurrentWeekKey))
        {
            _currentConflict = null;
            await PersistConflictsAsync();
        }
    }
    // Повертає понеділок поточного тижня.
    private static DateOnly GetMonday(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    // Прибирає дані попереднього контексту, щоб їх не можна було переглядати або змінювати під новою датою.
    private void ClearLoadedWeekContext()
    {
        _weekLoadGuard.Invalidate();
        _generationRangeLoadGuard.Invalidate();
        draftItems.Clear();
        publishedItems.Clear();
        tableItems.Clear();
        _generationRangeItems.Clear();
        _currentConflict = null;
        CloseEditor();
    }
    // Безпечно завантажує видимий тиждень і залишає помилку всередині сторінки для повторної спроби.
    private async Task<bool> TryLoadVisibleWeekAsync(bool clearExisting = true)
    {
        var expectedWeekStart = GetMonday(_selectedDate);
        var expectedCourseId = _selectedCourseId;
        if (clearExisting)
        {
            ClearLoadedWeekContext();
        }

        _weekContextLoadError = null;
        _weekContextLoadInProgress = true;
        try
        {
            await LoadWeek();
            return GetMonday(_selectedDate) == expectedWeekStart
                   && _selectedCourseId == expectedCourseId;
        }
        catch (ApiErrorException ex)
        {
            if (!_queryContextApplyPending
                && GetMonday(_selectedDate) == expectedWeekStart
                && _selectedCourseId == expectedCourseId)
            {
                ClearLoadedWeekContext();
                _weekContextLoadError = $"Не вдалося завантажити таблицю тижня: {ComposeErrorHeadline(ex)}";
            }
            return false;
        }
        catch (HttpRequestException)
        {
            if (!_queryContextApplyPending
                && GetMonday(_selectedDate) == expectedWeekStart
                && _selectedCourseId == expectedCourseId)
            {
                ClearLoadedWeekContext();
                _weekContextLoadError = "Не вдалося завантажити таблицю тижня через помилку мережі.";
            }
            return false;
        }
        catch (TaskCanceledException)
        {
            if (!_queryContextApplyPending
                && GetMonday(_selectedDate) == expectedWeekStart
                && _selectedCourseId == expectedCourseId)
            {
                ClearLoadedWeekContext();
                _weekContextLoadError = "Завантаження таблиці тижня тривало надто довго. Спробуйте ще раз.";
            }
            return false;
        }
        catch (Exception)
        {
            if (!_queryContextApplyPending
                && GetMonday(_selectedDate) == expectedWeekStart
                && _selectedCourseId == expectedCourseId)
            {
                ClearLoadedWeekContext();
                _weekContextLoadError = "Не вдалося завантажити таблицю тижня. Спробуйте ще раз.";
            }
            return false;
        }
        finally
        {
            _weekContextLoadInProgress = false;
        }
    }
