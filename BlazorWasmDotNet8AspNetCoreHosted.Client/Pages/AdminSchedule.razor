    private LookupDto? SelectedAutoGenCourse
        => meta is not null && _selectedCourseId is int courseId
            ? meta.Courses.FirstOrDefault(course => course.Id == courseId)
            : null;
    private bool CanRestoreLastAutoGenInput
    {
        get
        {
            if (meta is null || _lastAutoGenInput is not { } state)
            {
                return false;
            }
            var validModuleIds = meta.Modules
                .Where(module => module.CourseId == state.CourseId || module.CourseIds.Contains(state.CourseId))
                .Select(module => module.Id)
                .ToHashSet();
            var hasValidModule = state.Modules?.Any(module =>
                module.Value.Selected
                && module.Value.Hours > 0
                && validModuleIds.Contains(module.Key)) == true;
            var validGroupIds = meta.Groups
                .Where(group => group.CourseId == state.CourseId)
                .Select(group => group.Id)
                .ToHashSet();
            var hasValidGroup = state.SelectedGroupIds?.Any(validGroupIds.Contains) == true;
            return meta.Courses.Any(course => course.Id == state.CourseId)
                   && hasValidModule
                   && hasValidGroup;
        }
    }
    private bool IsAcademicPeriodReadyForAutoGen
        => SelectedAutoGenCourse?.AcademicPeriodStartDate is DateOnly academicPeriodStartDate
           && _generationFromDate >= academicPeriodStartDate;
    private bool HasInvalidGenerationDateRange => _generationToDate < _generationFromDate;
    private bool CanAutoGen
        => _selectedCourseId is int
           && !HasInvalidGenerationDateRange
           && IsAcademicPeriodReadyForAutoGen
           && _moduleWeekRows.Any(row => row.Selected && row.Hours > 0)
           && _courseGroupRows.Any(row => row.Selected);
    // Пояснює першу умову, через яку план ще не можна сформувати.
    private string? GetAutoGenBlockingReason()
    {
        if (HasInvalidGenerationDateRange)
        {
            return "Дата завершення не може бути раніше дати початку.";
        }
        if (_selectedCourseId is null)
        {
            return "Щоб сформувати план, оберіть курс.";
        }
        if (SelectedAutoGenCourse is not { } selectedCourse)
        {
            return "Щоб сформувати план, оберіть доступний курс.";
        }
        if (selectedCourse.AcademicPeriodStartDate is not DateOnly academicPeriodStartDate)
        {
            return "Для курсу не вказано початок навчального періоду.";
        }
        if (_generationFromDate < academicPeriodStartDate)
        {
            return $"Початок діапазону має бути не раніше {academicPeriodStartDate:dd.MM.yyyy}.";
        }
        if (_courseGroupRows.Count == 0)
        {
            return "Для обраного курсу немає доступних груп.";
        }
        if (!_courseGroupRows.Any(row => row.Selected))
        {
            return "Щоб сформувати план, оберіть хоча б одну групу.";
        }
        if (_moduleWeekRows.Count == 0)
        {
            return "Для обраного курсу немає доступних модулів.";
        }
        if (!_moduleWeekRows.Any(row => row.Selected && row.Hours > 0))
        {
            return "Щоб сформувати план, оберіть модуль і вкажіть кількість пар більше нуля.";
        }
        return null;
    }
