    // Форматує короткий статус чернетки з позначкою про відсутні призначення.
    private static string ComposeDraftStatusLabel(TeacherDraftItemDto draft)
    {
        var baseStatus = FormatDraftStatus(draft.Status);
        return draft.MissingTeacherAssignment || draft.MissingRoomAssignment
            ? $"{baseStatus} · потребує призначення"
            : baseStatus;
    }
