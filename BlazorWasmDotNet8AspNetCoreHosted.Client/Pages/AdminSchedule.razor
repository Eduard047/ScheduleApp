    // Запускає автогенерацію послідовно для кожного тижня в обраному діапазоні.
    private async Task<(AutoGenResult Result, DateOnly RangeStartDate, DateOnly RangeEndDate, int WeekCount, bool AllowDaysOffUsed)> RunAutoGenForRangeAsync(
        int courseId,
        Dictionary<int, int> moduleHours,
        bool clearExisting,
        bool softFill)
    {
        var (fromDate, toDate) = GetNormalizedGenerationDateRange();
        var weekStarts = BuildGenerationWeekStarts();
        var warnings = new List<string>();
        var gapDetails = new List<AutoGenGapDetail>();
        int created = 0;
        int skipped = 0;
        bool allowDaysOffUsed = false;
        foreach (var weekStart in weekStarts)
        {
            var weekEnd = weekStart.AddDays(6);
            var rangeStartDate = fromDate > weekStart ? fromDate : weekStart;
            var rangeEndDate = toDate < weekEnd ? toDate : weekEnd;
            if (rangeEndDate < rangeStartDate)
            {
                continue;
            }
            var allowDaysOff = AllowDaysOffForPreset(weekStart);
            allowDaysOffUsed |= allowDaysOff;
            var res = await Drafts.AutogenWeek(new AutoGenRequest(
                WeekStart: weekStart,
                ClearExisting: clearExisting,
                CourseId: courseId,
                GroupId: null,
                AllowOnDaysOff: allowDaysOff,
                Days: _daysPreset,
                ModuleHours: moduleHours,
                SoftFill: softFill,
                RangeStartDate: rangeStartDate,
                RangeEndDate: rangeEndDate
            ));
            created += res.Created;
            skipped += res.Skipped;
            if (res.Warnings.Count > 0)
            {
                warnings.AddRange(res.Warnings);
            }
            if (res.GapDetails is { Count: > 0 })
            {
                gapDetails.AddRange(res.GapDetails);
            }
        }
        var result = new AutoGenResult(created, skipped, warnings, gapDetails);
        return (result, fromDate, toDate, weekStarts.Count, allowDaysOffUsed);
    }
    // Запускає автогенерацію чернеток для обраного діапазону.
    private async Task AutoGenDrafts()
    {
        await ResetStatusAsync();
        try
        {
            if (_selectedCourseId is not int courseId)
            {
                error = "Оберіть курс для автогенерації.";
                return;
            }
            var moduleHours = _moduleWeekRows
                .Where(row => row.Selected && row.Hours > 0)
                .GroupBy(row => row.ModuleId)
                .ToDictionary(g => g.Key, g => g.First().Hours);
            if (moduleHours.Count == 0)
            {
                error = "Оберіть хоча б один модуль і вкажіть години > 0.";
                return;
            }
            await PersistAutoGenConfigAsync();
            var (res, rangeStartDate, rangeEndDate, weekCount, allowDaysOff) = await RunAutoGenForRangeAsync(
                courseId,
                moduleHours,
                clearExisting: true,
                softFill: false);
            var courseName = meta?.Courses.FirstOrDefault(c => c.Id == courseId)?.Name ?? $"#{courseId}";
            var rangeWeekStart = GetMonday(rangeStartDate);
            var isSingleFullWeek = weekCount == 1
                && rangeStartDate == rangeWeekStart
                && rangeEndDate == rangeWeekStart.AddDays(6);
            var summary = isSingleFullWeek
                ? $"Автогенерація тижня у чернетки (курс: {courseName}): створено {res.Created}, пропущено {res.Skipped}."
                : $"Автогенерація діапазону {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy} (курс: {courseName}): створено {res.Created}, пропущено {res.Skipped}.";
            await SetOkMessageAsync(summary, res.Warnings, res.GapDetails);
            await LoadWeek();
            await LogAutoGenAsync(
                summary,
                res,
                rangeStartDate,
                rangeEndDate,
                courseId,
                courseName,
                moduleHours,
                softFill: false,
                allowDaysOff: allowDaysOff);
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
