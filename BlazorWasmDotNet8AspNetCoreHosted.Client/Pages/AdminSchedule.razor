            LessonsTrimmed: false
        );
        await TryWriteLogAsync(entry);
    }
    private async Task TryWriteLogAsync(AdminScheduleLogEntry entry)
    {
        try
        {
            await LogService.AddAsync(entry);
        }
        catch (Exception)
        {
        }
    }
    private List<AdminScheduleLogLesson> BuildDraftLessonSnapshot(out bool trimmed)
    {
        var ordered = draftItems
            .OrderBy(x => x.Date)
            .ThenBy(x => x.TimeStart)
            .ToList();
        trimmed = ordered.Count > LogLessonLimit;
        return ordered
            .Take(LogLessonLimit)
            .Select(draft => new AdminScheduleLogLesson(
                Id: draft.Id,
                Date: draft.Date.ToString("yyyy-MM-dd"),
                TimeStart: draft.TimeStart,
                TimeEnd: draft.TimeEnd,
                Group: SafeValue(draft.Group),
                Module: SafeValue(draft.Module),
                Teacher: SafeValue(draft.Teacher),
                Room: SafeValue(draft.Room),
                LessonType: draft.LessonTypeName,
                Status: FormatDraftStatus(draft.Status),
                Source: "Чернетка"
            ))
            .ToList();
    }
    private List<AdminScheduleLogModuleHours> BuildModuleHours(Dictionary<int, int> moduleHours)
    {
        if (moduleHours.Count == 0)
        {
            return new();
        }
        var result = new List<AdminScheduleLogModuleHours>();
        foreach (var (moduleId, hours) in moduleHours)
        {
            var module = meta?.Modules.FirstOrDefault(m => m.Id == moduleId);
            var label = module is null
                ? $"#{moduleId}"
                : $"{module.Code} — {module.Name}";
            result.Add(new AdminScheduleLogModuleHours(moduleId, label, hours));
        }
        return result
            .OrderBy(x => x.ModuleName)
            .ToList();
    }
    private static string FormatWeekPreset(WeekPreset preset)
        => preset switch
        {
            WeekPreset.MonFri => "Пн–Пт",
            WeekPreset.MonSat => "Пн–Сб",
            _ => "Пн–Нд"
        };
    private static string SafeValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private void OpenEditor(TableItem item)
    {
        _editItem = item;
        _editError = null;
    }
    private void CloseEditor()
    {
        _editItem = null;
        _editError = null;
    }
    private async Task DeleteSelectedAsync()
    {
        if (_editItem is null)
        {
            return;
        }
        var current = _editItem;
        var confirmText = current.Source == TableItemSource.Draft
            ? $"Видалити чернетку #{current.Id}? Дію не можна скасувати."
            : $"Видалити запис розкладу #{current.Id}? Дію не можна скасувати.";
        if (current.Source == TableItemSource.Draft && current.IsLocked)
        {
            confirmText = $"Чернетка #{current.Id} заблокована. Видалити її попри блокування?";
        }
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed)
        {
            return;
        }
        await ResetStatusAsync(clearPersisted: false);
        _editDeleting = true;
        _editError = null;
        try
        {
            if (current.Source == TableItemSource.Draft)
            {
                await Drafts.Delete(current.Id, confirm: true, unrestricted: current.IsLocked);
            }
            else
            {
                await Api.Delete(current.Id);
            }
            RemoveTableItemFromState(current);
            var summary = $"Видалено заняття #{current.Id}.";
            await SetOkMessageAsync(summary, persist: false);
            await LogDeleteAsync(summary, current);
            CloseEditor();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
            _editError = error ?? "Сталася помилка під час видалення заняття.";
        }
        catch (Exception)
        {
            _editError = "Сталася помилка під час видалення заняття.";
        }
        finally
        {
            _editDeleting = false;
        }
    }
