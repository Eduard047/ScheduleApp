    // Оновлює підсумок після відповіді сервера за тиждень.
    private async Task UpdateAutoGenProgressAfterWeekAsync(int weekIndex, DateOnly rangeStartDate, DateOnly rangeEndDate, AutoGenResult result)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        _autoGenProgress.CompletedSteps = Math.Max(_autoGenProgress.CompletedSteps, weekIndex + 1);
        _autoGenProgress.Created += result.Created;
        _autoGenProgress.WarningCount += result.Warnings.Count;
        _autoGenProgress.GapCount += result.GapDetails?.Count ?? 0;
        _autoGenProgress.DeficitCount += result.Preflight?.Sum(item => item.Count) ?? 0;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        _autoGenProgress.LastCompletedMessage = BuildAutoGenProgressCompletedMessage(rangeStartDate, rangeEndDate, result);
        _autoGenProgress.CurrentMessage = _autoGenProgress.CompletedSteps >= _autoGenProgress.TotalSteps
            ? "Завершення операції..."
            : "Підготовка наступного тижня...";
        await InvokeAsync(StateHasChanged);
    }
    // Показує фінальний технічний крок після генерації.
