    // Рахує пари модуля в чернетках і опублікованому розкладі всього діапазону генерації.
    private (int Generated, int Planned, int Missing, int Over) GetModuleGeneratedHours(ModuleWeekRow row)
    {
        var selectedGroupIds = GetSelectedGroupIds().ToHashSet();
        var planned = row.Selected && row.Hours > 0
            ? row.Hours * selectedGroupIds.Count
            : 0;
        if (planned <= 0 || selectedGroupIds.Count == 0)
        {
            return (0, planned, Math.Max(0, planned), 0);
        }
        var (rangeStart, rangeEnd) = GetNormalizedGenerationDateRange();
        var generated = _generationRangeItems
            .Where(item =>
                item.ModuleId == row.ModuleId
                && selectedGroupIds.Contains(item.GroupId)
                && item.Date >= rangeStart
                && item.Date <= rangeEnd
                && !IsServiceLessonType(item.LessonTypeId))
            .Select(item => (
                item.Source,
                item.Date,
                item.TimeStart,
                item.TimeEnd,
                item.GroupId,
                item.ModuleId,
                item.LessonTypeId))
            .Distinct()
            .Count();
        return (generated, planned, Math.Max(0, planned - generated), Math.Max(0, generated - planned));
    }
    // Підсумовує план і фактичну кількість пар усіх вибраних модулів за діапазон генерації.
    private (int Scheduled, int Planned, int Missing, int Over) GetModuleWeekTotals()
    {
        var total = (Scheduled: 0, Planned: 0, Missing: 0, Over: 0);
        foreach (var row in _moduleWeekRows.Where(row => row.Selected && row.Hours > 0))
        {
            var progress = GetModuleGeneratedHours(row);
            total.Scheduled += progress.Generated;
            total.Planned += progress.Planned;
            total.Missing += progress.Missing;
            total.Over += progress.Over;
        }
        return total;
    }
    // Повертає діапазон дат, за яким пораховано факт у таблиці модулів.
    private string GetLoadedWeekRangeLabel()
    {
        var (rangeStart, rangeEnd) = GetNormalizedGenerationDateRange();
        return $"{rangeStart:dd.MM.yyyy}–{rangeEnd:dd.MM.yyyy}";
    }
    private static string FormatModuleGeneratedHours(int generated, int planned)
        => planned <= 0 ? "—" : $"{generated} / {planned}";
    private static string GetModuleGeneratedHoursClass(int generated, int planned)
    {
        var state = planned <= 0
            ? "empty"
            : generated >= planned
                ? "complete"
                : generated > 0
                    ? "partial"
                    : "missing";
        return $"module-generated-hours module-generated-hours--{state}";
    }
    // Повертає корпуси у зрозумілому для UI порядку.
    private IEnumerable<BuildingEditDto> GetOrderedBuildings()
        => _buildingOptions.OrderBy(building => building.Name, StringComparer.CurrentCultureIgnoreCase);
    // Повертає аудиторії конкретного корпусу.
    private IEnumerable<RoomEditDto> GetRoomsForBuilding(int buildingId)
        => _roomOptions
            .Where(room => room.Id.HasValue && room.BuildingId == buildingId)
            .OrderBy(room => room.Name, StringComparer.CurrentCultureIgnoreCase);
    // Формує короткий підпис ручного вибору аудиторій для групи.
    private string GetGroupRoomPreferenceSummary(CourseGroupRow row)
    {
        if (row.PreferredBuildingId is not int buildingId)
        {
            return "Автоматичний підбір аудиторій";
        }
        var buildingName = BuildingName(buildingId);
        if (row.PreferredRoomIds.Count == 0)
        {
            return $"Корпус: {buildingName}";
        }
        return $"Корпус: {buildingName} · аудиторій: {row.PreferredRoomIds.Count}";
    }
    // Стисло показує стан прихованих ручних обмежень аудиторій.
    private string GetGroupRoomPreferencesOverview()
    {
        var configuredCount = _courseGroupRows.Count(row => row.Selected && row.HasRoomPreferences);
        return configuredCount == 0
            ? "автоматичний підбір для всіх груп"
            : $"ручні обмеження: {configuredCount}";
    }
    // Стисло описує приховані параметри, щоб основний стан був зрозумілий без розгортання блоку.
    private string GetAutoGenAdvancedSettingsSummary()
    {
        var parts = new List<string>
        {
            _useRecommendedAutoGenProfile ? "рекомендований профіль" : "правила з довідників"
        };
        if (_selectedCourseId is null)
        {
            parts.Add("курс не обрано");
            return string.Join(" · ", parts);
        }

        var selectedGroups = _courseGroupRows.Count(row => row.Selected);
        parts.Add(_courseGroupRows.Count == 0
            ? "груп немає"
            : selectedGroups == _courseGroupRows.Count
                ? $"усі групи: {selectedGroups}"
                : $"групи: {selectedGroups} із {_courseGroupRows.Count}");
        parts.Add(GetGroupRoomPreferencesOverview());
        if (_allowIncompleteDrafts)
        {
            parts.Add("неповні чернетки дозволено");
        }
        return string.Join(" · ", parts);
    }
    // Формує коротке резюме обов'язкових параметрів поруч з основною дією.
    private string GetAutoGenActionSummary()
    {
        var courseName = SelectedAutoGenCourse?.Name ?? "Курс не обрано";
        var range = $"{_generationFromDate:dd.MM.yyyy}–{_generationToDate:dd.MM.yyyy}";
        var selectedGroups = _courseGroupRows.Count(row => row.Selected);
        var selectedModules = _moduleWeekRows.Count(row => row.Selected && row.Hours > 0);
        return $"{courseName} · {range} · груп: {selectedGroups} · модулів: {selectedModules}";
    }
    // Повертає підпис для кількості вибраних аудиторій.
    private string GetSelectedRoomCountLabel(CourseGroupRow row)
        => row.PreferredRoomIds.Count == 0
            ? "без вибору"
            : $"{row.PreferredRoomIds.Count} вибр.";
    // Повертає назву корпусу або службовий ідентифікатор.
    private string BuildingName(int buildingId)
        => _buildingOptions.FirstOrDefault(building => building.Id == buildingId)?.Name ?? $"#{buildingId}";
    // Перевіряє, чи для групи задано хоча б один ручний пріоритет.
    private static bool HasManualGroupRoomPreference(CourseGroupRow row)
        => row.PreferredBuildingId is int || row.PreferredRoomIds.Count > 0;
    // Нормалізує вибір аудиторій після зміни корпусу.
    private void NormalizeGroupRoomPreference(CourseGroupRow row)
    {
        if (row.PreferredBuildingId is not int buildingId)
        {
            row.PreferredRoomIds.Clear();
            return;
        }
        var validRoomIds = GetRoomsForBuilding(buildingId)
            .Select(room => room.Id!.Value)
            .ToHashSet();
        row.PreferredRoomIds = row.PreferredRoomIds
            .Where(validRoomIds.Contains)
            .Distinct()
            .ToList();
    }
    // Обробляє зміну корпусу для групи.
    private async Task OnGroupBuildingChangedAsync(CourseGroupRow row, ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        row.PreferredBuildingId = int.TryParse(rawValue, out var buildingId) ? buildingId : null;
        NormalizeGroupRoomPreference(row);
        await OnAutoGenConfigurationChangedAsync();
    }
    // Перемикає аудиторію в ручному наборі групи.
    private async Task OnGroupRoomToggleAsync(CourseGroupRow row, int roomId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;
        if (isChecked)
        {
            if (!row.PreferredRoomIds.Contains(roomId))
            {
                row.PreferredRoomIds.Add(roomId);
            }
        }
        else
        {
            row.PreferredRoomIds.Remove(roomId);
        }
        NormalizeGroupRoomPreference(row);
        await OnAutoGenConfigurationChangedAsync();
    }
    // Скидає ручний вибір корпусу та аудиторій для конкретної групи.
    private async Task ClearGroupRoomPreferenceAsync(CourseGroupRow row)
    {
        row.PreferredBuildingId = null;
        row.PreferredRoomIds.Clear();
        await OnAutoGenConfigurationChangedAsync();
    }
    // Формує опис діапазону тижня для генерації.
    private string GetGenerationRangeDescription()
    {
        if (HasInvalidGenerationDateRange)
        {
            return $"Некоректний діапазон: {_generationFromDate:dd.MM.yyyy} – {_generationToDate:dd.MM.yyyy}";
        }
        var fromDate = _generationFromDate;
        var toDate = _generationToDate;
        var dayCount = toDate.DayNumber - fromDate.DayNumber + 1;
        var fromWeekStart = GetMonday(fromDate);
        if (dayCount == 5 && fromDate == fromWeekStart && toDate == fromWeekStart.AddDays(4))
        {
            return $"Навчальний тиждень: {fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy} (Пн–Пт)";
        }
        if (dayCount == 7 && fromDate == fromWeekStart && toDate == fromWeekStart.AddDays(6))
        {
            return $"Тиждень: {fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy}";
        }
        if (dayCount == 1)
        {
            return $"Дата: {fromDate:dd.MM.yyyy} (1 день)";
        }
        return $"Діапазон: {fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy} ({FormatAutoGenDayCount(dayCount)})";
    }
    // Відмінює кількість календарних днів у підписі діапазону.
    private static string FormatAutoGenDayCount(int dayCount)
    {
        var lastTwoDigits = dayCount % 100;
        var lastDigit = dayCount % 10;
        var unit = lastDigit == 1 && lastTwoDigits != 11
            ? "день"
            : lastDigit is >= 2 and <= 4 && lastTwoDigits is not (>= 12 and <= 14)
                ? "дні"
                : "днів";
        return $"{dayCount} {unit}";
    }
    // Нормалізує межі генерації до стартів тижня (понеділок).
    private (DateOnly FromWeekStart, DateOnly ToWeekStart) GetNormalizedGenerationWeekRange()
    {
        var fromWeekStart = GetMonday(_generationFromDate);
        var toWeekStart = GetMonday(_generationToDate);
        if (toWeekStart < fromWeekStart)
        {
            (fromWeekStart, toWeekStart) = (toWeekStart, fromWeekStart);
        }
        return (fromWeekStart, toWeekStart);
    }
    // Нормалізує фактичні межі діапазону генерації за датами.
    private (DateOnly FromDate, DateOnly ToDate) GetNormalizedGenerationDateRange()
    {
        var fromDate = _generationFromDate;
        var toDate = _generationToDate;
        if (toDate < fromDate)
        {
            (fromDate, toDate) = (toDate, fromDate);
        }
        return (fromDate, toDate);
    }
    // Формує список стартів тижня для автогенерації.
    private List<DateOnly> BuildGenerationWeekStarts()
    {
        var (fromWeekStart, toWeekStart) = GetNormalizedGenerationWeekRange();
        var weekStarts = new List<DateOnly>();
        for (var week = fromWeekStart; week <= toWeekStart; week = week.AddDays(7))
        {
            weekStarts.Add(week);
        }
        return weekStarts;
    }
    // Скидає статуси повідомлень та, за потреби, збережений стан.
    private async Task ResetStatusAsync(bool clearPersisted = true)
    {
        _statusRestoreGuard.Invalidate();
        ok = error = null;
        okWarnings = new();
        _latestWarningDetails = new();
        okWarningsExpanded = false;
        _latestGapDetails = new();
        _latestGapSummary = new();
        _latestPreflight = new();
        _latestAutoGenReport = null;
        _latestAutoGenPlan = null;
        _latestAutoGenPlanChanges = new();
        _preparedAutoGenPlanLogContext = null;
        _lastAutoGenInputRestored = false;
        _appliedPlanReviewContext = null;
        if (clearPersisted)
        {
            await RemovePersistedAutoGenStatusAsync();
        }
    }
    // Скидає попередній план після зміни будь-якого параметра та зберігає нові налаштування.
    private async Task OnAutoGenConfigurationChangedAsync()
    {
        if (IsAutoGenBusy)
        {
            return;
        }
        await ResetStatusAsync();
        await PersistAutoGenConfigAsync();
    }
    // Запускає візуальний прогрес для довгих операцій автогенерації.
    private async Task StartAutoGenProgressAsync(string title, AutoGenProgressKind kind)
    {
        StopAutoGenProgress();
        _autoGenCancelRequested = false;
        var (fromDate, toDate) = GetNormalizedGenerationDateRange();
        _autoGenProgress = new AutoGenProgressState
        {
            Title = title,
            Kind = kind,
            RangeStartDate = fromDate,
            RangeEndDate = toDate,
            TotalSteps = Math.Max(1, BuildGenerationWeekStarts().Count),
            StartedAt = DateTimeOffset.Now,
            CurrentStepStartedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now,
            CurrentMessage = "Підготовка запиту..."
        };
        StartAutoGenProgressTimer();
        await InvokeAsync(StateHasChanged);
    }
    // Запускає візуальний прогрес для очищення тижня.
    private async Task StartClearProgressAsync(string title, string message, DateOnly weekStart, DateOnly weekEnd, AutoGenProgressKind kind)
    {
        StopAutoGenProgress();
        _autoGenCancelRequested = false;
        var now = DateTimeOffset.Now;
        _autoGenProgress = new AutoGenProgressState
        {
            Title = title,
            Kind = kind,
            RangeStartDate = weekStart,
            RangeEndDate = weekEnd,
            TotalSteps = 1,
            CurrentStepNumber = 1,
            CurrentWeekStartDate = weekStart,
            CurrentRangeStartDate = weekStart,
            CurrentRangeEndDate = weekEnd,
            StartedAt = now,
            CurrentStepStartedAt = now,
            LastUpdatedAt = now,
            CurrentMessage = message,
            Percent = 15
        };
        StartAutoGenProgressTimer();
        await InvokeAsync(StateHasChanged);
    }
    // Запускає один таймер оновлення прогресу та прив'язує його до життєвого циклу сторінки.
    private void StartAutoGenProgressTimer()
    {
        if (_autoGenProgressTimerCts is not null)
        {
            return;
        }
        _autoGenProgressTimerCts = CancellationTokenSource.CreateLinkedTokenSource(_componentLifetimeCts.Token);
        _ = RunAutoGenProgressTimerAsync(_autoGenProgressTimerCts.Token);
    }
    // Оновлює таймер прогресу, щоб інтерфейс не виглядав завислим під час одного довгого HTTP-запиту.
    private async Task RunAutoGenProgressTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_autoGenProgress is null)
                {
                    return;
                }
                _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
    // Зупиняє прогрес і звільняє таймер.
    private void StopAutoGenProgress()
    {
        _autoGenProgressTimerCts?.Cancel();
        _autoGenProgressTimerCts?.Dispose();
        _autoGenProgressTimerCts = null;
        _autoGenProgress = null;
        _currentAutoGenJobId = null;
        _autoGenCancelRequested = false;
    }
    // Надсилає запит на скасування поточної серверної задачі автогенерації.
    private async Task CancelAutoGenAsync()
    {
        var jobId = _currentAutoGenJobId;
        if (string.IsNullOrWhiteSpace(jobId) || _autoGenCancelRequested)
        {
            return;
        }
        _autoGenCancelRequested = true;
        if (_autoGenProgress is not null)
        {
            _autoGenProgress.CancellationRequested = true;
            _autoGenProgress.CurrentMessage = "Скасування запитано, очікуємо безпечного завершення...";
            _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        }
        await InvokeAsync(StateHasChanged);
        try
        {
            var status = await Drafts.CancelAutogenJob(jobId);
            if (!string.Equals(_currentAutoGenJobId, jobId, StringComparison.Ordinal))
            {
                return;
            }
            if (IsAutoGenJobTerminal(status.State))
            {
                ApplyAutoGenJobStatus(status);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (string.Equals(_currentAutoGenJobId, jobId, StringComparison.Ordinal))
            {
                // Невдалий HTTP-запит не є підтвердженням скасування: повертаємо можливість повторити дію.
                _autoGenCancelRequested = false;
                if (_autoGenProgress is not null)
                {
                    _autoGenProgress.CancellationRequested = false;
                    _autoGenProgress.CurrentMessage = "Запит на скасування не підтверджено. Можна повторити спробу.";
                    _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
                }
                error = $"Не вдалося скасувати автогенерацію: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    // Переносить серверний стан задачі автогенерації у локальну модель прогресу.
    private void ApplyAutoGenJobStatus(AutoGenJobStatus status)
    {
        if (!string.IsNullOrWhiteSpace(_currentAutoGenJobId)
            && !string.Equals(_currentAutoGenJobId, status.JobId, StringComparison.Ordinal))
        {
            return;
        }
        if (_autoGenProgress?.JobId == status.JobId
            && _autoGenProgress.State is AutoGenJobState currentState
            && IsAutoGenJobTerminal(currentState)
            && !IsAutoGenJobTerminal(status.State))
        {
            return;
        }
        var now = DateTimeOffset.Now;
        var totalWeeks = Math.Max(1, status.TotalWeeks);
        var previousCompletedSteps = _autoGenProgress?.CompletedSteps ?? 0;
        var currentStepNumber = status.CurrentWeekNumber > 0
            ? status.CurrentWeekNumber
            : Math.Min(totalWeeks, Math.Max(1, status.CompletedWeeks + 1));
        if (_autoGenProgress is null || _autoGenProgress.JobId != status.JobId)
        {
            _autoGenProgress = new AutoGenProgressState
            {
                JobId = status.JobId,
                Title = status.Title,
                Kind = MapProgressKind(status.Kind),
                RangeStartDate = status.RangeStartDate,
                RangeEndDate = status.RangeEndDate,
                TotalSteps = totalWeeks,
                StartedAt = (status.StartedAt ?? status.CreatedAt).ToLocalTime(),
                CurrentStepStartedAt = now,
                LastUpdatedAt = now
            };
        }
        if (status.StartedAt is DateTimeOffset serverStartedAt)
        {
            _autoGenProgress.StartedAt = serverStartedAt.ToLocalTime();
        }
        var currentWeekChanged = status.CurrentWeekStartDate is not null
            && _autoGenProgress.CurrentWeekStartDate != status.CurrentWeekStartDate;
        if (currentWeekChanged)
        {
            _autoGenProgress.CurrentStepStartedAt = now;
        }
        _currentAutoGenJobId = status.JobId;
        _autoGenProgress.JobId = status.JobId;
        _autoGenProgress.State = status.State;
        _autoGenProgress.Title = status.Title;
        _autoGenProgress.Kind = MapProgressKind(status.Kind);
        _autoGenProgress.RangeStartDate = status.RangeStartDate;
        _autoGenProgress.RangeEndDate = status.RangeEndDate;
        _autoGenProgress.TotalSteps = totalWeeks;
        _autoGenProgress.CompletedSteps = Math.Clamp(status.CompletedWeeks, 0, totalWeeks);
        _autoGenProgress.CurrentStepNumber = currentStepNumber;
        _autoGenProgress.CurrentWeekStartDate = status.CurrentWeekStartDate;
        _autoGenProgress.CurrentRangeStartDate = status.CurrentRangeStartDate;
        _autoGenProgress.CurrentRangeEndDate = status.CurrentRangeEndDate;
        _autoGenProgress.LastUpdatedAt = now;
        _autoGenProgress.CurrentMessage = status.CurrentStage;
        _autoGenProgress.LastCompletedMessage = status.LastCompletedMessage;
        _autoGenProgress.Created = status.Created;
        _autoGenProgress.WarningCount = status.WarningCount;
        _autoGenProgress.GapCount = status.GapCount;
        _autoGenProgress.DeficitCount = status.DeficitCount;
        _autoGenProgress.Percent = Math.Clamp(status.Percent, 0, 100);
        _autoGenProgress.CancellationRequested = status.CancellationRequested || _autoGenCancelRequested;
        if (_autoGenProgress.CompletedSteps > 0
            && (_autoGenProgress.CompletedSteps > previousCompletedSteps
                || _autoGenProgress.AverageCompletedStepSeconds is null))
        {
            var completedDurationEnd = currentWeekChanged
                ? _autoGenProgress.CurrentStepStartedAt
                : now;
            var measuredSeconds = Math.Max(
                1,
                (completedDurationEnd - _autoGenProgress.StartedAt).TotalSeconds);
            _autoGenProgress.AverageCompletedStepSeconds =
                measuredSeconds / _autoGenProgress.CompletedSteps;
        }
        if (status.Report is not null)
        {
            _latestAutoGenReport = status.Report;
        }
    }
    private static bool IsAutoGenJobTerminal(AutoGenJobState state)
        => state is AutoGenJobState.Succeeded or AutoGenJobState.Failed or AutoGenJobState.Canceled;
    private static AutoGenProgressKind MapProgressKind(AutoGenJobKind kind)
        => kind switch
        {
            AutoGenJobKind.Preflight => AutoGenProgressKind.Preflight,
            AutoGenJobKind.Fill => AutoGenProgressKind.Fill,
            _ => AutoGenProgressKind.Generate
        };
    private static AutoGenJobKind BuildAutoGenJobKind(bool softFill, bool preflightOnly)
        => preflightOnly ? AutoGenJobKind.Preflight : softFill ? AutoGenJobKind.Fill : AutoGenJobKind.Generate;
    // Позначає початок обробки конкретного тижня.
    private async Task UpdateAutoGenProgressBeforeWeekAsync(
        int weekIndex,
        DateOnly weekStart,
        DateOnly rangeStartDate,
        DateOnly rangeEndDate)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        _autoGenProgress.CurrentStepNumber = weekIndex + 1;
        _autoGenProgress.CurrentWeekStartDate = weekStart;
        _autoGenProgress.CurrentRangeStartDate = rangeStartDate;
        _autoGenProgress.CurrentRangeEndDate = rangeEndDate;
        _autoGenProgress.CurrentStepStartedAt = DateTimeOffset.Now;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        _autoGenProgress.CurrentMessage = $"{GetAutoGenProgressVerb(_autoGenProgress.Kind)} {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy}";
        await InvokeAsync(StateHasChanged);
    }
    // Оновлює підсумок після відповіді сервера за тиждень.
    private async Task UpdateAutoGenProgressAfterWeekAsync(int weekIndex, DateOnly rangeStartDate, DateOnly rangeEndDate, AutoGenResult result)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        var previousCompletedSteps = _autoGenProgress.CompletedSteps;
        _autoGenProgress.CompletedSteps = Math.Max(_autoGenProgress.CompletedSteps, weekIndex + 1);
        _autoGenProgress.Created += result.Created;
        _autoGenProgress.WarningCount += result.Warnings.Count;
        _autoGenProgress.GapCount += result.GapDetails?.Count ?? 0;
        _autoGenProgress.DeficitCount += result.Preflight?.Sum(item => item.Count) ?? 0;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        _autoGenProgress.LastCompletedMessage = BuildAutoGenProgressCompletedMessage(rangeStartDate, rangeEndDate, result);
        _autoGenProgress.CurrentMessage = _autoGenProgress.CompletedSteps >= _autoGenProgress.TotalSteps
            ? "Завершення операції..."
            : "Підготовка наступного тижня...";
        if (_autoGenProgress.CompletedSteps > previousCompletedSteps)
        {
            var measuredSeconds = Math.Max(
                1,
                (_autoGenProgress.LastUpdatedAt - _autoGenProgress.StartedAt).TotalSeconds);
            _autoGenProgress.AverageCompletedStepSeconds =
                measuredSeconds / _autoGenProgress.CompletedSteps;
        }
        await InvokeAsync(StateHasChanged);
    }
    // Показує фінальний технічний крок після генерації.
    private async Task UpdateAutoGenProgressMessageAsync(string message)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        _autoGenProgress.CurrentMessage = message;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        await InvokeAsync(StateHasChanged);
    }
    // Позначає коротку операцію як завершену перед оновленням сторінки.
    private async Task CompleteOperationProgressAsync(string message)
    {
        if (_autoGenProgress is null)
        {
            return;
        }
        _autoGenProgress.CompletedSteps = _autoGenProgress.TotalSteps;
        _autoGenProgress.Percent = 100;
        _autoGenProgress.CurrentMessage = message;
        _autoGenProgress.LastCompletedMessage = message;
        _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
        await InvokeAsync(StateHasChanged);
    }
    private static string GetAutoGenProgressVerb(AutoGenProgressKind kind)
        => kind switch
        {
            AutoGenProgressKind.Preflight => "Перевіряємо ресурси",
            AutoGenProgressKind.Fill => "Дозаповнюємо відсутні пари",
            AutoGenProgressKind.ClearDrafts => "Очищаємо чернетки",
            AutoGenProgressKind.ClearSchedule => "Очищаємо розклад",
            _ => "Генеруємо чернетки"
        };
    private static bool IsClearProgressKind(AutoGenProgressKind kind)
        => kind is AutoGenProgressKind.ClearDrafts or AutoGenProgressKind.ClearSchedule;
    private static string GetAutoGenProgressStepLabel(AutoGenProgressState progress)
        => IsClearProgressKind(progress.Kind)
            ? "Очищення тижня"
            : $"Крок {progress.CurrentStepNumber} із {progress.TotalSteps}";
    private static string GetAutoGenProgressCompletedLabel(AutoGenProgressState progress)
        => IsClearProgressKind(progress.Kind)
            ? progress.CompletedSteps >= progress.TotalSteps
                ? "Очищення завершено"
                : "Очищення виконується"
            : $"Виконано тижнів: {progress.CompletedSteps}/{progress.TotalSteps}";
    private static string BuildAutoGenProgressCompletedMessage(DateOnly rangeStartDate, DateOnly rangeEndDate, AutoGenResult result)
    {
        var parts = new List<string>
        {
            $"Готово {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy}",
            $"створено {result.Created}"
        };
        var gapCount = result.GapDetails?.Count ?? 0;
        var deficitCount = result.Preflight?.Sum(item => item.Count) ?? 0;
        if (gapCount > 0)
        {
            parts.Add($"не вдалося поставити пар: {gapCount}");
        }
        if (deficitCount > 0)
        {
            parts.Add($"дефіцитів {deficitCount}");
        }
        return string.Join(", ", parts) + ".";
    }
    private static TimeSpan GetAutoGenElapsed(AutoGenProgressState progress)
        => progress.LastUpdatedAt - progress.StartedAt;
    private static int GetAutoGenProgressPercent(AutoGenProgressState progress)
        => progress.Percent >= 0
            ? Math.Clamp(progress.Percent, 0, 100)
            : (int)Math.Round(GetAutoGenProgressRatio(progress) * 100, MidpointRounding.AwayFromZero);
    private static double GetAutoGenProgressRatio(AutoGenProgressState progress)
    {
        if (progress.Percent >= 0)
        {
            return Math.Clamp(progress.Percent / 100d, 0d, 1d);
        }
        var totalSteps = Math.Max(1, progress.TotalSteps);
        var completedSteps = Math.Clamp(progress.CompletedSteps, 0, totalSteps);
        if (completedSteps >= totalSteps)
        {
            return 1.0;
        }
        var stepSeconds = Math.Max(1, GetAutoGenExpectedStepSeconds(progress.Kind));
        var stepElapsed = Math.Max(0, (progress.LastUpdatedAt - progress.CurrentStepStartedAt).TotalSeconds);
        var currentStepEstimate = Math.Clamp(stepElapsed / stepSeconds, 0.05, 0.88);
        return Math.Clamp((completedSteps + currentStepEstimate) / totalSteps, 0.01, 0.99);
    }
    private static double GetAutoGenExpectedStepSeconds(AutoGenProgressKind kind)
        => kind switch
        {
            AutoGenProgressKind.Preflight => 6,
            AutoGenProgressKind.Fill => 24,
            AutoGenProgressKind.ClearDrafts or AutoGenProgressKind.ClearSchedule => 8,
            _ => 28
        };
    private static string GetAutoGenRemainingLabel(AutoGenProgressState progress)
    {
        if (progress.CompletedSteps >= progress.TotalSteps)
        {
            return "0 с";
        }
        if (progress.CompletedSteps <= 0
            || progress.AverageCompletedStepSeconds is not double averageStepSeconds
            || averageStepSeconds <= 0)
        {
            return "рахуємо...";
        }

        var remainingSteps = Math.Max(0, progress.TotalSteps - progress.CompletedSteps);
        var currentStepIsRunning = progress.CurrentStepNumber > progress.CompletedSteps
                                   && remainingSteps > 0;
        var futureFullSteps = currentStepIsRunning
            ? Math.Max(0, remainingSteps - 1)
            : remainingSteps;
        var remainingSeconds = futureFullSteps * averageStepSeconds;
        if (currentStepIsRunning)
        {
            var currentStepElapsedSeconds = Math.Max(
                0,
                (progress.LastUpdatedAt - progress.CurrentStepStartedAt).TotalSeconds);
            // Якщо поточний крок уже довший за середній, не показуємо хибний нуль:
            // оцінка адаптується до фактичної тривалості цього кроку.
            var estimatedCurrentStepSeconds = Math.Max(
                averageStepSeconds,
                currentStepElapsedSeconds * 1.15);
            remainingSeconds += Math.Max(
                1,
                estimatedCurrentStepSeconds - currentStepElapsedSeconds);
        }
        var remaining = TimeSpan.FromSeconds(Math.Max(0, remainingSeconds));
        return $"приблизно {FormatDuration(remaining)}";
    }
    private static string FormatDuration(TimeSpan duration)
    {
        if (duration < TimeSpan.Zero)
        {
            duration = TimeSpan.Zero;
        }
        var totalSeconds = Math.Max(0, (int)Math.Round(duration.TotalSeconds, MidpointRounding.AwayFromZero));
        if (totalSeconds < 60)
        {
            return $"{Math.Max(1, totalSeconds)} с";
        }
        var totalMinutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        if (totalMinutes < 60)
        {
            return seconds > 0 ? $"{totalMinutes} хв {seconds} с" : $"{totalMinutes} хв";
        }
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        return minutes > 0 ? $"{hours} год {minutes} хв" : $"{hours} год";
    }
    // Встановлює повідомлення успіху та опційні попередження.
    private async Task SetOkMessageAsync(
        string message,
        IEnumerable<string>? warnings = null,
        IEnumerable<AutoGenGapDetail>? gapDetails = null,
        IEnumerable<AutoGenGapSummaryItem>? gapSummary = null,
        IEnumerable<AutoGenPreflightItem>? preflight = null,
        AutoGenRunReport? report = null,
        IEnumerable<AutoGenWarningDetail>? warningDetails = null,
        AutoGenPlanSummaryDto? plan = null,
        IEnumerable<AutoGenPlanChangeDto>? planChanges = null,
        bool persist = true,
        string? persistenceWeekKey = null,
        int? persistenceCourseId = null)
    {
        ok = message;
        _latestGapDetails = gapDetails?
            .Select(AutoGenGapReasonClassifier.EnsureStructured)
            .ToList() ?? new List<AutoGenGapDetail>();
        _latestGapSummary = _latestGapDetails.Count > 0
            ? BuildGapReasonSummary(_latestGapDetails)
            : gapSummary?.ToList() ?? new List<AutoGenGapSummaryItem>();
        _latestPreflight = MergePreflight(preflight);
        _latestAutoGenReport = report;
        _latestAutoGenPlan = plan;
        _latestAutoGenPlanChanges = planChanges?.ToList() ?? new();
        if (plan?.CanRollback == true)
        {
            _latestRollbackableAutoGenPlan = plan;
        }
        else if (plan is not null
                 && string.Equals(_latestRollbackableAutoGenPlan?.PlanId, plan.PlanId, StringComparison.Ordinal)
                 && plan.State is AutoGenPlanState.RolledBack or AutoGenPlanState.Expired)
        {
            _latestRollbackableAutoGenPlan = null;
        }
        _latestWarningDetails = AdminScheduleAutoGenState.BuildTechnicalWarningDetails(
            warnings,
            warningDetails,
            _latestGapDetails);
        okWarnings = _latestWarningDetails
            .Select(detail => detail.Message)
            .ToList();
        // Технічні повідомлення завжди починаються у згорнутому стані.
        okWarningsExpanded = false;
        if (persist)
        {
            await PersistAutoGenStatusAsync(persistenceWeekKey, persistenceCourseId);
        }
    }
    // Перемикає видимість попереджень після успіху.
    private void ToggleOkWarnings()
    {
        okWarningsExpanded = !okWarningsExpanded;
    }
    // Розбирає попередження у структуру для відображення.
    private (string Message, string? Reason) ParseWarning(string warning)
    {
        const string marker = "Причина:";
        var idx = warning.IndexOf(marker, StringComparison.Ordinal);
        if (idx < 0)
        {
            return (warning, null);
        }
        var message = warning[..idx].Trim();
        var reason = warning[(idx + marker.Length)..].Trim();
        return (string.IsNullOrWhiteSpace(message) ? warning : message, string.IsNullOrWhiteSpace(reason) ? null : reason);
    }
    // Об'єднує структуровані попередження сервера з нормалізованими текстовими повідомленнями.
    private static List<AutoGenWarningDetail> MergeWarningDetails(
        IEnumerable<AutoGenWarningDetail>? warningDetails,
        IEnumerable<string> visibleWarnings)
    {
        var result = new List<AutoGenWarningDetail>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        if (warningDetails is not null)
        {
            foreach (var detail in warningDetails)
            {
                if (string.IsNullOrWhiteSpace(detail.Message))
                {
                    continue;
                }
                var normalized = detail with { Message = detail.Message.Trim() };
                if (seen.Add(normalized.Message))
                {
                    result.Add(normalized);
                }
            }
        }
        foreach (var detail in AutoGenWarningClassifier.ClassifyMany(visibleWarnings))
        {
            if (seen.Add(detail.Message))
            {
                result.Add(detail);
            }
        }
        return result;
    }
    private static IEnumerable<AutoGenWarningDetail> OrderWarningDetails(IEnumerable<AutoGenWarningDetail> warnings)
        => warnings
            .OrderBy(detail => GetWarningSeverityOrder(detail.Severity))
            .ThenBy(detail => detail.Category, StringComparer.Ordinal)
            .ThenBy(detail => detail.Code, StringComparer.Ordinal)
            .ThenBy(detail => detail.Message, StringComparer.Ordinal);
    private static int GetWarningSeverityOrder(string severity)
        => severity.ToLowerInvariant() switch
        {
            AutoGenWarningSeverities.Error => 0,
            AutoGenWarningSeverities.Warning => 1,
            _ => 2
        };
    private static string GetWarningSeverityLabel(string severity)
        => severity.ToLowerInvariant() switch
        {
            AutoGenWarningSeverities.Error => "Помилка",
            AutoGenWarningSeverities.Info => "Інформація",
            _ => "Попередження"
        };
    private static string GetWarningSeverityBadgeClass(string severity)
        => severity.ToLowerInvariant() switch
        {
            AutoGenWarningSeverities.Error => "autogen-warning-badge autogen-warning-badge--error",
            AutoGenWarningSeverities.Info => "autogen-warning-badge autogen-warning-badge--info",
            _ => "autogen-warning-badge"
        };
    private static List<string> BuildAutoGenActionItems(
        IReadOnlyList<AutoGenGapSummaryItem> gapSummary,
        IReadOnlyList<AutoGenPreflightItem> preflight,
        IReadOnlyList<AutoGenGapDetail> gapDetails)
    {
        var actions = new List<string>();
        var seen = new HashSet<string>(StringComparer.Ordinal);

        void Add(string text)
        {
            if (!string.IsNullOrWhiteSpace(text) && seen.Add(text))
            {
                actions.Add(text);
            }
        }

        foreach (var item in preflight.OrderByDescending(item => item.Count).Take(4))
        {
            Add(BuildPreflightActionText(item));
        }

        foreach (var item in gapSummary.OrderByDescending(item => item.Count).Take(4))
        {
            Add(item.Code switch
            {
                AutoGenGapReasonCodes.Teacher => $"{item.Count} пар не вдалося поставити через викладачів. Перевірте, чи прив'язані викладачі до цих модулів і чи вільні вони в потрібний час.",
                AutoGenGapReasonCodes.Room => $"{item.Count} пар не вдалося поставити через аудиторії. Перевірте вільні аудиторії потрібної місткості та дозволені корпуси.",
                AutoGenGapReasonCodes.Travel => $"{item.Count} пар не вдалося поставити через зміну аудиторії або перехід між корпусами. Залиште сусідні пари в тій самій аудиторії або збільшіть перерву.",
                AutoGenGapReasonCodes.TopicOrder => $"Для {item.Count} пар не вистачає доступних годин тем. Додайте години тем потрібного типу або зменште план модуля.",
                AutoGenGapReasonCodes.ModuleBlock => $"{item.Count} пар не вдалося поставити через правило суцільного модуля. Тримайте пари одного модуля поруч або перенесіть зайву пару цього дня.",
                AutoGenGapReasonCodes.Limit => $"{item.Count} пар зупинили денні обмеження. Додайте навчальний день або час чи зменште кількість пар у вибраному діапазоні.",
                AutoGenGapReasonCodes.SearchLimit => $"{item.Count} пар лишилися після досягнення безпечної межі пошуку. Спочатку виправте найвужчі обмеження ресурсів, а потім повторіть генерацію.",
                AutoGenGapReasonCodes.SharedFlow => $"{item.Count} пар пов'язані зі спільним потоком. Для груп потоку вирівняйте модуль, тему, викладача й аудиторію.",
                _ => $"{item.Count} пар треба перевірити вручну. Почніть з групи, модуля і часу в таблиці нижче."
            });
        }

        var groupHotspots = gapDetails
            .GroupBy(gap => gap.GroupName, StringComparer.Ordinal)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key, StringComparer.Ordinal)
            .Take(3)
            .Select(group => $"{group.Key} ({group.Count()})")
            .ToList();
        if (groupHotspots.Count > 0)
        {
            Add($"Почніть з груп: {string.Join(", ", groupHotspots)}.");
        }

        return actions.Take(6).ToList();
    }
    private static string BuildPreflightActionText(AutoGenPreflightItem item)
    {
        var example = item.Examples.FirstOrDefault();
        var exampleSuffix = string.IsNullOrWhiteSpace(example) ? string.Empty : $" Приклад: {example}";
        return item.Code switch
        {
            "calendar-capacity" => $"{item.Count} пар не поміщаються у вибрані дати. У розділі календаря зробіть додатковий день робочим для потрібного курсу або групи. Також можна обрати довший період чи додати час до сітки занять.{exampleSuffix}",
            "slot" => $"{item.Count} пар бракує у сітці груп. Додайте навчальний час або звільніть уже зайняті пари цієї групи.{exampleSuffix}",
            "teacher" => $"{item.Count} пар не вдалося поставити через викладачів. Перевірте прив'язку викладачів до модуля, їх робочі години та зайнятість.{exampleSuffix}",
            "room" => $"{item.Count} пар не вдалося поставити через аудиторії. Додайте або звільніть аудиторії потрібної місткості.{exampleSuffix}",
            "building" => $"{item.Count} пар заблокували налаштування корпусів. Розширте дозволені корпуси або пріоритетні аудиторії групи.{exampleSuffix}",
            "travel" => $"{item.Count} пар не вдалося поставити через переходи. Підберіть аудиторії ближче до сусідніх занять або збільшіть перерву.{exampleSuffix}",
            "topic-order" => $"Для {item.Count} пар не вистачає доступних годин тем. Додайте години тем потрібного типу або зменште план модуля.{exampleSuffix}",
            _ => $"{item.Title}: {item.Count}. {item.Recommendation}{exampleSuffix}"
        };
    }
    private static AutoGenOutcomeSummary? BuildAutoGenOutcomeSummary(
        string? message,
        AutoGenRunReport? report,
        AutoGenPlanSummaryDto? plan,
        IReadOnlyList<AutoGenGapSummaryItem> gapSummary,
        IReadOnlyList<AutoGenPreflightItem> preflight,
        IReadOnlyList<AutoGenGapDetail> gapDetails,
        int warningsTotal,
        IReadOnlyList<string> actionItems)
    {
        var gapCount = report?.GapCount ?? gapDetails.Count;
        var deficitCount = report?.DeficitCount ?? preflight.Sum(item => item.Count);
        var hasOutcomeData = report is not null
                             || plan is not null
                             || gapCount > 0
                             || deficitCount > 0
                             || warningsTotal > 0
                             || actionItems.Count > 0;
        if (!hasOutcomeData)
        {
            return null;
        }

        var hasIssues = gapCount > 0 || deficitCount > 0 || warningsTotal > 0 || actionItems.Count > 0;
        var headline = BuildAutoGenOutcomeHeadline(report, plan, gapCount, deficitCount, warningsTotal, gapSummary);
        var detail = report is not null
            ? BuildAutoGenOutcomeDetail(report, plan)
            : string.IsNullOrWhiteSpace(message) ? "Операцію виконано." : message.Trim();
        var metrics = BuildAutoGenOutcomeMetrics(report, plan, gapCount, deficitCount, warningsTotal);

        return new AutoGenOutcomeSummary(
            hasIssues ? "autogen-outcome--needs-review" : "autogen-outcome--clean",
            hasIssues ? "Потрібна перевірка" : "Готово",
            headline,
            detail,
            metrics,
            BuildAutoGenHotspotText(report, gapSummary, gapDetails));
    }

    private static string BuildAutoGenOutcomeHeadline(
        AutoGenRunReport? report,
        AutoGenPlanSummaryDto? plan,
        int gapCount,
        int deficitCount,
        int warningsTotal,
        IReadOnlyList<AutoGenGapSummaryItem> gapSummary)
    {
        var topicHoursCount = gapSummary
            .Where(item => string.Equals(item.Code, AutoGenGapReasonCodes.TopicOrder, StringComparison.Ordinal))
            .Sum(item => item.Count);
        if (report?.Created == 0 && gapCount > 0 && topicHoursCount > 0)
        {
            return $"{gapCount} пар не додано: для {topicHoursCount} пар не вистачає доступних годин тем";
        }
        if (gapCount > 0 && deficitCount > 0)
        {
            return $"За останню спробу не вдалося поставити {gapCount} пар; перевірка знайшла {deficitCount} проблем";
        }
        if (gapCount > 0)
        {
            return $"За останню спробу не вдалося поставити {gapCount} пар";
        }
        if (deficitCount > 0)
        {
            return $"Перевірка знайшла {deficitCount} проблем у налаштуваннях";
        }
        if (warningsTotal > 0)
        {
            return $"Є {warningsTotal} попереджень після автогенерації";
        }
        if (plan is not null)
        {
            return "План готовий до перегляду";
        }
        if (report is not null && report.Created > 0)
        {
            return $"Створено {report.Created} чернеток, усі запитані пари поставлено";
        }
        return "Усі запитані пари вдалося поставити";
    }

    private static string BuildAutoGenOutcomeDetail(AutoGenRunReport report, AutoGenPlanSummaryDto? plan)
    {
        var range = BuildAutoGenOutcomeRangeText(report.RangeStartDate, report.RangeEndDate);
        var weeksText = report.TotalWeeks == 1 ? "1 тиждень" : $"{report.TotalWeeks} тижнів";
        if (plan is not null)
        {
            return $"Діапазон {range}: {weeksText}. Усі зміни та проблемні місця показано нижче.";
        }
        var skippedText = report.Skipped > 0
            ? $", пропущено під час генерації: {report.Skipped}"
            : string.Empty;
        return $"Діапазон {range}: {weeksText}, створено {report.Created}{skippedText}.";
    }

    private static string BuildAutoGenOutcomeRangeText(DateOnly fromDate, DateOnly toDate)
        => fromDate == toDate
            ? fromDate.ToString("dd.MM.yyyy")
            : $"{fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy}";

    private static List<AutoGenOutcomeMetric> BuildAutoGenOutcomeMetrics(
        AutoGenRunReport? report,
        AutoGenPlanSummaryDto? plan,
        int gapCount,
        int deficitCount,
        int warningsTotal)
    {
        var metrics = new List<AutoGenOutcomeMetric>();
        if (plan is not null)
        {
            metrics.Add(new AutoGenOutcomeMetric("Додати", plan.AddCount.ToString()));
            if (plan.UpdateCount > 0)
            {
                metrics.Add(new AutoGenOutcomeMetric("Змінити або перемістити", plan.UpdateCount.ToString()));
            }
            if (plan.DeleteCount > 0)
            {
                metrics.Add(new AutoGenOutcomeMetric("Видалити", plan.DeleteCount.ToString()));
            }
            if (report is not null)
            {
                if (report.Skipped > 0)
                {
                    metrics.Add(new AutoGenOutcomeMetric("Пропущено під час генерації", report.Skipped.ToString(), "деталі нижче", true));
                }
                metrics.Add(new AutoGenOutcomeMetric("Тижнів", report.TotalWeeks.ToString()));
            }
        }
        else if (report is not null)
        {
            metrics.Add(new AutoGenOutcomeMetric("Створено", report.Created.ToString()));
            if (report.Skipped > 0)
            {
                metrics.Add(new AutoGenOutcomeMetric("Пропущено під час генерації", report.Skipped.ToString(), "деталі нижче", true));
            }
            metrics.Add(new AutoGenOutcomeMetric("Тижнів", report.TotalWeeks.ToString()));
        }
        metrics.Add(new AutoGenOutcomeMetric("Не поставлено", gapCount.ToString(), "за останню спробу", gapCount > 0));
        if (deficitCount > 0)
        {
            metrics.Add(new AutoGenOutcomeMetric(
                "Проблеми в налаштуваннях",
                deficitCount.ToString(),
                "одна пара може мати кілька причин",
                true));
        }
        if (warningsTotal > 0)
        {
            metrics.Add(new AutoGenOutcomeMetric("Попередження", warningsTotal.ToString(), "деталі нижче", true));
        }
        return metrics;
    }

    private static string? BuildAutoGenHotspotText(
        AutoGenRunReport? report,
        IReadOnlyList<AutoGenGapSummaryItem> gapSummary,
        IReadOnlyList<AutoGenGapDetail> gapDetails)
    {
        var parts = new List<string>();
        var worstGroup = report?.WorstGroups.FirstOrDefault();
        if (worstGroup is not null)
        {
            parts.Add($"група {worstGroup.GroupName} ({worstGroup.GapCount})");
        }
        else
        {
            var group = gapDetails
                .GroupBy(gap => gap.GroupName, StringComparer.Ordinal)
                .OrderByDescending(group => group.Count())
                .ThenBy(group => group.Key, StringComparer.Ordinal)
                .FirstOrDefault();
            if (group is not null)
            {
                parts.Add($"група {group.Key} ({group.Count()})");
            }
        }

        var worstModule = report?.WorstModules.FirstOrDefault();
        if (worstModule is not null)
        {
            parts.Add($"модуль {CompactAutoGenText(worstModule.ModuleName, 70)} ({worstModule.GapCount})");
        }
        var reason = gapSummary
            .OrderByDescending(item => item.Count)
            .ThenBy(item => item.Title, StringComparer.Ordinal)
            .FirstOrDefault();
        if (reason is not null)
        {
            parts.Add($"причина: {reason.Title.ToLowerInvariant()} ({reason.Count})");
        }

        return parts.Count == 0
            ? null
            : $"Найбільше уваги: {string.Join("; ", parts)}.";
    }
    private static List<AutoGenGapSummaryItem> BuildGapReasonSummary(IEnumerable<AutoGenGapDetail>? gapDetails)
    {
        if (gapDetails is null)
        {
            return new();
        }
        return gapDetails
            .GroupBy(AutoGenGapReasonClassifier.Classify)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key.Title, StringComparer.Ordinal)
            .Select(group => new AutoGenGapSummaryItem(
                group.Key.Code,
                group.Key.Title,
                group.Count(),
                group.Take(5).Select(BuildGapSummaryExample).ToList()))
            .ToList();
    }
    private static List<AutoGenPreflightItem> MergePreflight(IEnumerable<AutoGenPreflightItem>? preflight)
    {
        if (preflight is null)
        {
            return new();
        }

        return preflight
            .GroupBy(item => item.Code, StringComparer.Ordinal)
            .Select(group =>
            {
                var first = group.First();
                return new AutoGenPreflightItem(
                    first.Code,
                    first.Title,
                    group.Sum(item => item.Count),
                    first.Recommendation,
                    group.SelectMany(item => item.Examples)
                        .Where(example => !string.IsNullOrWhiteSpace(example))
                        .Distinct(StringComparer.Ordinal)
                        .Take(5)
                        .ToList());
            })
            .OrderByDescending(item => item.Count)
            .ThenBy(item => item.Title, StringComparer.Ordinal)
            .ToList();
    }
    private static string BuildGapSummaryExample(AutoGenGapDetail gap)
    {
        var reason = string.IsNullOrWhiteSpace(gap.Reason) ? "Причину не визначено." : gap.Reason.Trim();
        if (reason.Length > 220)
        {
            reason = reason[..220] + "...";
        }
        return $"{gap.Date:yyyy-MM-dd} {gap.SlotLabel}, {gap.GroupName}: {reason}";
    }
    private static string BuildGapModuleLabel(AutoGenGapDetail gap)
        => !string.IsNullOrWhiteSpace(gap.ModuleName)
            ? CompactAutoGenText(gap.ModuleName!, 90)
            : gap.ModuleId is int moduleId ? $"#{moduleId}" : "—";

    private static (string MainReason, string Action) BuildGapDiagnosis(AutoGenGapDetail gap)
    {
        var classified = AutoGenGapReasonClassifier.Classify(gap);
        var action = classified.Code switch
        {
            AutoGenGapReasonCodes.Teacher => "Додайте викладача до цього модуля або відкрийте його робочий час у цей слот.",
            AutoGenGapReasonCodes.Room => "Звільніть аудиторію потрібної місткості або додайте її в дозволені для модуля/групи.",
            AutoGenGapReasonCodes.Travel => "Поставте сусіднє заняття в ту саму аудиторію або збільшіть перерву для зміни аудиторії.",
            AutoGenGapReasonCodes.TopicOrder => "Додайте до модуля достатньо годин тем потрібного типу або зменште його квоту в цьому діапазоні.",
            AutoGenGapReasonCodes.ModuleBlock => "Залиште поруч кілька слотів під цей модуль або перенесіть зайву пару з дня.",
            AutoGenGapReasonCodes.Limit => "Додайте слоти/дні для групи або зменште кількість годин у цьому діапазоні.",
            AutoGenGapReasonCodes.SearchLimit => "Перевірте дефіцитні ресурси й повторіть генерацію після їх виправлення; межу пошуку не слід просто збільшувати без аналізу.",
            AutoGenGapReasonCodes.SharedFlow => "Для груп потоку зробіть однакові тему, викладача й аудиторію.",
            _ => "Почніть з модуля й групи в цій строкі: перевірте викладача, аудиторію та зайнятість слоту."
        };
        var target = BuildGapModuleLabel(gap);
        var reason = classified.Code switch
        {
            AutoGenGapReasonCodes.Teacher => $"Для {gap.GroupName} немає вільного викладача на {gap.SlotLabel}.",
            AutoGenGapReasonCodes.Room => $"Для {gap.GroupName} немає вільної аудиторії на {gap.SlotLabel}.",
            AutoGenGapReasonCodes.Travel => $"Для {gap.GroupName} не вистачає часу змінити аудиторію біля {gap.SlotLabel}.",
            AutoGenGapReasonCodes.TopicOrder => $"Для {gap.GroupName} не вистачає доступних годин тем модуля для цього слота.",
            AutoGenGapReasonCodes.ModuleBlock => $"Модуль {target} розривається в межах дня.",
            AutoGenGapReasonCodes.Limit => $"Для {gap.GroupName} спрацював ліміт дня або слоту.",
            AutoGenGapReasonCodes.SearchLimit => $"Для {gap.GroupName} пошук безпечного варіанта досяг установленої межі на {gap.SlotLabel}.",
            AutoGenGapReasonCodes.SharedFlow => $"Спільний потік для {gap.GroupName} не зібрав однакові ресурси.",
            _ => $"Не підібрано безпечний варіант для {gap.GroupName}, {gap.SlotLabel}."
        };
        return (reason, action);
    }

    private static string CompactAutoGenText(string text, int maxLength)
    {
        var normalized = string.IsNullOrWhiteSpace(text) ? "—" : text.Trim();
        return normalized.Length <= maxLength ? normalized : normalized[..maxLength] + "...";
    }

    private static bool IsSlotGapWarning(string warning)
        => warning.Contains("не заповнила слот", StringComparison.OrdinalIgnoreCase);
    // Рахує випадки, коли слот не заповнено через правило суцільного блоку модуля.
    private int CountContiguousModuleBlockWarnings()
    {
        var gapMatches = _latestGapDetails.Count(g =>
            AutoGenGapReasonClassifier.Classify(g).Code == AutoGenGapReasonCodes.ModuleBlock);
        if (gapMatches > 0)
        {
            return gapMatches;
        }
        return okWarnings.Count(ContainsContiguousModuleBlockReason);
    }
    // Перевіряє, чи текст містить причину про заборону розриву модуля в межах дня.
    private static bool ContainsContiguousModuleBlockReason(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }
        return text.Contains(ContiguousModuleBlockReasonMarker, StringComparison.OrdinalIgnoreCase);
    }
    // Зберігає повідомлення про автогенерацію у сховищі.
    private async Task PersistAutoGenStatusAsync(
        string? weekKey = null,
        int? courseId = null)
    {
        var targetWeekKey = string.IsNullOrWhiteSpace(weekKey)
            ? CurrentWeekKey
            : weekKey.Trim();
        var entry = BuildPersistedAutoGenStatus(courseId);
        if (entry is null)
        {
            await RemovePersistedAutoGenStatusAsync(targetWeekKey);
            return;
        }
        var statuses = await LoadPersistedAutoGenStatusesAsync();
        statuses[targetWeekKey] = entry;
        await SavePersistedAutoGenStatusesAsync(statuses);
    }
    // Видаляє збережений статус автогенерації.
    private async Task RemovePersistedAutoGenStatusAsync(string? weekKey = null)
    {
        var targetWeekKey = string.IsNullOrWhiteSpace(weekKey)
            ? CurrentWeekKey
            : weekKey.Trim();
        var statuses = await LoadPersistedAutoGenStatusesAsync();
        if (!statuses.Remove(targetWeekKey))
        {
            return;
        }
        await SavePersistedAutoGenStatusesAsync(statuses);
    }
    // Завантажує всі збережені статуси автогенерації.
    private async Task<Dictionary<string, PersistedAutoGenStatus>> LoadPersistedAutoGenStatusesAsync()
    {
        try
        {
            var stored = await ReadStorageAsync(AutoGenStatusStorageKey, useLocal: false);
            if (string.IsNullOrWhiteSpace(stored))
            {
                stored = await ReadStorageAsync(AutoGenStatusLocalStorageKey, useLocal: true);
            }
            if (string.IsNullOrWhiteSpace(stored))
                return new();
            var statuses = JsonSerializer.Deserialize<Dictionary<string, PersistedAutoGenStatus>>(stored, AutoGenStatusJsonOptions);
            return statuses ?? new();
        }
        catch (JSException)
        {
            await ClearPersistedAutoGenStorageAsync();
            return new();
        }
        catch (JsonException)
        {
            await ClearPersistedAutoGenStorageAsync();
            return new();
        }
    }
    // Зберігає статуси автогенерації у storage.
    private async Task SavePersistedAutoGenStatusesAsync(Dictionary<string, PersistedAutoGenStatus> statuses)
    {
        if (statuses.Count == 0)
        {
            await ClearPersistedAutoGenStorageAsync();
            return;
        }
        var json = JsonSerializer.Serialize(statuses, AutoGenStatusJsonOptions);
        try
        {
            await SetStorageAsync(AutoGenStatusStorageKey, json, useLocal: false);
            await SetStorageAsync(AutoGenStatusLocalStorageKey, json, useLocal: true);
        }
        catch (JSException)
        {
        }
    }
    // Очищає storage для статусів автогенерації.
    private async Task ClearPersistedAutoGenStorageAsync()
    {
        try
        {
            await RemoveStorageAsync(AutoGenStatusStorageKey, useLocal: false);
            await RemoveStorageAsync(AutoGenStatusLocalStorageKey, useLocal: true);
        }
        catch (JSException)
        {
        }
    }
    // Читає значення зі сховища браузера.
    private ValueTask<string?> ReadStorageAsync(string key, bool useLocal)
        => JS.InvokeAsync<string?>(useLocal ? "localStorage.getItem" : "sessionStorage.getItem", key);
    // Записує значення у сховище браузера.
    private ValueTask SetStorageAsync(string key, string value, bool useLocal)
        => JS.InvokeVoidAsync(useLocal ? "localStorage.setItem" : "sessionStorage.setItem", key, value);
    // Видаляє ключ зі сховища браузера.
    private ValueTask RemoveStorageAsync(string key, bool useLocal)
        => JS.InvokeVoidAsync(useLocal ? "localStorage.removeItem" : "sessionStorage.removeItem", key);
    // Зберігає активну задачу разом із курсом, щоб результат не залежав від іншого останнього вводу.
    private async Task PersistActiveAutoGenJobIdAsync(
        string jobId,
        int? courseId = null,
        DateOnly? rangeStartDate = null)
    {
        if (string.IsNullOrWhiteSpace(jobId))
        {
            return;
        }
        try
        {
            var normalizedJobId = jobId.Trim();
            await SetStorageAsync(ActiveAutoGenJobStorageKey, normalizedJobId, useLocal: true);
            if (courseId is int persistedCourseId && rangeStartDate is DateOnly persistedRangeStartDate)
            {
                var context = new ActiveAutoGenJobContext(
                    normalizedJobId,
                    persistedCourseId,
                    persistedRangeStartDate);
                await SetStorageAsync(
                    ActiveAutoGenJobContextStorageKey,
                    JsonSerializer.Serialize(context, AutoGenStatusJsonOptions),
                    useLocal: true);
            }
        }
        catch (JSException)
        {
        }
    }
    // Читає з localStorage лише валідний ідентифікатор задачі.
    private async Task<string?> ReadActiveAutoGenJobIdAsync()
    {
        try
        {
            var value = (await ReadStorageAsync(ActiveAutoGenJobStorageKey, useLocal: true))?.Trim();
            return Guid.TryParseExact(value, "N", out _) ? value : null;
        }
        catch (JSException)
        {
            return null;
        }
    }
    // Читає контекст лише тієї задачі, ідентифікатор якої щойно підтверджено.
    private async Task<ActiveAutoGenJobContext?> ReadActiveAutoGenJobContextAsync(string expectedJobId)
    {
        try
        {
            var stored = await ReadStorageAsync(ActiveAutoGenJobContextStorageKey, useLocal: true);
            if (string.IsNullOrWhiteSpace(stored))
            {
                return null;
            }
            var context = JsonSerializer.Deserialize<ActiveAutoGenJobContext>(
                stored,
                AutoGenStatusJsonOptions);
            return context is not null
                   && string.Equals(context.JobId, expectedJobId, StringComparison.Ordinal)
                ? context
                : null;
        }
        catch (JSException)
        {
            return null;
        }
        catch (JsonException)
        {
            return null;
        }
    }
    // Видаляє активний ідентифікатор, не зачіпаючи новішу задачу з іншої вкладки.
    private async Task RemoveActiveAutoGenJobIdAsync(string? expectedJobId = null)
    {
        if (string.IsNullOrWhiteSpace(expectedJobId))
        {
            return;
        }
        try
        {
            var current = (await ReadStorageAsync(ActiveAutoGenJobStorageKey, useLocal: true))?.Trim();
            if (string.Equals(current, expectedJobId, StringComparison.Ordinal))
            {
                await RemoveStorageAsync(ActiveAutoGenJobStorageKey, useLocal: true);
                var context = await ReadActiveAutoGenJobContextAsync(expectedJobId);
                if (context is not null)
                {
                    await RemoveStorageAsync(ActiveAutoGenJobContextStorageKey, useLocal: true);
                }
            }
        }
        catch (JSException)
        {
        }
    }
    // Створює новий ключ повторного запиту лише після перевірки, що збережена задача не виконується.
    private async Task<string> CreateClientJobIdForNewOperationAsync()
    {
        var activeJobId = await ReadActiveAutoGenJobIdAsync();
        if (string.IsNullOrWhiteSpace(activeJobId))
        {
            return Guid.NewGuid().ToString("N");
        }
        try
        {
            var activeStatus = await Drafts.GetAutogenJob(activeJobId);
            if (!IsAutoGenJobTerminal(activeStatus.State))
            {
                throw new InvalidOperationException(
                    $"Задача «{activeStatus.Title}» ще виконується. Оновіть сторінку, щоб відновити її прогрес, або скасуйте її перед новим запуском.");
            }
            await RemoveActiveAutoGenJobIdAsync(activeJobId);
            return Guid.NewGuid().ToString("N");
        }
        catch (ApiErrorException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            await RemoveActiveAutoGenJobIdAsync(activeJobId);
            return Guid.NewGuid().ToString("N");
        }
    }
    // Відновлює прогрес і можливість скасування для задачі, що пережила перезавантаження сторінки.
    private async Task RestoreActiveAutoGenJobAsync()
    {
        var requestVersion = _activeAutoGenRestoreGuard.Begin();
        var jobId = await ReadActiveAutoGenJobIdAsync();
        if (!_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(jobId))
        {
            return;
        }
        var activeJobContext = await ReadActiveAutoGenJobContextAsync(jobId);
        if (!_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
        {
            return;
        }

        _autoGenActionStarting = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            AutoGenJobStatus status;
            try
            {
                status = await Drafts.GetAutogenJob(jobId);
            }
            catch (ApiErrorException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
            {
                if (_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    await RemoveActiveAutoGenJobIdAsync(jobId);
                }
                return;
            }
            catch (ApiErrorException ex)
            {
                if (_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    await HandleApiError(ex);
                }
                return;
            }
            catch (HttpRequestException)
            {
                if (_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    error = "Не вдалося відновити стан автогенерації через тимчасову помилку мережі. Повторіть оновлення сторінки.";
                }
                return;
            }
            if (!_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
            {
                return;
            }

            ApplyAutoGenJobStatus(status);
            StartAutoGenProgressTimer();
            await InvokeAsync(StateHasChanged);
            var terminal = IsAutoGenJobTerminal(status.State);
            var resultHandled = false;
            try
            {
                if (!terminal)
                {
                    status = await WaitForAutoGenJobTerminalAsync(status);
                    terminal = true;
                }
                if (!_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    return;
                }
                resultHandled = await ShowRestoredAutoGenResultAsync(
                    status,
                    activeJobContext);
            }
            catch (OperationCanceledException) when (_componentLifetimeCts.IsCancellationRequested)
            {
            }
            catch (ApiErrorException ex)
            {
                if (_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    await HandleApiError(ex);
                }
            }
            catch (HttpRequestException)
            {
                if (_activeAutoGenRestoreGuard.IsCurrent(requestVersion))
                {
                    error = "Зв'язок із задачею автогенерації втрачено. Її ідентифікатор збережено для наступного відновлення.";
                }
            }
            finally
            {
                if (terminal)
                {
                    if (resultHandled)
                    {
                        await RemoveActiveAutoGenJobIdAsync(status.JobId);
                    }
                    StopAutoGenProgress();
                }
            }
        }
        finally
        {
            _autoGenActionStarting = false;
        }
    }
    // Показує підсумок відновленої задачі та оновлює поточну таблицю після змін у чернетках.
    private async Task<bool> ShowRestoredAutoGenResultAsync(
        AutoGenJobStatus status,
        ActiveAutoGenJobContext? activeJobContext)
    {
        var result = BuildAutoGenJobResult(status);
        var restoredPlan = status.Plan;
        IReadOnlyList<AutoGenPlanChangeDto>? restoredPlanChanges = null;
        var persistenceCourseId = activeJobContext?.CourseId;
        if (restoredPlan is not null)
        {
            try
            {
                var planDetails = await Drafts.GetAutogenPlan(restoredPlan.PlanId);
                restoredPlan = planDetails.Summary;
                restoredPlanChanges = planDetails.Changes;
                persistenceCourseId ??= ResolveCourseIdFromPlanChanges(planDetails.Changes);
            }
            catch (ApiErrorException ex) when (ex.StatusCode is HttpStatusCode.NotFound or HttpStatusCode.Conflict)
            {
                restoredPlan = null;
            }
        }
        if (restoredPlan?.CanApply == true && persistenceCourseId is null)
        {
            error = "Готовий план збережено на сервері, але не вдалося визначити його курс. Ідентифікатор задачі залишено для повторного відновлення.";
            return false;
        }
        var persistenceWeekKey = AdminScheduleAutoGenState.BuildWeekKey(status.RangeStartDate);
        var showInCurrentContext = string.Equals(
                                       CurrentWeekKey,
                                       persistenceWeekKey,
                                       StringComparison.Ordinal)
                                   && AdminScheduleAutoGenState.CanRestoreStatusForCourse(
                                       persistenceCourseId,
                                       _selectedCourseId);
        var summary = restoredPlan?.State == AutoGenPlanState.Ready
            ? $"Відновлено готовий план «{status.Title}»: додати {restoredPlan.AddCount}, змінити {restoredPlan.UpdateCount}, видалити {restoredPlan.DeleteCount}. Чернетки ще не змінено."
            : status.State switch
        {
            AutoGenJobState.Succeeded => $"Відновлену задачу «{status.Title}» завершено: створено {result.Created}, пропущено {result.Skipped}.",
            AutoGenJobState.Canceled => $"Відновлену задачу «{status.Title}» скасовано: створено {result.Created}.",
            _ => $"Відновлена задача «{status.Title}» завершилася з помилкою: створено {result.Created}."
        };
        await SetOkMessageAsync(
            summary,
            result.Warnings,
            result.GapDetails,
            result.GapSummary,
            result.Preflight,
            status.Report,
            result.WarningDetails,
            restoredPlan,
            restoredPlanChanges,
            persist: true,
            persistenceWeekKey: persistenceWeekKey,
            persistenceCourseId: persistenceCourseId);
        if (!await IsAutoGenStatusPersistedAsync(
                persistenceWeekKey,
                summary,
                restoredPlan?.PlanId,
                persistenceCourseId))
        {
            error = "Результат задачі показано, але браузер не зберіг його для наступного відновлення. Ідентифікатор задачі залишено.";
            return false;
        }
        if (!showInCurrentContext)
        {
            // Результат збережено для його діапазону, але не показуємо план у чужому тижні або курсі.
            await ResetStatusAsync(clearPersisted: false);
            await RestorePersistedAutoGenStatusAsync();
            return true;
        }
        if (status.Kind != AutoGenJobKind.Preflight)
        {
            try
            {
                await LoadWeek();
            }
            catch (ApiErrorException ex)
            {
                await HandleApiError(ex);
            }
            catch (HttpRequestException)
            {
                error = "Задачу завершено, але не вдалося оновити таблицю через помилку мережі.";
            }
        }
        return true;
    }
    // Визначає курс плану за групами у змінах, не покладаючись на глобальний останній ввід.
    private int? ResolveCourseIdFromPlanChanges(IEnumerable<AutoGenPlanChangeDto> changes)
    {
        if (meta is null)
        {
            return null;
        }
        var groupIds = changes
            .Select(change => change.After?.GroupId ?? change.Before?.GroupId)
            .Where(groupId => groupId is > 0)
            .Select(groupId => groupId!.Value)
            .ToHashSet();
        var courseIds = meta.Groups
            .Where(group => groupIds.Contains(group.Id))
            .Select(group => group.CourseId)
            .Distinct()
            .ToList();
        return courseIds.Count == 1 ? courseIds[0] : null;
    }
    // Підтверджує запис у storage до видалення єдиного ідентифікатора серверної задачі.
    private async Task<bool> IsAutoGenStatusPersistedAsync(
        string weekKey,
        string message,
        string? planId,
        int? courseId)
    {
        var statuses = await LoadPersistedAutoGenStatusesAsync();
        if (!statuses.TryGetValue(weekKey, out var persisted)
            || !string.Equals(persisted.Message, message, StringComparison.Ordinal)
            || (courseId is int expectedCourseId && persisted.CourseId != expectedCourseId))
        {
            return false;
        }
        return planId is null
            || string.Equals(persisted.Plan?.PlanId, planId, StringComparison.Ordinal);
    }
    // Формує запис для збереження статусу автогенерації.
    private PersistedAutoGenStatus? BuildPersistedAutoGenStatus(int? courseId = null)
    {
        if (string.IsNullOrWhiteSpace(ok))
            return null;
        return new PersistedAutoGenStatus(
            Message: ok,
            Warnings: new List<string>(okWarnings),
            GapDetails: new List<AutoGenGapDetail>(_latestGapDetails),
            GapSummary: new List<AutoGenGapSummaryItem>(_latestGapSummary),
            Preflight: new List<AutoGenPreflightItem>(_latestPreflight),
            Report: _latestAutoGenReport,
            WarningDetails: new List<AutoGenWarningDetail>(_latestWarningDetails),
            Plan: _latestAutoGenPlan,
            PlanLogContext: _preparedAutoGenPlanLogContext,
            CourseId: courseId
                      ?? _preparedAutoGenPlanLogContext?.CourseId
                      ?? _selectedCourseId
        );
    }
    // Відновлює останній статус автогенерації з storage.
    private async Task RestorePersistedAutoGenStatusAsync()
    {
        var requestVersion = _statusRestoreGuard.Begin();
        var weekKey = CurrentWeekKey;
        var statuses = await LoadPersistedAutoGenStatusesAsync();
        statuses.TryGetValue(weekKey, out var candidatePayload);
        var persistedCourseId = candidatePayload?.CourseId
                                ?? candidatePayload?.PlanLogContext?.CourseId;
        if (!_statusRestoreGuard.IsCurrent(requestVersion)
            || !string.Equals(CurrentWeekKey, weekKey, StringComparison.Ordinal)
            || candidatePayload is not { } payload
            || (payload.Plan is not null && persistedCourseId is null)
            || !AdminScheduleAutoGenState.CanRestoreStatusForCourse(
                persistedCourseId,
                _selectedCourseId))
        {
            return;
        }
        var plan = payload.Plan;
        IReadOnlyList<AutoGenPlanChangeDto>? planChanges = null;
        if (plan is not null)
        {
            try
            {
                var refreshedPlan = await Drafts.GetAutogenPlan(plan.PlanId);
                plan = refreshedPlan.Summary;
                planChanges = refreshedPlan.Changes;
            }
            catch (ApiErrorException ex) when (ex.StatusCode is HttpStatusCode.NotFound or HttpStatusCode.Conflict)
            {
                plan = null;
            }
        }
        if (!_statusRestoreGuard.IsCurrent(requestVersion)
            || !string.Equals(CurrentWeekKey, weekKey, StringComparison.Ordinal))
        {
            return;
        }
        _preparedAutoGenPlanLogContext = plan?.CanApply == true
            && string.Equals(payload.PlanLogContext?.PlanId, plan.PlanId, StringComparison.Ordinal)
                ? payload.PlanLogContext
                : null;
        await SetOkMessageAsync(
            payload.Message,
            payload.Warnings,
            payload.GapDetails,
            payload.GapSummary,
            payload.Preflight,
            payload.Report,
            payload.WarningDetails,
            plan,
            planChanges,
            persist: false);
    }
    // Відновлює останній доступний відкіт із серверної історії незалежно від поточного повідомлення сторінки.
    private async Task RestoreLatestRollbackableAutoGenPlanAsync()
    {
        var requestVersion = _rollbackablePlanLoadGuard.Begin();
        var courseId = _selectedCourseId;
        try
        {
            var details = await Drafts.GetLatestRollbackableAutogenPlan(courseId);
            if (!_rollbackablePlanLoadGuard.IsCurrent(requestVersion)
                || courseId != _selectedCourseId)
            {
                return;
            }
            _latestRollbackableAutoGenPlan = details?.Summary.CanRollback == true
                ? details.Summary
                : null;
        }
        catch (ApiErrorException)
        {
            if (_rollbackablePlanLoadGuard.IsCurrent(requestVersion)
                && courseId == _selectedCourseId)
            {
                _latestRollbackableAutoGenPlan = null;
            }
        }
        catch (HttpRequestException)
        {
            // Тимчасова помилка мережі не повинна приховувати вже відомий доступний відкіт.
        }
    }
    // Зберігає налаштування автогенерації для тижня.
    private async Task PersistAutoGenConfigAsync()
    {
        try
        {
            var configs = await LoadPersistedAutoGenConfigsAsync();
            configs.TryGetValue(CurrentWeekKey, out var weekConfig);
            var selectedCourseId = _selectedCourseId;
            weekConfig ??= new PersistedWeekAutoGenConfig(
                SelectedCourseId: selectedCourseId,
                Courses: new Dictionary<int, PersistedCourseAutoGenConfig>()
            );
            weekConfig = weekConfig with
            {
                SelectedCourseId = selectedCourseId
            };
            if (selectedCourseId is int courseId)
            {
                var moduleConfig = _moduleWeekRows
                    .Where(row => row.Selected || row.Hours > 0)
                    .GroupBy(row => row.ModuleId)
                    .ToDictionary(
                        g => g.Key,
                        g =>
                        {
                            var row = g.First();
                            return new PersistedModuleSelection(
                                Selected: row.Selected,
                                Hours: row.Hours
                            );
                        }
                    );
                var selectedGroupIds = _courseGroupRows
                    .Where(row => row.Selected)
                    .Select(row => row.GroupId)
                    .Distinct()
                    .ToList();
                var existingGroupRoomSelections = weekConfig.Courses.TryGetValue(courseId, out var existingCourseConfig)
                    ? new Dictionary<int, PersistedGroupRoomSelection>(existingCourseConfig.GroupRoomSelections ?? new())
                    : new Dictionary<int, PersistedGroupRoomSelection>();
                foreach (var row in _courseGroupRows.Where(row => row.Selected))
                {
                    if (HasManualGroupRoomPreference(row))
                    {
                        existingGroupRoomSelections[row.GroupId] = new PersistedGroupRoomSelection(
                            PreferredBuildingId: row.PreferredBuildingId,
                            PreferredRoomIds: row.PreferredRoomIds.Distinct().ToList()
                        );
                    }
                    else
                    {
                        existingGroupRoomSelections.Remove(row.GroupId);
                    }
                }
                weekConfig.Courses[courseId] = new PersistedCourseAutoGenConfig(
                    Modules: moduleConfig,
                    SelectedGroupIds: selectedGroupIds,
                    GroupRoomSelections: existingGroupRoomSelections.Count > 0 ? existingGroupRoomSelections : null,
                    UseRecommendedProfile: _useRecommendedAutoGenProfile,
                    AllowIncompleteDrafts: _allowIncompleteDrafts
                );
            }
            configs[CurrentWeekKey] = weekConfig;
            await SavePersistedAutoGenConfigsAsync(configs);
        }
        catch (JSException)
        {
        }
    }
    // Відновлює налаштування автогенерації для тижня.
    private async Task RestorePersistedAutoGenConfigAsync(bool restoreCourseSelection)
    {
        if (meta is null)
            return;
        var requestVersion = _autoGenConfigRestoreGuard.Begin();
        var weekKey = CurrentWeekKey;
        var selectedCourseId = _selectedCourseId;
        var configs = await LoadPersistedAutoGenConfigsAsync();
        if (!_autoGenConfigRestoreGuard.IsCurrent(requestVersion)
            || !string.Equals(CurrentWeekKey, weekKey, StringComparison.Ordinal)
            || (!restoreCourseSelection && _selectedCourseId != selectedCourseId))
        {
            return;
        }
        if (!configs.TryGetValue(weekKey, out var weekConfig))
        {
            _useRecommendedAutoGenProfile = true;
            _allowIncompleteDrafts = false;
            return;
        }
        if (restoreCourseSelection && weekConfig.SelectedCourseId is int persistedCourseId)
        {
            if (meta.Courses.Any(c => c.Id == persistedCourseId))
            {
                _selectedCourseId = persistedCourseId;
                BuildModuleWeekRows();
                BuildCourseGroupRows();
            }
        }
        if (_selectedCourseId is not int courseId)
        {
            _useRecommendedAutoGenProfile = true;
            _allowIncompleteDrafts = false;
            return;
        }
        if (_moduleWeekRows.Count == 0)
        {
            BuildModuleWeekRows();
        }
        if (_courseGroupRows.Count == 0)
        {
            BuildCourseGroupRows();
        }
        if (!weekConfig.Courses.TryGetValue(courseId, out var courseConfig))
        {
            _useRecommendedAutoGenProfile = true;
            _allowIncompleteDrafts = false;
            return;
        }
        _useRecommendedAutoGenProfile = courseConfig.UseRecommendedProfile;
        _allowIncompleteDrafts = courseConfig.AllowIncompleteDrafts;
        foreach (var row in _moduleWeekRows)
        {
            row.Selected = false;
            row.Hours = 0;
            if (courseConfig.Modules.TryGetValue(row.ModuleId, out var persisted))
            {
                row.Selected = persisted.Selected;
                row.Hours = persisted.Hours;
            }
        }
        var persistedGroupIds = courseConfig.SelectedGroupIds;
        if (persistedGroupIds is null)
        {
            foreach (var row in _courseGroupRows)
            {
                row.Selected = true;
            }
        }
        else
        {
            var persistedSet = persistedGroupIds
                .Where(groupId => groupId > 0)
                .ToHashSet();
            foreach (var row in _courseGroupRows)
            {
                row.Selected = persistedSet.Contains(row.GroupId);
            }
        }
        ApplyPersistedGroupRoomSelections(courseConfig.GroupRoomSelections);
    }
    // Відновлює ручні пріоритети корпусів і аудиторій для груп.
    private void ApplyPersistedGroupRoomSelections(Dictionary<int, PersistedGroupRoomSelection>? selections)
    {
        if (selections is null || selections.Count == 0)
        {
            foreach (var row in _courseGroupRows)
            {
                row.PreferredBuildingId = null;
                row.PreferredRoomIds.Clear();
            }
            return;
        }
        foreach (var row in _courseGroupRows)
        {
            if (!selections.TryGetValue(row.GroupId, out var persisted))
            {
                row.PreferredBuildingId = null;
                row.PreferredRoomIds.Clear();
                continue;
            }
            ApplyPersistedGroupRoomSelection(row, persisted);
        }
    }
    // Застосовує один збережений пріоритет до рядка групи.
    private void ApplyPersistedGroupRoomSelection(CourseGroupRow row, PersistedGroupRoomSelection persisted)
    {
        var normalizedBuildingId = persisted.PreferredBuildingId is int buildingId && _buildingOptions.Any(existing => existing.Id == buildingId)
            ? buildingId
            : (int?)null;
        if (normalizedBuildingId is null && persisted.PreferredRoomIds.Count > 0)
        {
            normalizedBuildingId = persisted.PreferredRoomIds
                .Select(roomId => _roomOptions.FirstOrDefault(room => room.Id.HasValue && room.Id.Value == roomId))
                .FirstOrDefault(room => room is not null)
                ?.BuildingId;
        }
        row.PreferredBuildingId = normalizedBuildingId;
        if (normalizedBuildingId is not int buildingForRooms)
        {
            row.PreferredRoomIds.Clear();
            return;
        }
        var validRoomIds = GetRoomsForBuilding(buildingForRooms)
            .Select(room => room.Id!.Value)
            .ToHashSet();
        row.PreferredRoomIds = persisted.PreferredRoomIds
            .Where(validRoomIds.Contains)
            .Distinct()
            .ToList();
    }
    // Завантажує збережені налаштування автогенерації.
    private async Task<Dictionary<string, PersistedWeekAutoGenConfig>> LoadPersistedAutoGenConfigsAsync()
    {
        try
        {
            var stored = await ReadStorageAsync(AutoGenConfigStorageKey, useLocal: false);
            if (string.IsNullOrWhiteSpace(stored))
            {
                stored = await ReadStorageAsync(AutoGenConfigLocalStorageKey, useLocal: true);
            }
            if (string.IsNullOrWhiteSpace(stored))
                return new();
            var configs = JsonSerializer.Deserialize<Dictionary<string, PersistedWeekAutoGenConfig>>(stored, AutoGenStatusJsonOptions);
            return configs ?? new();
        }
        catch (JSException)
        {
            await ClearPersistedAutoGenConfigStorageAsync();
            return new();
        }
        catch (JsonException)
        {
            await ClearPersistedAutoGenConfigStorageAsync();
            return new();
        }
    }
    // Зберігає налаштування автогенерації у storage.
    private async Task SavePersistedAutoGenConfigsAsync(Dictionary<string, PersistedWeekAutoGenConfig> configs)
    {
        if (configs.Count == 0)
        {
            await ClearPersistedAutoGenConfigStorageAsync();
            return;
        }
        var json = JsonSerializer.Serialize(configs, AutoGenStatusJsonOptions);
        try
        {
            await SetStorageAsync(AutoGenConfigStorageKey, json, useLocal: false);
            await SetStorageAsync(AutoGenConfigLocalStorageKey, json, useLocal: true);
        }
        catch (JSException)
        {
        }
    }
    // Очищає storage для налаштувань автогенерації.
    private async Task ClearPersistedAutoGenConfigStorageAsync()
    {
        try
        {
            await RemoveStorageAsync(AutoGenConfigStorageKey, useLocal: false);
            await RemoveStorageAsync(AutoGenConfigLocalStorageKey, useLocal: true);
        }
        catch (JSException)
        {
        }
    }
    // Завантажує останній використаний набір полів автогенерації.
    private async Task LoadLastAutoGenInputAsync()
    {
        try
        {
            var stored = await ReadStorageAsync(LastAutoGenInputStorageKey, useLocal: true);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _lastAutoGenInput = JsonSerializer.Deserialize<LastAutoGenInputState>(stored, AutoGenStatusJsonOptions);
            }
        }
        catch (JSException)
        {
            _lastAutoGenInput = null;
        }
        catch (JsonException)
        {
            _lastAutoGenInput = null;
        }
    }
    // Запам'ятовує повний набір полів перед запуском дії автогенерації.
    private async Task PersistLastAutoGenInputAsync()
    {
        if (_selectedCourseId is not int courseId)
        {
            return;
        }
        var state = new LastAutoGenInputState(
            SelectedDate: _selectedDate,
            GenerationFromDate: _generationFromDate,
            GenerationToDate: _generationToDate,
            DaysPreset: _daysPreset,
            CourseId: courseId,
            Modules: _moduleWeekRows
                .Where(row => row.Selected || row.Hours > 0)
                .GroupBy(row => row.ModuleId)
                .ToDictionary(
                    group => group.Key,
                    group =>
                    {
                        var row = group.First();
                        return new PersistedModuleSelection(row.Selected, row.Hours);
                    }),
            SelectedGroupIds: GetSelectedGroupIds(),
            GroupRoomSelections: _courseGroupRows
                .Where(row => row.Selected && HasManualGroupRoomPreference(row))
                .ToDictionary(
                    row => row.GroupId,
                    row => new PersistedGroupRoomSelection(
                        row.PreferredBuildingId,
                        row.PreferredRoomIds.Distinct().ToList())),
            UseRecommendedProfile: _useRecommendedAutoGenProfile,
            AllowIncompleteDrafts: _allowIncompleteDrafts,
            SavedAt: DateTimeOffset.Now);
        try
        {
            var json = JsonSerializer.Serialize(state, AutoGenStatusJsonOptions);
            await SetStorageAsync(LastAutoGenInputStorageKey, json, useLocal: true);
            _lastAutoGenInput = state;
        }
        catch (JSException)
        {
        }
    }
    // Повертає останній використаний набір і пропускає видалені довідникові значення.
    private async Task RestoreLastAutoGenInputAsync()
    {
        if (IsAutoGenBusy || meta is null || _lastAutoGenInput is not { } state)
        {
            return;
        }
        if (!CanRestoreLastAutoGenInput)
        {
            error = "Останні налаштування більше не відповідають доступним курсам, модулям або групам.";
            return;
        }
        _selectedDate = state.SelectedDate;
        _generationFromDate = state.GenerationFromDate;
        _generationToDate = state.GenerationToDate;
        if (_generationToDate < _generationFromDate)
        {
            _generationToDate = _generationFromDate.AddDays(4);
        }
        _daysPreset = Enum.IsDefined(state.DaysPreset) ? state.DaysPreset : WeekPreset.MonFri;
        _selectedCourseId = state.CourseId;
        TryAlignGenerationRangeWithAcademicPeriod();
        BuildModuleWeekRows();
        BuildCourseGroupRows();
        var modules = state.Modules ?? new Dictionary<int, PersistedModuleSelection>();
        foreach (var row in _moduleWeekRows)
        {
            row.Selected = false;
            row.Hours = 0;
            if (modules.TryGetValue(row.ModuleId, out var module))
            {
                row.Selected = module.Selected;
                row.Hours = Math.Max(0, module.Hours);
            }
        }
        var selectedGroupIds = (state.SelectedGroupIds ?? new List<int>())
            .Where(groupId => groupId > 0)
            .ToHashSet();
        foreach (var row in _courseGroupRows)
        {
            row.Selected = selectedGroupIds.Contains(row.GroupId);
        }
        ApplyPersistedGroupRoomSelections(state.GroupRoomSelections);
        _useRecommendedAutoGenProfile = state.UseRecommendedProfile;
        _allowIncompleteDrafts = state.AllowIncompleteDrafts;
        SynchronizeVisibleContextQuery();
        await ResetStatusAsync(clearPersisted: false);
        await PersistAutoGenConfigAsync();
        if (!await TryLoadVisibleWeekAsync())
        {
            return;
        }
        await RestoreLatestRollbackableAutoGenPlanAsync();
        _lastAutoGenInputRestored = true;
        error = null;
    }
    private string GetLastAutoGenInputButtonTitle()
        => _lastAutoGenInput is null
            ? "Кнопка стане доступною після першого формування плану."
            : $"Налаштування збережено {_lastAutoGenInput.SavedAt.ToLocalTime():dd.MM.yyyy HH:mm}";
    // Запускає автогенерацію послідовно для кожного тижня в обраному діапазоні.
    // Формує запит ручних пріоритетів корпусів і аудиторій для вибраних груп.
    private List<GroupRoomPreferenceDto> BuildSelectedGroupRoomPreferences(IReadOnlyCollection<int>? groupIds = null)
    {
        var groupSet = groupIds?
            .Where(groupId => groupId > 0)
            .ToHashSet();
        return _courseGroupRows
            .Where(row => row.Selected && HasManualGroupRoomPreference(row))
            .Where(row => groupSet is null || groupSet.Contains(row.GroupId))
            .Select(row => new GroupRoomPreferenceDto(
                GroupId: row.GroupId,
                BuildingId: row.PreferredBuildingId,
                RoomIds: row.PreferredRoomIds.Distinct().ToList()
            ))
            .ToList();
    }
    // Повертає рекомендований профіль пошуку для автогенерації та дозаповнення.
    private AutoGenSoftOptionsDto? BuildRecommendedSoftOptions()
        => _useRecommendedAutoGenProfile ? RecommendedSoftFillOptions : null;
    // За явного перемикача підміняємо збережений у БД ліміт "бажано першим" параметром рекомендованого профілю.
    private int? BuildRecommendedPreferredFirstLimitOverride()
        => _useRecommendedAutoGenProfile ? RecommendedPreferredFirstMaxSlotOrderOverride : null;
    private async Task<(AutoGenResult Result, DateOnly RangeStartDate, DateOnly RangeEndDate, int WeekCount, AutoGenJobStatus FinalStatus)> RunAutoGenForRangeAsync(
        int courseId,
        IReadOnlyList<int> groupIds,
        IReadOnlyList<GroupRoomPreferenceDto> groupRoomPreferences,
        Dictionary<int, int> moduleHours,
        bool clearExisting,
        bool softFill,
        bool preflightOnly = false,
        bool previewOnly = false)
    {
        var (fromDate, toDate) = GetNormalizedGenerationDateRange();
        var weekStarts = BuildGenerationWeekStarts();
        var normalizedGroupIds = groupIds
            .Where(groupId => groupId > 0)
            .Distinct()
            .ToList();
        var clientJobId = await CreateClientJobIdForNewOperationAsync();
        var request = new AutoGenJobRequest(
            Kind: BuildAutoGenJobKind(softFill, preflightOnly),
            FromDate: fromDate,
            ToDate: toDate,
            CourseId: courseId,
            GroupIds: normalizedGroupIds,
            ModuleHours: moduleHours,
            Days: _daysPreset,
            ClearExisting: clearExisting,
            SoftFill: softFill,
            PreflightOnly: preflightOnly,
            AllowIncompleteDrafts: _allowIncompleteDrafts,
            GroupRoomPreferences: groupRoomPreferences.Count > 0 ? groupRoomPreferences.ToList() : null,
            SoftOptions: BuildRecommendedSoftOptions(),
            PreferredFirstMaxSlotOrderOverride: BuildRecommendedPreferredFirstLimitOverride(),
            Title: previewOnly
                ? softFill
                    ? "Попередній план дозаповнення відсутніх пар"
                    : "Повний план автогенерації"
                : preflightOnly
                ? "Перевірка ресурсів"
                : softFill
                    ? "Дозаповнення відсутніх пар"
                    : "Автогенерація у чернетки",
            ClientJobId: clientJobId,
            PreviewOnly: previewOnly
        );
        await PersistActiveAutoGenJobIdAsync(clientJobId, courseId, fromDate);
        AutoGenJobStatus status;
        try
        {
            var started = await Drafts.StartAutogenJob(request);
            status = started.Status;
        }
        catch (Exception startException) when (startException is HttpRequestException or TaskCanceledException)
        {
            try
            {
                status = await Drafts.GetAutogenJob(clientJobId);
            }
            catch (ApiErrorException lookupException) when (lookupException.StatusCode == HttpStatusCode.NotFound)
            {
                await RemoveActiveAutoGenJobIdAsync(clientJobId);
                throw new HttpRequestException(
                    "Сервер не підтвердив запуск автогенерації після втрати з'єднання.",
                    startException);
            }
        }
        catch
        {
            await RemoveActiveAutoGenJobIdAsync(clientJobId);
            throw;
        }
        await PersistActiveAutoGenJobIdAsync(status.JobId, courseId, fromDate);
        ApplyAutoGenJobStatus(status);
        await InvokeAsync(StateHasChanged);
        status = await WaitForAutoGenJobTerminalAsync(status);
        await RemoveActiveAutoGenJobIdAsync(status.JobId);
        return (BuildAutoGenJobResult(status), fromDate, toDate, weekStarts.Count, status);
    }
    // Створює точний план без змін у БД, щоб користувач окремо переглянув деталі та попередження.
    private async Task<(AutoGenResult Result, DateOnly RangeStartDate, DateOnly RangeEndDate, int WeekCount, AutoGenJobStatus FinalStatus, AutoGenPlanSummaryDto? Plan, IReadOnlyList<AutoGenPlanChangeDto> Changes)> PrepareAutoGenPreviewForRangeAsync(
        int courseId,
        IReadOnlyList<int> groupIds,
        IReadOnlyList<GroupRoomPreferenceDto> groupRoomPreferences,
        Dictionary<int, int> moduleHours,
        bool clearExisting,
        bool softFill)
    {
        var (previewResult, rangeStartDate, rangeEndDate, weekCount, previewStatus) = await RunAutoGenForRangeAsync(
            courseId,
            groupIds,
            groupRoomPreferences,
            moduleHours,
            clearExisting,
            softFill,
            previewOnly: true);
        if (previewStatus.State != AutoGenJobState.Succeeded)
        {
            return (previewResult, rangeStartDate, rangeEndDate, weekCount, previewStatus, previewStatus.Plan, Array.Empty<AutoGenPlanChangeDto>());
        }

        var plan = await Drafts.GetAutogenPlan(previewStatus.JobId);
        return (
            plan.Result,
            rangeStartDate,
            rangeEndDate,
            weekCount,
            previewStatus with { Plan = plan.Summary },
            plan.Summary,
            plan.Changes);
    }
    // Опитує сервер до термінального стану задачі, зберігаючи можливість відновлення після тимчасових збоїв.
    private async Task<AutoGenJobStatus> WaitForAutoGenJobTerminalAsync(AutoGenJobStatus status)
    {
        var cancellationToken = _componentLifetimeCts.Token;
        var consecutivePollFailures = 0;
        while (!IsAutoGenJobTerminal(status.State))
        {
            await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            try
            {
                status = await Drafts.GetAutogenJob(status.JobId);
                cancellationToken.ThrowIfCancellationRequested();
                consecutivePollFailures = 0;
            }
            catch (Exception ex) when (IsTransientAutoGenPollFailure(ex) && consecutivePollFailures < 4)
            {
                consecutivePollFailures++;
                if (_autoGenProgress is not null)
                {
                    _autoGenProgress.CurrentMessage = $"Зв'язок із сервером тимчасово втрачено. Повторна спроба {consecutivePollFailures}/4...";
                    _autoGenProgress.LastUpdatedAt = DateTimeOffset.Now;
                }
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(Math.Pow(2, consecutivePollFailures - 1)), cancellationToken);
                continue;
            }
            ApplyAutoGenJobStatus(status);
            await InvokeAsync(StateHasChanged);
        }
        return status;
    }
    // Узгоджує результат для успішної, скасованої або невдалої серверної задачі.
    private static AutoGenResult BuildAutoGenJobResult(AutoGenJobStatus status)
    {
        var result = status.Result ?? new AutoGenResult(status.Created, status.Skipped, new List<string>());
        if (status.State == AutoGenJobState.Canceled)
        {
            result = result with
            {
                Warnings = result.Warnings.Concat(new[] { "Операцію скасовано користувачем." }).Distinct(StringComparer.Ordinal).ToList()
            };
        }
        else if (status.State == AutoGenJobState.Failed)
        {
            var failureMessage = string.IsNullOrWhiteSpace(status.Error)
                ? "сервер не надав опис помилки"
                : status.Error;
            result = result with
            {
                Warnings = result.Warnings
                    .Concat(new[] { $"Помилка автогенерації: {failureMessage}" })
                    .Distinct(StringComparer.Ordinal)
                    .ToList()
            };
        }
        return result with
        {
            WarningDetails = MergeWarningDetails(result.WarningDetails, result.Warnings)
        };
    }
    // Визначає тимчасові помилки опитування, після яких серверна задача може ще працювати.
    private static bool IsTransientAutoGenPollFailure(Exception exception)
        => exception is HttpRequestException
           || exception is ApiErrorException
           {
               StatusCode: HttpStatusCode.TooManyRequests or HttpStatusCode.ServiceUnavailable
           };
    // Запускає автогенерацію чернеток для обраного діапазону.
    private async Task AutoGenDrafts()
    {
        if (!TryBeginAutoGenAction())
        {
            return;
        }
        try
        {
            await ResetStatusAsync();
            if (HasInvalidGenerationDateRange)
            {
                error = "Дата завершення не може бути раніше дати початку.";
                return;
            }
            if (_selectedCourseId is not int courseId)
            {
                error = "Оберіть курс для автогенерації.";
                return;
            }
            var moduleHours = _moduleWeekRows
                .Where(row => row.Selected && row.Hours > 0)
                .GroupBy(row => row.ModuleId)
                .ToDictionary(g => g.Key, g => g.First().Hours);
            if (moduleHours.Count == 0)
            {
                error = "Оберіть хоча б один модуль і вкажіть години > 0.";
                return;
            }
            var selectedGroupIds = GetSelectedGroupIds();
            if (selectedGroupIds.Count == 0)
            {
                error = "Оберіть хоча б одну групу для автогенерації.";
                return;
            }
            var groupRoomPreferences = BuildSelectedGroupRoomPreferences(selectedGroupIds);
            await PersistAutoGenConfigAsync();
            await PersistLastAutoGenInputAsync();
            await StartAutoGenProgressAsync("Готуємо повний план автогенерації", AutoGenProgressKind.Generate);
            var (res, rangeStartDate, rangeEndDate, _, finalStatus, plan, planChanges) = await PrepareAutoGenPreviewForRangeAsync(
                courseId,
                selectedGroupIds,
                groupRoomPreferences,
                moduleHours,
                clearExisting: true,
                softFill: false);
            var courseName = meta?.Courses.FirstOrDefault(c => c.Id == courseId)?.Name ?? $"#{courseId}";
            var previewSummary = finalStatus.State == AutoGenJobState.Succeeded
                ? $"Повний план автогенерації {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy} для курсу {courseName} готовий. Автоматичне дозаповнення вже враховано. Перегляньте зміни та прийміть план. Чернетки ще не змінено."
                : $"Повний план автогенерації {rangeStartDate:dd.MM.yyyy} – {rangeEndDate:dd.MM.yyyy} не підготовлено. Чернетки не змінено.";
            _preparedAutoGenPlanLogContext = plan?.CanApply == true
                ? new PreparedAutoGenPlanLogContext(
                    plan.PlanId,
                    rangeStartDate,
                    rangeEndDate,
                    courseId,
                    courseName,
                    new Dictionary<int, int>(moduleHours),
                    false)
                : null;
            await SetOkMessageAsync(
                previewSummary,
                res.Warnings,
                res.GapDetails,
                res.GapSummary,
                res.Preflight,
                finalStatus.Report,
                res.WarningDetails,
                plan,
                planChanges);
        }
        catch (OperationCanceledException) when (_componentLifetimeCts.IsCancellationRequested)
        {
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            EndAutoGenAction();
        }
    }
    // Застосовує раніше підготовлений план, якщо його вихідний стан досі актуальний.
    private async Task ApplyLatestAutoGenPlanAsync()
    {
        var plan = _latestAutoGenPlan;
        if (plan?.CanApply != true || !TryBeginAutoGenAction())
        {
            return;
        }
        try
        {
            error = null;
            if (plan.DeleteCount > 0)
            {
                var confirmed = await JS.InvokeAsync<bool>(
                    "confirm",
                    $"Прийняти план із видаленням?\n\nБуде видалено незакріплених чернеток: {plan.DeleteCount}.\nДодати: {plan.AddCount}. Змінити: {plan.UpdateCount}.");
                if (!confirmed)
                {
                    return;
                }
            }

            await StartAutoGenProgressAsync("Застосовуємо готовий план", AutoGenProgressKind.Generate);
            var applied = await Drafts.ApplyAutogenPlan(
                plan.PlanId,
                new AutoGenPlanActionRequest(plan.Version));
            var report = _latestAutoGenReport is null
                ? null
                : _latestAutoGenReport with
                {
                    Created = applied.Result.Created,
                    Skipped = applied.Result.Skipped,
                    WarningCount = applied.Result.Warnings.Count,
                    GapCount = applied.Result.GapDetails?.Count ?? 0,
                    DeficitCount = applied.Result.Preflight?.Sum(item => item.Count) ?? 0
                };
            var logContext = string.Equals(
                _preparedAutoGenPlanLogContext?.PlanId,
                plan.PlanId,
                StringComparison.Ordinal)
                    ? _preparedAutoGenPlanLogContext
                    : null;
            _preparedAutoGenPlanLogContext = null;
            var summary = $"Готовий план застосовано: додано {applied.Summary.AddCount}, змінено {applied.Summary.UpdateCount}, видалено {applied.Summary.DeleteCount}.";
            await SetOkMessageAsync(
                summary,
                applied.Result.Warnings,
                applied.Result.GapDetails,
                applied.Result.GapSummary,
                applied.Result.Preflight,
                report,
                applied.Result.WarningDetails,
                applied.Summary,
                applied.Changes);
            var reviewCourseId = logContext?.CourseId ?? _selectedCourseId;
            if (reviewCourseId is int courseId)
            {
                var reviewDate = logContext?.RangeStartDate ?? report?.RangeStartDate ?? _generationFromDate;
                _appliedPlanReviewContext = new AppliedPlanReviewContext(GetMonday(reviewDate), courseId);
            }
            await UpdateAutoGenProgressMessageAsync("Оновлюємо таблицю після застосування...");
            await LoadWeek();
            if (logContext is not null)
            {
                await LogAutoGenAsync(
                    summary,
                    applied.Result,
                    logContext.RangeStartDate,
                    logContext.RangeEndDate,
                    logContext.CourseId,
                    logContext.CourseName,
                    logContext.ModuleHours,
                    logContext.SoftFill,
                    AutoGenJobState.Succeeded,
                    jobError: null);
            }
        }
        catch (ApiErrorException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            if (string.Equals(_latestAutoGenPlan?.PlanId, plan.PlanId, StringComparison.Ordinal))
            {
                _latestAutoGenPlan = AdminScheduleAutoGenState.InvalidatePlanAfterConflict(plan);
                _latestAutoGenPlanChanges = new();
                _preparedAutoGenPlanLogContext = null;
                await PersistAutoGenStatusAsync();
            }
            await HandleApiError(ex);
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            EndAutoGenAction();
        }
    }
    // Відкочує лише незмінений результат останнього застосованого плану.
    private async Task RollbackLatestAutoGenPlanAsync()
    {
        var plan = _latestRollbackableAutoGenPlan;
        if (plan?.CanRollback != true || !TryBeginAutoGenAction())
        {
            return;
        }
        try
        {
            error = null;
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Відкотити застосований план?\n\nБуде прибрано доданих: {plan.AddCount}\nВідновлено видалених: {plan.DeleteCount}\nПовернуто змінених: {plan.UpdateCount}\n\nВідкат спрацює лише якщо чернетки після застосування ніхто не редагував.");
            if (!confirmed)
            {
                return;
            }

            await StartAutoGenProgressAsync("Відкочуємо застосований план", AutoGenProgressKind.Generate);
            var rolledBack = await Drafts.RollbackAutogenPlan(
                plan.PlanId,
                new AutoGenPlanActionRequest(plan.Version));
            var summary = $"План автогенерації відкочено: прибрано доданих {rolledBack.Summary.AddCount}, відновлено видалених {rolledBack.Summary.DeleteCount}, повернуто змінених {rolledBack.Summary.UpdateCount}.";
            await SetOkMessageAsync(
                summary,
                rolledBack.Result.Warnings,
                rolledBack.Result.GapDetails,
                rolledBack.Result.GapSummary,
                rolledBack.Result.Preflight,
                warningDetails: rolledBack.Result.WarningDetails,
                plan: rolledBack.Summary,
                planChanges: rolledBack.Changes);
            await UpdateAutoGenProgressMessageAsync("Оновлюємо таблицю після відкоту...");
            await LoadWeek();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
            await RestoreLatestRollbackableAutoGenPlanAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            EndAutoGenAction();
        }
    }
