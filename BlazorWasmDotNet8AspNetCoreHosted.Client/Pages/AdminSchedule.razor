    {
        if (moduleId is null || meta is null) return string.Empty;
        var module = meta.Modules.FirstOrDefault(m => m.Id == moduleId.Value);
        return module is null || string.IsNullOrWhiteSpace(module.CourseName)
            ? string.Empty
            : module.CourseName;
