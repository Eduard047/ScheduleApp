        };
    private static string BuildAutoGenPlanChangeLabel(AutoGenPlanChangeDto change)
    {
        var draft = change.Operation == AutoGenPlanOperation.Delete ? change.Before : change.After;
        if (draft is null)
        {
            return "Некоректна зміна без даних заняття.";
        }
        var action = change.Operation switch
        {
            AutoGenPlanOperation.Delete => "Видалити",
            AutoGenPlanOperation.Update => "Змінити",
            _ => "Додати"
        };
        var resources = new List<string>();
        if (!string.IsNullOrWhiteSpace(draft.TeacherName))
        {
            resources.Add($"викладач: {draft.TeacherName}");
        }
        if (!string.IsNullOrWhiteSpace(draft.RoomName))
        {
            resources.Add($"аудиторія: {draft.RoomName}");
        }
        var resourceSuffix = resources.Count == 0 ? string.Empty : $", {string.Join(", ", resources)}";
        return $"{action}: {draft.Date:dd.MM.yyyy} {draft.TimeStart}–{draft.TimeEnd}, {draft.GroupName}, {draft.ModuleName}{resourceSuffix}";
    }
