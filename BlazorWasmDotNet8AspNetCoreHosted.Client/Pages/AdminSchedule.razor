        => state switch
        {
            AutoGenPlanState.Ready => "готовий до застосування",
            AutoGenPlanState.Applied => "застосований",
            AutoGenPlanState.RolledBack => "відкочений",
            AutoGenPlanState.Expired => "прострочений",
