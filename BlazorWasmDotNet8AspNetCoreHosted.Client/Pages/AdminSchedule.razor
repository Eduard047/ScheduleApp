@* Сторінка адміністрування розкладу *@
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@using System.Net
@using System.Text.Json
@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs
@implements IDisposable

@inject IScheduleApi Api
@inject IAdminApi Admin
@inject ITeacherDraftsApi Drafts
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AdminScheduleLogService LogService



@page "/admin/schedule"

<PageTitle>Сформувати план</PageTitle>

<div class="mb-3">
    <h1 class="h3 mb-1">Сформувати план</h1>
    <div class="text-muted">Налаштуйте період і навчальний план, перегляньте результат, а потім прийміть зміни.</div>
</div>

@if (meta is null)
{
    @if (_metaLoadInProgress || string.IsNullOrWhiteSpace(_metaLoadError))
    {
        <div class="alert alert-info d-flex align-items-center gap-2" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Завантажуємо дані сторінки…</span>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <div class="fw-semibold">Не вдалося завантажити сторінку</div>
            <div class="small mt-1">@_metaLoadError</div>
            <button type="button"
                    class="btn btn-sm btn-outline-danger mt-2"
                    @onclick="RetryPageInitializationAsync"
                    disabled="@_metaLoadInProgress">
                Спробувати ще раз
            </button>
        </div>
    }
}
else
{
    <div class="card p-3">
        <div class="border rounded-3 p-3 bg-light">
            <div>
                <div>
                    <div class="fw-semibold mb-1">Підготовка плану</div>
                    <div class="small text-muted">
                        @GetGenerationRangeDescription(). Чернетки зміняться лише після того, як ви переглянете і приймете план.
                    </div>
                </div>
                <div class="autogen-plan-toolbar mt-3">
                    <div class="autogen-plan-field">
                        <label class="form-label small mb-1" for="autogen-from-date">Від дати</label>
                        <input id="autogen-from-date"
                               type="date"
                               class="form-control"
                               value="@_generationFromDate.ToString("yyyy-MM-dd")"
                               @onchange="OnGenerationFromDateChanged"
                               disabled="@IsPageInteractionBusy" />
                    </div>
                    <div class="autogen-plan-field">
                        <label class="form-label small mb-1" for="autogen-to-date">До дати</label>
                        <input id="autogen-to-date"
                               type="date"
                               class="form-control"
                               value="@_generationToDate.ToString("yyyy-MM-dd")"
                               @onchange="OnGenerationToDateChanged"
                               disabled="@IsPageInteractionBusy" />
                    </div>
                    <div class="autogen-plan-field">
                        <label class="form-label small mb-1" for="admin-schedule-days">Навчальні дні</label>
                        <select id="admin-schedule-days"
                                class="form-select"
                                @bind="_daysPreset"
                                @bind:after="OnAutoGenConfigurationChangedAsync"
                                disabled="@IsPageInteractionBusy">
                            <option value="@WeekPreset.MonFri">Пн–Пт</option>
                            <option value="@WeekPreset.MonSat">Пн–Сб</option>
                            <option value="@WeekPreset.MonSun">Пн–Нд</option>
                        </select>
                    </div>
                    <div class="autogen-plan-field autogen-plan-field--course">
                        <label class="form-label small mb-1" for="autogen-course">Курс</label>
                        <select id="autogen-course"
                                class="form-select"
                                @bind="_selectedCourseId"
                                @bind:after="OnSelectedCourseChanged"
                                disabled="@IsPageInteractionBusy">
                            <option value="">Оберіть курс</option>
                            @foreach (var course in meta.Courses.OrderBy(c => c.Name))
                            {
                                <option value="@course.Id">@course.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    Система спочатку побудує розклад, а потім автоматично дозаповнить прогалини за м’якими правилами. Жорсткі обмеження залишаться без змін.
                </div>
                @if (HasInvalidGenerationDateRange)
                {
                    <div class="alert alert-danger py-2 px-3 mt-2 mb-0" role="alert">
                        Дата завершення не може бути раніше дати початку. Виправте діапазон, щоб сформувати план.
                    </div>
                }
                @if (CanRestoreLastAutoGenInput && _lastAutoGenInput is { } lastAutoGenInput)
                {
                    <div class="autogen-restore-callout @(_lastAutoGenInputRestored ? "autogen-restore-callout--restored" : null) mt-3"
                         role="status">
                        <div>
                            <div class="fw-semibold">
                                @(_lastAutoGenInputRestored ? "Відновлено останні налаштування" : "Можна продовжити з останніми налаштуваннями")
                            </div>
                            <div class="small">
                                Збережено @lastAutoGenInput.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"). Після відновлення всі поля можна змінити.
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-sm @(_lastAutoGenInputRestored ? "btn-outline-success" : "btn-outline-primary")"
                                @onclick="RestoreLastAutoGenInputAsync"
                                disabled="@IsPageInteractionBusy"
                                title="@GetLastAutoGenInputButtonTitle()">
                            @(_lastAutoGenInputRestored ? "Відновити ще раз" : "Використати останні налаштування")
                        </button>
                    </div>
                }
                @if (_latestRollbackableAutoGenPlan?.CanRollback == true)
                {
                    <details class="autogen-secondary-actions mt-3">
                        <summary>Історія застосування</summary>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button class="btn btn-sm btn-autogen-rollback" @onclick="RollbackLatestAutoGenPlanAsync" disabled="@IsPageInteractionBusy">
                                Відкотити останнє застосування
                            </button>
                        </div>
                    </details>
                }
            </div>
            @if (SelectedAutoGenCourse is { } selectedAutoGenCourse)
            {
                if (selectedAutoGenCourse.AcademicPeriodStartDate is not DateOnly academicPeriodStartDate)
                {
                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        <strong>Автогенерацію заблоковано.</strong>
                        Для курсу «@selectedAutoGenCourse.Name» не вказано початок поточного навчального періоду.
                        <a class="alert-link" href="/admin/courses">Налаштувати курс</a>.
                    </div>
                }
                else if (_generationFromDate < academicPeriodStartDate)
                {
                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        <strong>Автогенерацію заблоковано.</strong>
                        Обрана дата початку генерації передує початку навчального періоду
                        (@academicPeriodStartDate.ToString("dd.MM.yyyy")) для курсу «@selectedAutoGenCourse.Name».
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-dark"
                                    @onclick="UseAcademicPeriodStartAsync"
                                    disabled="@IsPageInteractionBusy">
                                Почати з @academicPeriodStartDate.ToString("dd.MM.yyyy")
                            </button>
                            <span class="small">Або <a class="alert-link" href="/admin/courses">налаштуйте курс</a>, якщо дата вказана неправильно.</span>
                        </div>
                    </div>
                }
            }
            @if (_autoGenProgress is not null)
            {
                var progress = _autoGenProgress;
                var progressPercent = GetAutoGenProgressPercent(progress);
                <div class="autogen-progress mt-3" role="status" aria-live="polite" aria-busy="true">
                    <div class="autogen-progress__head">
                        <div>
                            <div class="autogen-progress__title">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>@progress.Title</span>
                            </div>
                            <div class="autogen-progress__subtitle">@progress.CurrentMessage</div>
                        </div>
                        <div class="autogen-progress__actions">
                            <div class="autogen-progress__badge">@progressPercent%</div>
                            @if (!string.IsNullOrWhiteSpace(progress.JobId))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="CancelAutoGenAsync"
                                        disabled="@progress.CancellationRequested">
                                    @(progress.CancellationRequested ? "Скасовується..." : "Скасувати")
                                </button>
                            }
                        </div>
                    </div>
                    <div class="progress autogen-progress__bar" aria-label="Прогрес автогенерації">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             style="width: @progressPercent%;"
                             aria-valuenow="@progressPercent"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <div class="autogen-progress__meta">
                        <span>@GetAutoGenProgressStepLabel(progress)</span>
                        <span>@GetAutoGenProgressCompletedLabel(progress)</span>
                        <span>Минуло: @FormatDuration(GetAutoGenElapsed(progress))</span>
                        <span>Залишилось: @GetAutoGenRemainingLabel(progress)</span>
                    </div>
                    <div class="autogen-progress__range">
                        Діапазон: @progress.RangeStartDate.ToString("dd.MM.yyyy") – @progress.RangeEndDate.ToString("dd.MM.yyyy")
                    </div>
                    @if (!string.IsNullOrWhiteSpace(progress.LastCompletedMessage))
                    {
                        <div class="autogen-progress__last">@progress.LastCompletedMessage</div>
                    }
                </div>
            }
            <details class="autogen-advanced-options mt-3">
                <summary class="autogen-advanced-options__summary">
                    <span class="fw-semibold">Додаткові налаштування</span>
                    <span class="small text-muted">@GetAutoGenAdvancedSettingsSummary()</span>
                </summary>
                <div class="autogen-advanced-options__body">
                    <div class="d-flex flex-column flex-lg-row align-items-start justify-content-between gap-3">
                        <label class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="_useRecommendedAutoGenProfile"
                                   @bind:after="OnAutoGenConfigurationChangedAsync"
                                   disabled="@IsPageInteractionBusy" />
                            <span class="form-check-label fw-semibold">Використовувати рекомендований профіль автогенерації</span>
                        </label>
                        <div class="small text-muted">
                            @if (_useRecommendedAutoGenProfile)
                            {
                                <span>Система використовує перевірені налаштування, щоб щільніше заповнювати дні та рідше залишати вікна.</span>
                            }
                            else
                            {
                                <span>Використовуються лише правила, збережені в довідниках.</span>
                            }
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top">
                        <label class="form-check mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="_allowIncompleteDrafts"
                                   @bind:after="OnAutoGenConfigurationChangedAsync"
                                   disabled="@IsPageInteractionBusy" />
                            <span class="form-check-label fw-semibold">Створювати неповні чернетки без викладача або аудиторії</span>
                        </label>
                        <div class="small text-muted mt-2">
                            Такі чернетки не усувають дефіцит ресурсів: їх потрібно завершити вручну у повному редакторі.
                        </div>
                    </div>
                    @if (_useRecommendedAutoGenProfile)
                    {
                        <div class="small text-muted mt-3 pt-3 border-top">
                            Профіль: <strong>@RecommendedAutoGenProfileName</strong>;
                            «бажано першим» — до слоту @RecommendedPreferredFirstMaxSlotOrderOverride;
                            паралельні групи модуля — до @RecommendedSoftFillMaxParallelGroupsPerModuleInSlot;
                            різні модулі на день — @RecommendedSoftFillPreferredMaxDistinctModulesPerDay/@RecommendedSoftFillMaxDistinctModulesPerDay;
                            вікно повторів — @RecommendedSoftFillRepeatWindowDays дн.
                        </div>
                    }
            @if (_selectedCourseId is int)
            {
                <div class="mt-3">
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-2">
                        <div class="fw-semibold">Групи для автогенерації</div>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Вибір груп курсу">
                            <button type="button" class="btn btn-outline-secondary" @onclick="SelectAllCourseGroupsAsync" disabled="@IsPageInteractionBusy">
                                Усі
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearCourseGroupsSelectionAsync" disabled="@IsPageInteractionBusy">
                                Жодної
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var row in _courseGroupRows)
                        {
                            <label class="form-check mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input m-0"
                                       type="checkbox"
                                       @bind="row.Selected"
                                       @bind:after="OnAutoGenConfigurationChangedAsync"
                                       disabled="@IsPageInteractionBusy" />
                                <span class="form-check-label">@row.Caption</span>
                            </label>
                        }
                        @if (_courseGroupRows.Count == 0)
                        {
                            <span class="text-muted small">Для цього курсу немає доступних груп.</span>
                        }
                    </div>
                    <div class="small text-muted mt-2">
                        Автогенерація створює заняття лише для обраних груп.
                    </div>
                    <details class="group-room-preferences mt-3">
                        <summary class="group-room-preferences__summary">
                            <span class="fw-semibold">Корпуси й аудиторії</span>
                            <span class="small text-muted">@GetGroupRoomPreferencesOverview()</span>
                        </summary>
                        <div class="small text-muted mt-2 mb-3">
                            За потреби обмежте корпус або виберіть конкретні аудиторії для окремих груп.
                            Без ручного вибору система підбере їх автоматично.
                        </div>
                        @if (!_roomCatalogLoaded)
                        {
                            <div class="small text-muted mb-2">
                                Довідник корпусів і аудиторій ще не завантажено.
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_roomCatalogError))
                        {
                            <div class="small text-warning mb-2">
                                Не вдалося завантажити довідник корпусів і аудиторій: @_roomCatalogError
                            </div>
                        }
                        @if (_courseGroupRows.Any(row => row.Selected))
                        {
                            <div class="group-room-grid">
                                @foreach (var row in _courseGroupRows.Where(row => row.Selected))
                                {
                                    <div class="group-room-card" @key="row.GroupId">
                                        <div class="group-room-card__head">
                                            <div>
                                                <div class="fw-semibold">@row.Caption</div>
                                                <div class="group-room-card__summary">@GetGroupRoomPreferenceSummary(row)</div>
                                            </div>
                                            <button type="button"
                                                    class="btn btn-sm btn-link text-decoration-none p-0"
                                                    aria-label="Скинути корпуси й аудиторії для групи @row.Caption"
                                                    disabled="@(!row.HasRoomPreferences || IsPageInteractionBusy)"
                                                    @onclick="() => ClearGroupRoomPreferenceAsync(row)">
                                                Скинути
                                            </button>
                                        </div>
                                        <div class="group-room-card__body">
                                            <div>
                                                <label class="form-label form-label-sm mb-1" for="@($"group-{row.GroupId}-building")">Корпус</label>
                                                <select id="@($"group-{row.GroupId}-building")"
                                                        class="form-select form-select-sm"
                                                        value="@(row.PreferredBuildingId?.ToString() ?? string.Empty)"
                                                        @onchange="e => OnGroupBuildingChangedAsync(row, e)"
                                                        disabled="@IsPageInteractionBusy">
                                                    <option value="">Автоматично</option>
                                                    @foreach (var building in GetOrderedBuildings())
                                                    {
                                                        <option value="@building.Id">@building.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                                    <label class="form-label form-label-sm mb-0">Аудиторії</label>
                                                    <span class="small text-muted">@GetSelectedRoomCountLabel(row)</span>
                                                </div>
                                                @if (row.PreferredBuildingId is int buildingId)
                                                {
                                                    <div class="group-room-roomlist">
                                                        @foreach (var room in GetRoomsForBuilding(buildingId))
                                                        {
                                                            if (room.Id is int roomId)
                                                            {
                                                                var isSelected = row.PreferredRoomIds.Contains(roomId);
                                                                <label class="room-chip @(isSelected ? "room-chip--selected" : null)">
                                                                    <input type="checkbox"
                                                                           checked="@isSelected"
                                                                           aria-label="Аудиторія @room.Name для групи @row.Caption"
                                                                           @onchange="e => OnGroupRoomToggleAsync(row, roomId, e)"
                                                                           disabled="@IsPageInteractionBusy" />
                                                                    <span>@room.Name</span>
                                                                </label>
                                                            }
                                                        }
                                                        @if (!GetRoomsForBuilding(buildingId).Any())
                                                        {
                                                            <div class="small text-muted">
                                                                Для цього корпусу немає доступних аудиторій.
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="small text-muted">
                                                        Спочатку оберіть корпус, щоб побачити аудиторії.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted">
                                Спочатку оберіть хоча б одну групу, щоб налаштувати аудиторії для неї.
                            </div>
                        }
                    </details>
                </div>
            }
            else
            {
                <div class="small text-muted mt-3">
                    Оберіть курс, щоб налаштувати групи та аудиторії.
                </div>
            }
                </div>
            </details>
            @if (_selectedCourseId is int)
            {
                <div class="mt-3">
                    @{
                        var moduleWeekTotals = GetModuleWeekTotals();
                    }
                    <div class="fw-semibold">Модулі та пари на діапазон</div>
                    <div class="small text-muted mb-2">
                        План задається для однієї групи. Факт рахується за @GetLoadedWeekRangeLabel() для всіх вибраних груп разом.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 60px;" class="text-center">
                                        <span aria-hidden="true">✓</span>
                                        <span class="visually-hidden">Вибір модуля</span>
                                    </th>
                                    <th scope="col">Модуль</th>
                                    <th scope="col" style="width: 140px;" class="text-center">Пар на групу</th>
                                    <th scope="col" style="width: 190px;" class="text-center">У розкладі та чернетках</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _moduleWeekRows)
                                {
                                    var moduleProgress = GetModuleGeneratedHours(row);
                                    var moduleSelectionId = $"autogen-module-selected-{row.ModuleId}";
                                    var moduleHoursId = $"autogen-module-hours-{row.ModuleId}";
                                    <tr>
                                        <td class="text-center">
                                            <input id="@moduleSelectionId"
                                                   class="form-check-input"
                                                   type="checkbox"
                                                   aria-label="@($"Додати модуль «{row.Caption}» до плану")"
                                                   @bind="row.Selected"
                                                   @bind:after="OnAutoGenConfigurationChangedAsync"
                                                   disabled="@IsPageInteractionBusy" />
                                        </td>
                                        <th scope="row" class="fw-normal">@row.Caption</th>
                                        <td class="text-center">
                                            <input id="@moduleHoursId"
                                                   type="number"
                                                   class="form-control form-control-sm text-center"
                                                   min="0"
                                                   step="1"
                                                   aria-label="@($"Кількість пар на групу для модуля «{row.Caption}»")"
                                                   @bind="row.Hours"
                                                   @bind:after="OnAutoGenConfigurationChangedAsync"
                                                   disabled="@(!row.Selected || IsPageInteractionBusy)" />
                                        </td>
                                        <td class="text-center">
                                            <div class="@GetModuleGeneratedHoursClass(moduleProgress.Generated, moduleProgress.Planned)">
                                                @FormatModuleGeneratedHours(moduleProgress.Generated, moduleProgress.Planned)
                                            </div>
                                            @if (moduleProgress.Missing > 0)
                                            {
                                                <div class="module-generated-hours__missing">бракує @moduleProgress.Missing</div>
                                            }
                                            @if (moduleProgress.Over > 0)
                                            {
                                                <div class="module-generated-hours__over">перебір @moduleProgress.Over</div>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (_moduleWeekRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-2">
                                            Для цього курсу немає доступних модулів.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (moduleWeekTotals.Planned > 0)
                    {
                        <div class="module-week-total @(moduleWeekTotals.Missing > 0 ? "module-week-total--missing" : "module-week-total--complete")">
                            <span>Разом за @GetLoadedWeekRangeLabel():</span>
                            <strong>@moduleWeekTotals.Scheduled із @moduleWeekTotals.Planned пар</strong>
                            @if (moduleWeekTotals.Missing > 0)
                            {
                                <span>Ще не вистачає @moduleWeekTotals.Missing пар.</span>
                            }
                            else
                            {
                                <span>План виконано.</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="small text-muted mt-2">
                    Оберіть курс, щоб налаштувати модулі та кількість пар для автогенерації в обраному діапазоні.
                </div>
            }
            <div class="small text-muted mt-2">
                План замінить незакріплені чернетки вибраних груп у вибраному діапазоні. Закріплені елементи залишаться без змін.
            </div>
            <div class="autogen-submit-panel mt-3">
                <div>
                    <div class="fw-semibold">@GetAutoGenActionSummary()</div>
                    <div id="autogen-plan-action-state" class="small @(GetAutoGenBlockingReason() is null ? "text-muted" : "text-danger")" role="status">
                        @(GetAutoGenBlockingReason() ?? "Спочатку буде створено попередній план без змін у чернетках.")
                    </div>
                </div>
                <button class="btn btn-primary autogen-plan-submit"
                        @onclick="AutoGenDrafts"
                        aria-describedby="autogen-plan-action-state"
                        disabled="@(!CanAutoGen || IsPageInteractionBusy)">
                    Сформувати план
                </button>
            </div>
        </div>
        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@ok</div>
        @if (!string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert autogen-result-alert @AutoGenOutcomeAlertCssClass mt-3">
                <div class="d-flex flex-column gap-2">
                    @{
                        var warningsTotal = _latestWarningDetails.Count;
                        var actionableWarningsTotal = _latestWarningDetails.Count(detail =>
                            !string.Equals(detail.Severity, AutoGenWarningSeverities.Info, StringComparison.OrdinalIgnoreCase));
                        var gapSummary = _latestGapSummary;
                        var preflightItems = _latestPreflight;
                        var report = _latestAutoGenReport;
                        var actionItems = BuildAutoGenActionItems(gapSummary, preflightItems, _latestGapDetails);
                        var outcome = BuildAutoGenOutcomeSummary(ok, report, _latestAutoGenPlan, gapSummary, preflightItems, _latestGapDetails, actionableWarningsTotal, actionItems);
                        var gapRows = _latestGapDetails
                            .OrderBy(gap => gap.Date)
                            .ThenBy(gap => gap.GroupName, StringComparer.Ordinal)
                            .ThenBy(gap => gap.Start)
                            .Take(10)
                            .ToList();
                        var hiddenGapRows = Math.Max(0, _latestGapDetails.Count - gapRows.Count);
                        var hasAutoGenIssues = warningsTotal > 0 || actionItems.Count > 0 || gapRows.Count > 0;
                    }
                    @if (outcome is not null)
                    {
                        <div class="autogen-outcome @outcome.CssClass">
                            <div class="autogen-outcome__head">
                                <div>
                                    <div class="autogen-outcome__status">@outcome.StatusLabel</div>
                                    <div class="autogen-outcome__title">@outcome.Headline</div>
                                    <div class="autogen-outcome__message">@outcome.Detail</div>
                                </div>
                            </div>
                            <div class="autogen-outcome__metrics">
                                @foreach (var metric in outcome.Metrics)
                                {
                                    <div class="autogen-outcome-metric @(metric.IsProblem ? "autogen-outcome-metric--problem" : null)">
                                        <span>@metric.Label:</span>@(" ")
                                        <strong>@metric.Value</strong>
                                        @if (!string.IsNullOrWhiteSpace(metric.Hint))
                                        {
                                            @(" ")
                                            <small>(@metric.Hint)</small>
                                        }
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(outcome.HotspotText))
                            {
                                <div class="autogen-outcome__hotspot">@outcome.HotspotText</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div>@ok</div>
                    }
                    @if (_appliedPlanReviewContext is { } reviewContext)
                    {
                        <div class="autogen-review-transition">
                            <div>
                                <div class="fw-semibold">План прийнято — перевірте чернетку перед публікацією</div>
                                <div class="small">
                                    Відкриємо тиждень @reviewContext.WeekStart.ToString("dd.MM.yyyy") та збережемо обраний курс.
                                </div>
                            </div>
                            <button type="button"
                                    class="btn btn-primary"
                                    @onclick="OpenAppliedDraftsReview">
                                Перейти до перевірки чернетки
                            </button>
                        </div>
                    }
                    @if (_latestAutoGenPlan is { } latestPlan)
                    {
                        <div class="small border rounded-2 bg-light p-2">
                            <div class="fw-semibold">Перелік змін · @GetAutoGenPlanStateLabel(latestPlan.State)</div>
                            @if (latestPlan.DeleteCount > 0)
                            {
                                <div class="text-danger mt-2">
                                    Видалення охоплює всі незаблоковані чернетки вибраних груп у діапазоні, зокрема модулі поза поточним списком.
                                </div>
                            }
                            @if (_latestAutoGenPlanChanges.Count > 0)
                            {
                                var shownPlanChanges = _latestAutoGenPlanChanges
                                    .OrderBy(change => GetAutoGenPlanOperationOrder(change.Operation))
                                    .ThenBy(change => change.Before?.Date ?? change.After?.Date)
                                    .ThenBy(change => change.Before?.TimeStart ?? change.After?.TimeStart, StringComparer.Ordinal)
                                    .Take(50)
                                    .ToList();
                                <details class="mt-2">
                                    <summary>Переглянути заняття у плані (@_latestAutoGenPlanChanges.Count)</summary>
                                    <ul class="mb-0 mt-2">
                                        @foreach (var planChange in shownPlanChanges)
                                        {
                                            <li>@BuildAutoGenPlanChangeLabel(planChange)</li>
                                        }
                                    </ul>
                                    @if (shownPlanChanges.Count < _latestAutoGenPlanChanges.Count)
                                    {
                                        <div class="text-muted mt-1">Показано 50 із @_latestAutoGenPlanChanges.Count змін.</div>
                                    }
                                </details>
                            }
                        </div>
                    }
                    @if (hasAutoGenIssues)
                    {
                        <div class="autogen-next-steps small">
                            <div class="fw-semibold">@(actionableWarningsTotal > 0 || actionItems.Count > 0 || gapRows.Count > 0 ? "Що перевірити" : "Деталі результату")</div>
                            @if (actionItems.Count > 0)
                            {
                                <ol class="autogen-action-list mb-0">
                                    @foreach (var action in actionItems)
                                    {
                                        <li>@action</li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <div>
                                    @(actionableWarningsTotal > 0
                                        ? "Автогенерація залишила проблемні місця. Почніть з групи, модуля та часу в таблиці нижче."
                                        : "Сервер додав інформаційні повідомлення про виконану операцію.")
                                </div>
                            }
                            @if (gapRows.Count > 0)
                            {
                                <details class="autogen-detail-panel mt-2">
                                    <summary>Показати пари, які не вдалося поставити (@_latestGapDetails.Count)</summary>
                                    <div class="table-responsive mt-2">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Дата</th>
                                                <th>Група</th>
                                                <th>Слот</th>
                                                <th>Модуль</th>
                                                <th>Що не так</th>
                                                <th>Що зробити</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var gap in gapRows)
                                            {
                                                var diagnosis = BuildGapDiagnosis(gap);
                                                <tr>
                                                    <td>@gap.Date.ToString("dd.MM.yyyy")</td>
                                                    <td>@gap.GroupName</td>
                                                    <td>@gap.SlotLabel</td>
                                                    <td>@BuildGapModuleLabel(gap)</td>
                                                    <td>@diagnosis.MainReason</td>
                                                    <td>@diagnosis.Action</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (hiddenGapRows > 0)
                                    {
                                        <div class="text-muted mt-1">Показано 10 із @_latestGapDetails.Count, решта є в журналі автогенерації.</div>
                                    }
                                </details>
                            }
                        </div>
                        @if (warningsTotal > 0)
                        {
                            <div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-dark"
                                        @onclick="ToggleOkWarnings">
                                    @(okWarningsExpanded
                                        ? "Сховати технічні деталі"
                                        : $"Технічні деталі ({warningsTotal})")
                                </button>
                            </div>
                            @if (okWarningsExpanded)
                            {
                                <ul class="mb-0 mt-1 small">
                            @foreach (var warningDetail in OrderWarningDetails(_latestWarningDetails))
                            {
                                var parsedWarning = ParseWarning(warningDetail.Message);
                                <li class="warning-item">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="badge @GetWarningSeverityBadgeClass(warningDetail.Severity)">@GetWarningSeverityLabel(warningDetail.Severity)</span>
                                        <span class="badge autogen-warning-meta-badge">@warningDetail.Category / @warningDetail.Code</span>
                                    </div>
                                    <div class="warning-main mt-1">@parsedWarning.Message</div>
                                    @if (!string.IsNullOrWhiteSpace(parsedWarning.Reason))
                                    {
                                        <div class="warning-reason">Причина: @parsedWarning.Reason</div>
                                        <div class="warning-consequence">Наслідок: цю пару потрібно поставити вручну або перерозподілити навчальний час.</div>
                                    }
                                    @if (warningDetail.Context is { Count: > 0 })
                                    {
                                        <details class="mt-1">
                                            <summary>Контекст</summary>
                                            <dl class="row mb-0 mt-1">
                                                @foreach (var contextItem in warningDetail.Context.OrderBy(item => item.Key, StringComparer.Ordinal))
                                                {
                                                    <dt class="col-sm-4">@contextItem.Key</dt>
                                                    <dd class="col-sm-8">@contextItem.Value</dd>
                                                }
                                            </dl>
                                        </details>
                                    }
                                </li>
                            }
                                </ul>
                            }
                        }
                    }
                    @if (_latestAutoGenPlan?.CanApply == true)
                    {
                        <div class="border rounded-2 bg-white p-2">
                            <div class="small mb-2">
                                Перегляньте зміни та попередження. Сервер не прийме план, якщо чернетки вже змінилися.
                            </div>
                            <button class="btn btn-success" @onclick="ApplyLatestAutoGenPlanAsync" disabled="@IsPageInteractionBusy">
                                Прийняти план
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3" role="alert">@error</div>
        }
        <div class="schedule-table-header mt-4 pt-3 border-top">
            <div>
                <h2 class="h6 mb-1">Таблиця тижня</h2>
                <div class="small text-muted">
                    Вибрана дата змінює лише таблицю та очищення цього тижня. Діапазон формування плану налаштовується вище окремо.
                </div>
            </div>
            <div class="schedule-table-week-field">
                <label class="form-label small mb-1" for="admin-schedule-week-date">Дата в потрібному тижні</label>
                <input id="admin-schedule-week-date"
                       type="date"
                       class="form-control"
                       value="@_selectedDate.ToString("yyyy-MM-dd")"
                       @onchange="OnDateChanged"
                       disabled="@IsPageInteractionBusy" />
            </div>
            <details class="schedule-table-danger-actions">
                <summary>Очищення тижня</summary>
                <div class="schedule-table-danger-panel">
                    <div class="small text-muted mb-2">
                        Курс: @(SelectedAutoGenCourse?.Name ?? "не обрано"). Дії стосуються лише @GetMonday(_selectedDate).ToString("dd.MM.yyyy")–@GetMonday(_selectedDate).AddDays(6).ToString("dd.MM.yyyy") і не змінюють діапазон формування плану.
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="ClearWeekForCurrent"
                                disabled="@(_selectedCourseId is null || IsPageInteractionBusy)">
                            Очистити чернетки обраного курсу
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="ClearWeekOfficial"
                                disabled="@(_selectedCourseId is null || IsPageInteractionBusy)">
                            Очистити розклад обраного курсу
                        </button>
                    </div>
                </div>
            </details>
        </div>
        @if (IsWeekContextLoading)
        {
            <div class="alert alert-info mt-3 d-flex align-items-center gap-2" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Завантажуємо вибраний тиждень…</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_weekContextLoadError))
        {
            <div class="alert alert-danger mt-3" role="alert">
                <div class="fw-semibold">Не вдалося оновити таблицю тижня</div>
                <div class="small mt-1">@_weekContextLoadError</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="RetryVisibleWeekContextAsync"
                        disabled="@(IsAutoGenBusy || _editDeleting || IsWeekContextLoading)">
                    Спробувати ще раз
                </button>
            </div>
        }
        else
        {
        @if (_currentConflict is not null)
        {
            <div class="alert alert-warning mt-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <strong>Остання помилка:</strong> @_currentConflict.Message
                        <div class="small text-muted">
                            Тиждень @GetMonday(_selectedDate).ToString("dd.MM.yyyy") – @GetMonday(_selectedDate).AddDays(6).ToString("dd.MM.yyyy").<br />
                            Збережено @_currentConflict.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm").
                        </div>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleConflictDetails">
                            @_currentConflict.ToggleLabel
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearConflictDetails">
                            Очистити
                        </button>
                    </div>
                </div>
                @if (_currentConflict.Expanded && _currentConflict.Errors.Count > 0)
                {
                    <ul class="mt-2 mb-0">
                        @foreach (var err in _currentConflict.Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                }
                @if (_currentConflict.Expanded && _currentConflict.Warnings.Count > 0)
                {
                    <div class="mt-2">
                        <div class="fw-semibold">Попередження:</div>
                        <ul class="mb-0">
                            @foreach (var warn in _currentConflict.Warnings)
                            {
                                <li class="text-muted">@warn</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        var rows = ViewItems.ToList();
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mt-3">
            <div class="small text-muted">
                Показано @rows.Count із @tableItems.Count записів.
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshVisibleWeekAsync" disabled="@IsPageInteractionBusy">
                    Оновити таблицю
                </button>
                <AdminSearchBox @bind-Value="_search" Style="max-width:360px;" Placeholder="Id, група, модуль, викладач, аудиторія..." />
            </div>
        </div>
        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <SortableHeader Field="@SortById" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Id</SortableHeader>
                        <SortableHeader Field="@SortByDate" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Дата</SortableHeader>
                        <SortableHeader Field="@SortByTime" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Час</SortableHeader>
                        <SortableHeader Field="@SortByGroup" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Група</SortableHeader>
                        <SortableHeader Field="@SortByModule" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Модуль</SortableHeader>
                        <SortableHeader Field="@SortByTeacher" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Викладач</SortableHeader>
                        <SortableHeader Field="@SortByRoom" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Аудиторія</SortableHeader>
                        <SortableHeader Field="@SortByLessonType" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Тип</SortableHeader>
                        <SortableHeader Field="@SortByStatus" ActiveField="@_sortField" SortAscending="@_sortAsc" OnSort="@ToggleSort">Статус</SortableHeader>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rows.Count > 0)
                    {
                        foreach (var item in rows)
                        {
                            var isBreak = IsBreak(item.LessonTypeId);
                            var isCanceled = IsCanceled(item.LessonTypeId);
                            <tr class="@(isBreak ? "table-light" : null)">
                                <td>@item.Id</td>
                                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                <td>@item.TimeStart-@item.TimeEnd</td>
                                <td>@(isCanceled ? "-" : item.Group)</td>
                                <td>
                                    @if (isBreak || isCanceled)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        var moduleCourse = ModuleCourseCaption(item.ModuleId);
                                        <div>
                                            <div>@(item.Module ?? "-")</div>
                                            @if (!string.IsNullOrWhiteSpace(moduleCourse))
                                            {
                                                <div class="text-muted small" style="margin-top:.1rem;">@moduleCourse</div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@(isBreak || isCanceled ? "-" : (item.Teacher ?? "-"))</td>
                                <td>@(isCanceled ? "-" : (item.Room ?? "-"))</td>
                                <td>@item.LessonTypeName</td>
                                <td>@item.StatusText</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => OpenEditor(item)"
                                            disabled="@IsPageInteractionBusy">
                                        Редактор
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-3">
                                Даних не знайдено для вибраних критеріїв.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_editItem is not null)
        {
            var selected = _editItem!;
            <AdminEditorModal Title="Редактор заняття"
                              Subtitle="@($"{selected.SourceLabel} — ID {selected.Id}")"
                              CssClass="lesson-editor"
                              Busy="@_editDeleting"
                              OnClose="@CloseEditor">
                    <div class="lesson-editor-grid small">
                        <div>
                            <div class="lesson-editor-label">Дата</div>
                            <div>@selected.Date.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Час</div>
                            <div>@selected.TimeStart-@selected.TimeEnd</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Група</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Group) ? "-" : selected.Group)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Модуль</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Module) ? "-" : selected.Module)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Викладач</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Teacher) ? "-" : selected.Teacher)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Аудиторія</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Room) ? "-" : selected.Room)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Тип</div>
                            <div>@selected.LessonTypeName</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Статус</div>
                            <div>@selected.StatusText</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Блокування</div>
                            <div>@(selected.IsLocked ? "Так" : "Ні")</div>
                        </div>
                    </div>
                    @if (selected.NeedsManualAssignment)
                    {
                        <div class="alert alert-warning mt-3 mb-0" role="status">
                            Для цієї чернетки ще потрібно призначити: @selected.MissingAssignmentSummary.
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_editError))
                    {
                        <div class="alert alert-danger mt-2" role="alert">@_editError</div>
                    }
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (selected.Source == TableItemSource.Draft)
                        {
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="() => OpenDraftsEditor(selected)"
                                    disabled="@_editDeleting">
                                Редагувати у повному редакторі
                            </button>
                        }
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="DeleteSelectedAsync"
                                disabled="@_editDeleting">
                            @if (_editDeleting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            <span>Видалити</span>
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CloseEditor"
                                disabled="@_editDeleting">
                            Закрити
                        </button>
                    </div>
            </AdminEditorModal>
        }
        }
    </div>
}

@code
{
    [Parameter, SupplyParameterFromQuery(Name = "weekStart")]
    public string? QueryWeekStart { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "courseId")]
    public int? QueryCourseId { get; set; }

