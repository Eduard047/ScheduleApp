@* Сторінка адміністрування розкладу *@
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using BlazorWasmDotNet8AspNetCoreHosted.Client.Services
@using BlazorWasmDotNet8AspNetCoreHosted.Shared.DTOs

@inject IScheduleApi Api
@inject ITeacherDraftsApi Drafts
@inject IJSRuntime JS
@inject AdminScheduleLogService LogService

<style>
    .gap-detail-item {
        padding: .3rem 0;
        border-bottom: 1px dashed rgba(10, 120, 65, 0.3);
    }
    .gap-detail-item:last-child {
        border-bottom: none;
    }
    .gap-reason {
        font-weight: 700;
        color: #064e3b;
        margin: .15rem 0 0 1rem;
    }
    .gap-consequence {
        font-size: .85rem;
        color: #0f172a;
        margin: .1rem 0 0 1.25rem;
    }
    .warning-item {
        padding: .25rem 0;
        border-bottom: 1px solid rgba(56, 189, 248, 0.3);
    }
    .warning-item:last-child {
        border-bottom: none;
    }
    .warning-main {
        font-weight: 600;
        color: #0f766e;
    }
    .warning-reason {
        font-size: .85rem;
        color: #0f172a;
        margin-left: 1rem;
        margin-top: .1rem;
    }
    .warning-consequence {
        font-size: .8rem;
        color: #115e59;
        margin-left: 1.25rem;
        margin-top: .05rem;
    }
    .contiguous-module-block-warning {
        border-left: 4px solid #b45309;
        background: #fffbeb;
        color: #78350f;
        border-radius: .35rem;
        padding: .45rem .65rem;
    }
    .lesson-editor-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 72px 16px 24px;
        z-index: 1050;
    }
    .lesson-editor {
        width: min(720px, 100%);
        border-radius: 12px;
        box-shadow: 0 24px 50px rgba(15, 23, 42, 0.25);
    }
    .lesson-editor-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .lesson-editor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
    }
    .lesson-editor-label {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .02em;
        color: #64748b;
        margin-bottom: 2px;
    }
</style>

@page "/admin/schedule"

<h3 class="mb-3">Редактор розкладу → Чернетки викладачів</h3>

@if (meta is null)
{
    <div>Завантаження...</div>
}
else
{
    <div class="card p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label">Дні тижня:</label>
                <select class="form-select" @bind="_daysPreset">
                    <option value="@WeekPreset.MonFri">Пн–Пт</option>
                    <option value="@WeekPreset.MonSat">Пн–Сб</option>
                    <option value="@WeekPreset.MonSun">Пн–Нд</option>
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label">Дата тижня:</label>
                <input type="date"
                       class="form-control"
                       value="@_selectedDate.ToString("yyyy-MM-dd")"
                       @onchange="OnDateChanged" />
            </div>
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label">Дії з даними:</label>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-grow-1" @onclick="LoadWeek">
                        Оновити таблицю
                    </button>
                </div>
            </div>
        </div>
        <div class="mt-3 border rounded-3 p-3 bg-light">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="fw-semibold mb-1">Генерація у чернетки</div>
                    <div class="small text-muted">@GetGenerationRangeDescription()</div>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-stretch">
                    <div style="min-width: 180px;">
                        <label class="form-label small mb-1">Від дати</label>
                        <input type="date"
                               class="form-control"
                               value="@_generationFromDate.ToString("yyyy-MM-dd")"
                               @onchange="OnGenerationFromDateChanged" />
                    </div>
                    <div style="min-width: 180px;">
                        <label class="form-label small mb-1">До дати</label>
                        <input type="date"
                               class="form-control"
                               value="@_generationToDate.ToString("yyyy-MM-dd")"
                               @onchange="OnGenerationToDateChanged" />
                    </div>
                    <select class="form-select flex-grow-1 flex-md-grow-0"
                            style="min-width: 220px;"
                            @bind="_selectedCourseId"
                            @bind:after="OnSelectedCourseChanged">
                        <option value="">Оберіть курс</option>
                        @foreach (var course in meta.Courses.OrderBy(c => c.Name))
                        {
                            <option value="@course.Id">@course.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-primary" @onclick="AutoGenDrafts" disabled="@(!CanAutoGen)">
                        Автогенерація (у чернетки)
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="FillWeekDrafts" disabled="@(!CanAutoGen)">
                        Заповнити порожні слоти
                    </button>
                    <button class="btn btn-outline-danger" @onclick="ClearWeekForCurrent">
                        Очистити тиждень (чернетки, всі групи)
                    </button>
                    <button class="btn btn-danger" @onclick="ClearWeekOfficial">
                        Очистити тиждень (розклад, всі групи)
                    </button>
                </div>
            </div>
            @if (_selectedCourseId is int)
            {
                <div class="mt-3">
                    <div class="fw-semibold mb-2">Модулі та години на тиждень</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 60px;" class="text-center">✓</th>
                                    <th>Модуль</th>
                                    <th style="width: 140px;" class="text-center">Годин</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _moduleWeekRows)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   @bind="row.Selected"
                                                   @bind:after="PersistAutoGenConfigAsync" />
                                        </td>
                                        <td>@row.Caption</td>
                                        <td class="text-center">
                                            <input type="number"
                                                   class="form-control form-control-sm text-center"
                                                   min="0"
                                                   step="1"
                                                   @bind="row.Hours"
                                                   @bind:after="PersistAutoGenConfigAsync"
                                                   disabled="@(!row.Selected)" />
                                        </td>
                                    </tr>
                                }
                                @if (_moduleWeekRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-2">
                                            Для цього курсу немає доступних модулів.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="small text-muted mt-2">
                        Вкажіть, які модулі мають бути на поточному тижні, і скільки годин потрібно згенерувати для всіх груп курсу.
                    </div>
                </div>
            }
            else
            {
                <div class="small text-muted mt-2">
                    Оберіть курс, щоб налаштувати модулі та години для автогенерації в обраному діапазоні.
                </div>
            }
            <div class="small text-muted mt-2">
                Чернетки оновлюються одразу для всіх груп у вибраному діапазоні. Закріплені елементи залишаються без змін.<br />
                Розклад очищується окремо і не зачіпає закріплені заняття.
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success mt-3">
                <div class="d-flex flex-column gap-2">
                    <div>@ok</div>
                    @{
                        var warningsTotal = okWarnings.Count + _latestGapDetails.Count;
                        var contiguousModuleBlockWarnings = CountContiguousModuleBlockWarnings();
                    }
                    @if (warningsTotal > 0)
                    {
                        @if (contiguousModuleBlockWarnings > 0)
                        {
                            <div class="contiguous-module-block-warning small">
                                <div class="fw-semibold">Окреме попередження про суцільний блок модуля</div>
                                <div>
                                    Виявлено @contiguousModuleBlockWarnings випадок(ів), коли автогенерація не заповнила слот через правило:
                                    один модуль у межах дня ставиться суцільним блоком.
                                </div>
                            </div>
                        }
                        <div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-dark"
                                    @onclick="ToggleOkWarnings">
                                @(okWarningsExpanded
                                    ? "Сховати попередження"
                                    : $"Попередження ({warningsTotal})")
                            </button>
                        </div>
                        @if (okWarningsExpanded)
                        {
                            <ul class="mb-0 mt-1 small">
                        @foreach (var warn in okWarnings)
                        {
                            var detail = ParseWarning(warn);
                            <li class="warning-item">
                                <div class="warning-main">@detail.Message</div>
                                @if (!string.IsNullOrWhiteSpace(detail.Reason))
                                {
                                    <div class="warning-reason">Причина: @detail.Reason</div>
                                    <div class="warning-consequence">Наслідок: слот потрібно заповнити вручну або перерозподілити години.</div>
                                }
                            </li>
                        }
                            </ul>
                        }
                    }
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }
        @if (_currentConflict is not null)
        {
            <div class="alert alert-warning mt-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <strong>Остання помилка:</strong> @_currentConflict.Message
                        <div class="small text-muted">
                            Тиждень @GetMonday(_selectedDate).ToString("dd.MM.yyyy") – @GetMonday(_selectedDate).AddDays(6).ToString("dd.MM.yyyy").<br />
                            Збережено @_currentConflict.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm").
                        </div>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleConflictDetails">
                            @_currentConflict.ToggleLabel
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearConflictDetails">
                            Очистити
                        </button>
                    </div>
                </div>
                @if (_currentConflict.Expanded && _currentConflict.Errors.Count > 0)
                {
                    <ul class="mt-2 mb-0">
                        @foreach (var err in _currentConflict.Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                }
                @if (_currentConflict.Expanded && _currentConflict.Warnings.Count > 0)
                {
                    <div class="mt-2">
                        <div class="fw-semibold">Попередження:</div>
                        <ul class="mb-0">
                            @foreach (var warn in _currentConflict.Warnings)
                            {
                                <li class="text-muted">@warn</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        @{
            var rows = ViewItems.ToList();
        }
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mt-3">
            <div class="small text-muted">
                Показано @rows.Count із @tableItems.Count записів.
            </div>
            <div class="input-group" style="max-width:360px;">
                <span class="input-group-text">Пошук</span>
                <input class="form-control"
                       placeholder="Id, група, модуль, викладач, аудиторія..."
                       @bind="_search"
                       @bind:event="oninput" />
            </div>
        </div>
        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortById)">Id @HeaderIcon(SortById)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByDate)">Дата @HeaderIcon(SortByDate)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByTime)">Час @HeaderIcon(SortByTime)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByGroup)">Група @HeaderIcon(SortByGroup)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByModule)">Модуль @HeaderIcon(SortByModule)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByTeacher)">Викладач @HeaderIcon(SortByTeacher)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByRoom)">Аудиторія @HeaderIcon(SortByRoom)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByLessonType)">Тип @HeaderIcon(SortByLessonType)</th>
                        <th class="sortable-th" role="button" @onclick="() => ToggleSort(SortByStatus)">Статус @HeaderIcon(SortByStatus)</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rows.Count > 0)
                    {
                        foreach (var item in rows)
                        {
                            var isBreak = IsBreak(item.LessonTypeId);
                            var isCanceled = IsCanceled(item.LessonTypeId);
                            <tr class="@(isBreak ? "table-light" : null)">
                                <td>@item.Id</td>
                                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                <td>@item.TimeStart-@item.TimeEnd</td>
                                <td>@(isCanceled ? "-" : item.Group)</td>
                                <td>
                                    @if (isBreak || isCanceled)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        var moduleCourse = ModuleCourseCaption(item.ModuleId);
                                        <div>
                                            <div>@(item.Module ?? "-")</div>
                                            @if (!string.IsNullOrWhiteSpace(moduleCourse))
                                            {
                                                <div class="text-muted small" style="margin-top:.1rem;">@moduleCourse</div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@(isBreak || isCanceled ? "-" : (item.Teacher ?? "-"))</td>
                                <td>@(isCanceled ? "-" : (item.Room ?? "-"))</td>
                                <td>@item.LessonTypeName</td>
                                <td>@item.StatusText</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => OpenEditor(item)">
                                        Редактор
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-3">
                                Даних не знайдено для вибраних критеріїв.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_editItem is not null)
        {
            var selected = _editItem!;
            <div class="lesson-editor-overlay" @onclick="CloseEditor">
                <div class="lesson-editor card p-3" @onclick:stopPropagation="true">
                    <div class="lesson-editor-head">
                        <div>
                            <div class="fw-semibold">Редактор заняття</div>
                            <div class="text-muted small">@selected.SourceLabel - ID @selected.Id</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseEditor">x</button>
                    </div>
                    <div class="lesson-editor-grid small">
                        <div>
                            <div class="lesson-editor-label">Дата</div>
                            <div>@selected.Date.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Час</div>
                            <div>@selected.TimeStart-@selected.TimeEnd</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Група</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Group) ? "-" : selected.Group)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Модуль</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Module) ? "-" : selected.Module)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Викладач</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Teacher) ? "-" : selected.Teacher)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Аудиторія</div>
                            <div>@(string.IsNullOrWhiteSpace(selected.Room) ? "-" : selected.Room)</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Тип</div>
                            <div>@selected.LessonTypeName</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Статус</div>
                            <div>@selected.StatusText</div>
                        </div>
                        <div>
                            <div class="lesson-editor-label">Блокування</div>
                            <div>@(selected.IsLocked ? "Так" : "Ні")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_editError))
                    {
                        <div class="alert alert-danger mt-2">@_editError</div>
                    }
                    <div class="d-flex gap-2 mt-3">
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="DeleteSelectedAsync"
                                disabled="@_editDeleting">
                            @if (_editDeleting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            <span>Видалити</span>
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CloseEditor"
                                disabled="@_editDeleting">
                            Закрити
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code
{
    private MetaResponseDto? meta;
    private int breakTypeId;
    private int canceledTypeId;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _generationFromDate = GetMonday(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly _generationToDate = GetMonday(DateOnly.FromDateTime(DateTime.Today));
    private WeekPreset _daysPreset = WeekPreset.MonFri;
    private int? _selectedCourseId;
    private readonly List<ModuleWeekRow> _moduleWeekRows = new();
    private string? ok;
    private string? error;
    private List<string> okWarnings = new();
    private bool okWarningsExpanded;
    private List<AutoGenGapDetail> _latestGapDetails = new();
    private const string AutoGenStatusStorageKey = "adminSchedule.autoGenStatus.v1";
    private const string AutoGenStatusLocalStorageKey = "adminSchedule.autoGenStatus.local.v1";
    private const string AutoGenConfigStorageKey = "adminSchedule.autoGenConfig.v1";
    private const string AutoGenConfigLocalStorageKey = "adminSchedule.autoGenConfig.local.v1";
    private const int LogLessonLimit = 300;
    private const string LogActionAutogen = "autogen-week";
    private const string LogActionFill = "fill-week";
    private const string LogActionClearDrafts = "clear-drafts-week";
    private const string LogActionClearSchedule = "clear-schedule-week";
    private const string LogActionDelete = "delete-item";
    private const string ContiguousModuleBlockReasonMarker = "суцільним блоком без повернення після перемикання на інший модуль";
    private static readonly JsonSerializerOptions AutoGenStatusJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private readonly List<TeacherDraftItemDto> draftItems = new();
    private readonly List<ScheduleItemDto> publishedItems = new();
    private readonly List<TableItem> tableItems = new();
    private TableItem? _editItem;
    private bool _editDeleting;
    private string? _editError;
    private string _search = string.Empty;
    private string _sortField = SortByDate;
    private bool _sortAsc = true;
    private ConflictDetails? _currentConflict;
    private Dictionary<string, ConflictDetails> _conflictStorage = new();
    private bool _conflictsLoaded;
    private Dictionary<DateOnly, bool> _calendarLookup = new();
    private const string ConflictStorageKey = "adminSchedule.conflicts.v1";
    private static readonly JsonSerializerOptions ConflictJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };
    private const string SortById = nameof(TeacherDraftItemDto.Id);
    private const string SortByDate = nameof(TeacherDraftItemDto.Date);
    private const string SortByTime = nameof(TeacherDraftItemDto.TimeStart);
    private const string SortByGroup = nameof(TeacherDraftItemDto.Group);
    private const string SortByModule = nameof(TeacherDraftItemDto.Module);
    private const string SortByTeacher = nameof(TeacherDraftItemDto.Teacher);
    private const string SortByRoom = nameof(TeacherDraftItemDto.Room);
    private const string SortByLessonType = nameof(TeacherDraftItemDto.LessonTypeName);
    private const string SortByStatus = nameof(TeacherDraftItemDto.Status);
    // Початкове завантаження метаданих і станів сторінки.
    protected override async Task OnInitializedAsync()
    {
        meta = await Api.GetMeta();
        if (meta is null)
        {
            error = "Не вдалося завантажити метадані.";
            return;
        }
        _calendarLookup = meta.Calendar
            .Where(c => c.CourseId is null && c.GroupId is null)
            .Select(c => new { Date = DateOnly.ParseExact(c.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture), c.IsWorkingDay })
            .GroupBy(x => x.Date)
            .ToDictionary(g => g.Key, g => g.First().IsWorkingDay);
        var selectedWeekStart = GetMonday(_selectedDate);
        _generationFromDate = selectedWeekStart;
        _generationToDate = selectedWeekStart;
        await RestorePersistedAutoGenConfigAsync(restoreCourseSelection: true);
        if (_selectedCourseId is null && meta.Courses.Count == 1)
        {
            _selectedCourseId = meta.Courses[0].Id;
            BuildModuleWeekRows();
        }
        breakTypeId = meta.LessonTypes.FirstOrDefault(x => x.Code == "BREAK")?.Id ?? 0;
        canceledTypeId = meta.LessonTypes.FirstOrDefault(x => x.Code == "CANCELED")?.Id ?? 0;
        await LoadConflictsAsync();
        await LoadWeek();
        await RestorePersistedAutoGenStatusAsync();
    }
    private string CurrentWeekKey => GetMonday(_selectedDate).ToString("yyyy-MM-dd");
    private bool IsBreak(int lessonTypeId) => lessonTypeId == breakTypeId;
    private bool IsCanceled(int lessonTypeId) => lessonTypeId == canceledTypeId;
    private bool CanAutoGen
        => _selectedCourseId is int
           && _moduleWeekRows.Any(row => row.Selected && row.Hours > 0);
    // Реагує на зміну обраного курсу для автогенерації.
    private async Task OnSelectedCourseChanged()
    {
        BuildModuleWeekRows();
        await RestorePersistedAutoGenConfigAsync(restoreCourseSelection: false);
        await PersistAutoGenConfigAsync();
    }
    // Формує список модулів та годин для поточного курсу.
    private void BuildModuleWeekRows()
    {
        _moduleWeekRows.Clear();
        if (meta is null || _selectedCourseId is not int courseId)
        {
            return;
        }
        var modules = meta.Modules
            .Where(m => m.CourseId == courseId || m.CourseIds.Contains(courseId))
            .OrderBy(m => m.Code)
            .ThenBy(m => m.Name)
            .Select(m => new ModuleWeekRow(m.Id, $"{m.Code} — {m.Name}"))
            .ToList();
        _moduleWeekRows.AddRange(modules);
    }
    // Формує опис діапазону тижня для генерації.
    private string GetGenerationRangeDescription()
    {
        var (fromDate, toDate) = GetNormalizedGenerationDateRange();
        var totalWeeks = BuildGenerationWeekStarts().Count;
        var fromWeekStart = GetMonday(fromDate);
        if (totalWeeks == 1 && fromDate == fromWeekStart && toDate == fromWeekStart.AddDays(6))
        {
            return $"Тиждень: {fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy}";
        }
        return $"Діапазон: {fromDate:dd.MM.yyyy} – {toDate:dd.MM.yyyy} ({totalWeeks} тижн.)";
    }
    // Нормалізує межі генерації до стартів тижня (понеділок).
    private (DateOnly FromWeekStart, DateOnly ToWeekStart) GetNormalizedGenerationWeekRange()
    {
        var fromWeekStart = GetMonday(_generationFromDate);
        var toWeekStart = GetMonday(_generationToDate);
        if (toWeekStart < fromWeekStart)
        {
            (fromWeekStart, toWeekStart) = (toWeekStart, fromWeekStart);
        }
        return (fromWeekStart, toWeekStart);
    }
    // Нормалізує фактичні межі діапазону генерації за датами.
    private (DateOnly FromDate, DateOnly ToDate) GetNormalizedGenerationDateRange()
    {
        var fromDate = _generationFromDate;
        var toDate = _generationToDate;
        if (toDate < fromDate)
        {
            (fromDate, toDate) = (toDate, fromDate);
        }
        return (fromDate, toDate);
    }
    // Формує список стартів тижня для автогенерації.
    private List<DateOnly> BuildGenerationWeekStarts()
    {
        var (fromWeekStart, toWeekStart) = GetNormalizedGenerationWeekRange();
        var weekStarts = new List<DateOnly>();
        for (var week = fromWeekStart; week <= toWeekStart; week = week.AddDays(7))
        {
            weekStarts.Add(week);
        }
        return weekStarts;
    }
    // Скидає статуси повідомлень та, за потреби, збережений стан.
    private async Task ResetStatusAsync(bool clearPersisted = true)
    {
        ok = error = null;
        okWarnings = new();
        okWarningsExpanded = false;
