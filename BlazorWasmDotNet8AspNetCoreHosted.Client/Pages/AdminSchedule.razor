    private async Task DeleteSelectedAsync()
    {
        if (_editItem is null || IsWeekContextLoading)
        {
            return;
        }
        var current = _editItem;
        var confirmText = current.Source == TableItemSource.Draft
            ? $"Видалити чернетку #{current.Id}? Дію не можна скасувати."
            : $"Видалити запис розкладу #{current.Id}? Дію не можна скасувати.";
        if (current.Source == TableItemSource.Draft && current.IsLocked)
        {
            confirmText = $"Чернетка #{current.Id} заблокована. Видалити її попри блокування?";
        }
        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed)
        {
            return;
        }
        await ResetStatusAsync(clearPersisted: false);
        _editDeleting = true;
        _editError = null;
        try
        {
            if (current.Source == TableItemSource.Draft)
            {
                await Drafts.Delete(current.Id, current.Revision, confirm: true, unrestricted: current.IsLocked);
            }
            else
            {
                await Api.Delete(current.Id, current.Revision);
            }
            var rangeRefreshWarning = await RemoveTableItemFromStateAsync(current);
            var summary = $"Видалено заняття #{current.Id}.";
            await SetOkMessageAsync(
                summary,
                rangeRefreshWarning is null ? null : new[] { rangeRefreshWarning },
                persist: false);
            await LogDeleteAsync(summary, current);
            CloseEditor();
        }
        catch (ApiErrorException ex)
        {
            await HandleApiError(ex);
            _editError = error ?? "Сталася помилка під час видалення заняття.";
        }
        catch (Exception)
        {
            _editError = "Сталася помилка під час видалення заняття.";
        }
        finally
        {
            _editDeleting = false;
            if (_queryContextApplyPending)
            {
                _ = InvokeAsync(ApplyPendingQueryContextAsync);
            }
        }
    }
    // Обробляє зміну дати тижня.
    private async Task OnDateChanged(ChangeEventArgs args)
    {
        if (IsPageInteractionBusy)
        {
            return;
        }
        if (DateOnly.TryParse(args.Value?.ToString(), out var value))
        {
            var requestVersion = _weekSelectionGuard.Begin();
            _weekLoadGuard.Invalidate();
            _generationRangeLoadGuard.Invalidate();
            _statusRestoreGuard.Invalidate();
            _rollbackablePlanLoadGuard.Invalidate();
            _autoGenConfigRestoreGuard.Invalidate();
            _activeAutoGenRestoreGuard.Invalidate();
            _latestRollbackableAutoGenPlan = null;
            _selectedDate = value;
            _weekContextLoadError = null;
            ClearLoadedWeekContext();
            await ResetStatusAsync(clearPersisted: false);
            if (!_weekSelectionGuard.IsCurrent(requestVersion))
            {
                return;
            }
            await RestorePersistedAutoGenConfigAsync(restoreCourseSelection: true);
            if (!_weekSelectionGuard.IsCurrent(requestVersion))
            {
                return;
            }
            SynchronizeVisibleContextQuery();
            if (!await TryLoadVisibleWeekAsync(clearExisting: false))
            {
                return;
            }
            if (!_weekSelectionGuard.IsCurrent(requestVersion))
            {
                return;
            }
            await RestorePersistedAutoGenStatusAsync();
            if (!_weekSelectionGuard.IsCurrent(requestVersion))
            {
                return;
            }
            await RestoreLatestRollbackableAutoGenPlanAsync();
        }
    }
