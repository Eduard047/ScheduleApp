    private async Task LogDeleteAsync(string summary, TableItem item)
    {
        var lesson = new AdminScheduleLogLesson(
            Id: item.Id,
            Date: item.Date.ToString("yyyy-MM-dd"),
            TimeStart: item.TimeStart,
            TimeEnd: item.TimeEnd,
            Group: SafeValue(item.Group),
            Module: SafeValue(item.Module),
