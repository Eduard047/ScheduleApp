    // Обробляє помилки API та зберігає конфлікти.
    private async Task HandleApiError(ApiErrorException ex)
    {
        var headline = ComposeErrorHeadline(ex);
        error = headline;
        if (ex.StatusCode == HttpStatusCode.Conflict && (ex.Errors.Count > 0 || ex.Warnings.Count > 0))
        {
            var expanded = _conflictStorage.TryGetValue(CurrentWeekKey, out var existing)
                ? existing.Expanded
                : true;
            var details = new ConflictDetails
            {
                Message = headline,
                Errors = ex.Errors.ToList(),
                Warnings = ex.Warnings.ToList(),
                SavedAt = DateTimeOffset.Now,
                Expanded = expanded
            };
            _conflictStorage[CurrentWeekKey] = details;
            _currentConflict = details;
            await PersistConflictsAsync();
        }
    }
    // Формує короткий заголовок помилки з деталей API.
    private static string ComposeErrorHeadline(ApiErrorException ex)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(ex.Message))
        {
            parts.Add(ex.Message.Trim());
        }
        var firstError = ex.Errors.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));
        if (!string.IsNullOrWhiteSpace(firstError))
        {
            parts.Add(firstError!.Trim());
        }
        else
        {
            var firstWarning = ex.Warnings.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
            if (!string.IsNullOrWhiteSpace(firstWarning))
            {
                parts.Add(firstWarning!.Trim());
            }
        }
        if (parts.Count == 0)
        {
            return "Невідома помилка.";
        }
        return parts.Count == 1 ? parts[0] : string.Join(": ", parts.Distinct(StringComparer.Ordinal));
    }
    // Завантажує конфлікти з localStorage.
    private async Task LoadConflictsAsync()
    {
        if (_conflictsLoaded) return;
        _conflictsLoaded = true;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ConflictStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var data = JsonSerializer.Deserialize<Dictionary<string, ConflictDetails>>(json, ConflictJsonOptions);
                if (data is not null)
                {
                    _conflictStorage = data;
                }
            }
        }
        catch
        {
            _conflictStorage = new();
        }
    }
    // Зберігає конфлікти у localStorage.
    private async Task PersistConflictsAsync()
    {
        try
        {
            if (_conflictStorage.Count == 0)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", ConflictStorageKey);
            }
            else
            {
                var json = JsonSerializer.Serialize(_conflictStorage, ConflictJsonOptions);
                await JS.InvokeVoidAsync("localStorage.setItem", ConflictStorageKey, json);
            }
        }
        catch
        {
        }
    }
    // Синхронізує поточний конфлікт із кешем.
    private void SyncCurrentConflict()
    {
        _conflictStorage.TryGetValue(CurrentWeekKey, out _currentConflict);
    }
    // Перемикає видимість деталей конфлікту.
    private async Task ToggleConflictDetails()
    {
        if (_currentConflict is null) return;
        _currentConflict.Expanded = !_currentConflict.Expanded;
        _conflictStorage[CurrentWeekKey] = _currentConflict;
        await PersistConflictsAsync();
    }
    // Очищає конфлікт для поточного тижня.
    private async Task ClearConflictDetails()
    {
        if (_conflictStorage.Remove(CurrentWeekKey))
        {
            _currentConflict = null;
            await PersistConflictsAsync();
        }
    }
    // Повертає понеділок поточного тижня.
    private static DateOnly GetMonday(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    // Завантажує чернетки та опублікований розклад за тиждень.
    private async Task LoadWeek()
    {
        var monday = GetMonday(_selectedDate);
        var draftTask = Drafts.GetWeek(monday, null);
        var publishedTask = Api.GetWeek(monday);
        await Task.WhenAll(draftTask, publishedTask);
        var draftData = await draftTask;
        var publishedData = await publishedTask;
        draftItems.Clear();
        draftItems.AddRange(draftData);
        publishedItems.Clear();
        publishedItems.AddRange(publishedData);
        RebuildTableItems();
        ok ??= $"Завантажено {draftItems.Count} чернеток та {publishedItems.Count} опублікованих записів.";
        error = null;
    }
    private void RebuildTableItems()
    {
        tableItems.Clear();
        tableItems.AddRange(draftItems.Select(CreateTableItemFromDraft));
        tableItems.AddRange(publishedItems.Select(CreateTableItemFromPublished));
        SyncCurrentConflict();
    }
    private void RemoveTableItemFromState(TableItem item)
    {
        if (item.Source == TableItemSource.Draft)
        {
            draftItems.RemoveAll(x => x.Id == item.Id);
        }
        else
        {
            publishedItems.RemoveAll(x => x.Id == item.Id);
        }
        RebuildTableItems();
    }
    private void RemoveItemsFromState(TableItemSource source, Func<TableItem, bool> predicate)
    {
        if (source == TableItemSource.Draft)
        {
            var ids = tableItems
                .Where(item => item.Source == TableItemSource.Draft)
                .Where(predicate)
                .Select(item => item.Id)
                .ToHashSet();
            if (ids.Count == 0)
            {
                return;
            }
            draftItems.RemoveAll(x => ids.Contains(x.Id));
        }
        else
        {
            var ids = tableItems
                .Where(item => item.Source == TableItemSource.Published)
                .Where(predicate)
                .Select(item => item.Id)
                .ToHashSet();
            if (ids.Count == 0)
            {
                return;
            }
            publishedItems.RemoveAll(x => ids.Contains(x.Id));
        }
        RebuildTableItems();
    }
    private async Task LogAutoGenAsync(
        string summary,
        AutoGenResult res,
        DateOnly rangeStart,
        DateOnly rangeEnd,
        int courseId,
        string courseName,
        Dictionary<int, int> moduleHours,
        bool softFill)
    {
        var lessons = BuildDraftLessonSnapshot(out var trimmed);
        var logWarnings = res.Warnings
            .Where(warning => !string.IsNullOrWhiteSpace(warning))
            .Select(warning => warning.Trim())
            .Where(warning => !IsSlotGapWarning(warning))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var entry = new AdminScheduleLogEntry(
            Id: Guid.NewGuid().ToString("N"),
            Timestamp: DateTimeOffset.Now,
            ActionCode: softFill ? LogActionFill : LogActionAutogen,
            ActionLabel: softFill ? "Заповнення порожніх слотів" : "Автогенерація (чернетки)",
            Summary: summary,
            Success: true,
            Error: null,
            WeekStart: rangeStart.ToString("yyyy-MM-dd"),
            WeekEnd: rangeEnd.ToString("yyyy-MM-dd"),
            DaysPreset: FormatWeekPreset(_daysPreset),
            AllowDaysOff: null,
            CourseId: courseId,
            CourseName: courseName,
            ModuleHours: BuildModuleHours(moduleHours),
            Warnings: logWarnings,
            GapDetails: res.GapDetails?.ToList() ?? new List<AutoGenGapDetail>(),
            Lessons: lessons,
            LessonsTrimmed: trimmed
        );
        await TryWriteLogAsync(entry);
    }
