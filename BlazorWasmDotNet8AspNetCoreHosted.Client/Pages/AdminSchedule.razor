    // Завантажує чернетки та опублікований розклад за тиждень.
    private async Task LoadWeek()
    {
        var requestVersion = _weekLoadGuard.Begin();
        var monday = GetMonday(_selectedDate);
        var draftTask = Drafts.GetWeek(monday, null);
        var publishedTask = Api.GetWeek(monday);
        var rangeTask = LoadGenerationRangeItemsAsync();
        await Task.WhenAll(draftTask, publishedTask, rangeTask);
        if (!_weekLoadGuard.IsCurrent(requestVersion)
            || GetMonday(_selectedDate) != monday)
        {
            return;
        }
        var draftData = await draftTask;
        var publishedData = await publishedTask;
        draftItems.Clear();
        draftItems.AddRange(draftData);
        publishedItems.Clear();
        publishedItems.AddRange(publishedData);
        RebuildTableItems();
        error = null;
    }
    // Завантажує записи всіх тижнів, що перетинають діапазон генерації, для спільного лічильника.
    private async Task LoadGenerationRangeItemsAsync()
    {
        var requestVersion = _generationRangeLoadGuard.Begin();
        var weekStarts = BuildGenerationWeekStarts();
        var draftTasks = weekStarts
            .Select(weekStart => Drafts.GetWeek(weekStart, null))
            .ToList();
        var publishedTasks = weekStarts
            .Select(weekStart => Api.GetWeek(weekStart))
            .ToList();

        await Task.WhenAll(draftTasks.Cast<Task>().Concat(publishedTasks));

        var loadedItems = new List<TableItem>();
        foreach (var task in draftTasks)
        {
            loadedItems.AddRange(task.Result.Select(CreateTableItemFromDraft));
        }
        foreach (var task in publishedTasks)
        {
            loadedItems.AddRange(task.Result.Select(CreateTableItemFromPublished));
        }
        if (!_generationRangeLoadGuard.IsCurrent(requestVersion))
        {
            return;
        }

        _generationRangeItems.Clear();
        _generationRangeItems.AddRange(loadedItems);
    }
    private void RebuildTableItems()
    {
        tableItems.Clear();
        tableItems.AddRange(draftItems.Select(CreateTableItemFromDraft));
        tableItems.AddRange(publishedItems.Select(CreateTableItemFromPublished));
        SyncCurrentConflict();
    }
    private async Task<string?> RemoveTableItemFromStateAsync(TableItem item)
    {
        _generationRangeLoadGuard.Invalidate();
        _generationRangeItems.RemoveAll(candidate =>
            candidate.Source == item.Source
            && candidate.Id == item.Id);
        if (GetMonday(item.Date) == GetMonday(_selectedDate))
        {
            // Не скасовуємо завантаження іншого тижня, якщо користувач уже змінив дату.
            _weekLoadGuard.Invalidate();
            if (item.Source == TableItemSource.Draft)
            {
                draftItems.RemoveAll(x => x.Id == item.Id);
            }
            else
            {
                publishedItems.RemoveAll(x => x.Id == item.Id);
            }
            RebuildTableItems();
        }
        return await RefreshGenerationRangeItemsAfterMutationAsync();
    }
    private async Task<string?> RemoveItemsFromStateAsync(TableItemSource source, Func<TableItem, bool> predicate)
    {
        _weekLoadGuard.Invalidate();
        _generationRangeLoadGuard.Invalidate();
        if (source == TableItemSource.Draft)
        {
            var ids = tableItems
                .Where(item => item.Source == TableItemSource.Draft)
                .Where(predicate)
                .Select(item => item.Id)
                .ToHashSet();
            if (ids.Count > 0)
            {
                _generationRangeItems.RemoveAll(item =>
                    item.Source == TableItemSource.Draft
                    && ids.Contains(item.Id));
                draftItems.RemoveAll(x => ids.Contains(x.Id));
            }
        }
        else
        {
            var ids = tableItems
                .Where(item => item.Source == TableItemSource.Published)
                .Where(predicate)
                .Select(item => item.Id)
                .ToHashSet();
            if (ids.Count > 0)
            {
                _generationRangeItems.RemoveAll(item =>
                    item.Source == TableItemSource.Published
                    && ids.Contains(item.Id));
                publishedItems.RemoveAll(x => ids.Contains(x.Id));
            }
        }
        RebuildTableItems();
        return await RefreshGenerationRangeItemsAfterMutationAsync();
    }
    // Після вже успішної зміни на сервері помилка повторного читання не повинна маскувати результат операції.
    private async Task<string?> RefreshGenerationRangeItemsAfterMutationAsync()
    {
        try
        {
            await LoadGenerationRangeItemsAsync();
            return null;
        }
        catch (ApiErrorException ex)
        {
            return $"Зміни збережено, але не вдалося оновити лічильник пар за діапазон: {ComposeErrorHeadline(ex)}";
        }
        catch (HttpRequestException)
        {
            return "Зміни збережено, але не вдалося оновити лічильник пар за діапазон через помилку мережі.";
        }
        catch (Exception)
        {
            return "Зміни збережено, але під час оновлення лічильника пар за діапазон сталася помилка.";
        }
    }
    private async Task LogAutoGenAsync(
        string summary,
        AutoGenResult res,
        DateOnly rangeStart,
        DateOnly rangeEnd,
        int courseId,
        string courseName,
        Dictionary<int, int> moduleHours,
        bool softFill,
        AutoGenJobState finalState,
        string? jobError)
    {
        var lessons = BuildDraftLessonSnapshot(out var trimmed);
        var logWarnings = res.Warnings
            .Where(warning => !string.IsNullOrWhiteSpace(warning))
            .Select(warning => warning.Trim())
            .Where(warning => !IsSlotGapWarning(warning))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var entry = new AdminScheduleLogEntry(
            Id: Guid.NewGuid().ToString("N"),
            Timestamp: DateTimeOffset.Now,
            ActionCode: softFill ? LogActionFill : LogActionAutogen,
            ActionLabel: softFill ? "Дозаповнення відсутніх пар" : "Автогенерація (чернетки)",
            Summary: summary,
            Success: finalState == AutoGenJobState.Succeeded,
            Error: finalState switch
            {
                AutoGenJobState.Failed => string.IsNullOrWhiteSpace(jobError)
                    ? "Задача автогенерації завершилася з помилкою."
                    : jobError,
                AutoGenJobState.Canceled => "Операцію скасовано користувачем.",
                _ => null
            },
            WeekStart: rangeStart.ToString("yyyy-MM-dd"),
            WeekEnd: rangeEnd.ToString("yyyy-MM-dd"),
            DaysPreset: FormatWeekPreset(_daysPreset),
            AllowDaysOff: null,
            CourseId: courseId,
            CourseName: courseName,
            ModuleHours: BuildModuleHours(moduleHours),
            Warnings: logWarnings,
            GapDetails: res.GapDetails?.ToList() ?? new List<AutoGenGapDetail>(),
            Lessons: lessons,
            LessonsTrimmed: trimmed
        );
        await TryWriteLogAsync(entry);
    }
    private async Task LogWeekClearAsync(string actionCode, string actionLabel, string summary, DateOnly weekStart)
    {
