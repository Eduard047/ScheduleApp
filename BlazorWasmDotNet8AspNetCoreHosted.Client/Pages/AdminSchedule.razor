    // Початкове завантаження метаданих і станів сторінки.
    protected override async Task OnInitializedAsync()
    {
        var initializationWeekStart = QueryWeekStart;
        var initializationCourseId = QueryCourseId;
        var initializationQueryContextKey = BuildQueryContextKey(initializationWeekStart, initializationCourseId);
        _metaLoadInProgress = true;
        _metaLoadError = null;
        try
        {
            meta = await Api.GetMeta();
        }
        catch (ApiErrorException ex)
        {
            _metaLoadError = $"Не вдалося завантажити довідники: {ComposeErrorHeadline(ex)}";
            return;
        }
        catch (HttpRequestException)
        {
            _metaLoadError = "Не вдалося завантажити довідники через помилку мережі.";
            return;
        }
        catch (TaskCanceledException)
        {
            _metaLoadError = "Завантаження довідників тривало надто довго. Спробуйте ще раз.";
            return;
        }
        catch (Exception)
        {
            _metaLoadError = "Не вдалося завантажити довідники. Спробуйте ще раз.";
            return;
        }
        finally
        {
            _metaLoadInProgress = false;
        }
        if (meta is null)
        {
            _metaLoadError = "Сервер не повернув необхідні довідники. Спробуйте ще раз.";
            return;
        }
        _calendarLookup = meta.Calendar
            .Where(c => c.CourseId is null && c.GroupId is null)
            .Select(c => new { Date = DateOnly.ParseExact(c.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture), c.IsWorkingDay })
            .GroupBy(x => x.Date)
            .ToDictionary(g => g.Key, g => g.First().IsWorkingDay);
        _selectedDate = ResolveRequestedWeekStart(initializationWeekStart, _selectedDate);
        var requestedCourseId = ResolveRequestedCourseId(initializationCourseId);
        if (requestedCourseId is int courseId)
        {
            _selectedCourseId = courseId;
            BuildModuleWeekRows();
            BuildCourseGroupRows();
        }
        var selectedWeekStart = GetMonday(_selectedDate);
        _generationFromDate = selectedWeekStart;
        _generationToDate = selectedWeekStart.AddDays(4);
        // Мережевий довідник аудиторій і локальні налаштування незалежні,
        // тому завантажуємо їх паралельно, скорочуючи старт сторінки.
        var roomCatalogTask = LoadRoomCatalogAsync();
        var lastAutoGenInputTask = LoadLastAutoGenInputAsync();
        await Task.WhenAll(roomCatalogTask, lastAutoGenInputTask);
        await RestorePersistedAutoGenConfigAsync(restoreCourseSelection: requestedCourseId is null);
        if (_selectedCourseId is null && meta.Courses.Count == 1)
        {
            _selectedCourseId = meta.Courses[0].Id;
            BuildModuleWeekRows();
            BuildCourseGroupRows();
        }
        TryAlignGenerationRangeWithAcademicPeriod();
        breakTypeId = meta.LessonTypes.FirstOrDefault(x => x.Code == "BREAK")?.Id ?? 0;
        canceledTypeId = meta.LessonTypes.FirstOrDefault(x => x.Code == "CANCELED")?.Id ?? 0;
        await LoadConflictsAsync();
        var initialWeekLoaded = await TryLoadVisibleWeekAsync();
        if (initialWeekLoaded)
        {
            await RestorePersistedAutoGenStatusAsync();
            await RestoreActiveAutoGenJobAsync();
            await RestoreLatestRollbackableAutoGenPlanAsync();
        }
        _appliedQueryContextKey = initializationQueryContextKey;
        _pageInitializationComplete = true;
        if (!string.Equals(_appliedQueryContextKey, GetQueryContextKey(), StringComparison.Ordinal))
        {
            _queryContextApplyPending = true;
            await OnParametersSetAsync();
            return;
        }
        // Канонізуємо початкову адресу після обов'язкового першого OnParametersSetAsync,
        // щоб replace-навігація не запускала повторне повне завантаження того самого контексту.
        _initialContextSyncPending = true;
    }
    private async Task RetryPageInitializationAsync()
    {
        if (_metaLoadInProgress)
        {
            return;
        }

        await OnInitializedAsync();
    }
    // Оновлює сторінку, коли Blazor повторно використовує її з іншим тижнем або курсом у посиланні.
    protected override async Task OnParametersSetAsync()
    {
        var queryContextKey = GetQueryContextKey();
        if (!_pageInitializationComplete
            || meta is null
            || string.Equals(_appliedQueryContextKey, queryContextKey, StringComparison.Ordinal))
        {
            return;
        }
        if (IsAutoGenBusy || _editDeleting || _queryContextApplyInProgress)
        {
            _queryContextApplyPending = true;
            return;
        }

        _queryContextApplyPending = false;
        _queryContextApplyInProgress = true;
        try
        {
            var requestedWeekStart = ResolveRequestedWeekStart(_selectedDate);
            var requestedCourseId = ResolveRequestedCourseId();
            _weekSelectionGuard.Invalidate();
            _weekLoadGuard.Invalidate();
            _generationRangeLoadGuard.Invalidate();
            _statusRestoreGuard.Invalidate();
            _rollbackablePlanLoadGuard.Invalidate();
            _autoGenConfigRestoreGuard.Invalidate();
            _activeAutoGenRestoreGuard.Invalidate();
            _latestRollbackableAutoGenPlan = null;
            _appliedPlanReviewContext = null;
            _lastAutoGenInputRestored = false;
            _weekContextLoadError = null;
            ClearLoadedWeekContext();
            _selectedDate = requestedWeekStart;
            _generationFromDate = requestedWeekStart;
            _generationToDate = requestedWeekStart.AddDays(4);
            _selectedCourseId = requestedCourseId;
            BuildModuleWeekRows();
            BuildCourseGroupRows();
            await ResetStatusAsync(clearPersisted: false);
            await RestorePersistedAutoGenConfigAsync(restoreCourseSelection: requestedCourseId is null);
            if (_selectedCourseId is null && meta.Courses.Count == 1)
            {
                _selectedCourseId = meta.Courses[0].Id;
                BuildModuleWeekRows();
                BuildCourseGroupRows();
            }
            TryAlignGenerationRangeWithAcademicPeriod();
            var weekLoaded = await TryLoadVisibleWeekAsync(clearExisting: false);
            if (weekLoaded)
            {
                await RestorePersistedAutoGenStatusAsync();
                await RestoreActiveAutoGenJobAsync();
                await RestoreLatestRollbackableAutoGenPlanAsync();
            }
            _appliedQueryContextKey = queryContextKey;
        }
        finally
        {
            _queryContextApplyInProgress = false;
        }
        if (!string.Equals(GetQueryContextKey(), queryContextKey, StringComparison.Ordinal))
        {
            _queryContextApplyPending = true;
            _ = InvokeAsync(ApplyPendingQueryContextAsync);
            return;
        }
        _queryContextApplyPending = false;
        SynchronizeVisibleContextQuery();
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pageInitializationComplete || !_initialContextSyncPending)
        {
            return Task.CompletedTask;
        }

        _initialContextSyncPending = false;
        if (_queryContextApplyPending
            || !string.Equals(_appliedQueryContextKey, GetQueryContextKey(), StringComparison.Ordinal))
        {
            // Новіший зовнішній query має пріоритет над відкладеною канонізацією початкової адреси.
            return Task.CompletedTask;
        }
        SynchronizeVisibleContextQuery();
        return Task.CompletedTask;
    }
    private DateOnly ResolveRequestedWeekStart(DateOnly fallback)
        => ResolveRequestedWeekStart(QueryWeekStart, fallback);
    private static DateOnly ResolveRequestedWeekStart(string? queryWeekStart, DateOnly fallback)
        => DateOnly.TryParse(queryWeekStart, out var requestedDate)
            ? GetMonday(requestedDate)
            : GetMonday(fallback);
    private int? ResolveRequestedCourseId()
        => ResolveRequestedCourseId(QueryCourseId);
    private int? ResolveRequestedCourseId(int? queryCourseId)
        => queryCourseId is > 0
            && meta?.Courses.Any(course => course.Id == queryCourseId) == true
                ? queryCourseId
                : null;
    private string GetQueryContextKey()
        => BuildQueryContextKey(QueryWeekStart, QueryCourseId);
    private static string BuildQueryContextKey(string? queryWeekStart, int? queryCourseId)
        => $"{queryWeekStart?.Trim()}|{queryCourseId?.ToString(CultureInfo.InvariantCulture)}";
    // Записує фактично видимі тиждень і курс у URL, не запускаючи повторне відновлення стану сторінки.
    private void SynchronizeVisibleContextQuery()
    {
        var visibleWeekStart = GetMonday(_selectedDate);
        var weekStartValue = visibleWeekStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var targetContextKey = BuildQueryContextKey(weekStartValue, _selectedCourseId);
        var targetUri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["weekStart"] = weekStartValue,
            ["courseId"] = _selectedCourseId
        });

        // Внутрішня replace-навігація лише канонізує адресу; стан уже відповідає цільовому контексту.
        _appliedQueryContextKey = targetContextKey;
        if (!string.Equals(targetUri, Nav.Uri, StringComparison.Ordinal))
        {
            Nav.NavigateTo(targetUri, replace: true);
        }
    }
