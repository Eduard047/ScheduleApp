@* Верхня панель навігації застосунку *@
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="app-navbar" aria-label="Головна навігація">
    <div class="app-navbar__inner">
        <div class="app-navbar__nav" role="menubar">
            @foreach (var item in PrimaryNavItems)
            {
                <NavLink class="app-navbar__item"
                         ActiveClass="app-navbar__item--active"
                         href="@item.Href"
                         Match="NavLinkMatch.All"
                         role="menuitem">
                    @item.Label
                </NavLink>
            }
        </div>

        <div class="app-navbar__admin">
            <button type="button"
                    class="@AdminItemClass"
                    @onclick="ToggleAdminMenu"
                    aria-expanded="@AdminMenuExpanded"
                    aria-haspopup="menu">
                Адмін
                <span class="app-navbar__caret" aria-hidden="true"></span>
            </button>

            <div class="@AdminMenuClass" role="menu" aria-hidden="@AdminMenuHidden">
                @foreach (var item in AdminNavItems)
                {
                    <NavLink class="app-navbar__dropdown-item"
                             href="@item.Href"
                             Match="NavLinkMatch.All"
                             @onclick="CloseAdminMenu"
                             role="menuitem">
                        @item.Label
                    </NavLink>
                }
            </div>
        </div>
    </div>
</nav>

@if (_isAdminMenuOpen)
{
    <button type="button"
            class="app-navbar__backdrop"
            aria-label="Закрити меню Адмін"
            @onclick="CloseAdminMenu"></button>
}

@code {
    private static readonly NavItem[] PrimaryNavItems =
    [
        new("/schedule", "Розклад"),
        new("/teacher-drafts", "Графік викладачів"),
        new("/admin/schedule", "Редактор")
    ];

    private static readonly NavItem[] AdminNavItems =
    [
        new("/admin/schedule-logs", "Журнал розкладу"),
        new("/admin/time-slots", "Слоти часу"),
        new("/admin/courses", "Курси"),
        new("/admin/buildings", "Корпуси"),
        new("/admin/rooms", "Аудиторії"),
        new("/admin/groups", "Групи"),
        new("/admin/lesson-types", "Типи занять"),
        new("/admin/modules", "Модулі"),
        new("/admin/module-sequence", "Послідовності"),
        new("/admin/departments", "Кафедри"),
        new("/admin/teachers", "Викладачі"),
        new("/admin/calendar", "Календар")
    ];

    private bool _isAdminMenuOpen;

    private string AdminItemClass =>
        IsAdminActive || _isAdminMenuOpen
            ? "app-navbar__item app-navbar__item--dropdown app-navbar__item--active"
            : "app-navbar__item app-navbar__item--dropdown";

    private string AdminMenuClass =>
        _isAdminMenuOpen
            ? "app-navbar__dropdown-menu app-navbar__dropdown-menu--open"
            : "app-navbar__dropdown-menu";

    private string AdminMenuExpanded => _isAdminMenuOpen ? "true" : "false";

    private string AdminMenuHidden => _isAdminMenuOpen ? "false" : "true";

    private bool IsAdminActive => AdminNavItems.Any(item => IsCurrentRoute(item.Route));

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _isAdminMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleAdminMenu()
    {
        _isAdminMenuOpen = !_isAdminMenuOpen;
    }

    private void CloseAdminMenu()
    {
        _isAdminMenuOpen = false;
    }

    private bool IsCurrentRoute(string route)
    {
        var currentPath = GetCurrentPath();
        return currentPath.Equals(route, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith($"{route}/", StringComparison.OrdinalIgnoreCase);
    }

    private string GetCurrentPath()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var queryIndex = currentPath.IndexOf('?');
        if (queryIndex >= 0)
        {
            currentPath = currentPath[..queryIndex];
        }

        var fragmentIndex = currentPath.IndexOf('#');
        if (fragmentIndex >= 0)
        {
            currentPath = currentPath[..fragmentIndex];
        }

        return currentPath.Trim('/');
    }

    private sealed record NavItem(string Href, string Label)
    {
        public string Route => Href.Trim('/');
    }
}
